          <input id="cvChatInput" type="text" maxlength="500" placeholder="Nhập tin nhắn…" style="flex:1;min-width:160px" onkeydown="if(event.key==='Enter')cvSendChat()">
          <button type="button" class="cv-btn blue small" onclick="cvSendChat()">Gửi</button>
