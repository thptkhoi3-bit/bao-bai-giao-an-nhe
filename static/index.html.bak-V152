="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></symbol><symbol id="i-wand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72Z"/><path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/></symbol><symbol id="i-files" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15.5 2H8.6c-.4 0-.8.2-1.1.5-.3.3-.5.7-.5 1.1v12.8c0 .4.2.8.5 1.1.3.3.7.5 1.1.5h9.8c.4 0 .8-.2 1.1-.5.3-.3.5-.7.5-1.1V6.5L15.5 2z"/><path d="M3 7.6v12.8c0 .4.2.8.5 1.1.3.3.7.5 1.1.5h9.8"/><path d="M15 2v5h5"/></symbol><symbol id="i-chart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></symbol><symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></symbol><symbol id="i-checkc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></symbol><symbol id="i-alert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></symbol><symbol id="i-sliders" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="4" y1="21" y2="14"/><line x1="4" x2="4" y1="10" y2="3"/><line x1="12" x2="12" y1="21" y2="12"/><line x1="12" x2="12" y1="8" y2="3"/><line x1="20" x2="20" y1="21" y2="16"/><line x1="20" x2="20" y1="12" y2="3"/><line x1="2" x2="6" y1="14" y2="14"/><line x1="10" x2="14" y1="8" y2="8"/><line x1="18" x2="22" y1="16" y2="16"/></symbol><symbol id="i-clipboard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></symbol><symbol id="i-cap" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/><path d="M22 10v6"/></symbol><symbol id="i-clip" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></symbol><symbol id="i-folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m6 14 1.45-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.55 6a2 2 0 0 1-1.94 1.5H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H18a2 2 0 0 1 2 2v2"/></symbol><symbol id="i-clock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></symbol><symbol id="i-circle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></symbol><symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol><symbol id="i-bell" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></symbol><symbol id="i-users" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol><symbol id="i-login" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" x2="3" y1="12" y2="12"/></symbol><symbol id="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></symbol><symbol id="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></symbol><symbol id="i-cal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></symbol><symbol id="i-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></symbol><symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></symbol><symbol id="i-send" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></symbol><symbol id="i-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></symbol></svg>
<header class="v9 hide" id="hdr"><div class="banner" role="img" aria-label="Báo bài - Giáo án · Đơn giản - Nhanh chóng - Hiệu quả · Vì những ngày dạy học hạnh phúc"><div class="bl"></div><div class="br"></div><h1 class="sr">Báo bài - Giáo án</h1></div>
<div class="hbar"><div id="navdrop" class="hide"><button id="t1" class="on" role="menuitem" onclick="tab(1)"><span class="te">📒</span>Báo bài</button><button id="t2" role="menuitem" style="display:none" onclick="tab(2)"><span class="te">📗</span>Giáo án</button><button id="t3" role="menuitem" onclick="etShow()"><span class="te">📝</span>Tạo đề</button><button id="t4" role="menuitem" onclick="tab(4)"><span class="te">🧒</span>Nhận xét</button><button id="t5" role="menuitem" onclick="tab(5)"><span class="te">🗂️</span>Kho lưu</button><button id="t8" role="menuitem" onclick="ttsShow()"><span class="te">🔊</span>Đọc văn bản</button><button id="t9" role="menuitem" onclick="tab(9)"><span class="te">🧰</span>Công cụ lớp học</button><button id="t10" role="menuitem" onclick="tab(10)"><span class="te">🎮</span>Học vui chơi giỏi</button><button id="t11" role="menuitem" onclick="tab(11)"><span class="te">🎓</span>Giáo viên ôn VC</button><button id="t12" role="menuitem" onclick="tab(12)"><span class="te">🍚</span>Bán trú thông minh</button><button id="t13" role="menuitem" onclick="tab(13)"><span class="te">🍚</span>Bán trú</button><button id="tva" role="menuitem" onclick="vaShow()"><span class="te">🎬</span>Tạo video AI</button><button id="tcv" role="menuitem" onclick="cvShow()"><span class="te">♟️</span>Cờ vua</button></div><button class="btn light" type="button" onclick="homeShow()" style="margin-left:8px">🏠 Trang chủ</button><div class="hright"><div class="acard"><span class="aav"><svg class="i"><use href="#i-user"/></svg></span><span><small>Người viết phần mềm</small><b>Lê Đắc Đạt</b></span></div><a class="aphone" href="tel:0865291703"><svg class="i"><use href="#i-phone"/></svg>0865291703</a>
<div class="user hide" id="userbox"><div class="ledbox" title="Tổng số lượt thầy/cô đã truy cập phần mềm"><span class="ledlab">👥 LƯỢT TRUY CẬP</span><span class="lednum" id="lednum">------</span></div><button class="admb hide" id="admbtn" type="button" onclick="openAdm()" title="Quản lý tài khoản"><svg class="i"><use href="#i-users"/></svg><span class="lo">Quản lý tài khoản</span><span class="badge hide" id="admbadge">0</span></button><button class="admb hide" id="visitbtn" type="button" onclick="openVisits()" title="Thông báo người truy cập"><svg class="i"><use href="#i-bell"/></svg><span class="lo">Người truy cập</span><span class="badge hide" id="visitbadge">0</span></button><div class="umenu" id="umenu"><button class="uchip" type="button" onclick="uMenuToggle(event)" aria-haspopup="true" aria-expanded="false" title="Tài khoản của thầy/cô"><svg class="i"><use href="#i-user"/></svg><span id="uname"></span><span id="utier" class="utier hide"></span><span class="ucaret">▾</span></button><div class="udrop hide" id="udrop" role="menu"><button type="button" role="menuitem" onclick="pwOpen()">🔑 Đổi mật khẩu</button><button type="button" role="menuitem" onclick="giOpen()">📝 Thông tin giáo án</button><button type="button" role="menuitem" onclick="logout()">🚪 Đăng xuất</button></div></div></div></div></div></header>
<section id="login" class="hide off">
<div class="stage" id="stage">
  <div class="bg" id="bgOff"></div>
  <div class="bg" id="bgOn"></div>
  <div id="dim"></div>
  <div class="chain" id="chain">
    <div class="chain-eyelet"></div>
    <div class="chain-line" id="chainLine"></div>
    <div class="chain-ball" id="chainBall"></div>
    <div class="chain-hit" id="chainHit"></div>
  </div>

  <div class="dash-layer">
    <div class="dash">
      <div class="dash-banner">
        <div class="dash-logo">🎓</div>
        <div>
          <div class="dash-title">Chào mừng bạn đến với trường học <span>thông minh</span>.</div>
          <div class="dash-sub">Công nghệ đồng hành cùng thầy cô – Nâng tầm giáo dục</div>
        </div>
        <div class="dash-dev">
          <span class="gear">⚙️</span>
          <span><small>Nhà phát triển</small><b>Lê Đắc Đạt</b><small>Giải pháp chuyển đổi số giáo dục</small></span>
        </div>
      </div>
      <div class="dash-portrait"><img src="/static/img/dash-portrait.jpg?v=__V__" alt="Giáo viên"></div>
      <div class="dash-login">
        <div class="dash-tabs">
          <button type="button" class="dash-tab active" id="dTabIn" onclick="showReg(false)">Đăng nhập</button>
          <button type="button" class="dash-tab" id="dTabUp" onclick="showReg(true)">Đăng ký</button>
        </div>
        <p class="hello" id="dHello">Chào mừng bạn quay trở lại!</p>
        <div id="lview">
          <div id="regbox"><label for="lph">Số điện thoại</label>
          <div class="dash-field"><span class="ico">📱</span><input id="lph" type="tel" inputmode="tel" autocomplete="tel" placeholder="Nhập số điện thoại"></div></div>
          <label for="lp">Mật khẩu</label>
          <div class="dash-field"><span class="ico">🔒</span><input id="lp" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" onkeydown="if(event.key==='Enter')login()"><button type="button" class="dash-eye" id="eyeb" onclick="togglePw()" aria-label="Hiện mật khẩu"><svg class="i"><use href="#i-eye"/></svg></button></div>
          <button type="button" class="dash-submit" id="lbtn" onclick="login()">Đăng nhập →</button>
          <p class="dash-msg" id="lerr"></p>
          <p class="lsw">Chưa có tài khoản? <button type="button" id="toReg" onclick="showReg(true)">Đăng ký</button></p>
        </div>
        <div id="rview" class="hide">
          <div id="rform">
            <label for="rname">Họ và tên *</label>
            <div class="dash-field"><span class="ico">👤</span><input id="rname" maxlength="80" autocomplete="name" placeholder="Họ và tên *"></div>
            <label for="rphone">Số điện thoại *</label>
            <div class="dash-field"><span class="ico">📱</span><input id="rphone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Số điện thoại * (VD: 0912345678)"></div>
            <label for="rschool">Trường / lớp</label>
            <div class="dash-field"><span class="ico">📖</span><input id="rschool" maxlength="120" autocomplete="organization" placeholder="Trường / lớp (không bắt buộc)"></div>
            <label for="rpw">Mật khẩu *</label>
            <div class="dash-field"><span class="ico">🔒</span><input id="rpw" type="password" autocomplete="new-password" placeholder="Mật khẩu * (tối thiểu 6 ký tự)"></div>
            <label for="rpw2">Nhập lại mật khẩu *</label>
            <div class="dash-field"><span class="ico">🔒</span><input id="rpw2" type="password" autocomplete="new-password" placeholder="Nhập lại mật khẩu *" onkeydown="if(event.key==='Enter')doReg()"></div>
            <button type="button" class="dash-submit" id="rbtn" onclick="doReg()">GỬI ĐĂNG KÝ</button>
            <p class="dash-msg" id="rerr"></p>
          </div>
          <div id="rok" class="rok hide"><span>✓</span><div><b>Đăng ký thành công</b><span id="rokt"></span></div></div>
          <p class="lsw">Đã có tài khoản? <button type="button" id="toLogin" onclick="showReg(false)">Đăng nhập</button></p>
        </div>
        <p class="dash-note">Đăng ký xong dùng ngay.</p>
      </div>
      <div class="dash-funcs">
        <h3>▦ Các chức năng chính</h3>
        <div class="tile-row r3">
          <div class="tile" style="background:#EC4899"><div class="t-ico">📄</div><b>Báo bài tự động</b><small>Soạn báo bài nhanh chóng</small></div>
          <div class="tile" style="background:#3B82F6"><div class="t-ico">📝</div><b>Giáo án tự động</b><small>Tạo giáo án theo chương trình</small></div>
          <div class="tile" style="background:#22C55E"><div class="t-ico">✅</div><b>Tạo đề kiểm tra</b><small>Đề đa dạng, theo ma trận</small></div>
        </div>
        <div class="tile-row r4">
          <div class="tile" style="background:#7C3AED"><div class="t-ico">🤖</div><b>Trợ lý</b><small>Hỗ trợ giảng dạy, giải đáp</small></div>
          <div class="tile" style="background:#F59E0B"><div class="t-ico">👥</div><b>Nhận xét học sinh</b><small>Nhận xét nhanh, dễ dàng</small></div>
          <div class="tile" style="background:#D946EF"><div class="t-ico">📊</div><b>Thống kê</b><small>Báo cáo trực quan</small></div>
          <div class="tile" style="background:#06B6D4"><div class="t-ico">📁</div><b>Quản lý bài viết</b><small>Lưu trữ và chia sẻ tài liệu</small></div>
        </div>
      </div>
      <div class="dash-stats">
        <div class="stat"><span class="s-ico">👥</span><span><b>1,250+</b><small>Học sinh</small></span></div>
        <div class="stat"><span class="s-ico">📖</span><span><b>120+</b><small>Bài giảng</small></span></div>
        <div class="stat"><span class="s-ico">📋</span><span><b>350+</b><small>Đề kiểm tra</small></span></div>
        <div class="stat"><span class="s-ico">📊</span><span><b>98%</b><small>Tỷ lệ hài lòng</small></span></div>
      </div>
    </div>
  </div>

  <div class="hint" id="hint">Điều gì xảy ra khi bạn kéo dây đèn</div>
<script>
(function(){

  var lampOn = false;
  var loginSec = document.getElementById('login');
  var hint = document.getElementById('hint');
  var chain = document.getElementById('chain');
  var chainLine = document.getElementById('chainLine');
  var chainBall = document.getElementById('chainBall');

  // ---- Âm thanh tổng hợp bằng WebAudio (không cần file ngoài) ----
  var soundOn = true;
  var AC = null;
  function ac() {
    try {
      if (!AC) AC = new (window.AudioContext || window.webkitAudioContext)();
      if (AC.state === 'suspended') AC.resume();
      return AC;
    } catch (e) { return null; }
  }
  function tone(freq, t0, dur, type, vol, slideTo) {
    var ctx = ac(); if (!ctx || ctx.state !== 'running' || !soundOn) return;
    var o = ctx.createOscillator(), g = ctx.createGain();
    o.type = type || 'sine';
    o.frequency.setValueAtTime(freq, ctx.currentTime + t0);
    if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, ctx.currentTime + t0 + dur);
    g.gain.setValueAtTime(0.0001, ctx.currentTime + t0);
    g.gain.exponentialRampToValueAtTime(vol, ctx.currentTime + t0 + 0.01);
    g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + t0 + dur);
    o.connect(g); g.connect(ctx.destination);
    o.start(ctx.currentTime + t0); o.stop(ctx.currentTime + t0 + dur + 0.05);
  }
  function noiseBurst(t0, dur, vol, fFrom, fTo) {
    var ctx = ac(); if (!ctx || ctx.state !== 'running' || !soundOn) return;
    var len = Math.floor(ctx.sampleRate * dur);
    var buf = ctx.createBuffer(1, len, ctx.sampleRate);
    var d = buf.getChannelData(0);
    for (var i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
    var src = ctx.createBufferSource(); src.buffer = buf;
    var bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.Q.value = 1.2;
    bp.frequency.setValueAtTime(fFrom, ctx.currentTime + t0);
    bp.frequency.exponentialRampToValueAtTime(fTo, ctx.currentTime + t0 + dur);
    var g = ctx.createGain();
    g.gain.setValueAtTime(0.0001, ctx.currentTime + t0);
    g.gain.exponentialRampToValueAtTime(vol, ctx.currentTime + t0 + 0.05);
    g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + t0 + dur);
    src.connect(bp); bp.connect(g); g.connect(ctx.destination);
    src.start(ctx.currentTime + t0);
  }
  var Snd = {
    pull: function () { noiseBurst(0, 0.4, 0.10, 3200, 700); tone(2400, 0.05, 0.08, 'triangle', 0.05); },
    clickOn: function () { tone(1900, 0, 0.03, 'square', 0.10, 900); noiseBurst(0, 0.05, 0.12, 4000, 1500); },
    chime: function () { [1318, 1568, 1976, 2637].forEach(function (f, i) { tone(f, i * 0.09, 0.9, 'sine', 0.08); }); tone(4200, 0.1, 0.7, 'sine', 0.03); },
    clickOff: function () { tone(900, 0, 0.05, 'square', 0.08, 420); }
  };
  document.addEventListener('pointerdown', function () { ac(); }, { passive: true });

  // ---- Trạng thái: off (ảnh tối + phủ tối) → on (ảnh sáng) ----
  function isNarrow() { return window.innerWidth / window.innerHeight < 1.2; }
  function hintText() {
    return 'Điều gì xảy ra khi bạn kéo dây đèn';
  }
  function setBg(on) {
    lampOn = on;
    loginSec.classList.remove('off', 'on');
    loginSec.classList.add(on ? 'on' : 'off');
    hint.innerHTML = hintText();
    hint.style.display = on ? 'none' : '';
  }

  // ---- Căn dây đúng đèn trong ảnh ở mọi cửa sổ (cover math) ----
  // Tọa độ đo từ ảnh thầy gửi: mép dưới chao (0.165, 0.512); dây dài ~0.117 chiều cao ảnh
  var IMG_W = 1671, IMG_H = 941;
  var RIM = { x: 0.165, y: 0.512 }, CORD_LEN = 0.117;
  var cordX = 0, chainTopY = 0, restLen = 0, currentStretch = 0;
  function setStretch(s) {
    currentStretch = s;
    chainLine.style.height = (restLen + s) + 'px';
    chainBall.style.top = (restLen - 8 + s) + 'px';
  }
  function layoutCord() {
    var w = window.innerWidth, h = window.innerHeight;
    var s = Math.max(w / IMG_W, h / IMG_H);
    var dw = IMG_W * s, dh = IMG_H * s;
    // Màn hình hẹp: nền căn trái để đèn (bên trái ảnh) không bị cắt mất
    var narrow = isNarrow();
    var pos = narrow ? 'left center' : 'center';
    document.getElementById('bgOff').style.backgroundPosition = pos;
    document.getElementById('bgOn').style.backgroundPosition = pos;
    var ox = narrow ? 0 : (w - dw) / 2, oy = (h - dh) / 2;
    cordX = ox + RIM.x * dw;
    chainTopY = oy + RIM.y * dh;
    restLen = CORD_LEN * dh;
    chain.style.left = (cordX - 12) + 'px';
    chain.style.top = chainTopY + 'px';
    setStretch(currentStretch);
    hint.innerHTML = hintText();
  }
  window.addEventListener('resize', layoutCord);
  layoutCord();
  setBg(lampOn);

  // Dây co lại kèm dao động tắt dần + lắc ngang nhẹ quanh điểm gắn
  var swayId = null;
  function swayChain(fromY) {
    if (swayId) cancelAnimationFrame(swayId);
    chainLine.style.transition = 'none';
    chainBall.style.transition = 'none';
    var start = performance.now(), dur = 1400;
    function frame(now) {
      var t = (now - start) / 1000;
      if (t >= dur / 1000) {
        chain.style.transform = '';
        chainLine.style.transition = '';
        chainBall.style.transition = '';
        setStretch(0);
        swayId = null;
        return;
      }
      var decay = Math.exp(-3.0 * t);
      setStretch(fromY * decay * Math.cos(13 * t));
      chain.style.transform = 'rotate(' + (5 * Math.exp(-2.5 * t) * Math.sin(9 * t)).toFixed(2) + 'deg)';
      swayId = requestAnimationFrame(frame);
    }
    swayId = requestAnimationFrame(frame);
  }

  function toggleLamp() {
    if (lampOn) { setBg(false); Snd.clickOff(); }
    else { setBg(true); Snd.clickOn(); setTimeout(Snd.chime, 120); }
  }

  // Bấm vào dòng gợi ý cũng bật/tắt được (phòng khi dây bị form che trên màn hình hẹp)
  hint.addEventListener('click', function () {
    if (dragging || animating) return;
    toggleLamp();
  });

  // Bấm: dây dãn xuống rồi bật/tắt ở điểm cuối. Kéo: dây theo tay, thả quá 45px thì bật/tắt.
  var startY = 0, dy = 0, dragging = false, animating = false;
  var hit = document.getElementById('chainHit');
  hit.addEventListener('pointerdown', function (e) {
    if (animating) return;
    if (swayId) { cancelAnimationFrame(swayId); swayId = null; }
    dragging = true; startY = e.clientY; dy = 0;
    hit.setPointerCapture(e.pointerId);
    chain.style.transform = '';
    chainLine.style.transition = 'none';
    chainBall.style.transition = 'none';
  });
  hit.addEventListener('pointermove', function (e) {
    if (!dragging) return;
    dy = Math.max(0, Math.min(90, e.clientY - startY));
    setStretch(dy);
  });
  hit.addEventListener('pointerup', function (e) {
    if (!dragging) return;
    dragging = false;
    if (dy < 8) {
      // Bấm nhẹ: dây tự dãn xuống rồi bật/tắt
      animating = true;
      Snd.pull();
      chainLine.style.transition = 'height 0.35s ease-in-out';
      chainBall.style.transition = 'top 0.35s ease-in-out';
      setStretch(90);
      setTimeout(function () {
        toggleLamp();
        animating = false;
        swayChain(90);
      }, 360);
    } else {
      if (dy > 45) toggleLamp();
      swayChain(dy);
    }
    dy = 0;
  });
  hit.addEventListener('pointercancel', function () {
    if (!dragging) return;
    dragging = false;
    swayChain(dy);
    dy = 0;
  });
  layoutCord(); setBg(false);
})();
</script>
</section>
<main>
<section id="app" class="hide">
 <div id="nodata" class="alert hide"></div>
 <div id="p1" class="grid">
  <div>
   <div class="card c1"><img class="ill" src="/static/img/ill_books.webp?v=__V__" alt=""><div class="step" id="s11"><div class="num">1</div><div><h2>Báo bài gốc</h2><p>Bản tổng hợp các tuần của thầy/cô.</p></div></div>
    <div id="mbadge"></div><p class="muted" id="mstat"></p>
    <a class="btn light" id="mdl" href="/api/baobai/download"><svg class="i"><use href="#i-download"/></svg>Tải báo bài gốc hiện tại</a>
    <details class="more" id="mmore"><summary>Thay báo bài gốc khác</summary>
     <label class="drop" data-drop><input type="file" id="mfile" accept=".docx"><div class="ic"><svg class="i"><use href="#i-file"/></svg></div><b>Chạm để chọn tệp .docx</b><small>hoặc kéo thả vào đây</small><div class="files"></div></label>
     <button class="btn" onclick="replaceMaster(this)"><span class="spin"></span><span class="bi"><svg class="i"><use href="#i-upload"/></svg></span> Tải lên &amp; thay thế</button></details></div>
   <div class="card c2"><img class="ill" src="/static/img/ill_folder.webp?v=__V__" alt=""><div class="step"><div class="num">2</div><div><h2>Tải báo bài phụ</h2><p>Tệp có tên bài của tuần cần điền.</p></div></div>
    <label class="drop" data-drop><input type="file" id="bbfile" accept=".docx"><div class="ic"><svg class="i"><use href="#i-cloud"/></svg></div><b>Chạm để chọn báo bài phụ</b><small>hoặc kéo thả tệp .docx vào đây</small><div class="files"></div></label>
    <div id="bbauto" class="alert" style="display:none;margin-top:6px"></div></div>
   <div class="card c3"><img class="ill" src="/static/img/ill_note.webp?v=__V__" alt=""><div class="step"><div class="num">3</div><div><h2>Điền &amp; tải về</h2><p>Chỉ điền ô trống của tuần đã chọn, các tuần khác giữ nguyên.</p></div></div>
    <button class="btn" id="bbgo" onclick="fill()"><span class="spin"></span><span class="bi"><svg class="i"><use href="#i-sparkles"/></svg></span> Điền báo bài</button><div id="bbres"></div></div>
  </div>
  <div class="sticky"><div class="card pvcard"><div class="pvhead"><div class="step"><div class="num eye"><svg class="i"><use href="#i-eye"/></svg></div><div><h2 id="pvh">Xem trước tuần</h2><p>Kiểm tra nhanh trước khi in. Bấm vào ô Tên bài / Tích hợp để sửa.</p></div></div>
   <div class="wbox"><label for="wsel">Chọn tuần để xem</label><div class="wsel"><svg class="i"><use href="#i-cal"/></svg><select id="wsel" onchange="showWeek()"></select></div></div></div>
   <div class="legend"><span><i></i>Ô còn trống tên bài</span><span id="pvcount"></span></div><div class="tw" id="pv"><p class="muted" style="padding:12px">Chưa có dữ liệu.</p></div></div></div>
 </div>
 <style>
#p2 .sticky .card{border-radius:18px;overflow:hidden}
#p2 .card.c1,#p2 .card.c2,#p2 .card.c3{border-radius:18px}
#p2 .bbband{margin:-14px -16px 12px;padding:13px 16px;background:linear-gradient(90deg,#1d4ed8,#0ea5e9);border-radius:18px 18px 0 0}
#p2 .rsband{margin:-14px -16px 12px;padding:13px 16px;background:linear-gradient(90deg,#047857,#10b981);border-radius:18px 18px 0 0}
#p2 .bbband h2,#p2 .rsband h2{color:#fff}
#p2 .bbband p{color:#dbeafe}
#p2 .rsband p{color:#d1fae5}
#p2 .rsband .num{background:#ffffff33}
#p2 #ggo{background:linear-gradient(90deg,#2563eb,#7c3aed);border:0}
@media(max-width:1180px){#p2 #bbcmp,#p2 #gres{max-height:62vh}}
</style>
<div id="p2" class="grid hide">
  <div>
   <div class="card c1"><img class="ill" src="/static/img/ill_cal.webp?v=__V__" alt=""><div class="step"><div class="num">1</div><div><h2>Chọn tuần</h2><p>Chọn tuần cần tạo giáo án.</p></div></div>
    <div id="tbadge" style="display:none"></div><label class="f" for="gweek">Tuần <small id="ghint" class="whint">· Chọn tuần cần làm trước</small></label><select id="gweek" onchange="wGate();bbInfo().then(()=>gaGate());bbCmp()"></select>
    <div id="bbinfo" class="muted" style="margin-top:6px;font-size:13px"></div>
    </div>
   <div class="card c2" id="gac2"><img class="ill" src="/static/img/ill_folder.webp?v=__V__" alt=""><div class="step"><div class="num">2</div><div><h2>Tải giáo án phụ</h2><p>Một hoặc nhiều tệp, mỗi tệp một hay nhiều môn. Có thể bỏ trống.</p></div></div>
    <label class="drop" data-drop><input type="file" id="gfiles" accept=".docx" multiple><div class="ic"><svg class="i"><use href="#i-files"/></svg></div><b>Chạm để chọn các giáo án phụ</b><small>thêm dần từng môn trong lần làm này</small><div class="files"></div></label>
    <div id="dstat" class="dstat"></div><p class="muted" style="font-size:12.5px;margin-top:8px">🔒 Giáo án phụ <b>không được lưu lại</b> — tạo xong là hệ thống xóa ngay; mỗi lần tạo, thầy/cô tải lên mới để tránh dùng nhầm bản cũ.</p></div>
   <div class="card c3" id="gac3"><img class="ill" src="/static/img/ill_note.webp?v=__V__" alt=""><div class="step"><div class="num">3</div><div><h2>Ghép giáo án</h2><p>Chèn từng bài vào đúng TIẾT, giữ nguyên định dạng, bảng, hình.</p></div></div>
    <button class="btn" id="ggo" onclick="build()"><span class="spin"></span><span class="bi"><svg class="i"><use href="#i-wand"/></svg></span> Tạo giáo án</button></div>
   <details class="more" id="thwrap"><summary>🧩 Tích hợp thêm (không bắt buộc) — NLS, AI, Link…</summary>
    <div class="card c2" id="thcard">
    <div id="thstat" class="muted" style="margin:4px 0"></div>
    <div id="thbody"><div id="thcats" class="thcats"></div>
     <div class="thbtns"><button class="btn light sm" id="thpv" type="button" onclick="thPreview()"><span class="spin"></span>👁 Xem trước</button><button class="btn sm" id="thgo" type="button" onclick="thRun('verbatim')"><span class="spin"></span>✚ Tích hợp</button></div>
     <details class="more" id="thup"><summary>Tải / thay Khung KHDH (.odt, .docx)</summary>
      <label class="drop" data-drop><input type="file" id="thfile" accept=".odt,.docx"><div class="ic"><svg class="i"><use href="#i-file"/></svg></div><b>Chạm để chọn Khung KHDH</b><small>chỉ cần tải 1 lần</small><div class="files"></div></label>
      <button class="btn" type="button" onclick="thUpload(this)"><span class="spin"></span><span class="bi"><svg class="i"><use href="#i-upload"/></svg></span> Tải lên</button></details></div></div>
   </details>
   </div>
  <div class="sticky"><div style="display:flex;gap:14px;flex:1;min-height:0;min-width:0;width:100%;height:100%;align-items:stretch"><div class="card" style="flex:1 1 0;min-width:0;display:flex;flex-direction:column;min-height:0"><div class="step bbband"><div class="num" style="background:#ffffff33">📋</div><div><h2>Báo bài <span id="bbcmpw"></span></h2><p>Đối chiếu với giáo án đã ghép ở khung bên cạnh.</p></div></div><div id="bbcmp" style="flex:1;min-height:0;overflow:auto"><p class="muted" style="padding:10px">Anh chọn tuần ở Bước 1 — báo bài của tuần đó sẽ hiện ở đây để đối chiếu với giáo án đã ghép bên cạnh.</p></div></div><div class="card pvcard" style="flex:1 1 0;min-width:0;display:flex;flex-direction:column;min-height:0"><div class="step rsband"><div class="num eye"><svg class="i"><use href="#i-chart"/></svg></div><div><h2>Kết quả</h2><p>Tóm tắt từng TIẾT sau khi ghép.</p></div></div><div id="gres"><p class="muted">Bấm “Tạo giáo án” để xem kết quả ở đây.</p></div><div id="gact" style="display:none;gap:8px;align-items:center;border-top:1px solid #e6ecf5;padding-top:12px;margin-top:10px"><a class="btn green" id="gdl2" href="#" style="flex:1;justify-content:center;white-space:nowrap"><svg class="i"><use href="#i-download"/></svg>Tải giáo án về máy</a><button class="btn blue" type="button" style="flex:1;justify-content:center;white-space:nowrap" onclick="gvOpen()">👁️ Xem giáo án</button></div></div></div></div>
 </div>
 <div id="p3" class="grid hide">
  <div><div style="margin:2px 0 12px"><button type="button" onclick="etShow()" style="width:100%;padding:10px;border:0;border-radius:10px;background:#2563eb;color:#fff;font-weight:700;cursor:pointer">← Giao diện EduTest</button></div>
   <div class="card c1 de1"><div class="step"><div class="num">1</div><div><h2>Thông tin đề</h2><p>Phần đầu đề theo trường của thầy cô.</p></div></div>
    <div class="dgrid"><div><label class="f" for="dxa">UBND xã</label><input class="tx" id="dxa" placeholder="VD: Hoà Bình" autocomplete="off"></div><div><label class="f" for="dtruong">Trường</label><input class="tx" id="dtruong" placeholder="VD: TH Kim Đồng" autocomplete="off"></div>
     <div><label class="f" for="dnam">Năm học</label><select id="dnam"><option>2025 - 2026</option><option selected>2026 - 2027</option><option>2027 - 2028</option></select></div><div><label class="f" for="dlop">Lớp</label><select id="dlop"><option value="1">Lớp 1</option><option value="2">Lớp 2</option><option value="3" selected>Lớp 3</option><option value="4">Lớp 4</option><option value="5">Lớp 5</option></select></div>
     <div class="fw"><label class="f" for="dloai">Loại bài</label><select id="dloai"><option value="Giữa học kì I">BÀI KIỂM TRA GIỮA HỌC KÌ I</option><option value="Cuối học kì I">BÀI KIỂM TRA CUỐI HỌC KÌ I</option><option value="Giữa học kì II">BÀI KIỂM TRA GIỮA HỌC KÌ II</option><option value="Cuối học kì II">BÀI KIỂM TRA CUỐI HỌC KÌ II</option></select></div>
     <div><label class="f" for="dmon">Môn</label><select id="dmon" onchange="deMon();deClearAll()"><option value="toan">Toán</option><option value="tv">Tiếng Việt</option></select></div><div id="dkindw" class="hide"><label class="f" for="dkind">Loại đề</label><select id="dkind" onchange="deMon()"><option value="doc">Đọc hiểu</option><option value="viet">Viết</option></select></div><div><label class="f" for="dtg">Thời gian</label><input class="tx" id="dtg" value="40 phút"></div>
    </div></div>
   <div class="card c2"><div class="step"><div class="num">2</div><div><h2>Tải nội dung đề</h2><p>Ảnh, PDF hoặc Word – chọn được nhiều tệp.</p></div></div>
    <div id="dtoan"><label class="drop" data-ddrop><input type="file" id="dfiles" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx"><b>Chạm để chọn tệp đề</b><small>· hoặc kéo thả vào đây</small></label><div class="thumbs" id="dthumbs"></div></div>
    <div id="dtv" class="hide"><div class="slots">
     <label class="slot" data-slot><input type="file" id="ddoc" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx"><span class="sic r"><svg class="i"><use href="#i-book"/></svg></span><span class="st" title="bài đọc + câu hỏi"><b>Đề đọc hiểu</b> <small>bài đọc + câu hỏi</small></span><span class="sf add"><svg class="i"><use href="#i-upload"/></svg>Chọn tệp</span></label>
     <label class="slot" data-slot><input type="file" id="dviet" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx"><span class="sic w"><svg class="i"><use href="#i-pen"/></svg></span><span class="st" title="đề viết đoạn"><b>Đề viết</b> <small>viết đoạn</small></span><span class="sf add"><svg class="i"><use href="#i-upload"/></svg>Chọn tệp</span></label>
     <label class="slot" data-slot><input type="file" id="dnghe" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx"><span class="sic n"><svg class="i"><use href="#i-file"/></svg></span><span class="st" title="GV đọc"><b>Bài nghe - viết</b> <small>GV đọc</small></span><span class="sf add"><svg class="i"><use href="#i-upload"/></svg>Chọn tệp</span></label></div>
     <label class="drop one" data-ddrop><input type="file" id="dall" multiple accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx"><b>hoặc tải chung 1 file</b><small>· tự tách 3 phần</small></label><div class="thumbs sm" id="dallthumbs"></div></div>
    <p class="muted ainote" id="dainote"></p></div>
   <div class="card c3"><div class="step s3"><div class="num">3</div><div><h2 style="white-space:nowrap">Tạo đề</h2></div><label class="ck"><input type="checkbox" id="ddapan" checked> <span id="ddapanl">Kèm đáp án</span></label></div>
    <div class="brow"><button class="btn" id="dgo" onclick="deCreate(this)"><span class="spin"></span><span class="bi"><svg class="i"><use href="#i-wand"/></svg></span> Tạo đề</button><a class="btn light dis" id="ddl" href="#" onclick="return deDl(event)"><svg class="i"><use href="#i-download"/></svg> Tải file Word</a></div>
    <div id="dadm" class="hide dadm"><span>Đề mẫu (quản trị):</span><label class="lnk" title="Thay đề mẫu cho môn đang chọn"><input type="file" id="dtpl" accept=".docx" onchange="deTpl(this)">Thay đề mẫu <b id="dtplm">Toán</b></label><a href="#" class="lnk" id="dtplr" title="Dùng lại đề mẫu gốc đi kèm phần mềm" onclick="return deTplReset()">Mẫu gốc</a></div></div>
  </div>
  <div class="sticky"><div class="card pvcard dpv"><div class="pvhead"><div class="step"><div class="num eye"><svg class="i"><use href="#i-eye"/></svg></div><div><h2>Xem trước đề</h2><p id="dpvsub">Khổ A4 · đúng như file Word</p></div></div><div class="dhr"><span class="badge ok hide" id="dbadge"><svg class="i"><use href="#i-checkc"/></svg><span></span></span><button class="btn light sm hide" id="dnew" type="button" onclick="deNew()" title="Xoá đề hiện tại và các tệp đã chọn để làm đề khác">↺ Tạo đề mới</button></div></div>
   <div class="dmode"><div class="ptabs" id="dptabs" role="tablist"></div><div class="dsw" role="tablist"><button id="dmA4" class="on" onclick="deMode('a4')">📄 Trang A4</button><button id="dmEd" onclick="deMode('ed')">✏️ Sửa nội dung</button></div></div>
   <div class="dfw hide" id="dfw" role="alert"></div><div class="paperwrap" id="dwrap"><div class="dempty" id="dempty"><svg class="i"><use href="#i-file"/></svg><b>Chưa có đề</b><span>Điền thông tin, tải nội dung đề rồi bấm “Tạo đề”. Đề sẽ hiện ở đây đúng như khi in.</span></div><img id="dpage" class="dpage hide" alt="Trang đề" title="Bấm để xem cả trang / phóng to" onclick="this.classList.toggle('fit')"><div id="dhtml" class="paper hide"></div><div id="ded" class="ded hide"></div></div>
   <div class="pvnav" id="dnav"><button class="btn light sm" id="dprev" onclick="dePg(-1)" disabled>‹ Trang trước</button><span id="dpgi">–</span><button class="btn light sm" id="dnext" onclick="dePg(1)" disabled>Trang sau ›</button></div>
   <div class="pvnav hide" id="dednav"><span class="muted" id="dedinfo">Sửa xong bấm “Cập nhật đề” để dựng lại file Word.</span><button class="btn sm" id="dupd" onclick="deUpdate(this)"><span class="spin"></span>Cập nhật đề</button></div>
  </div></div>
 </div>
 <div id="p4" class="grid hide">
  <div>
   <div class="card c1"><div class="step"><div class="num">1</div><div><h2>Thông tin đánh giá</h2><p>Theo Thông tư 27/2020/TT-BGDĐT.</p></div></div>
    <div class="nxrow"><div><label class="f" for="nxki">Kì đánh giá</label><select id="nxki" onchange="nxSet()"></select></div><div><label class="f" for="nxlop">Lớp</label><input class="tx" id="nxlop" value="2" maxlength="20" oninput="nxSet()"></div></div>
    <label class="f">Môn học &amp; hoạt động giáo dục</label><div class="nxsubs" id="nxsubs"></div></div>
   <div class="card c2"><div class="step"><div class="num">2</div><div><h2>Danh sách lớp</h2><p>Tải tệp .xlsx / .docx / .csv hoặc dán danh sách.</p></div></div>
    <label class="drop" data-drop><input type="file" id="nxfile" accept=".xlsx,.docx,.csv,.txt"><div class="ic"><svg class="i"><use href="#i-users"/></svg></div><b>Chạm để chọn tệp danh sách</b><small>cột “Họ và tên” hoặc mỗi dòng 1 em</small><div class="files"></div></label>
    <textarea id="nxpaste" placeholder="hoặc dán danh sách, mỗi dòng 1 em&#10;1. Nguyễn Văn An&#10;2. Trần Thị Bình"></textarea>
    <div class="nxbtns"><button class="btn light" id="nxload" onclick="nxLoadList(this)"><span class="spin"></span>📋 Nhập danh sách</button><button class="btn light" onclick="nxAddRow()">＋ Thêm 1 em</button></div></div>
   <div class="card c3"><div class="step"><div class="num">3</div><div><h2>Viết nhận xét &amp; xuất tệp</h2><p>Mỗi em một lời nhận xét khác nhau, đúng mức đạt.</p></div></div>
    <button class="btn" id="nxgo" onclick="nxGen(this)"><span class="spin"></span><span class="bi"><svg class="i"><use href="#i-sparkles"/></svg></span> Viết nhận xét cả lớp</button>
    <p class="muted nxmsg" id="nxai"></p>
    <div class="nxbtns"><button class="btn green" id="nxx" onclick="nxExport(this,'xlsx')"><span class="spin"></span>⬇ Excel (.xlsx)</button><button class="btn green" id="nxw" onclick="nxExport(this,'docx')"><span class="spin"></span>⬇ Word (.docx)</button></div></div>
  </div>
  <div class="sticky"><div class="card pvcard"><div class="nxhead"><div class="step"><div class="num eye"><svg class="i"><use href="#i-clipboard"/></svg></div><div><h2>Bảng đánh giá <span class="muted" id="nxcnt" style="font-size:14px"></span></h2><p>Chọn mức đạt cho từng em, rồi xem và sửa lời nhận xét.</p></div></div>
    <div class="nxsw" role="tablist"><button id="nxv1" class="on" onclick="nxView(1)">Mức đạt</button><button id="nxv2" onclick="nxView(2)">Nhận xét</button></div></div>
   <div class="nxtw" id="nxtw"><div class="nxempty">Chưa có học sinh. Thầy cô nhập danh sách lớp ở bước 2 nhé.</div></div></div></div>
 </div>
 <div id="p5" class="grid hide">
  <div>
   <div class="card c1"><div class="step"><div class="num"><svg class="i"><use href="#i-folder"/></svg></div><div><h2>Kho lưu theo tuần</h2><p>Tự lưu mọi tệp thầy cô đã tạo.</p></div></div>
    <p class="muted" style="font-size:13.5px;margin:4px 0">Báo bài đã điền, giáo án, giáo án tích hợp, đề kiểm tra, bảng nhận xét, phiếu bài tập, trò chơi được lưu theo <b>tuần</b>. Tạo lại cùng loại trong cùng tuần thì giữ bản mới nhất.</p>
    <div id="khstat" class="muted" style="font-size:13px"></div><div class="khbar"><i id="khbar" style="width:0"></i></div>
    <button class="btn light" onclick="khLoad(1)">↻ Làm mới</button></div>
  </div>
  <div class="sticky"><div class="card pvcard"><div class="step"><div class="num eye"><svg class="i"><use href="#i-files"/></svg></div><div><h2>Tệp đã lưu</h2><p>Theo tuần, mới nhất ở trên. Chỉ thầy cô xem được kho của mình.</p></div></div>
   <div class="khl" id="khl"><p class="muted">Đang tải…</p></div></div></div>
 </div>
 <div id="p8" class="hide grid"></div>
<div id="p9" class="hide grid"><div><div class="card" id="gvCard"><div class="step"><div class="n">🎉</div><div><h2>Gọi tên vui</h2><p>Mười trò gọi tên ngẫu nhiên bằng hoạt hình cho lớp học. Bấm vào thẻ trò nào thì sân khấu hiện trò đó; cần chiếu to đã có nút Toàn màn hình ở dưới. Nhập danh sách tên ngay trong thẻ bên dưới sân khấu.</p></div></div>
<style>
#gvCard .gv-games{display:flex;gap:10px;margin:10px 0}
#gvCard .gv-gbtn{flex:1;background:#FFFDF8;border:2px solid #F0DFC2;border-radius:14px;padding:9px 6px 7px;cursor:pointer;font-family:inherit;text-align:center}
#gvCard .gv-gbtn.on{border-color:#F06423;background:#FFF1E2}
#gvCard .gv-emo{font-size:26px;display:block}
#gvCard .gv-gn{font-weight:800;color:#7C4A1E;display:block}
#gvCard .gv-gd{font-size:11.5px;color:#A5855F;display:block}
#gvCard .gv-stagewrap{position:relative;border-radius:14px;overflow:hidden;background:#BDE7FF}
#gvStage{display:block;width:100%;height:auto}
#gvTimer{position:absolute;top:8px;left:10px;background:rgba(0,0,0,.45);color:#fff;font-weight:800;font-size:17px;padding:2px 11px;border-radius:999px;display:none;z-index:3}
#gvTimer.urgent{background:#D32F2F;animation:gvTmShake .12s infinite}
@keyframes gvTmShake{0%{transform:translate(0,0)}50%{transform:translate(1.4px,-1px)}100%{transform:translate(-1px,1px)}}
#gvBanner{position:absolute;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;text-align:center;pointer-events:none;padding:8px;z-index:2}
#gvBanner .gv-b1{font-size:16px;font-weight:700;color:#fff;text-shadow:0 2px 8px rgba(0,0,0,.45)}
#gvBanner .gv-b2{font-size:42px;font-weight:900;color:#FFE45E;text-shadow:0 3px 0 #D97B06,0 6px 18px rgba(0,0,0,.4);line-height:1.15}
#gvBanner .gv-b3{font-size:14.5px;font-weight:700;color:#fff;text-shadow:0 2px 8px rgba(0,0,0,.45);background:rgba(0,0,0,.25);padding:3px 12px;border-radius:999px}
#gvCard .gv-ctrl{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:10px;flex-wrap:wrap}
#gvCounter{font-weight:800;color:#B3541E;font-size:14px}
#gvStart{background:linear-gradient(180deg,#FF8A3D,#F0541E);color:#fff;border:none;font-size:16.5px;font-weight:800;padding:10px 24px;border-radius:999px;cursor:pointer;box-shadow:0 4px 0 #C74312;font-family:inherit}
#gvStart:disabled{opacity:.55;cursor:wait}
#gvCard .gv-checks{display:flex;flex-wrap:wrap;gap:5px 14px;margin-top:9px;font-size:13.5px}
#gvCard .gv-checks label{display:flex;gap:5px;align-items:center;cursor:pointer;font-weight:600}
#gvCard .gv-row2{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;margin-top:9px;font-size:13.5px}
#gvCard .gv-sbtn{background:#FFF1E2;border:2px solid #F0C48C;color:#8A5312;border-radius:999px;padding:6px 12px;font-weight:700;cursor:pointer;font-family:inherit;font-size:13px}
#gvCard .gv-dur{display:flex;gap:8px;align-items:center;flex:1;min-width:240px;font-weight:600}
#gvDur{flex:1;accent-color:#F06423}
#gvCnt{width:64px;padding:5px 7px;border:2px solid #F0DFC2;border-radius:9px;font-family:inherit}
#gvCard .gv-called{margin-top:10px;font-size:13.5px;line-height:1.8}
#gvCalled .tag{display:inline-block;background:#FFF1E2;border:1.5px solid #F0C48C;border-radius:999px;padding:1px 9px;margin:0 3px 3px 0;font-weight:600}
#gvCalled .none{color:#B99B78}
#gvWrap:fullscreen{border-radius:0;background:#000}
#gvBanner .gv-board{background:linear-gradient(180deg,#FFFBEB,#FFEFC4);border:4px solid #B5641D;border-radius:22px;padding:20px 42px;box-shadow:0 16px 38px rgba(90,50,0,.35);text-align:center}
#gvBanner .gv-b1{font-size:23px;color:#A3540F;text-shadow:none}
#gvBanner .gv-b2{font-size:84px;color:#E64A19;text-shadow:0 2px 0 #FFD54F;line-height:1.12}
#gvBanner .gv-b3{font-size:18px;color:#7C4A1E;background:rgba(181,100,29,.13);text-shadow:none}
#gvNames{width:100%;box-sizing:border-box;border:2px solid #F0DFC2;border-radius:12px;padding:9px 11px;font-family:inherit;font-size:14.5px;background:#FFFDF8;resize:vertical}


#p9>div:first-child{grid-column:1/-1}
.p9top{display:grid;grid-template-columns:minmax(380px,32%) minmax(0,1fr);gap:14px;align-items:start}
@media(max-width:900px){.p9top{grid-template-columns:1fr}}
#gvCard{margin-top:14px}
#gvCard .gv-gbtn{padding:13px 6px 10px}
#gvCard .gv-emo{font-size:34px}
#gvCard .gv-gn{font-size:17.5px}
#gvCard .gv-gd{font-size:12.5px}
#gvBanner .gv-b1{font-size:21px}
#gvBanner .gv-b2{font-size:66px}
#gvBanner .gv-b3{font-size:17px}
#gvCounter{font-size:16.5px}
#gvStart{font-size:19px;padding:13px 36px}
#gvCard .gv-hint{text-align:center;color:#A68B6B;font-size:13.5px;margin-top:8px}
#gvCard .gv-cols{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
@media(max-width:900px){#gvCard .gv-cols{grid-template-columns:1fr}}
#gvCard .gv-mini{background:#FFFBF2;border:1.5px solid #F3E3C2;border-radius:14px;padding:11px 15px}
#gvCard .gv-mini h3{margin:0 0 8px;font-size:16.5px;color:#7C4A1E}
#gvCard .gv-called{margin-top:2px}

#gvCard .gv-games{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px}
#gvCard .gv-cols{grid-template-columns:1fr 1.3fr 1fr}
#gvCard .gv-stagewrap{max-width:880px;margin:0 auto}
#gvCard .gv-ctrl,#gvCard .gv-checks,#gvCard .gv-row2{max-width:880px;margin-left:auto;margin-right:auto}
#gvCard #gvWrap:fullscreen{max-width:none}
</style>
<div class="gv-games">
<button type="button" class="gv-gbtn on" data-gv="trung"><span class="gv-emo">🐔</span><span class="gv-gn">Trộm trứng</span><span class="gv-gd">Gà mẹ rượt đuổi</span></button>
<button type="button" class="gv-gbtn" data-gv="dua"><span class="gv-emo">🏁</span><span class="gv-gn">Đường đua</span><span class="gv-gd">Ai về đích trước</span></button>
<button type="button" class="gv-gbtn" data-gv="ca"><span class="gv-emo">🎣</span><span class="gv-gn">Câu cá</span><span class="gv-gd">Cá nào cắn câu</span></button>
<button type="button" class="gv-gbtn" data-gv="bong"><span class="gv-emo">🎈</span><span class="gv-gn">Bóng bay</span><span class="gv-gd">Quả cuối cùng còn lại</span></button>
<button type="button" class="gv-gbtn" data-gv="long"><span class="gv-emo">🦖</span><span class="gv-gn">Khủng long</span><span class="gv-gd">Ai bị ăn mất bánh</span></button>
<button type="button" class="gv-gbtn" data-gv="lua"><span class="gv-emo">🚀</span><span class="gv-gn">Tên lửa</span><span class="gv-gd">Ai lên Mặt Trăng trước</span></button>
<button type="button" class="gv-gbtn" data-gv="pin"><span class="gv-emo">🔦</span><span class="gv-gn">Đèn pin</span><span class="gv-gd">Tắt đèn đi tìm</span></button>
<button type="button" class="gv-gbtn" data-gv="qua"><span class="gv-emo">🎁</span><span class="gv-gn">Hộp quà</span><span class="gv-gd">Mở hộp nhận thử thách</span></button>
<button type="button" class="gv-gbtn" data-gv="the"><span class="gv-emo">🟥</span><span class="gv-gn">Thẻ đỏ</span><span class="gv-gd">Trọng tài rút thẻ</span></button>
<button type="button" class="gv-gbtn" data-gv="ufo"><span class="gv-emo">🛸</span><span class="gv-gn">UFO</span><span class="gv-gd">Đĩa bay bắt cóc</span></button>
</div>
<div class="gv-stagewrap" id="gvWrap"><canvas id="gvStage" width="960" height="540"></canvas><div id="gvTimer">⏱ 20</div><div id="gvBanner"><div class="gv-board"><div class="gv-b1" id="gvB1"></div><div class="gv-b2" id="gvB2"></div><div class="gv-b3" id="gvB3" style="display:none"></div></div></div></div>
<p class="gv-hint">Bấm vào sân chơi hoặc nút Bắt đầu!</p>
<div class="gv-ctrl"><span id="gvCounter">CÒN 0/0 BẠN CHƯA ĐƯỢC GỌI</span><button type="button" id="gvStart">Bắt đầu!</button></div>
<div class="gv-checks">
<label><input type="checkbox" id="gvSit" checked> Bạn đã được gọi thì nghỉ lượt sau</label>
<label><input type="checkbox" id="gvShuffle"> Trộn vị trí mỗi lượt</label>
<label><input type="checkbox" id="gvTwist"> Lật kèo</label>
<label><input type="checkbox" id="gvSound" checked> Âm thanh</label>
</div>
<div class="gv-cols">
<div class="gv-mini"><h3>⏱ Thời gian chọn</h3>
<label class="gv-dur"><b><span id="gvDurVal">20</span> giây</b><input type="range" id="gvDur" min="10" max="20" value="20"></label>
<p class="muted" style="margin:7px 0 0">Trong lúc chờ sẽ có vài lần “chọn hụt” cho hồi hộp. Bạn được gọi thật chỉ lộ diện ở khoảng 2 giây cuối.</p>
</div>
<div class="gv-mini"><h3>✏️ Nhập tên học sinh</h3>
<textarea id="gvNames" rows="4" placeholder="Mỗi dòng một tên — dán danh sách lớp vào đây. Số bạn chơi = số dòng tên."></textarea>
<p class="muted" style="margin:7px 0 0">Ưu tiên dùng danh sách nhập ở đây. Để trống thì dùng danh sách lớp đã lưu; không có nữa mới dùng số thứ tự.</p>
</div>
<div class="gv-mini"><h3>✅ Đã được gọi</h3>
<div class="gv-called"><span id="gvCalled"><span class="none">chưa bạn nào</span></span><br><button type="button" class="gv-sbtn" id="gvReset" style="margin-top:4px">↺ Làm lại từ đầu</button></div>
</div>
</div>
<div class="gv-row2">
<button type="button" class="gv-sbtn" id="gvSndTest">🔊 Thử âm thanh</button>
<button type="button" class="gv-sbtn" id="gvFs">⛶ Toàn màn hình</button>
<span class="muted" id="gvSrcNote"></span>
</div>
<div class="gv-row2" id="gvCntRow" style="display:none"><label style="font-weight:600">Số bạn (dùng số thứ tự) <input type="number" id="gvCnt" min="2" max="50" value="20"></label><span class="muted">mỗi bạn mang một số, từ 2 đến 50 bạn</span></div>
</div></div></div>
<div id="p11" class="hide grid"></div> <div id="p12" class="hide grid"><div>
<div class="card"><div class="step"><div class="n">🍚</div><div><h2>Bán trú thông minh</h2><p>Ứng dụng quản lý bán trú của Trường Tiểu học Phật Tích: phụ huynh báo nghỉ ăn trước giờ hạn, nhà trường duyệt báo muộn và chốt suất ăn cho nhà bếp mỗi ngày.</p></div></div>
<p class="muted">Ứng dụng có <b>hệ thống tài khoản riêng</b> theo vai trò (quản trị, Ban giám hiệu, giáo viên chủ nhiệm, nhân sự bán trú, nhà bếp, phụ huynh) — đăng nhập ngay trong khung bên cạnh, không dùng chung mật khẩu của web này.</p>
<p class="muted">Phụ huynh chỉ cần mở địa chỉ <b>/bantru/</b> trên điện thoại, đăng nhập bằng tài khoản nhà trường cấp và cài lên màn hình chính để dùng như một ứng dụng riêng.</p>
<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px"><a class="btn" href="/bantru/" target="_blank" rel="noopener">⛶ Mở Bán trú toàn màn hình</a></div>
</div>
</div><div class="sticky"><div style="flex:1;width:100%;max-width:980px;margin:0 auto;overflow:auto;min-height:0;padding-bottom:12px">
<div class="card" style="padding:10px"><iframe id="btFrame" title="Ứng dụng Bán trú thông minh" style="width:100%;height:78vh;border:0;border-radius:12px;background:#eff6ff"></iframe></div>
</div></div></div>
<script>function btInit(){var f=document.getElementById('btFrame');if(f&&!f.getAttribute('src'))f.setAttribute('src','/bantru/');}</script>
<div id="p13" class="hide grid"><div>
<div class="card"><div class="step"><div class="n">🍚</div><div><h2>Bán trú</h2><p>Mục Bán trú mới: giao diện lấy đúng ảnh mẫu của nhà trường làm nền, mọi nút bấm và số liệu đều chạy bằng hệ thống thật — chung tài khoản và dữ liệu với mục Bán trú thông minh.</p></div></div>
<p class="muted">Quản trị, Ban giám hiệu, giáo viên và nhân sự bán trú dùng bản quản trị; phụ huynh đăng nhập sẽ thấy bản di động với đúng các màn hình trong ảnh mẫu.</p>
<div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px"><a class="btn" href="/bantru2/" target="_blank" rel="noopener">⛶ Mở Bán trú toàn màn hình</a></div>
</div>
</div><div class="sticky"><div style="flex:1;width:100%;max-width:980px;margin:0 auto;overflow:auto;min-height:0;padding-bottom:12px">
<div class="card" style="padding:10px"><iframe id="bt2Frame" title="Mục Bán trú mới" style="width:100%;height:78vh;border:0;border-radius:12px;background:#0e2a4d"></iframe></div>
</div></div></div>
<script>function bt2Init(){var f=document.getElementById('bt2Frame');if(f&&!f.getAttribute('src'))f.setAttribute('src','/bantru2/');}</script>
<div id="p10" class="hide grid"><div><div class="card"><div class="step"><div class="n">🎮</div><div><h2>Góc học sinh</h2><p>Thầy cô mở mục này cho học sinh chơi trên TV/máy chiếu hoặc máy tính của lớp.</p></div></div>
<div id="hs-who"></div>
<label>Chọn trò chơi
<span style="display:flex;flex-direction:column;gap:8px;margin-top:6px">
<button class="btn2" type="button" onclick="hsOpen('math')">🐰 Nối thỏ với nhà — Toán</button>
<button class="btn2" type="button" onclick="hsOpen('read')">🔤 Bé tập đọc — Tiếng Việt</button>
<button class="btn2" type="button" onclick="hsOpen('mem')">🃏 Lật thẻ trí nhớ</button>
</span></label>
<div class="row"><button class="btn" type="button" onclick="hsFull()">⛶ Toàn màn hình</button><button class="btn2" type="button" onclick="hsReset()">🔄 Đổi bạn chơi</button></div>
<p class="muted">⭐ Sao thưởng cộng dồn trong buổi chơi — thầy cô dùng để khích lệ các bé thi đua nhẹ nhàng.</p>
</div></div>
<div class="sticky"><div id="hs-stage" class="hs-stage"></div></div></div>
</section>
</main>
<div id="homeView">
<span id="hmname" style="display:none"></span><span id="hmusername" style="display:none"></span><span id="hmvisits" style="display:none"></span><span id="hmbadge" style="display:none"></span>
<img class="hv-bg" src="/static/img/hv-desk-bright.jpg?v=__V__" alt="">
<div class="hv-stage">
<div class="hv-board hv-main">
<div class="hv-greet"><b id="hvGreet">Chào buổi chiều bạn,</b></div>
<div class="hv-note">👥 <span id="hvVisits">…</span> lượt truy cập · Trang chủ Trường học thông minh</div>
<div class="hv-ai"><input id="hvAiIn" placeholder="Hỏi Hiền AI điều gì ạ…" onkeydown="if(event.key==='Enter')hvAskAi()"><button type="button" onclick="hvAskAi()">Hỏi AI</button></div>
</div>
<div class="hv-board hv-func">
<h3>🧩 Bảng chức năng <span class="hv-hint">🖱️ Lăn chuột để trượt</span></h3>
<div class="hv-tiles">
<button class="hv-tile hv-tile-img" type="button" onclick="tab(1)" aria-label="Báo bài — Soạn bài nhanh chóng" title="Báo bài"><img src="/static/img/hv-btn-bao-bai.png?v=__V__" alt="Báo bài"></button>
