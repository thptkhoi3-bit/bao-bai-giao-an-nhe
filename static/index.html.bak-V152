</script><script>const NX={info:null,st:null,view:1,t:null,busy:0},NXM={T:"HTT",H:"HT",C:"CHT"},NXP={T:"T",D:"Đ",C:"CCG"};async function nxInit(t){if(!NX.info||t)try{const t=await api("/api/nhanxet");NX.info=t.info,NX.st=t.state||{ki:t.info.ki[0],lop:"2",truong:"",subjects:t.info.default_subjects.slice(),students:[]},$("nxki").innerHTML=t.info.ki.map(t=>`<option ${t===NX.st.ki?"selected":""}>${esc(t)}</option>`).join(""),$("nxlop").value=NX.st.lop||"2",nxSubs(),nxAi(),nxDraw()}catch(t){toast(t.message,"err")}}function nxAi(t){const n=NX.info;$("nxai").textContent=t||(n.ai?`Dùng AI (còn ${Math.max(0,n.ai_limit-n.ai_used)}/${n.ai_limit} lượt hôm nay, ~1 lượt cho 15 em); hết lượt sẽ tự dùng câu mẫu.`:"Chưa bật AI – phần mềm dùng ngân hàng câu mẫu, mỗi em một câu khác nhau.")}function nxSubs(){$("nxsubs").innerHTML=NX.info.subjects.map(t=>{const n=NX.st.subjects.includes(t.key);return`<label class="${n?"on":""}"><input type="checkbox" value="${t.key}" ${n?"checked":""} onchange="nxSubT(this)">${esc(t.name)}</label>`}).join("")}function nxSubT(t){const n=t.value,e=NX.st.subjects;if(t.checked)e.includes(n)||e.push(n);else{if(e.length<=1)return t.checked=!0,toast("Cần ít nhất 1 môn","err");NX.st.subjects=e.filter(t=>t!==n)}const a=NX.info.subjects.map(t=>t.key);NX.st.subjects.sort((t,n)=>a.indexOf(t)-a.indexOf(n)),nxSubs(),nxDraw(),nxSave()}function nxSet(){NX.st.ki=$("nxki").value,NX.st.lop=$("nxlop").value.trim()||"2",nxSave()}function nxSave(){clearTimeout(NX.t),NX.t=setTimeout(()=>api("/api/nhanxet/state",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({state:NX.st})}).catch(()=>{}),700)}function nxName(t){return(NX.info.subjects.find(n=>n.key===t)||{}).name||("pc"===t?"Phẩm chất":"Năng lực")}function nxView(t){NX.view=t,$("nxv1").classList.toggle("on",1===t),$("nxv2").classList.toggle("on",2===t),nxDraw()}function nxDraw(){const t=NX.st.students,n=NX.st.subjects;if($("nxcnt").textContent=t.length?`· ${t.length} em`:"",!t.length)return vo