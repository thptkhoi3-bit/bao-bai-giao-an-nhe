      <div id="cvLearnOpenings" style="margin-top:16px;display:none"></div>
    </div>
  </div>

  <!-- CỘNG ĐỒNG / BẢNG XẾP HẠNG -->
  <div class="cv-sec" id="cvSecCommunity">
    <div class="cv-goldtitle">🏆 BẢNG XẾP HẠNG</div>
    <div class="cv-subtitle">Vinh quang dành cho những bộ óc kiệt xuất — thắng 1 điểm, hòa 0,5 điểm, chỉ ván xếp hạng mới tính điểm.</div>
    <div class="cv-panel" style="margin-top:16px">
      <h3 class="cv-h">🏆 Kỳ thủ</h3>
      <div id="cvPodium"></div>
      <div class="cv-scroll" style="margin-top:14px"><table class="cv-tbl" id="cvBoardPlayers"><tr><td class="cv-mut">Đang tải…</td></tr></table></div>
    </div>
    <div class="cv-panel" style="margin-top:14px">
      <h3 class="cv-h">🏫 Bảng trường</h3>
