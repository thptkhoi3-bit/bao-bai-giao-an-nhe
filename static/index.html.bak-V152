    const hasBG = drawBG("pin");
    if(!hasBG){ ctx.fillStyle = "#F7EBD4"; ctx.fillRect(0, 0, W, 452);
    ctx.fillStyle = "#EFDFC2"; ctx.fillRect(0, 0, W, 26);
    ctx.fillStyle = "#C89B6A"; ctx.fillRect(0, 452, W, 88);
    ctx.strokeStyle = "rgba(150,105,55,.35)"; ctx.lineWidth = 2;
    for(let i=0;i<5;i++){ ctx.beginPath(); ctx.moveTo(0, 470 + i*17); ctx.lineTo(W, 470 + i*17); ctx.stroke(); }
    // bảng đen
    ctx.fillStyle = "#8A5A2E"; rr(292, 36, 376, 138, 10); ctx.fill();
    ctx.fillStyle = "#2E5E4E"; rr(300, 44, 360, 122, 6); ctx.fill();
    ctx.fillStyle = "rgba(255,255,255,.93)"; ctx.font = '700 28px "Segoe UI", sans-serif'; ctx.textAlign = "center";
    ctx.fillText("Where is...?", 480, 94);
    ctx.font = '600 15.5px "Segoe UI", sans-serif'; ctx.fillStyle = "rgba(255,255,255,.55)";
    ctx.fillText("a   b   c   d   e   f   g   h ...", 480, 128);
    ctx.strokeStyle = "rgba(255,255,255,.5)"; ctx.lineWidth = 2; // phấn vẽ mặt trời + ngôi nhà
    ctx.beginPath(); ctx.arc(338, 140, 9, 0, 7); ctx.stroke();
    for(let i=0;i<6;i++){ const an = i/6 * Math.PI*2; ctx.beginPath(); ctx.moveTo(338 + Math.cos(an)*12, 140 + Math.sin(an)*12); ctx.lineTo(338 + Math.cos(an)*16, 140 + Math.sin(an)*16); ctx.stroke(); }
    ctx.strokeRect(592, 128, 22, 17); ctx.beginPath(); ctx.moveTo(589, 128); ctx.lineTo(603, 116); ctx.lineTo(617, 128); ctx.stroke();
    // đồng hồ treo tường
    ctx.fillStyle = "#fff"; circle(120, 84, 25); ctx.fill(); ctx.strokeStyle = "#8A5A2E"; ctx.lineWidth = 3.4; circle(120, 84, 25); ctx.stroke();
    ctx.strokeStyle = "#37474F"; ctx.lineWidth = 2.6; ctx.beginPath(); ctx.moveTo(120, 84); ctx.lineTo(120, 69); ctx.moveTo(120, 84); ctx.lineTo(131, 89); ctx.stroke();
    // cửa sổ bên phải (trời tối, trăng)
    ctx.fillStyle = "#8A5A2E"; rr(742, 52, 168, 128, 8); ctx.fill();
    ctx.fillStyle = "#22355E"; rr(750, 60, 152, 112, 5); ctx.fill();
    ctx.fillStyle = "#F5EFE0"; circle(872, 84, 13); ctx.fill(); ctx.fillStyle = "#22355E"; circle(866, 80, 11); ctx.fill();
    ctx.fillStyle = "#fff"; circle(786, 84, 1.8); ctx.fill(); circle(812, 130, 1.6); ctx.fill(); circle(852, 146, 1.8); ctx.fill(); circle(776, 148, 1.4); ctx.fill();
    ctx.strokeStyle = "#8A5A2E"; ctx.lineWidth = 4; ctx.beginPath(); ctx.moveTo(826, 60); ctx.lineTo(826, 172); ctx.stroke();
    ctx.fillStyle = "#C65D7A"; rr(742, 52, 26, 128, 8); ctx.fill(); rr(884, 52, 26, 128, 8); ctx.fill(); // rèm
    // đèn trần
    ctx.strokeStyle = "#8A8A8A"; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(480, 0); ctx.lineTo(480, 20); ctx.stroke();
    ctx.fillStyle = "#FFF3C4"; ctx.beginPath(); ctx.moveTo(448, 38); ctx.quadraticCurveTo(480, 16, 512, 38); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = "#D9A83F"; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(448, 38); ctx.quadraticCurveTo(480, 16, 512, 38); ctx.stroke(); }
    if(hasBG){ ctx.fillStyle = "rgba(255,255,255,.93)"; ctx.font = '700 30px "Segoe UI", sans-serif'; ctx.textAlign = "center"; ctx.fillText("Where is...?", 484, 208); ctx.font = '600 16px "Segoe UI", sans-serif'; ctx.fillStyle = "rgba(255,255,255,.55)"; ctx.fillText("a   b   c   d   e   f   g   h ...", 484, 254); }
    // các bạn + bàn học của từng bạn
    for(const a of state.actors){
      ctx.fillStyle = "#B07B45"; rr(a.x - 31, a.y + 13, 62, 10, 4); ctx.fill();
      ctx.fillStyle = "#96682F"; ctx.fillRect(a.x - 26, a.y + 23, 6, 12); ctx.fillRect(a.x + 20, a.y + 23, 6, 12);
      ctx.fillStyle = "#E53935"; rr(a.x - 14, a.y + 4, 13, 9, 2); ctx.fill(); // sách vở trên bàn
      ctx.fillStyle = "#42A5F5"; rr(a.x + 3, a.y + 5, 11, 8, 2); ctx.fill();
      drawKid(a.x, a.y - Math.abs(Math.sin(now * 3.3 + a.seed * 1.7)) * 4.2, a.s, a.seed, { name: a.p.name, ooh: R && R.target === a,
        ring: R && (R.phase === "reveal" || R.phase === "done") && R.winner === a });
      if(R && R.target === a && R.targetKind === "fake"){ if(R.targetT < .7) bubble("Tìm thấy rồi!", a.x, a.y - 68); else if(R.targetT > .95) bubble("ơ... khoan đã!", a.x, a.y - 68); }
    }
    if(R){
      if(R.target !== R.g.lastT){ R.g.lastT = R.target; if(R.target) sndDing(); }
      const beam = R.g.beam;
      let tx = 480 + Math.sin(now * .66) * 335, ty = 300 + Math.cos(now * .83) * 118;
      if(R.target){ tx = R.target.x; ty = R.target.y - 10; }
      if(R.phase === "reveal" || R.phase === "done" || R.twistShown){ R.g.light = Math.min(1, (R.g.light || 0) + (dt || .016) / .5); if(R.phase !== "playing"){ tx = R.winner.x; ty = R.winner.y - 10; } }
      beam.x = lerp(beam.x, tx, .085); beam.y = lerp(beam.y, ty, .085);
      const dark = .965 * (1 - (R.g.light || 0));
      if(dark > .02){
        const gr = ctx.createRadialGradient(beam.x, beam.y, 24, beam.x, beam.y, 168);
        gr.addColorStop(0, "rgba(8,8,32,0)"); gr.addColorStop(.6, `rgba(8,8,32,${dark * .3})`); gr.addColorStop(1, `rgba(8,8,32,${dark})`);
        ctx.fillStyle = gr; ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = "rgba(255,240,170,.12)"; circle(beam.x, beam.y, 58 + Math.sin(now * 5) * 3); ctx.fill();
      }
      if(R.g.light > 0){ // đèn trần bật sáng
        const lg = ctx.createRadialGradient(480, 34, 8, 480, 34, 300);
        lg.addColorStop(0, `rgba(255,244,180,${.4 * R.g.light})`); lg.addColorStop(1, "rgba(255,244,180,0)");
        ctx.fillStyle = lg; ctx.fillRect(0, 0, W, H);
      }
      // cây đèn pin ở góc dưới trái, chĩa theo chùm sáng
      ctx.save(); ctx.translate(58, 492); ctx.rotate(Math.atan2(beam.y - 492, beam.x - 58) + Math.PI / 2); ctx.scale(1.25, 1.25);
      ctx.fillStyle = "#37474F"; rr(-9, -30, 18, 26, 5); ctx.fill();
      ctx.fillStyle = "#546E7A"; rr(-11, -38, 22, 10, 4); ctx.fill();
      ctx.fillStyle = "#F5A623"; rr(-12.5, -47, 25, 10, 5); ctx.fill();
      ctx.fillStyle = "#FFF59D"; circle(0, -42, 3.4); ctx.fill();
      ctx.restore();
      if(R.t < 1.7) bubble("Tắt đèn! Đèn pin đi tìm nào...", 480, 196);
    } else {
      label("Tắt đèn đi nào — đèn pin sẽ tìm ra một bạn!", W/2, 516, 16.5, "#7C4A1E");
    }
  }
};

/* ============ TRÒ 8: HỘP QUÀ ============ */
function drawGift(x, y, s, seed, opened, t){
  const gim = opened ? GV_GIFT[4] : GV_GIFT[seed % 4];
  if(imgReady(gim)){
    const hh = (opened ? 52 : 46)*s, ww = hh * gim.naturalWidth / gim.naturalHeight;
    ctx.drawImage(gim, x - ww/2, y - 6*s - hh/2 + Math.sin(t*3)*1.5, ww, hh);
    return;
  }
  const cols = ["#EF5350","#66BB6A","#42A5F5","#FFA726","#AB47BC","#EC407A"];
  ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
  if(opened){ // món đồ nhỏ bên trong
    ctx.fillStyle = "#FFD93B"; ctx.save(); ctx.translate(0,-24 - Math.sin(t*3)*2); ctx.rotate(Math.sin(t*2)*.2);
    ctx.beginPath(); for(let i=0;i<5;i++){ const an=-Math.PI/2 + i*2*Math.PI/5;
      ctx.lineTo(Math.cos(an)*9, Math.sin(an)*9); const an2=an+Math.PI/5; ctx.lineTo(Math.cos(an2)*4, Math.sin(an2)*4); }
    ctx.closePath(); ctx.fill(); ctx.restore();
  }
  ctx.fillStyle = cols[seed % cols.length]; rr(-19,-14,38,26,4); ctx.fill();
  ctx.fillStyle = "rgba(0,0,0,.13)"; ctx.fillRect(-19, 6, 38, 6);
  ctx.fillStyle = "#FFE45E"; ctx.fillRect(-3.2,-14,6.4,26);
  ctx.save();
  if(opened){ ctx.translate(-16,-14); ctx.rotate(-.5); ctx.translate(16,14); }
  ctx.fillStyle = cols[seed % cols.length]; rr(-22,-21,44,9,4); ctx.fill();
  ctx.fillStyle = "#FFE45E"; ctx.fillRect(-3.2,-21,6.4,9);
  ctx.beginPath(); ctx.ellipse(-5,-25,5.4,3.4,-.5,0,7); ctx.strokeStyle = "#FFE45E"; ctx.lineWidth = 2.6; ctx.stroke();
  ctx.beginPath(); ctx.ellipse(5,-25,5.4,3.4,.5,0,7); ctx.stroke();
  ctx.restore();
  ctx.restore();
}
GAMES.qua = {
  icon:"🎁", name:"Hộp quà", desc:"Mở hộp nhận thử thách",
  layout(actors){ yardLayout(actors, 322, 452); actors.forEach(a => a.opened = false); },
  begin(R){
    const others = shuffle(state.actors.filter(a => a !== R.winner));
    R.g.elims = others.map((a,i)=>({ a, at: 1 + (R.dur - 3.6) * (i+1)/(others.length+0.3), done:false }));
  },
  resultText: w => "Hộp quà của",
  onReveal(){ sndSparkle(); },
  draw(now, R){
    const hasBG = drawBG("qua");
    if(!hasBG){ ctx.fillStyle = "#FFF3E0"; ctx.fillRect(0,0,W,H);
    // dây cờ tam giác
    for(let sI=0;sI<2;sI++){
      ctx.strokeStyle = "rgba(150,110,60,.5)"; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(-10, 26 + sI*44); ctx.quadraticCurveTo(W/2, 74 + sI*44, W+10, 22 + sI*44); ctx.stroke();
      for(let i=0;i<14;i++){
        const t = i/13, fx = lerp(-10, W+10, t), fy = (26 + sI*44) + Math.sin(t*Math.PI) * (48 - sI*2) - (sI*4);
        ctx.fillStyle = ["#EF5350","#FFA726","#66BB6A","#42A5F5","#AB47BC"][i%5];
        ctx.beginPath(); ctx.moveTo(fx-9, fy); ctx.lineTo(fx+9, fy); ctx.lineTo(fx, fy+17); ctx.closePath(); ctx.fill();
      }
    }
    ctx.fillStyle = "#F6C6DA"; ctx.fillRect(0, 470, W, 70);
    ctx.fillStyle = "#EF9BC2"; ctx.fillRect(0, 470, W, 7); }
    if(R) for(const e of R.g.elims) if(!e.done && R.t >= e.at){ e.done = true; e.a.opened = true; sndPop(); }
    for(const a of state.actors){
      const win = R && R.phase==="reveal" && R.winner===a;
      drawKid(a.x, a.y + Math.sin(now*2 + a.seed)*1.6, a.s*.94, a.seed, { name:a.p.name, ring: win, jump: win ? now*6 : 0 });
      drawGift(a.x, a.y + 26, 1, a.seed, a.opened || win, now);
      if(win && R.t > R.dur - 1.6) bubble("Mở quà!", a.x, a.y - 74);
    }
    if(R && R.t < 1.7) bubble("Xào trộn hộp quà nào!", 480, 128);
    if(R && R.target && R.targetKind === "fake" && R.targetT > .4 && R.targetT < 1.05) bubble("Khoan đã... quay tiếp!", R.target.x, R.target.y - 72);
    if(!R) label("Hộp quà của ai sẽ được mở cuối cùng — kèm một thử thách vui?", W/2, 512, 16.5, "#7C4A1E");
  }
};

/* ============ TRÒ 9: THẺ ĐỎ ============ */
function drawRef(x, y, s, face, card, ph){
  ctx.save(); ctx.translate(x,y); ctx.scale(s*face, s); ctx.translate(0, -Math.abs(Math.sin(ph*11))*2.4);
  ctx.fillStyle = "#263238"; rr(-8, 6, 7.4, 14, 3); ctx.fill(); rr(1, 6, 7.4, 14, 3); ctx.fill();
  ctx.fillStyle = "#FDD835"; rr(-11.5, -12, 23, 20, 6); ctx.fill();
  ctx.fillStyle = "#FFD9B3"; circle(0, -22, 10); ctx.fill();
  ctx.fillStyle = "#4E342E"; ctx.beginPath(); ctx.arc(0,-25,10,Math.PI*1.05,Math.PI*1.95); ctx.fill();
  ctx.fillStyle = "#FFD9B3"; circle(12.6, -5, 4.2); ctx.fill(); circle(-12.6, -5, 4.2); ctx.fill();
  ctx.restore();
  if(card){
    ctx.save(); ctx.translate(x + 20*face, y - 34); ctx.rotate(.12*face);
    ctx.fillStyle = card === "red" ? "#E53935" : "#FDD835";
    rr(-8, -12, 16, 24, 2.6); ctx.fill();
    ctx.strokeStyle = "rgba(0,0,0,.3)"; ctx.lineWidth = 1.6; rr(-8,-12,16,24,2.6); ctx.stroke();
    ctx.restore();
  }
  label("Trọng tài", x, y + 34*s, 12.5, "#546E7A");
}
GAMES.the = {
  icon:"🟥", name:"Thẻ đỏ", desc:"Trọng tài rút thẻ",
  layout(actors){ yardLayout(actors, 318, 466); },
  begin(R){ R.g.ref = { x:90, y:400, face:1 }; },
  resultText: w => "Trọng tài rút thẻ đỏ cho —",
  onReveal(){ sndWhistle(); },
  draw(now, R, dt){
    ctx.fillStyle = "#43A047"; ctx.fillRect(0,0,W,H);
    for(let i=0;i<6;i++){ ctx.fillStyle = i%2 ? "rgba(255,255,255,.05)" : "rgba(0,0,0,.04)"; ctx.fillRect(i*(W/6), 0, W/6, H); }
    ctx.strokeStyle = "rgba(255,255,255,.85)"; ctx.lineWidth = 3.4;
    ctx.strokeRect(26, 26, W-52, H-52);
    ctx.beginPath(); ctx.moveTo(W/2, 26); ctx.lineTo(W/2, H-26); ctx.stroke();
    circle(W/2, H/2, 62); ctx.stroke();
    ctx.strokeRect(26, 168, 92, 204); ctx.strokeRect(W-118, 168, 92, 204);
    for(const a of state.actors){
      drawKid(a.x, a.y + Math.sin(now*2 + a.seed)*1.6, a.s, a.seed, { name:a.p.name, ooh: R && R.target===a,
        ring: R && R.phase==="reveal" && R.winner===a });
      if(R && R.target===a && R.targetKind==="fake" && R.targetT > .95) bubble("Thẻ vàng thôi!", a.x, a.y - 66);
      if(R && R.phase==="reveal" && R.winner===a && R.t > R.dur - 1.5) bubble("Thẻ đỏ!", a.x, a.y - 66);
    }
    const ref = R ? R.g.ref : { x:110, y:404, face:1 };
    let card = null;
    if(R){
      let tx = ref.x, ty = ref.y;
      if(R.target){ tx = R.target.x - 30; ty = R.target.y + 4; }
      else { const a = state.actors[Math.floor(now/2.4) % Math.max(1,state.actors.length)]; if(a){ tx = a.x - 30; ty = a.y + 4; } }
      const arrived = moveToward(ref, tx, ty, 250, dt||.016);
      if(R.phase === "reveal"){ moveToward(ref, R.winner.x - 30, R.winner.y + 4, 300, dt||.016); card = "red"; }
      else if(arrived && R.target && R.targetT > .45) card = "yellow";
      if(arrived && R.target && R.targetKind === "fake" && R.targetT === .45 + (dt||.016)) tone(1200, 0, .1, "square", .05);
    }
    if(R && R.t < 1.7) bubble("Tuýt tuýt! Phạm lỗi!", ref.x + 24, ref.y - 96);
    drawRef(ref.x, ref.y, 1.02, ref.face||1, card, R ? R.t : now);
  }
};

/* ============ TRÒ 10: UFO ============ */
function drawUFO(x, y, s, now, beamOn, beamLen){
  beamLen = beamLen || 190;
  if(imgReady(GV_UFO2)){
    ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
    if(beamOn){
      const gr = ctx.createLinearGradient(0,10,0,beamLen);
      gr.addColorStop(0,"rgba(179,157,217,.5)"); gr.addColorStop(1,"rgba(179,157,217,.04)");
      ctx.fillStyle = gr; ctx.beginPath(); ctx.moveTo(-13,12); ctx.lineTo(13,12); ctx.lineTo(26 + beamLen*.14, beamLen); ctx.lineTo(-26 - beamLen*.14, beamLen); ctx.closePath(); ctx.fill();
    }
    const ww = 150, hh = ww * GV_UFO2.naturalHeight / GV_UFO2.naturalWidth;
    ctx.drawImage(GV_UFO2, -ww/2, -hh/2 - 2, ww, hh);
    ctx.restore();
    return;
  }
  ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
  if(beamOn){
    const gr = ctx.createLinearGradient(0,10,0,beamLen);
    gr.addColorStop(0,"rgba(179,157,217,.5)"); gr.addColorStop(1,"rgba(179,157,217,.04)");
    ctx.fillStyle = gr; ctx.beginPath(); ctx.moveTo(-13,12); ctx.lineTo(13,12); ctx.lineTo(26 + beamLen*.14, beamLen); ctx.lineTo(-26 - beamLen*.14, beamLen); ctx.closePath(); ctx.fill();
  }
  ctx.fillStyle = "#B39DDB"; ctx.beginPath(); ctx.ellipse(0,6,44,13,0,0,7); ctx.fill();
  ctx.fillStyle = "#9575CD"; ctx.beginPath(); ctx.ellipse(0,10,44,10,0,0,Math.PI); ctx.fill();
  ctx.fillStyle = "rgba(179,229,252,.9)"; ctx.beginPath(); ctx.ellipse(0,-6,21,13,0,Math.PI,0); ctx.fill();
  ctx.fillStyle = "#7ED3F7"; circle(-4,-8,3.4); ctx.fill(); circle(5,-9,2.6); ctx.fill();
  const cols = ["#EF5350","#FFD93B","#66BB6A","#42A5F5"];
  for(let i=0;i<4;i++){ ctx.fillStyle = Math.sin(now*6 + i*1.7) > 0 ? cols[i] : "#5E35B1"; circle(-30 + i*20, 8, 3.6); ctx.fill(); }
  ctx.restore();
}
GAMES.ufo = {
  icon:"🛸", name:"UFO", desc:"Đĩa bay bắt cóc",
  layout(actors){ yardLayout(actors, 392, 480); for(const a of actors){ a.hx = a.x; a.hy = a.y; a.wx = a.x; a.wy = a.y; a.wt = Math.random()*1.5; a.runPh = a.seed * 2.3; a.moving = false; } },
  begin(R){ GAMES.ufo.layout(state.actors); R.g.ufo = { x:480, y:96 }; R.g.lift = 0; R.g.liftActor = null; },
  resultText: w => "UFO đã bắt cóc",
  onReveal(){ sndBeam(); },
  draw(now, R, dt){
    const hasBG = drawBG("ufo");
    if(!hasBG){ const g = ctx.createLinearGradient(0,0,0,H); g.addColorStop(0,"#FF9E64"); g.addColorStop(.55,"#FFD3A5"); g.addColorStop(1,"#FFF1D6");
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);
    sun(96, 300, 30);
    // phố cổ: nhà mái ngói hai bên
    for(const [hx, hw, hh, c] of [[8,150,120,"#F6E3C5"],[166,120,96,"#F1D9B0"],[676,124,100,"#F1D9B0"],[808,144,126,"#F6E3C5"]]){
      ctx.fillStyle = c; ctx.fillRect(hx, 330-hh, hw, hh+84);
      ctx.fillStyle = "#B5542D"; ctx.beginPath(); ctx.moveTo(hx-8, 330-hh); ctx.lineTo(hx+hw/2, 330-hh-30); ctx.lineTo(hx+hw+8, 330-hh); ctx.closePath(); ctx.fill();
      ctx.fillStyle = "#8A5A2E"; rr(hx+hw/2-13, 330-hh+34, 26, 40, 9); ctx.fill();
      ctx.fillStyle = "#FFE9A8"; rr(hx+16, 330-hh+22, 20, 20, 3); ctx.fill(); rr(hx+hw-36, 330-hh+22, 20, 20, 3); ctx.fill();
    }
    // cây anh đào
    ctx.strokeStyle = "#6D4C41"; ctx.lineWidth = 8; ctx.beginPath(); ctx.moveTo(330, 414); ctx.quadraticCurveTo(336, 360, 322, 322); ctx.stroke();
    ctx.fillStyle = "#F8BBD0"; circle(322,306,21); ctx.fill(); circle(300,320,15); ctx.fill(); circle(346,318,16); ctx.fill(); circle(330,290,13); ctx.fill();
    ctx.fillStyle = "#90A4AE"; ctx.fillRect(0, 414, W, 126);
    ctx.fillStyle = "rgba(255,255,255,.35)"; for(let x=14;x<W;x+=64) ctx.fillRect(x, 470, 34, 5); }
    // học sinh chạy tung tăng quanh sân; đĩa bay sà xuống gần thì bỏ chạy tán loạn
    for(const a of state.actors){
      if(a.abducted) continue;
      if(a.hx === undefined){ a.hx = a.x; a.hy = a.y; a.wx = a.x; a.wy = a.y; a.wt = 0; a.runPh = a.seed * 2.3; a.moving = false; }
      const lifted = R && R.g.liftActor === a && R.g.lift > 3;
      const winnerWait = R && R.phase === "reveal" && R.winner === a;
      if(lifted || winnerWait){ a.moving = false; continue; }
      let sp = R ? 92 : 24, fleeing = false;
      if(R && R.phase === "play" && R.g.ufo && Math.abs(a.x - R.g.ufo.x) < 135){
        fleeing = true; sp = 178;
        a.wx = Math.max(60, Math.min(900, a.x + (a.x < R.g.ufo.x ? -190 : 190)));
        a.wy = Math.max(378, Math.min(492, a.hy + ((a.seed % 3) - 1) * 18));
        a.wt = .3;
      }
      a.wt -= dt || .016;
      const dx = a.wx - a.x, dy = a.wy - a.y, dist = Math.hypot(dx, dy);
      if(!fleeing && (dist < 6 || a.wt <= 0)){
        a.wx = Math.max(46, Math.min(914, a.hx + (Math.random() - .5) * 300));
        a.wy = Math.max(376, Math.min(494, a.hy + (Math.random() - .5) * 40));
        a.wt = 1.2 + Math.random() * 1.6;
      }
      if(dist > 2){
        const step = Math.min(dist, sp * (dt || .016));
        a.x += dx / dist * step; a.y += dy / dist * step;
        a.runPh += (dt || .016) * (fleeing ? 15 : sp > 50 ? 11 : 6);
        a.moving = true;
      } else { a.moving = false; a.runPh += (Math.round(a.runPh / Math.PI) * Math.PI - a.runPh) * .3; }
    }
    // tránh dồn cục: các bạn tự né nhau ra
    for(let i = 0; i < state.actors.length; i++) for(let j = i + 1; j < state.actors.length; j++){
      const A = state.actors[i], B = state.actors[j];
      if(A.abducted || B.abducted) continue;
      const dx = B.x - A.x, dy = (B.y - A.y) * 1.6, d = Math.hypot(dx, dy);
      if(d > 0.01 && d < 44){ const push = (44 - d) / 2, ux = dx / d, uy = dy / d / 1.6;
        A.x -= ux * push; A.y -= uy * push * .4; B.x += ux * push; B.y += uy * push * .4;
        A.x = Math.max(40, Math.min(920, A.x)); B.x = Math.max(40, Math.min(920, B.x));
        A.y = Math.max(374, Math.min(496, A.y)); B.y = Math.max(374, Math.min(496, B.y)); }
    }
    for(const a of state.actors){
      if(a.abducted) continue;
      let yy = a.y, sc = a.s, alpha = 1;
      if(R && R.g.liftActor === a){ yy -= R.g.lift; sc = a.s * (1 - R.g.lift/430); }
      ctx.save(); ctx.globalAlpha = alpha;
      drawKid(a.x, yy, sc, a.seed, { name: a.p.name, ooh: R && R.target===a, jump: a.runPh || 0, spin: (R && R.g.liftActor === a && R.g.lift > 2) ? now*9 : (a.moving ? (a.runPh || 0) : 0) });
      ctx.restore();
      if(R && R.phase === "play" && R.g.ufo && a !== R.target && Math.abs(a.x - R.g.ufo.x) < 64) bubble(a.seed % 2 ? "Cứu với!" : "Ôi!", a.x, a.y - 78);
      if(R && R.target===a && R.targetKind==="fake" && R.targetT > .95) bubble("ơ... khoan đã!", a.x, a.y - 76);
    }
    const ufo = R ? R.g.ufo : { x: 480 + Math.sin(now*.5)*240, y: 96 };
    let beamOn = false;
    if(R){
      let tx = 480 + Math.sin(now*.6)*300, ty = 96;
      if(R.target){ tx = R.target.x; ty = 108; }
      if(R.phase === "reveal"){ tx = R.winner.x; ty = 108; }
      moveToward(ufo, tx, ty, R.phase === "reveal" ? 1000 : 380, dt||.016);
      const tgt = R.phase === "reveal" ? R.winner : R.target;
      const aligned = tgt && Math.abs(ufo.x - tgt.x) < 34;
      if(R.phase === "reveal" && aligned){
        beamOn = true;
        R.g.lift = Math.min(356, (R.g.lift||0) + (dt||.016)*420); R.g.liftActor = R.winner;
        if(R.g.lift >= 338 && R.t > R.dur - .9) R.winner.abducted = true;
      } else if(aligned){
        beamOn = true;
        if(R.target) { R.g.lift = Math.sin(Math.min(1, R.targetT/1.25) * Math.PI) * 84; R.g.liftActor = R.target; }
      } else { R.g.lift = 0; R.g.liftActor = null; }
    }
    drawUFO(ufo.x, ufo.y, 1.15, now, beamOn, (R && R.g.liftActor) ? Math.max(190, (R.g.liftActor.y - R.g.lift) - ufo.y + 36) : 190);
    if(!R) label("Đĩa bay sẽ hút một bạn lên — ai sẽ bị bắt cóc?", W/2, 522, 16, "#7C4A1E");
  }
};

/* ============ GỌI TÊN VUI — gắn vào mục Danh sách lớp (p9) ============ */
for(const k in GAMES){ if(GAMES[k].holdAfter == null) GAMES[k].holdAfter = 5; }
let gvSig = "";
function gvTypedNames(){
  const ta = $("gvNames");
  if(!ta) return null;
  const ns = ta.value.split(/\r?\n/).map(x => x.trim()).filter(Boolean);
  return ns.length >= 2 ? ns : null;
}
function gvNames(){
  try{
    if(typeof LOP !== "undefined" && Array.isArray(LOP.students)){
      const ns = LOP.students.map(s => (s && s.name) ? String(s.name).trim() : "").filter(Boolean);
      if(ns.length >= 2) return ns;
    }
  }catch(e){}
  return null;
}
function gvRefresh(){
  const tn = gvTypedNames(), ns = gvNames();
  const note = $("gvSrcNote"), row = $("gvCntRow");
  if(tn){ if(note) note.textContent = "Đang dùng danh sách nhập ngay trong thẻ trò chơi — " + tn.length + " bạn."; if(row) row.style.display = "none"; }
  else if(ns){ if(note) note.textContent = "Đang dùng danh sách lớp đã lưu — " + ns.length + " bạn."; if(row) row.style.display = "none"; }
  else { if(note) note.textContent = "Chưa có danh sách nào — đang dùng số thứ tự. Thầy cô nhập tên ngay trong thẻ trò chơi bên dưới."; if(row) row.style.display = "flex"; }
  refreshCounter(); gvSyncActors(true);
}
function gvSyncActors(force){
  const pool = activePool();
  const sig = pool.map(p => p.name).join("|");
  if(force || sig !== gvSig){ gvSig = sig; makeActors(); }
}
function gvInit(){
  if(window.__gvInit) { gvRefresh(); return; }
  window.__gvInit = true;
  document.querySelectorAll(".gv-gbtn").forEach(b => b.onclick = () => {
    if(state.playing) return;
    state.game = b.dataset.gv;
    document.querySelectorAll(".gv-gbtn").forEach(x => x.classList.toggle("on", x === b));
    hideBanner(); makeActors();
    const w = $("gvWrap"); if(w) w.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
  $("gvStart").onclick = () => { gvSyncActors(false); startRound(); };
  $("gvWrap").onclick = e => { if(!state.playing){ gvSyncActors(false); startRound(); } };
  $("gvReset").onclick = () => { state.called = []; hideBanner(); $("gvStart").textContent = "Bắt đầu!"; refreshCounter(); makeActors(); };
  $("gvDur").oninput = e => $("gvDurVal").textContent = e.target.value;
  const gvn = $("gvNames"); if(gvn) gvn.oninput = () => gvRefresh();
  $("gvSit").onchange = () => { refreshCounter(); makeActors(); };
  $("gvCnt").oninput = () => { refreshCounter(); makeActors(); };
  $("gvSndTest").onclick = () => { const was = $("gvSound").checked; $("gvSound").checked = true; sndWin(); if(!was) setTimeout(() => $("gvSound").checked = was, 700); };
  $("gvFs").onclick = () => { const el = $("gvWrap"); if(document.fullscreenElement) document.exitFullscreen(); else if(el.requestFullscreen) el.requestFullscreen(); };
  gvRefresh();
  requestAnimationFrame(gvLoop);
}
function gvLoop(ts){
  const p9 = document.getElementById("p9");
  if(p9 && !p9.classList.contains("hide")) loop(ts);
  requestAnimationFrame(gvLoop);
}
window.gvInit = gvInit; window.gvRefresh = gvRefresh;
/* mở tab 9 thì khởi động + nạp lại tên (danh sách lớp tải bất đồng bộ) */
try{
  const _tabOrig = tab;
  tab = function(n){ _tabOrig(n); if(n === 9){ setTimeout(gvInit, 60); setTimeout(gvRefresh, 900); setTimeout(gvRefresh, 2200); } };
}catch(e){}
document.addEventListener("click", e => { if(e.target.closest && e.target.closest("#gvCard")) gvInit(); }, true);

})();</script>

<!-- ===== BẢNG THÔNG BÁO BẢN THỬ NGHIỆM (hiện khi đăng nhập) ===== -->
<div id="tbDemo" class="hide" style="position:fixed;inset:0;background:rgba(43,32,16,.55);z-index:99990;display:flex;align-items:center;justify-content:center;padding:16px">
  <div style="background:#FFF9EE;max-width:520px;width:100%;border-radius:20px;border:3px solid #F2C14E;box-shadow:0 18px 50px rgba(0,0,0,.35);padding:26px 26px 20px;text-align:center">
    <div style="font-size:40px;line-height:1">📢</div>
    <div style="font-weight:800;font-size:23px;color:#B3541E;margin:8px 0 2px">THÔNG BÁO</div>
    <div style="font-weight:700;font-size:17px;color:#37474F">Trang web đang trong giai đoạn<br>CHẠY THỬ NGHIỆM (bản demo)</div>
    <div style="text-align:left;font-size:15px;line-height:1.55;color:#4E342E;margin:14px 4px 4px">
      <p style="margin:0 0 9px">🌐 <b>Trợ lý Báo bài &amp; Giáo án</b> hiện là phiên bản demo. Một số tính năng vẫn đang được hoàn thiện, nên giao diện và cách dùng có thể còn thay đổi trong thời gian tới.</p>
      <p style="margin:0 0 9px">💾 Thầy cô vui lòng <b>giữ lại bản gốc</b> các file đã tải lên (báo bài, giáo án...) trên máy của mình, vì dữ liệu trong giai đoạn thử nghiệm có thể được điều chỉnh khi nâng cấp hệ thống.</p>
      <p style="margin:0 0 9px">🛠️ Nếu gặp lỗi hoặc có góp ý, thầy cô vui lòng liên hệ quản trị viên: <b>Lê Đắc Đạt — 0865 291 703</b>.</p>
      <p style="margin:0">❤️ Cảm ơn thầy cô đã tin tưởng dùng thử và góp ý để trang web ngày càng hoàn thiện!</p>
    </div>
    <button id="tbDemoOk" style="margin-top:18px;background:#F39C3D;color:#fff;font-weight:800;font-size:16.5px;border:none;border-radius:999px;padding:12px 34px;cursor:pointer;box-shadow:0 4px 0 #C77414">Đã hiểu, bắt đầu dùng</button>
  </div>
</div>
<script>
function demoNotice(){
  try{ if(sessionStorage.getItem("tbDemoSeen")) return; }catch(e){}
  var m = document.getElementById("tbDemo"); if(!m) return;
  m.classList.remove("hide");
  document.getElementById("tbDemoOk").onclick = function(){
    try{ sessionStorage.setItem("tbDemoSeen", "1"); }catch(e){}
    m.classList.add("hide");
  };
}
</script>

<div id="etView" style="display:none">
  <div class="et-app">
    <nav class="et-nav">
      <!-- Logo: ảnh cắt verbatim từ ảnh mẫu, CHỈ là ảnh trang trí,
           KHÔNG bấm được, không gán chức năng gì. -->
      <img class="et-navlogo" src="/static/img/et-nav-logo.png?v=__V__" alt="EduTest AI">
      <div class="et-navlinks">
        <button class="et-pill-home" type="button" onclick="etHome()" title="Về trang chủ"><img src="/static/img/et-pill-trangchu.png?v=__V__" alt="Trang chủ"></button>
        <!-- Mục đang đứng: active, không làm gì. -->
        <a class="et-navlink et-active" href="#" onclick="return false">Tạo đề</a>
        <a class="et-navlink" href="#" onclick="etGoKho();return false">Ngân hàng đề</a>
        <a class="et-navlink" href="#" onclick="etAdmin();return false">Quản lý tài khoản</a>
        <!-- Người truy cập: BẤM ĐƯỢC. Bấm mở hộp nhỏ ngay dưới link, hiện tổng
             lượt truy cập lấy từ GET /api/visits/total (fetch RAW, xem
             etVisitsToggle). Bấm lại thì đóng; bấm ra ngoài cũng đóng. -->
        <span class="et-navdrop">
          <button class="et-navlink et-navdrop-btn" type="button" onclick="etVisitsToggle(event)">Người truy cập</button>
          <div id="et-visits-box" class="et-visits-box" style="display:none">Đang tải…</div>
        </span>
        <a class="et-navlink" href="#" onclick="etSupport();return false">Hỗ trợ</a>
      </div>
      <div class="et-navright">
        <!-- Tên + chữ cái avatar do etShow() điền từ #uname của web thật. -->
        <div class="et-who"><div class="et-av" id="et-av">?</div><div><b id="et-uname"></b><span>Giáo viên ▾</span></div></div>
      </div>
    </nav>

    <div class="et-banner"><img src="/static/img/et-banner.png?v=__V__" alt="EduTest AI"></div>

    <main class="et-main">
      <section class="et-left">
        <div>
          <h2>Tạo đề kiểm tra / tài liệu</h2>
          <div class="et-sub">Chọn một chức năng bên dưới để bắt đầu</div>
        </div>

        <div class="et-cards">
          <button class="et-cardbtn et-active" type="button" data-mode="thongtin" onclick="etMode('thongtin')"><span class="et-cardframe"><img src="/static/img/et-card-thongtin.png?v=__V__" alt="Thông tin đề"></span></button>
          <button class="et-cardbtn" type="button" data-mode="saochep" onclick="etMode('saochep')"><span class="et-cardframe"><img src="/static/img/et-card-saochep.png?v=__V__" alt="Sao chép đề"></span></button>
          <button class="et-cardbtn" type="button" data-mode="ai" onclick="etMode('ai')"><span class="et-cardframe"><img src="/static/img/et-card-ai.png?v=__V__" alt="Tạo đề bằng AI"></span></button>
          <button class="et-cardbtn" type="button" data-mode="phieu" onclick="etMode('phieu')"><span class="et-cardframe"><img src="/static/img/et-card-phieu.png?v=__V__" alt="Tạo Phiếu bài tập ngày"></span></button>
        </div>

        <!-- Chế độ: Cấu hình nhanh -->
        <div id="et-mode-thongtin" class="et-mode et-on">
          <div class="et-sec-h"><span>⚙️ Cấu hình nhanh</span></div>
          <div class="et-frow">
            <div class="et-field"><label>📅 Năm học</label><select id="et-cfg-nam"><option selected>2026 - 2027</option></select></div>
            <div class="et-field"><label>👥 Lớp</label><select id="et-cfg-lop"><option value="1">Lớp 1</option><option value="2">Lớp 2</option><option value="3">Lớp 3</option><option value="4">Lớp 4</option><option value="5" selected>Lớp 5</option></select></div>
            <div class="et-field"><label>📖 Môn</label><select id="et-cfg-mon"><option selected>Toán</option><option>Tiếng Việt</option><option>Tiếng Anh</option></select></div>
            <div class="et-field"><label>📄 Loại đề</label><select id="et-cfg-loai"><option>Phiếu bài tập theo chủ đề</option><option>Đề ôn tập</option><option selected>Đề kiểm tra giữa HK1</option><option>Đề kiểm tra cuối HK1</option><option>Đề kiểm tra giữa HK2</option><option>Đề kiểm tra cuối năm</option></select></div>
            <div class="et-field"><label>⏱️ Thời gian</label><select id="et-cfg-tg"><option>35 phút</option><option selected>40 phút</option></select></div>
            <div class="et-field"><label>📚 Dạng đề</label><select id="et-cfg-ht"><option selected>Tự luận + Trắc nghiệm</option><option>Trắc nghiệm</option><option>Tự luận</option></select></div>
          </div>
          <button class="et-btn-start" type="button" onclick="etCfgToAi()">✨ Bắt đầu tạo đề →</button>
        </div>

        <!-- Chế độ: Soạn đề mới bằng AI -->
        <div id="et-mode-ai" class="et-mode">
          <div class="et-sec-h"><span>🤖 Soạn đề mới bằng AI</span></div>
          <div class="et-frow">
            <div class="et-field"><label>Môn học</label><select id="et-ai-mon" onchange="etLoadToc()"><option selected>Toán</option><option>Tiếng Việt</option><option>Tiếng Anh</option></select></div>
            <div class="et-field"><label>Lớp</label><select id="et-ai-lop" onchange="etLoadToc()"><option value="1">Lớp 1</option><option value="2">Lớp 2</option><option value="3">Lớp 3</option><option value="4">Lớp 4</option><option value="5" selected>Lớp 5</option></select></div>
            <div class="et-field et-full"><label>Loại đề</label><select id="et-ai-loai"><option>Phiếu bài tập theo chủ đề</option><option>Đề ôn tập</option><option selected>Đề kiểm tra giữa HK1</option><option>Đề kiểm tra cuối HK1</option><option>Đề kiểm tra giữa HK2</option><option>Đề kiểm tra cuối năm</option></select></div>
            <div class="et-field et-full"><label>Chủ đề / phạm vi kiến thức</label><span id="et-ai-topic-box"><input id="et-ai-chude" placeholder="Gõ chủ đề, hoặc chọn từ mục lục khi tải xong"></span><div class="et-note" style="margin-top:6px;font-size:13.5px">Để trống = toàn bộ nội dung kiểm tra.</div></div>
            <div class="et-field et-full" id="et-ai-tap-wrap" style="display:none"><label>Tập (Tiếng Việt)</label><select id="et-ai-tap" onchange="etLoadToc()"></select></div>
            <div class="et-field et-full"><label>Ghi chú thêm (không bắt buộc)</label><textarea id="et-ai-ghichu" placeholder="Ví dụ: 10 câu, 10 điểm, 6 trắc nghiệm + 4 tự luận…"></textarea></div>
            <div class="et-field"><label>UBND xã <span style="opacity:.7">(để xuất Word)</span></label><input id="et-ai-xa" placeholder="Nhập tên xã…"></div>
            <div class="et-field"><label>Trường <span style="opacity:.7">(để xuất Word)</span></label><input id="et-ai-truong" placeholder="Nhập tên trường…"></div>
          </div>
          <p class="et-warn" id="et-toc-warn" style="display:none">Mục lục lớp này lấy từ nguồn phụ, chưa đối chiếu sách thật — thầy kiểm tra lại trước khi dùng</p>
          <div class="et-btn-stack">
            <button class="et-btn-mini et-btn-blue" id="et-btn-draft" type="button" onclick="etDraft('de')">✨ AI soạn đề ngay</button>
            <button class="et-btn-mini et-btn-pink" type="button" onclick="etPhieu()">🎨 Tạo phiếu màu</button>
          </div>
          <p class="et-note" style="margin-top:10px">Chủ đề lấy từ mục lục SGK Kết nối tri thức (chỉ cấp Tiểu học, bộ sách mặc định).</p>
        </div>

        <!-- Chế độ: Từ đề có sẵn (luồng Tạo đề hiện tại của web) -->
        <div id="et-mode-saochep" class="et-mode">
          <div class="et-sec-h"><span>📄 Từ đề có sẵn</span></div>
          <p class="et-note" style="margin-top:10px">Chế độ hiện tại của mục Tạo đề: thầy/cô tải đề có sẵn (ảnh, PDF, Word) lên, hệ thống đọc rồi dựng lại đúng theo file mẫu của thầy/cô, giữ nguyên luật mẫu v16.</p>
          <button class="et-btn-start" type="button" onclick="etOpenOld()">Mở giao diện Tạo đề hiện tại →</button>
        </div>

        <!-- Chế độ: Tạo Phiếu bài tập ngày (dùng chung đề mẫu của chế độ AI) -->
        <div id="et-mode-phieu" class="et-mode">
          <div class="et-sec-h"><span>🎨 Tạo Phiếu bài tập ngày</span></div>
          <p class="et-note" style="margin-top:10px">Cùng nội dung đề AI soạn nhưng xuất phiếu A4 nhiều màu cho học sinh tiểu học, khác bản Word theo phom mẫu chính thức.</p>
          <button class="et-btn-start" type="button" style="background:linear-gradient(90deg,#db2777,#f59e0b)" onclick="etPhieu()">🎨 Tạo phiếu màu →</button>
        </div>
      </section>

      <section class="et-right" id="et-right">
        <div class="et-pv-head">
          <div class="et-eye">👁️</div>
          <div><b>Xem trước đề</b><span>Khổ A4 • Đúng như file Word khi xuất ra</span></div>
          <!-- CHỈ còn nút Sửa nội dung, đặt absolute góc phải sát mép trên của
               panel (top:8px right:12px). KHÔNG còn nút Toàn màn hình / Trang A4. -->
          <div class="et-pv-btns"><button class="et-pv-btn" type="button" onclick="etEditToggle()">✏️ Sửa nội dung</button></div>
        </div>
        <div class="et-pv-body">
          <div id="et-pv-empty">
            <div class="et-empty">
              <img class="et-papers" src="/static/img/et-empty-papers.png?v=__V__" alt="">
              <h3>Chưa có đề để xem trước</h3>
              <p>Hãy chọn chức năng ở bên trái để tạo đề.</p>
              <p>Nội dung đề sẽ hiển thị tại đây đúng như khi xuất ra file Word.</p>
              <div style="margin-top:14px"><button class="et-btn-mini et-btn-blue" type="button" style="background:linear-gradient(90deg,#7c3aed,#2563eb);padding:13px 26px;font-size:16px" onclick="etMode('ai')">✨ Tạo đề ngay →</button></div>
            </div>
            <img class="et-empty-books" src="/static/img/et-empty-books.png?v=__V__" alt="">
            <img class="et-empty-cat" src="/static/img/et-empty-cat.png?v=__V__" alt="">
          </div>
          <div id="et-pv-exam" style="display:none">
            <!-- Cụm tab + nút hành động: CHỈ hiện khi đã có đề mẫu. -->
            <div id="et-pv-tools" style="display:none">
              <div class="et-tabrow" style="text-align:center;margin-bottom:10px">
                <button class="et-pv-btn et-tabbtn et-active" type="button" data-et-tab="de" onclick="etShowTab('de')">📝 Đề</button>
                <button class="et-pv-btn et-tabbtn" type="button" data-et-tab="phieu" onclick="etShowTab('phieu')">🎨 Phiếu màu</button>
                <button class="et-pv-btn et-tabbtn" type="button" data-et-tab="dapan" onclick="etShowTab('dapan')">✅ Đáp án (1 trang)</button>
                <button class="et-pv-btn et-tabbtn" type="button" data-et-tab="matran" onclick="etShowTab('matran')">📊 Ma trận (1 trang)</button>
              </div>
              <div id="et-actions" style="text-align:center;margin-bottom:14px"></div>
            </div>
            <div id="et-pv-de" class="et-sheet-now"></div>
            <div id="et-pv-phieu" class="et-sheet-now" style="display:none"></div>
            <div id="et-pv-dapan" class="et-sheet-now" style="display:none"></div>
            <div id="et-pv-matran" class="et-sheet-now" style="display:none"></div>
          </div>
        </div>
      </section>
    </main>
  </div>
</div>
<script>
/* Trang chủ mới V101 */
function homeShow(){if(typeof etHide==="function")etHide();if(typeof ttsHide==="function")ttsHide();if(typeof vaHide==="function")vaHide();if(typeof vcHide==="function")vcHide();if(typeof cvHide==="function")cvHide();var hv=$("homeView");if(!hv)return;["p1","p2","p3","p4","p5","p8","p9","p10","p11","p12","p13"].forEach(function(id){var e=$(id);e&&e.classList.add("hide")});hv.classList.remove("hide");var b=$("bot");b&&(b.style.display="none");var un=$("uname");var nm=(un&&un.textContent||"").trim();$("hmname").textContent=nm||"Tài khoản";$("hmusername").textContent=nm||"Tài khoản";hmVisits();hmBellBadge();scrollTo(0,0)}
async function hmGet(u){try{var r=await fetch(u);if(!r.ok)return null;return await r.json()}catch(e){return null}}
async function hmVisits(){var t=await hmGet("/api/visits/total");$("hmvisits").textContent=t?((+t.total||0).toLocaleString("vi-VN")):"—"}
function hmSearch(v){v=(v||"").toLowerCase().trim();document.querySelectorAll("#homeView .hm-fbtn").forEach(function(b){var ok=!v||(b.dataset.name||b.textContent).toLowerCase().indexOf(v)>=0;b.classList.toggle("dim",!ok)})}
function hmScroll(dx){var s=$("hmstrip");s&&s.scrollBy({left:dx*s.clientWidth,behavior:"smooth"})}
(function(){var hv=$("homeView"),s=$("hmstrip");if(!hv||!s)return;var lock=false;hv.addEventListener("wheel",function(e){if(Math.abs(e.deltaY)<=Math.abs(e.deltaX)||lock)return;e.preventDefault();lock=true;setTimeout(function(){lock=false},600);s.scrollBy({left:(e.deltaY>0?1:-1)*s.clientWidth,behavior:"smooth"})},{passive:false})})();
(function(){var s=$("hmstrip");if(!s)return;var done=false;s.addEventListener("scroll",function(){if(done)return;done=true;s.querySelectorAll("img[data-src]").forEach(function(im){if(im.dataset.src){im.src=im.dataset.src;im.removeAttribute("data-src")}})},{passive:true})})();
(function(){var s=$("hmstrip");if(!s)return;var down=false,x0=0,l0=0;s.addEventListener("pointerdown",function(e){down=true;x0=e.clientX;l0=s.scrollLeft;s.classList.add("dragging")});window.addEventListener("pointermove",function(e){if(down)s.scrollLeft=l0-(e.clientX-x0)});window.addEventListener("pointerup",function(){down=false;s.classList.remove("dragging")})})();
async function hmBellData(){
var items=[],total=0,admin=false;
var me=await hmGet("/api/me");
if(me){
admin=!!me.admin;
if(admin&&me.pending){items.push({t:"Tài khoản đăng ký chờ duyệt",n:me.pending,act:function(){openAdm()}});}
}
if(admin){
var oc=await hmGet("/api/onthi/pending-counts");
if(oc){
if(oc.pending_accounts){items.push({t:"Ôn thi: đơn đăng ký chờ",n:oc.pending_accounts,act:function(){tab(11)}});}
if(oc.pending_redeems){items.push({t:"Ôn thi: yêu cầu đổi sao chờ",n:oc.pending_redeems,sub:oc.pending_stars+" sao",act:function(){tab(11)}});}
}
var d=new Date();
var ds=d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
var sd=await hmGet("/bantru/api/staff/day?date="+ds);
var lp=sd&&sd.totals&&sd.totals.late_pending;
if(lp){items.push({t:"Bán trú: báo muộn chờ duyệt (hôm nay)",n:lp,act:function(){tab(13)}});}
}
var mn=await hmGet("/bantru/api/me/notifications");
if(mn&&mn.unread){items.push({t:"Bán trú: thông báo chưa đọc",n:mn.unread,act:function(){tab(13)}});}
items.forEach(function(it){total+=it.n});
return{items:items,total:total};
}
async function hmBellBadge(){try{var d=await hmBellData();var b=$("hmbadge");b.textContent=d.total>99?"99+":d.total;b.classList.toggle("hide",!d.total)}catch(e){}}
async function hmBellToggle(ev){ev&&ev.stopPropagation();var drop=$("hmbelldrop");if(!drop)return;if(!drop.classList.contains("hide")){drop.classList.add("hide");return}drop.innerHTML='<div class="muted" style="padding:10px">Đang tải thông báo…</div>';drop.classList.remove("hide");var d=await hmBellData();if(!d.items.length){drop.innerHTML='<div style="padding:10px;color:#173f6e;font-weight:600">Chưa có thông báo mới</div>';return}drop.innerHTML=d.items.map(function(it,i){return '<button type="button" class="bi" data-i="'+i+'"><span><b>'+esc(it.t)+'</b>'+(it.sub?'<br><span>'+esc(it.sub)+'</span>':'')+'</span><b>'+it.n+'</b></button>'}).join("");drop.querySelectorAll(".bi").forEach(function(el){el.onclick=function(){drop.classList.add("hide");d.items[+el.dataset.i].act()}})}
function hmUserToggle(ev){ev&&ev.stopPropagation();$("hmuserdrop").classList.toggle("hide")}
document.addEventListener("click",function(e){var bd=$("hmbelldrop");if(bd&&!bd.classList.contains("hide")&&!e.target.closest(".hm-bellwrap"))bd.classList.add("hide");var ud=$("hmuserdrop");if(ud&&!ud.classList.contains("hide")&&!e.target.closest(".hm-userwrap"))ud.classList.add("hide")});
(function(){var app=$("app");if(!app)return;new MutationObserver(function(){if(!app.classList.contains("hide"))homeShow()}).observe(app,{attributes:true,attributeFilter:["class"]});if(!app.classList.contains("hide"))homeShow()})();
</script>
<script>
/* ===== ETVIEW-JS (V111) ===== */
/* ==========================================================================
   ETVIEW-JS — ghi chú tích hợp (người tích hợp đọc kỹ trước khi nối)
   --------------------------------------------------------------------------
   1. Hàm web thật mà khối này DỰA VÀO (đã kiểm chứng trong
      source/static/index.html — nếu web đổi chữ ký thì khối này phải đổi theo):
      - $ (id)               → document.getElementById(id). Dùng khắp khối.
      - api(path, options)   → fetch bọc sẵn: 401 (trừ /login) thì gọi
        closeAdm() + showLogin() rồi throw Error('Phiên đăng nhập đã hết…');
        lỗi khác throw Error với message tiếng Việt thân thiện; thành công
        trả JSON đã parse. etDraft()/etWord() dùng api() vì đó là hành động
        do người dùng bấm → 401→login là ĐÚNG.
      - tab(n)               → ẩn #homeView, hiện #bot, bật panel p<n>, tắt
        các panel còn lại, scroll top. tab() KHÔNG biết etView → mọi đường
        rời etView sang panel khác phải etHide() trước (xem etGoKho,
        etOpenOld).
      - homeShow()           → ẩn p1..p13, hiện #homeView, ẩn #bot, điền tên
        từ #uname. Cũng KHÔNG biết etView → etHome() etHide() trước.
      - openAdm()            → mở bảng quản trị #adm (bảng người đăng ký).
        Xem cảnh báo z-index ở etAdmin() — BẮT BUỘC etHide() trước.
      - botOpen()            → mở khung chat #botp (z=70, cao hơn etView
        z=40) nên mở chồng lên được, không cần ẩn etView.
      - toast(msg,'err')     → hiện thông báo lỗi (nếu không có thì dùng
        alert). Khối dùng qua etErr().
   2. Fetch RAW (KHÔNG dùng api()): etLoadToc() và etVisitsToggle() là thao
      tác phụ/nền. Dùng api() ở đó sẽ biến lỗi 401 thành showLogin() — vòng
      lặp khó chịu. Vì vậy hai hàm này dùng etGetRaw() (fetch thuần +
      credentials same-origin); lỗi chỉ im lặng hoặc hiện "—", không redirect.
   3. API backend người tích hợp phải viết:
      - GET /api/taode/toc?mon=<Toán|Tiếng Việt|Tiếng Anh>&lop=<1..5>
        [&tap=<...>] → JSON, một trong các dạng (parser chấp nhận cả 3):
          a) ["Chủ đề A", "Chủ đề B", ...]
          b) {topics: [...], verified: true|false, tap: ["Tập 1", ...]}
          c) {chude: [...]} hoặc {danhsach: [...]} (mỗi phần tử là chuỗi
             hoặc {ten|name|title, tap?}).
        verified=true chỉ khi mục lục đã đối chiếu sách thật (hiện tại chỉ
        lớp 2 đã xác thực). verified=false/thiếu → khối hiện cảnh báo nguồn
        phụ. Tiếng Việt: trả thêm tap[] thì khối hiện select Tập; đổi Tập sẽ
        gọi lại API kèm &tap=... (server tự lọc theo tập).
        Lỗi mạng/JSON sai/danh sách rỗng → Chủ đề trở về ô text tự gõ.
      - POST /api/taode/ai-draft (JSON, xem etAiFields) → {exam: {...}}
        hoặc trả thẳng {...}. exam xem mục 4.
      - POST /api/taode/word {exam, fields} → {url | download | href}
        (link tải file Word; tải ngay trong trang, không mở tab mới). Lỗi → {detail} sẽ hiện qua
        etErr(). Tiếng Anh: server chưa cần làm (khối đã thay nút Word bằng
        ghi chú "Chưa có file mẫu Tiếng Anh — anh gửi mẫu thì em nối").
   4. Schema đề mẫu JSON (etExam) mà các renderer bám theo:
        { fields: {xa, truong, namhoc, loai, mon, lop, chude, pages},
          reading: {intro, title, paragraphs[], source[], instruction}
                   (CHỈ đề Tiếng Việt mới có; Toán/Tiếng Anh không có),
          questions: [ {n, kind: 'tn'|'tl', level: 'M1'|'M2'|'M3',
                        diem: number, text: string,
                        options: [string...] (chỉ tn, KHÔNG kèm chữ cái),
                        answer: string, giai: string (tùy chọn),
                        lines: number (chỉ tl, số dòng chấm, mặc định 2)} ] }
      - reading chỉ hiển thị khi paragraphs có ít nhất 1 đoạn thật, và chỉ
        ở tab Đề (etSheetHtml) + tab Phiếu màu (etCsheetHtml), nằm TRƯỚC
        các phần câu hỏi, qua etReadingBlock(). Tab Đáp án/Ma trận không
        hiện bài đọc. Không có reading → không hiện khối nào.
      - level thiếu → mặc định 'M1' (chỉ để khỏi vỡ ma trận; server PHẢI
        trả đúng level). diem thiếu → 0.
      - text/options/answer/giai là TEXT THUẦN, renderer escape toàn bộ rồi
        mới chèn (không chèn HTML thô từ AI). AI muốn ký hiệu đặc biệt thì
        dùng ký tự unicode (vd: m², ×, ÷) thay vì thẻ <sup>.
      - Ma trận TÍNH XÁC ĐỊNH từ questions (không lấy ma trận AI gửi kèm):
        hàng M1/M2/M3 × cột TN/TL + tổng số câu + tổng điểm.
      - pages: số trang ghi trong đầu đề ("02" như mẫu toan.docx).
   5. Đầu đề phiếu chính thức bám đúng mẫu toan.docx: bảng đầu đề
      (UBND XÃ / TRƯỜNG / (Bài kiểm tra có .. trang) | LOẠI / NĂM HỌC /
      Môn – Lớp), hàng Điểm/Nhận xét, dòng Họ tên/Lớp, "I. TRẮC NGHIỆM" +
      câu dẫn, "Câu N." + (M..) (x,xđ), phương án, tự luận kèm dòng chấm,
      bảng ĐÁP ÁN cuối. Cách ráp tên xã/trường giống exam.py: bỏ tiền tố
      UBND/XÃ/PHƯỜNG/TRƯỜNG nếu người dùng gõ thừa rồi ráp lại.
   6. Luật trang: tab Đáp án và Ma trận mỗi tab đúng 1 trang riêng khi in
      (class et-pagebreak + @media print). Bản Word thật vẫn do server chịu
      trách nhiệm ngắt trang trước mỗi phần + kiểm tra không tràn trang.
   7. In phiếu màu (etPrintPhieu) mở cửa sổ mới chỉ chứa phiếu màu + CSS in
      riêng (etPrintCss). CSS này là BẢN SAO của các rule .et-csheet trong
      ETVIEW-CSS — sửa giao diện phiếu màu thì phải sửa cả hai chỗ.
   8. KHÔNG bịa dữ liệu: etExam=null lúc đầu → panel phải chỉ hiện trạng
      thái trống; tab + nút hành động chỉ hiện sau khi etDraft() thành công.
   9. LỆCH BRIEF CÓ CHỦ Ý (đề Tiếng Việt): brief liệt kê khối bài đọc gồm
      intro, title, paragraphs, source — KHÔNG nhắc instruction. Nhưng
      instruction là field thật trong exam.reading do AI trả về, và preview
      có nhiệm vụ hiện "đúng như file Word khi xuất ra" nên giấu field này
      sẽ làm giáo viên không kiểm được dòng hướng dẫn. Vì vậy
      etReadingBlock() vẫn hiện instruction (dòng đầu khối, in đậm) khi có.
      Nếu anh muốn ẩn instruction khỏi xem trước thì xóa 1 dòng đó trong
      etReadingBlock() là xong (không ảnh hưởng etWord vì etWord gửi nguyên
      exam JSON lên server).
   ========================================================================== */
var etExam = null, etExamRaw = null, etDrafting = false, etTocSeq = 0, etVisitsBound = false;
var etCfg = {namhoc: '2026 - 2027', thoigian: '40 phút', hinhthuc: 'Tự luận + Trắc nghiệm'};

function etEl(id){ return (typeof $ === 'function') ? $(id) : document.getElementById(id); }
function etEsc(t){ return String(t == null ? '' : t).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
function etBr(t){ return etEsc(t).replace(/\n/g, '<br>'); }
function etFmtDiem(d){ var n = Math.round((parseFloat(d || 0) || 0) * 100) / 100; return String(n).replace('.', ','); }
function etErr(msg){ try{ if (typeof toast === 'function') { toast(msg, 'err'); return; } }catch(e){} alert(msg); }
function etGetRaw(path){ return fetch(path, {credentials: 'same-origin'}).then(function(r){ if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); }); }
function etCleanPrefix(name, prefixes){
  var t = String(name || '').trim(), changed = true;
  while (changed) { changed = false;
    for (var i = 0; i < prefixes.length; i++) { var p = prefixes[i];
      if (t.toUpperCase().indexOf(p) === 0) { t = t.slice(p.length).trim(); changed = true; } } }
  return t;
}
/* Tiêu đề đầu đề bám đúng mẫu toan.docx + đúng logic header_rules() của
   exam.py: "BÀI KIỂM TRA GIỮA/CUỐI HỌC KÌ I/II", phiếu → "PHIẾU BÀI TẬP",
   ôn tập → "ĐỀ ÔN TẬP". LƯU Ý CHO NGƯỜI TÍCH HỢP: header_rules() hiện tại
   chỉ viết lại GIỮA/CUỐI khi loai bắt đầu bằng GIỮA/CUỐI, nên nếu endpoint
   /api/taode/word đưa loai nguyên dạng "Đề kiểm tra cuối HK1" vào build thì
   Word sẽ giữ nguyên "GIỮA" của mẫu — cần căn lại phía backend (hoặc chuẩn
   hoá loai trước khi build) để Word khớp với tiêu đề xem trước này. */
function etLoaiTitle(loai){
  var t = String(loai || '').trim().toUpperCase();
  if (t === 'PHIẾU BÀI TẬP THEO CHỦ ĐỀ') return 'PHIẾU BÀI TẬP';
  if (t === 'ĐỀ ÔN TẬP') return 'ĐỀ ÔN TẬP';
  var m = t.match(/KIỂM TRA\s+(GIỮA|CUỐI)\s+HK\s*([12])/);
  if (m) return 'BÀI KIỂM TRA ' + m[1] + ' HỌC KÌ ' + (m[2] === '1' ? 'I' : 'II');
  if (t === 'ĐỀ KIỂM TRA CUỐI NĂM') return 'BÀI KIỂM TRA CUỐI NĂM';
  return t.replace(/HK1/g, 'HỌC KÌ I').replace(/HK2/g, 'HỌC KÌ II');
}

/* ---------- Vào / ra màn hình ---------- */
function etShow(){
  if(typeof ttsHide==="function")ttsHide();if(typeof vaHide==="function")vaHide();if(typeof vcHide==="function")vcHide();if(typeof cvHide==="function")cvHide();
  ['homeView','p1','p2','p3','p4','p5','p8','p9','p10','p11','p12','p13'].forEach(function(id){ var e = etEl(id); if (e) e.classList.add('hide'); });
  var v = etEl('etView'); if (v) v.style.display = 'block';
  var b = etEl('bot'); if (b) b.style.display = 'none';
  etVisitsHide();
  var un = etEl('uname');
  var nm = un ? (un.textContent || '').trim() : '';
  var nmEl = etEl('et-uname'); if (nmEl) nmEl.textContent = nm || 'Tài khoản';
  var av = etEl('et-av'); if (av) av.textContent = (nm ? nm.charAt(0) : '?').toUpperCase();
  /* Điền sẵn UBND xã + Trường từ form Tạo đề hiện tại (nếu trang đã có). */
  var dxa = etEl('dxa'); if (dxa && dxa.value) etEl('et-ai-xa').value = dxa.value;
  var dtr = etEl('dtruong'); if (dtr && dtr.value) etEl('et-ai-truong').value = dtr.value;
  scrollTo(0, 0);
}
function etHide(){
  var v = etEl('etView'); if (v) v.style.display = 'none';
  etVisitsHide();
  /* tab()/homeShow() của web thật không biết etView nên người tích hợp phải
     gọi thêm etHide() trong mọi đường rời màn hình (hoặc gọi etHide() trước
     khi gọi chúng như etHome/etGoKho/etAdmin/etOpenOld dưới đây). */
}
function etHome(){ etHide(); if (typeof homeShow === 'function') homeShow(); }
function etGoKho(){ etHide(); if (typeof tab === 'function') tab(5); }
/* QUAN TRỌNG — #adm NẰM DƯỚI LỚP PHỦ etView:
   etView là position:fixed, z-index:40, phủ toàn bộ cửa sổ. Bảng quản trị
   #adm của web thật có z-index thấp hơn nên nếu chỉ gọi openAdm() thì bảng
   sẽ bị màn hình etView che mất, nhìn như bấm không có tác dụng.
   Vì vậy PHẢI etHide() TRƯỚC rồi mới openAdm(). */
function etAdmin(){ etHide(); if (typeof openAdm === 'function') openAdm(); }
function etSupport(){
  /* #botp (khung chat, z=70) cao hơn etView (z=40) nên mở chồng lên được,
     không cần ẩn etView. */
  if (typeof botOpen === 'function') botOpen();
}
function etOpenOld(){ etHide(); if (typeof tab === 'function') tab(3); }

/* ---------- "Người truy cập": hộp tổng lượt truy cập ---------- */
function etVisitsHide(){ var box = etEl('et-visits-box'); if (box) box.style.display = 'none'; }
function etVisitsToggle(ev){
  if (ev) ev.stopPropagation();
  var box = etEl('et-visits-box'); if (!box) return;
  if (box.style.display !== 'none') { box.style.display = 'none'; return; }
  box.style.display = 'block';
  box.textContent = 'Đang tải…';
  if (!etVisitsBound) {
    etVisitsBound = true;
    document.addEventListener('click', function(e){
      var b = etEl('et-visits-box');
      if (!b || b.style.display === 'none') return;
      if (e.target.closest && (e.target.closest('#et-visits-box') || e.target.closest('.et-navdrop'))) return;
      b.style.display = 'none';
    });
  }
  /* Fetch RAW, KHÔNG dùng api(): đây là thao tác phụ, api() sẽ coi 401 là
     hết phiên rồi gọi showLogin() — vòng lặp khó chịu. Lỗi (kể cả 401) chỉ
     hiện "—", im lặng, không redirect. GET /api/visits/total trả {total}. */
  etGetRaw('/api/visits/total').then(function(r){
    var num = Number(r && (r.total != null ? r.total : r));
    box.textContent = 'Tổng lượt truy cập: ' + (isFinite(num) ? num.toLocaleString('vi-VN') : '—');
  }).catch(function(){ box.textContent = 'Tổng lượt truy cập: —'; });
}

/* ---------- Chế độ + Cấu hình nhanh ---------- */
function etMode(name){
  ['thongtin','saochep','ai','phieu'].forEach(function(m){
    var pane = etEl('et-mode-' + m);
    if (pane) pane.classList.toggle('et-on', m === name);
  });
  document.querySelectorAll('.et-cardbtn').forEach(function(b){
    b.classList.toggle('et-active', b.getAttribute('data-mode') === name);
  });
  if (name === 'ai') etLoadToc();
}
function etCfgToAi(){
  etEl('et-ai-mon').value = etEl('et-cfg-mon').value;
  etEl('et-ai-lop').value = etEl('et-cfg-lop').value;
  etEl('et-ai-loai').value = etEl('et-cfg-loai').value;
  etCfg = {namhoc: etEl('et-cfg-nam').value, thoigian: etEl('et-cfg-tg').value, hinhthuc: etEl('et-cfg-ht').value};
  etMode('ai');
}

/* ---------- Mục lục (TOC) ---------- */
function etTocFallback(){
  var cur = '';
  var old = etEl('et-ai-chude'); if (old) cur = old.value;
  etEl('et-ai-topic-box').innerHTML = '<input id="et-ai-chude" placeholder="Gõ chủ đề, hoặc chọn từ mục lục khi tải xong" value="' + etEsc(cur) + '">';
  etEl('et-ai-tap-wrap').style.display = 'none';
  etEl('et-toc-warn').style.display = 'none';
}
function etLoadToc(){
  var mon = etEl('et-ai-mon').value;
  var lop = etEl('et-ai-lop').value;
  var tapEl = etEl('et-ai-tap');
  var tapWrap = etEl('et-ai-tap-wrap');
  var tap = (mon === 'Tiếng Việt' && tapWrap && tapWrap.style.display !== 'none' && tapEl) ? tapEl.value : '';
  var seq = ++etTocSeq;
  var url = '/api/taode/toc?mon=' + encodeURIComponent(mon) + '&lop=' + encodeURIComponent(lop);
  if (tap) url += '&tap=' + encodeURIComponent(tap);
  etGetRaw(url).then(function(data){
    if (seq !== etTocSeq) return; /* phản hồi cũ, bỏ qua */
    var topics = [], verified = false, taps = null;
    if (Array.isArray(data)) { topics = data; }
    else if (data && typeof data === 'object') {
      var arr = data.topics || data.chude || data.danhsach || [];
      topics = Array.isArray(arr) ? arr : [];
      verified = data.verified === true;
      if (Array.isArray(data.tap) && data.tap.length) taps = data.tap;
    }
    var norm = topics.map(function(t){
      if (typeof t === 'string') return {ten: t};
      return {ten: t.ten || t.name || t.title || ''};
    }).filter(function(t){ return t.ten; });
    if (!norm.length) { etTocFallback(); return; }
    if (mon === 'Tiếng Việt' && taps) {
      var cur = tapEl ? tapEl.value : '';
      tapEl.innerHTML = taps.map(function(tp){ return '<option' + (tp === cur ? ' selected' : '') + '>' + etEsc(tp) + '</option>'; }).join('');
      tapWrap.style.display = 'block';
    } else {
      tapWrap.style.display = 'none';
    }
    var box = etEl('et-ai-topic-box');
    var old = etEl('et-ai-chude') ? etEl('et-ai-chude').value : '';
    box.innerHTML = '<select id="et-ai-chude"><option value="">— Để trống = toàn bộ nội dung kiểm tra —</option>' +
      norm.map(function(t){ return '<option value="' + etEsc(t.ten) + '"' + (t.ten === old ? ' selected' : '') + '>' + etEsc(t.ten) + '</option>'; }).join('') + '</select>';
    etEl('et-toc-warn').style.display = verified ? 'none' : 'block';
  }).catch(function(){ if (seq === etTocSeq) etTocFallback(); });
}

/* ---------- Soạn đề bằng AI ---------- */
function etAiFields(){
  var chudeEl = etEl('et-ai-chude');
  var tapWrap = etEl('et-ai-tap-wrap');
  var tap = (etEl('et-ai-mon').value === 'Tiếng Việt' && tapWrap && tapWrap.style.display !== 'none') ? etEl('et-ai-tap').value : '';
  return {
    mon: etEl('et-ai-mon').value,
    lop: parseInt(etEl('et-ai-lop').value, 10),
    loai: etEl('et-ai-loai').value,
    chude: chudeEl ? chudeEl.value.trim() : '',
    tap: tap,
    ghichu: etEl('et-ai-ghichu').value.trim(),
    xa: etEl('et-ai-xa').value.trim(),
    truong: etEl('et-ai-truong').value.trim(),
    namhoc: etCfg.namhoc, thoigian: etCfg.thoigian, hinhthuc: etCfg.hinhthuc
  };
}
/* Chuyển đề mẫu dạng backend (sections/answers/reading, khớp exam.build)
   sang dạng phẳng mà các renderer dùng (questions[]). Đề gốc giữ ở
   etExamRaw để etWord gửi lên server đúng định dạng build. */
function etFromBackend(be, f){
  if (!be || !Array.isArray(be.sections)) return null;
  var qs = [];
  be.sections.forEach(function(s){
    (s.questions || []).forEach(function(q){
      var opts = [], lines = 2;
      (q.blocks || []).forEach(function(b){
        if (b.t === 'options' && Array.isArray(b.items)) opts = b.items;
        if (b.t === 'lines' && b.n) lines = b.n;
      });
      var a = (be.answers || {})[String(q.so)] || {};
      qs.push({n: q.so || (qs.length + 1), kind: opts.length ? 'tn' : 'tl',
        level: q.muc || 'M1',
        diem: parseFloat(String(q.diem == null ? '0' : q.diem).replace(',', '.')) || 0,
        text: q.text || '', options: opts, answer: a.text == null ? '' : String(a.text),
        giai: a.giai == null ? '' : String(a.giai), lines: lines});
    });
  });
  var fields = Object.assign({}, f, {pages: '02'});
  return {fields: fields, reading: be.reading || null, questions: qs};
}
function etDraft(showTab){
  if (etDrafting) return;
  var btn = etEl('et-btn-draft');
  var oldText = btn.textContent;
  etDrafting = true; btn.disabled = true; btn.textContent = 'Đang soạn…';
  /* Dùng api() của web thật: hành động do người dùng bấm nên 401→login là
     đúng. Nếu phiên hết thì ẩn etView để form đăng nhập không bị che. */
  var ff = etAiFields();
  var monCode = {'Toán': 'toan', 'Tiếng Việt': 'tv', 'Tiếng Anh': 'ta'}[ff.mon] || 'toan';
  var req = {mon: monCode, lop: parseInt(ff.lop, 10), loai_de: ff.loai, chu_de: ff.chude, ghi_chu: ff.ghichu, nam_hoc: ff.namhoc, thoi_gian: ff.thoigian, hinh_thuc: ff.hinhthuc};
  api('/api/taode/ai-draft', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(req)}).then(function(r){
    var be = (r && r.exam) ? r.exam : r;
    var ex = etFromBackend(be, ff);
    if (!ex || !ex.questions.length) throw new Error('AI chưa trả về đề hợp lệ, thầy bấm lại giúp em nhé');
    etExam = ex;
    etExamRaw = be;
    etRenderAll();
    etShowTab(showTab || 'de');
  }).catch(function(e){
    if (e && e.message && e.message.indexOf('Phiên đăng nhập') >= 0) etHide();
    etErr(e && e.message ? e.message : 'Có lỗi khi soạn đề');
  }).finally(function(){ etDrafting = false; btn.disabled = false; btn.textContent = oldText; });
}
function etPhieu(){
  if (etDrafting) return;
  if (etExam) { etShowTab('phieu'); return; }
  etDraft('phieu');
}

/* ---------- Renderers (bám đúng markup demo) ---------- */
function etNormQ(q, i){
  return {
    n: q.n || (i + 1),
    kind: q.kind || (Array.isArray(q.options) && q.options.length ? 'tn' : 'tl'),
    level: q.level || 'M1',
    diem: parseFloat(q.diem || 0) || 0,
    text: q.text || '',
    options: Array.isArray(q.options) ? q.options : [],
    answer: q.answer == null ? '' : String(q.answer),
    giai: q.giai == null ? '' : String(q.giai),
    lines: parseInt(q.lines, 10) || 2
  };
}
/* ---------- Khối bài đọc (chỉ đề Tiếng Việt có exam.reading) ----------
   Chỉ hiện khi reading.paragraphs là mảng có ít nhất 1 đoạn thật (không
   tính dòng rỗng). Thứ tự trong khối: instruction (nếu có, in đậm — xem
   ghi chú lệch brief ở cuối ETVIEW-JS) → intro (nếu có) → tiêu đề (in đậm,
   căn giữa) → các đoạn văn → dòng nguồn (nếu có, mỗi nguồn 1 dòng).
   Tab Đáp án và Ma trận KHÔNG gọi hàm này nên không hiện bài đọc.
   Không có reading (Toán/Tiếng Anh) hoặc không có paragraphs → trả '' và
   không hiện khối nào (không bịa bài đọc mẫu). */
function etReadingBlock(ex, mode){
  var r = ex && ex.reading;
  if (!r || !Array.isArray(r.paragraphs)) return '';
  var paras = r.paragraphs.filter(function(p){ return p != null && String(p).trim() !== ''; });
  if (!paras.length) return '';
  var h = (mode === 'csheet') ? '<div class="et-cread">' : '';
  if (r.instruction) h += '<p><b>' + etBr(r.instruction) + '</b></p>';
  if (r.intro) h += '<p>' + etBr(r.intro) + '</p>';
  if (r.title) h += '<p style="text-align:center"><b>' + etBr(r.title) + '</b></p>';
  paras.forEach(function(p){ h += '<p>' + etBr(p) + '</p>'; });
  var srcLines = [];
  if (Array.isArray(r.source)) { r.source.forEach(function(s){ String(s == null ? '' : s).split('\n').forEach(function(l){ if (l.trim() !== '') srcLines.push(l); }); }); }
  else if (r.source) { String(r.source).split('\n').forEach(function(l){ if (l.trim() !== '') srcLines.push(l); }); }
  if (srcLines.length) h += '<p>' + srcLines.map(etEsc).join('<br>') + '</p>';
  if (mode === 'csheet') h += '</div>';
  return h;
}
function etSheetHtml(ex){
  var f = ex.fields || {};
  var qs = (ex.questions || []).map(etNormQ);
  var tn = qs.filter(function(q){ return q.kind === 'tn'; });
  var tl = qs.filter(function(q){ return q.kind === 'tl'; });
  var xa = etCleanPrefix(f.xa || '', ['UBND XÃ', 'UBND', 'XÃ', 'PHƯỜNG']);
  var tr = etCleanPrefix(f.truong || '', ['TRƯỜNG']);
  var letters = ['A','B','C','D','E','F'];
  var h = '<div class="et-sheet et-sheet-mau">';
  h += '<table class="et-hdr"><tr><td>UBND XÃ ' + etEsc(xa.toUpperCase()) + '<br>TRƯỜNG ' + etEsc(tr.toUpperCase()) + '<br>(Bài kiểm tra có ' + etEsc(f.pages || '02') + ' trang)</td><td>' + etEsc(etLoaiTitle(f.loai || '')) + '<br>NĂM HỌC ' + etEsc(f.namhoc || '') + '<br>Môn: ' + etEsc(String(f.mon || '').toUpperCase()) + ' – Lớp ' + etEsc(f.lop || '') + '</td></tr>';
  h += '<tr><td>Điểm</td><td>Nhận xét của giáo viên</td></tr>';
  h += '<tr><td class="et-blank">&nbsp;</td><td class="et-blank">&nbsp;</td></tr></table>';
  h += '<p><b>Họ và tên:</b> ………………………………………… <b>Lớp:</b> ' + etEsc(f.lop || '') + '……</p>';
  /* Khối bài đọc (nếu có) nằm TRƯỚC các phần câu hỏi. */
  h += etReadingBlock(ex, 'sheet');
  if (tn.length) {
    h += '<p><b>I. TRẮC NGHIỆM</b><br><b>Khoanh vào chữ cái đặt trước kết quả đúng hoặc điền số thích hợp vào chỗ chấm</b></p>';
    tn.forEach(function(q){
      h += '<div class="et-q"><b>Câu ' + q.n + '.</b> ' + etBr(q.text) + ' (' + etEsc(q.level) + ') (' + etFmtDiem(q.diem) + 'đ)<br>';
      h += '<span class="et-opts">' + q.options.map(function(o, i){ return '<b>' + (letters[i] || '?') + '.</b> ' + etBr(o); }).join(' &nbsp;&nbsp; ') + '</span></div>';
    });
  }
  if (tl.length) {
    h += '<p><b>' + (tn.length ? 'II' : 'I') + '. TỰ LUẬN</b></p>';
    tl.forEach(function(q){
      h += '<div class="et-q"><b>Câu ' + q.n + '.</b> ' + etBr(q.text) + ' (' + etEsc(q.level) + ') (' + etFmtDiem(q.diem) + 'đ)';
      for (var i = 0; i < q.lines; i++) h += '<div class="et-dots"></div>';
      h += '</div>';
    });
  }
  h += '<p><b>ĐÁP ÁN</b></p><table class="et-ans"><tr><th>Câu</th><th>Đáp án</th><th>Điểm</th></tr>';
  if (tn.length) {
    var sumTn = tn.reduce(function(s, q){ return s + q.diem; }, 0);
    h += '<tr><td>I. Trắc nghiệm</td><td class="et-l">' + tn.map(function(q){ return 'Câu ' + q.n + ' – ' + etEsc(q.answer); }).join('; ') + '</td><td>' + etFmtDiem(sumTn) + '</td></tr>';
  }
  tl.forEach(function(q){
    h += '<tr><td>Câu ' + q.n + '.</td><td class="et-l">' + etBr(q.giai || q.answer) + '</td><td>' + etFmtDiem(q.diem) + '</td></tr>';
  });
  h += '</table></div>';
  return h;
}
function etCsheetHtml(ex){
  var f = ex.fields || {};
  var qs = (ex.questions || []).map(etNormQ);
  var tn = qs.filter(function(q){ return q.kind === 'tn'; });
  var tl = qs.filter(function(q){ return q.kind === 'tl'; });
  var sumTl = tl.reduce(function(s, q){ return s + q.diem; }, 0);
  var letters = ['A','B','C','D','E','F'];
  var h = '<div class="et-csheet"><div class="et-chead"><span class="et-badge">✦ PHIẾU BÀI TẬP ✦</span>';
  h += '<h3>🌈 ' + etEsc(f.chude || f.loai || '') + ' — ' + etEsc(f.mon || '') + ' lớp ' + etEsc(f.lop || '') + ' 🌈</h3>';
  h += '<p>Họ và tên: ……………………………… Lớp: ' + etEsc(f.lop || '') + '…… &nbsp;&nbsp; ⭐ Điểm: …………</p></div>';
  /* Khối bài đọc (nếu có) nằm TRƯỚC các phần câu hỏi. */
  h += etReadingBlock(ex, 'csheet');
  if (tn.length) {
    h += '<span class="et-csec">PHẦN 1 — Khoanh tròn đáp án đúng</span>';
    tn.forEach(function(q){
      h += '<div class="et-cq"><b class="et-num">Câu ' + q.n + '.</b> ' + etBr(q.text);
      h += '<div class="et-copts">' + q.options.map(function(o, i){ return (letters[i] || '?') + '. ' + etBr(o); }).join(' &nbsp;&nbsp; ') + '</div></div>';
    });
  }
  if (tl.length) {
    h += '<span class="et-csec et-csec2">PHẦN 2 — Tự làm (' + etFmtDiem(sumTl) + ' điểm)</span>';
    tl.forEach(function(q){
      h += '<div class="et-cq"><b class="et-num">Câu ' + q.n + ' (' + etFmtDiem(q.diem) + ' điểm).</b> ' + etBr(q.text);
      for (var i = 0; i < q.lines; i++) h += '<div class="et-cline"></div>';
      h += '</div>';
    });
  }
  h += '<p style="text-align:center">🎉 Làm xong rồi — kiểm tra lại một lượt nhé! 🎉</p></div>';
  return h;
}
function etAnswersHtml(ex){
  var qs = (ex.questions || []).map(etNormQ);
  var tn = qs.filter(function(q){ return q.kind === 'tn'; });
  var tl = qs.filter(function(q){ return q.kind === 'tl'; });
  var sumTn = tn.reduce(function(s, q){ return s + q.diem; }, 0);
  var uniform = tn.length && tn.every(function(q){ return q.diem === tn[0].diem; });
  var h = '<div class="et-sheet et-sheet-mau et-pagebreak"><p><b>ĐÁP ÁN VÀ HƯỚNG DẪN CHẤM</b></p>';
  if (tn.length) {
    h += '<p><b>Trắc nghiệm:</b> ' + tn.map(function(q){ return 'Câu ' + q.n + ' – ' + etEsc(q.answer); }).join('; ') + '. ' +
      (uniform ? '(Mỗi câu đúng ' + etFmtDiem(tn[0].diem) + ' điểm.)' : '(Tổng ' + etFmtDiem(sumTn) + ' điểm.)') + '</p>';
  }
  tl.forEach(function(q){
    h += '<p><b>Câu ' + q.n + ' (' + etFmtDiem(q.diem) + ' điểm):</b> ' + etBr(q.giai || q.answer) + '</p>';
  });
  h += '</div>';
  return h;
}
function etMatrixHtml(ex){
  var qs = (ex.questions || []).map(etNormQ);
  var levels = ['M1','M2','M3'];
  var totN = 0, totP = 0, totTnN = 0, totTnP = 0, totTlN = 0, totTlP = 0;
  var rows = levels.map(function(lv){
    var tnq = qs.filter(function(q){ return q.kind === 'tn' && q.level === lv; });
    var tlq = qs.filter(function(q){ return q.kind === 'tl' && q.level === lv; });
    var tnP = tnq.reduce(function(s, q){ return s + q.diem; }, 0);
    var tlP = tlq.reduce(function(s, q){ return s + q.diem; }, 0);
    totTnN += tnq.length; totTnP += tnP; totTlN += tlq.length; totTlP += tlP;
    totN += tnq.length + tlq.length; totP += tnP + tlP;
    return '<tr><td>' + lv + '</td><td>' + tnq.length + ' câu<br>' + etFmtDiem(tnP) + ' điểm</td><td>' + tlq.length + ' câu<br>' + etFmtDiem(tlP) + ' điểm</td><td>' + (tnq.length + tlq.length) + ' câu</td><td>' + etFmtDiem(tnP + tlP) + '</td></tr>';
  }).join('');
  var h = '<div class="et-sheet et-sheet-mau et-pagebreak"><p><b>MA TRẬN ĐỀ</b></p><table>';
  h += '<tr><th>Mức độ</th><th>Trắc nghiệm</th><th>Tự luận</th><th>Tổng số câu</th><th>Tổng điểm</th></tr>';
  h += rows;
  h += '<tr><th>Tổng cộng</th><th>' + totTnN + ' câu<br>' + etFmtDiem(totTnP) + ' điểm</th><th>' + totTlN + ' câu<br>' + etFmtDiem(totTlP) + ' điểm</th><th>' + totN + ' câu</th><th>' + etFmtDiem(totP) + '</th></tr>';
  h += '</table></div>';
  return h;
}
function etRenderActions(){
  var box = etEl('et-actions');
  if (!etExam) { box.innerHTML = ''; return; }
  var f = etExam.fields || {};
  var html = '';
  if (f.mon === 'Tiếng Anh') {
    html += '<span class="et-note">Chưa có file mẫu Tiếng Anh — anh gửi mẫu thì em nối</span> ';
  } else {
    html += '<button class="et-pv-btn et-act-primary" type="button" onclick="etWord(this)">⬇ Tải bản Word</button> ';
  }
  html += '<button class="et-pv-btn et-act-secondary" type="button" onclick="etPrintPhieu()">🖨 In phiếu màu</button>';
  box.innerHTML = html;
}
function etRenderAll(){
  if (!etExam) return;
  etEl('et-pv-de').innerHTML = etSheetHtml(etExam);
  etEl('et-pv-phieu').innerHTML = etCsheetHtml(etExam);
  etEl('et-pv-dapan').innerHTML = etAnswersHtml(etExam);
  etEl('et-pv-matran').innerHTML = etMatrixHtml(etExam);
  etRenderActions();
  etEl('et-pv-empty').style.display = 'none';
  etEl('et-pv-exam').style.display = 'block';
  etEl('et-pv-tools').style.display = 'block';
}
function etShowTab(kind){
  if (!etExam) return;
  ['de','phieu','dapan','matran'].forEach(function(k){
    etEl('et-pv-' + k).style.display = (k === kind ? 'block' : 'none');
  });
  document.querySelectorAll('[data-et-tab]').forEach(function(b){
    b.classList.toggle('et-active', b.getAttribute('data-et-tab') === kind);
  });
}

/* ---------- Tải Word / In phiếu màu / Sửa nội dung ---------- */
function etWord(btn){
  if (!etExam || !etExamRaw) { etErr('Chưa có đề mẫu để tải Word'); return; }
  var f = etAiFields();
  if (!f.xa || !f.truong) {
    etErr('Thầy nhập UBND xã và Trường ở form AI trước khi tải Word nhé');
    etMode('ai');
    var xaEl = etEl('et-ai-xa'); if (xaEl) xaEl.focus();
    return;
  }
  var monCode = {'Toán': 'toan', 'Tiếng Việt': 'tv', 'Tiếng Anh': 'ta'}[f.mon] || 'toan';
  var wfields = {mon: monCode, xa: f.xa, truong: f.truong, nam: f.namhoc, lop: parseInt(f.lop, 10), loai_de: f.loai, thoigian: f.thoigian};
  var b = (btn && btn.tagName) ? btn : null;
  if (!b) { var all = document.querySelectorAll('.et-pv-btn'); for (var i = 0; i < all.length; i++) { if ((all[i].textContent || '').indexOf('Tải bản Word') >= 0) { b = all[i]; break; } } }
  var old = b ? b.textContent : '';
  if (b) { b.disabled = true; b.textContent = '⏳ Đang tạo file Word...'; }
  function fin(){ if (b) { b.disabled = false; b.textContent = old; } }
  api('/api/taode/word', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({exam: etExamRaw, fields: wfields})}).then(function(r){
    var url = r && (r.url || r.download || r.href);
    if (!url) throw new Error('Máy chủ chưa trả về link tải file Word');
    return etDownloadFile(url);
  }).catch(function(e){
    if (e && e.message && e.message.indexOf('Phiên đăng nhập') >= 0) etHide();
    etErr(e && e.message ? e.message : 'Có lỗi khi tạo file Word');
  }).finally(fin);
}
/* Tải file ngay trong trang (không mở tab mới): lấy file dạng blob rồi bấm link ẩn có thuộc tính download. */
function etDownloadFile(url){
  return fetch(url, {credentials: 'same-origin'}).then(function(resp){
    if (resp.status === 401) throw new Error('Phiên đăng nhập đã hết, mời thầy cô đăng nhập lại');
    if (resp.status === 409) {
      return resp.json().catch(function(){ return {}; }).then(function(j){
        var msg = (j && j.detail) || 'Đề còn nội dung chạm/tràn khung viền trang.';
        if (window.confirm(msg + '\n\nVẫn tải file về?')) return etDownloadFile(url + (url.indexOf('?') >= 0 ? '&' : '?') + 'force=1');
        return null;
      });
    }
    if (!resp.ok) throw new Error('Không tải được file Word (mã ' + resp.status + ')');
    var cd = resp.headers.get('Content-Disposition') || '';
    var m = /filename\*=UTF-8''([^;]+)|filename="?([^";]+)"?/.exec(cd);
    var name = 'DeKiemTra.docx';
    try { if (m) name = decodeURIComponent(m[1] || m[2]); } catch (e) {}
    return resp.blob().then(function(blob){
      var a = document.createElement('a');
      var u = URL.createObjectURL(blob);
      a.href = u; a.download = name; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function(){ URL.revokeObjectURL(u); }, 5000);
    });
  });
}
/* BẢN SAO các rule .et-csheet trong ETVIEW-CSS — sửa giao diện phiếu màu
   thì phải sửa cả hai chỗ (cửa sổ in không thấy CSS của trang chính). */
var etPrintCss = 'body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;margin:0;padding:16px}' +
  '.et-csheet{border-radius:16px;padding:26px 26px 30px;background:linear-gradient(180deg,#fff7ed 0%,#fef9c3 45%,#ecfdf5 100%);border:3px solid #f59e0b;color:#111}' +
  '.et-csheet .et-chead{text-align:center}' +
  '.et-csheet .et-chead .et-badge{display:inline-block;background:#db2777;color:#fff;font-weight:800;border-radius:999px;padding:4px 16px;font-size:14px;letter-spacing:.5px}' +
  '.et-csheet .et-chead h3{font-size:24px;margin:10px 0 2px;color:#9a3412}' +
  '.et-csheet .et-chead p{margin:2px 0;color:#44403c}' +
  '.et-csheet .et-csec{display:inline-block;font-weight:800;color:#fff;background:#2563eb;border-radius:999px;padding:4px 14px;margin:18px 0 8px}' +
  '.et-csheet .et-csec2{background:#059669}' +
  '.et-csheet .et-cq{background:rgba(255,255,255,.75);border-left:6px solid #f59e0b;border-radius:10px;padding:10px 14px;margin:10px 0}' +
  '.et-csheet .et-cq b.et-num{color:#db2777}' +
  '.et-csheet .et-copts{margin:4px 0 0 8px}' +
  '.et-csheet .et-cline{border-bottom:2px dotted #f59e0b;height:20px;margin:4px 0}' +
  '.et-csheet .et-cread{background:rgba(255,255,255,.85);border-left:6px solid #2563eb;border-radius:10px;padding:12px 14px;margin:14px 0}' +
  '.et-csheet .et-cread p{margin:8px 0}';
function etPrintPhieu(){
  if (!etExam) { etErr('Chưa có đề mẫu để in phiếu màu'); return; }
  var w = window.open('', '_blank');
  if (!w) { etErr('Trình duyệt đã chặn cửa sổ in, thầy cho phép popup rồi bấm lại nhé'); return; }
  w.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>Phiếu màu</title><style>' + etPrintCss + '</style></head><body>' + etCsheetHtml(etExam) + '</body></html>');
  w.document.close();
  w.focus();
  w.print();
}
function etEditToggle(){
  if (!etExam) { etErr('Chưa có đề mẫu để sửa'); return; }
  var pane = null;
  ['de','phieu','dapan','matran'].forEach(function(k){
    var p = etEl('et-pv-' + k);
    if (!pane && p && p.style.display !== 'none') pane = p;
  });
  var s = pane ? pane.querySelector('.et-sheet, .et-csheet') : null;
  if (!s) { etErr('Chưa có đề mẫu để sửa'); return; }
  var on = s.contentEditable !== 'true';
  s.contentEditable = on ? 'true' : 'false';
  alert(on ? 'Đang ở chế độ sửa: bấm trực tiếp vào chữ trong đề để sửa (không lưu lên máy chủ).' : 'Đã tắt chế độ sửa.');
}
</script>
<!-- MÀN HÌNH ĐỌC VĂN BẢN (V113) — overlay full-screen kiểu EduTest, art của thầy + element thật, giữ nguyên id p8 cũ để JS cũ chạy -->
<div id="ttsView" style="display:none">
<style>
#ttsView{position:fixed;inset:0;z-index:40;overflow-y:auto;background:linear-gradient(180deg,#0a1e6e,#050f3a 60%,#03081f);font-family:"Segoe UI",system-ui,-apple-system,sans-serif;color:#fff}
#ttsView .tts-page{max-width:none;margin:0;min-height:100%;background:linear-gradient(180deg,#0a1a5c,#071243);border:1px solid rgba(96,165,250,.35);border-radius:0;overflow:hidden;box-shadow:0 0 60px rgba(59,130,246,.35)}
#ttsView .tts-banner img{display:block;width:100%;height:auto}
#ttsView .tts-grid{display:grid;grid-template-columns:370px 1fr;gap:20px;padding:20px}
@media(max-width:900px){#ttsView .tts-grid{grid-template-columns:1fr}}
#ttsView .tts-card{background:linear-gradient(180deg,#0d2268,#081654);border:1px solid rgba(96,165,250,.35);border-radius:20px;padding:20px;box-shadow:0 8px 30px rgba(0,0,0,.35)}
#ttsView .tts-ic{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;background:linear-gradient(135deg,#2563eb,#7c3aed);box-shadow:0 0 18px rgba(59,130,246,.7);flex:none}
#ttsView .tts-hrow{display:flex;gap:12px;align-items:center}
#ttsView .tts-hrow h2{margin:0;font-size:20px;color:#fff}
#ttsView .tts-hrow p{margin:3px 0 0;color:#9db4e8;font-size:13.5px}
#ttsView textarea#ttstext{width:100%;min-height:215px;margin-top:14px;background:#071a4d;border:1px solid rgba(96,165,250,.35);border-radius:12px;color:#fff;font-size:15px;padding:12px;resize:vertical;outline:none}
#ttsView textarea#ttstext::placeholder{color:#7d94c9}
#ttsView .tts-count{text-align:right;color:#c7d6f7;font-size:13px;margin-top:6px}
#ttsView .tts-filebtn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(90deg,#1d4ed8,#3b82f6);border:0;color:#fff;font-weight:700;font-size:15px;padding:10px 20px;border-radius:999px;cursor:pointer;box-shadow:0 0 16px rgba(59,130,246,.6)}
#ttsView .tts-filenote{color:#9db4e8;font-size:13px;margin-top:8px}
#ttsView .tts-ill{width:100%;border-radius:12px;margin-top:14px;display:block}
#ttsView .tts-modes{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media(max-width:700px){#ttsView .tts-modes{grid-template-columns:1fr}}
#ttsView .tts-mode{border:1px solid rgba(96,165,250,.35);background:linear-gradient(180deg,#0d2268,#081654);border-radius:16px;padding:14px 16px;cursor:pointer;text-align:left;color:#fff;width:100%}
#ttsView .tts-mode .tts-mt{font-weight:800;font-size:16px}
#ttsView .tts-mode .tts-md{color:#9db4e8;font-size:13px;margin-top:3px}
#ttsView .tts-mode.on{background:linear-gradient(90deg,#2563eb,#7c3aed);border-color:transparent;box-shadow:0 0 24px rgba(124,58,237,.7)}
#ttsView .tts-mode.on .tts-md{color:#e0e7ff}
#ttsView .tts-opts{margin-top:20px}
#ttsView .tts-optgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:700px){#ttsView .tts-optgrid{grid-template-columns:1fr}}
#ttsView label.tts-fl{display:block;color:#e0e7ff;font-weight:700;font-size:15px}
#ttsView select,#ttsView input[type=text]{width:100%;margin-top:6px;background-color:#071a4d!important;border:1px solid rgba(96,165,250,.4);border-radius:12px;color:#fff;font-size:15px;padding:11px 12px;outline:none}
#ttsView .tts-note{color:#9db4e8;font-size:13.5px;margin:12px 0 0}
#ttsView .tts-note b{color:#fff}
#ttsView button#ttsgen{width:100%;margin-top:16px;border:0;cursor:pointer;color:#fff;font-weight:800;font-size:19px;padding:17px;border-radius:16px;background:linear-gradient(90deg,#2563eb,#7c3aed,#d946ef);box-shadow:0 0 30px rgba(124,58,237,.65);display:flex;align-items:center;justify-content:center;gap:10px}
#ttsView button#ttsgen:disabled{opacity:.6}
#ttsView .tts-stat{color:#c7d6f7;font-size:14px;min-height:20px;margin-top:10px}
#ttsView .tts-res{margin-top:20px}
#ttsView .tts-res-head{display:flex;gap:12px;align-items:center}
#ttsView .tts-res-head h3{margin:0;font-size:18px;color:#fff}
#ttsView .tts-res-head p{margin:3px 0 0;color:#9db4e8;font-size:13.5px}
#ttsView .tts-res-actions{margin-left:auto;display:flex;gap:8px;flex:none}
#ttsView .tts-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(7,26,77,.8);border:1px solid rgba(96,165,250,.45);color:#fff;border-radius:999px;padding:8px 14px;font-size:14px;cursor:pointer;text-decoration:none}
#ttsView .tts-chip.loved{color:#f472b6;border-color:#f472b6}
#ttsView .tts-chip.active{background:#2563eb}
#ttsView .tts-player{display:flex;align-items:center;gap:16px;margin-top:16px;background:rgba(7,26,77,.55);border:1px solid rgba(96,165,250,.3);border-radius:16px;padding:14px 18px}
#ttsView .tts-playbtn{width:76px;height:76px;border:0;background:none;padding:0;cursor:pointer;flex:none;border-radius:50%}
#ttsView .tts-playbtn img{width:100%;height:100%;display:block;border-radius:50%}
#ttsView .tts-wave{flex:1;display:flex;align-items:center;gap:3px;height:56px}
#ttsView .tts-wave i{flex:1;border-radius:3px;background:linear-gradient(180deg,#38bdf8,#a855f7);opacity:.55}
#ttsView .tts-wave.playing i{animation:tts-wb 1s ease-in-out infinite alternate}
@keyframes tts-wb{from{transform:scaleY(.35)}to{transform:scaleY(1)}}
#ttsView .tts-time{font-size:14px;color:#e0e7ff;white-space:nowrap}
#ttsView input[type=range]{accent-color:#38bdf8}
#ttsView .tts-save-row{display:flex;gap:10px;margin-top:12px}
#ttsView .tts-save-row input{flex:1}
#ttsView .castrow{display:flex;gap:10px;align-items:center;margin-top:10px}
#ttsView .castrow span{flex:none;color:#e0e7ff}
#ttsView .castrow select{margin-top:0}
</style>
<div class="tts-page">
  <div class="tts-banner">
    <img id="ttsBannerImg" src="/static/img/tts-banner.png?v=__V__" alt="Chuyển văn bản thành giọng nói" usemap="#ttsmap">
    <map name="ttsmap"><area id="ttsHomeArea" shape="rect" coords="30,20,225,88" href="#" alt="Trang chủ"></map>
  </div>
  <div class="tts-grid">
    <div class="tts-card">
      <div class="tts-hrow"><div class="tts-ic">🎙️</div><div><h2>Nhập văn bản</h2><p>Dán hoặc nhập văn bản cần chuyển thành giọng nói</p></div></div>
      <textarea id="ttstext" maxlength="3000" rows="12" placeholder="Nhập hoặc dán văn bản vào đây…" oninput="ttsOnText()"></textarea>
      <div class="tts-count"><span id="ttscount">0 / 3000 ký tự</span></div>
      <label class="tts-filebtn">📂 Mở file .txt<input type="file" id="ttsfile" accept=".txt" onchange="ttsFile(this)" hidden></label>
      <div class="tts-filenote">📄 Hỗ trợ file văn bản định dạng .txt</div>
      <img class="tts-ill" src="/static/img/tts-ill.png?v=__V__" alt="Tài liệu txt">
    </div>
    <div>
      <div class="tts-modes">
        <button type="button" class="tts-mode on" id="ttsm-read" onclick="ttsMode('read')"><div class="tts-mt">📖 Đọc thường</div><div class="tts-md">Chuyển văn bản thành giọng nói</div></button>
        <button type="button" class="tts-mode" id="ttsm-dictation" onclick="ttsMode('dictation')"><div class="tts-mt">✏️ Nghe – viết chính tả</div><div class="tts-md">Nghe và viết lại nội dung</div></button>
        <button type="button" class="tts-mode" id="ttsm-dialogue" onclick="ttsMode('dialogue')"><div class="tts-mt">💬 Đối thoại</div><div class="tts-md">Luyện phản xạ qua hội thoại</div></button>
      </div>
      <div class="tts-card tts-opts">
        <div id="ttsopt-read">
          <div class="tts-optgrid">
            <label class="tts-fl">🎙️ Giọng đọc
              <select id="ttsvoice" onchange="ttsVoiceChange()"><option>Đang tải giọng đọc…</option></select>
            </label>
            <label class="tts-fl">🎧 Tốc độ đọc
              <select id="ttsspeed"><option value="cham">🐢 Chậm</option><option value="vua" selected>🚀 Vừa</option><option value="nhanh">🏃 Nhanh</option></select>
            </label>
          </div>
          <div id="ttscustom" class="hide"><label class="tts-fl" style="margin-top:14px">✨ Mô tả giọng đọc thầy/cô muốn<input type="text" id="ttsstyle" placeholder="VD: Bé gái 7 tuổi, giọng vui vẻ, đọc hơi nhanh…"></label></div>
          <p class="tts-note">💡 Giọng <b>Bé gái / Bé trai</b> rất hợp đọc thơ, kể chuyện cho học sinh nghe.</p>
        </div>
        <div id="ttsopt-dictation" class="hide">
          <div class="tts-optgrid">
            <label class="tts-fl">🎙️ Giọng đọc
              <select id="ttsdvoice"><option>Đang tải giọng đọc…</option></select>
            </label>
            <label class="tts-fl">⏸️ Nghỉ giữa câu
              <select id="ttspause"><option value="3">3 giây</option><option value="5" selected>5 giây</option><option value="8">8 giây</option></select>
            </label>
            <label class="tts-fl">🔁 Lặp mỗi câu
              <select id="ttsrepeat"><option value="1">1 lần</option><option value="2" selected>2 lần</option><option value="3">3 lần</option></select>
            </label>
          </div>
          <p class="tts-note">Máy đọc từng câu chậm rãi, tự ngắt nghỉ để học sinh kịp viết.</p>
        </div>
        <div id="ttsopt-dialogue" class="hide">
          <p class="tts-note" style="margin-top:0">Viết kịch bản, mỗi dòng một lượt thoại theo mẫu: <b>Thỏ:</b> câu thoại — <b>Rùa:</b> câu thoại. Dòng không ghi tên nhân vật sẽ là lời dẫn chuyện (giọng Cô giáo). Chọn giọng cho từng nhân vật ở danh sách bên dưới.</p>
          <div id="ttscastbox" class="hide"><div id="ttscast"></div></div>
        </div>
        <button type="button" id="ttsgen" onclick="ttsGen()">✦ Tạo giọng đọc →</button>
        <div class="tts-stat" id="ttsstat"></div>
      </div>
      <div class="tts-card tts-res hide" id="ttsout">
        <div class="tts-res-head"><div class="tts-ic" style="width:44px;height:44px;font-size:20px">🎧</div>
          <div><h3>Kết quả giọng đọc</h3><p>Nghe, tải xuống hoặc chia sẻ đoạn âm thanh</p></div>
          <div class="tts-res-actions">
            <a class="tts-chip" id="ttsdl" href="#" download="giong-doc.mp3">⬇️ Tải xuống</a>
            <button type="button" class="tts-chip" onclick="ttsShare()">🔗 Chia sẻ</button>
            <button type="button" class="tts-chip" id="ttsLoveBtn" onclick="ttsLove(this)">♡</button>
          </div>
        </div>
        <div class="tts-player">
          <button type="button" class="tts-playbtn" id="tts-play-btn"><img src="/static/img/tts-play.png?v=__V__" alt="Phát"></button>
          <div class="tts-wave" id="tts-wave"></div>
          <div class="tts-time"><span id="tts-tcur">0:00</span> / <span id="tts-tdur">0:00</span></div>
          <input type="range" id="tts-vol" min="0" max="100" value="80" style="width:110px" title="Âm lượng">
          <button type="button" class="tts-chip" id="ttsNativeBtn" onclick="ttsToggleNative(this)">⋮</button>
        </div>
        <audio id="ttsplayer" style="display:none;width:100%"></audio>
        <div class="tts-save-row"><input type="text" id="ttsname" placeholder="Tên khi lưu vào Kho lưu…"><button type="button" class="tts-chip" onclick="ttsSave()">💾 Lưu vào Kho lưu</button></div>
      </div>
    </div>
  </div>
</div>
</div>
<script>
/* Đọc văn bản — màn hình riêng V113: mở/đóng + nối trình phát tự vẽ vào audio thật */
const ttsEl = id => document.getElementById(id);
function ttsShow(){
  if(typeof etHide==="function")etHide();
  if(typeof vaHide==="function")vaHide();
  if(typeof vcHide==="function")vcHide();
  if(typeof cvHide==="function")cvHide();
  ["p1","p2","p3","p4","p5","p8","p9","p10","p11","p12","p13"].forEach(function(id){var e=ttsEl(id);if(e)e.classList.add("hide");});
  var hv=ttsEl("homeView");if(hv)hv.classList.add("hide");
  var b=ttsEl("bot");if(b)b.style.display="none";
  var v=ttsEl("ttsView");if(v)v.style.display="block";
  if(window.ttsInit)ttsInit();
  ttsPlayerInit();ttsFitMap();
  scrollTo(0,0);
}
function ttsHide(){var v=ttsEl("ttsView");if(v)v.style.display="none";}
/* Vùng bấm nút Trang chủ nướng trong banner (tọa độ ảnh gốc 1659px) — co giãn theo ảnh hiển thị */
function ttsFitMap(){var img=ttsEl("ttsBannerImg");if(!img||!img.clientWidth)return;var k=img.clientWidth/1659;ttsEl("ttsHomeArea").coords=[30*k,20*k,225*k,88*k].map(function(v){return Math.round(v);}).join(",");}
window.addEventListener("resize",ttsFitMap);
(function(){
  var area=ttsEl("ttsHomeArea");
  if(area)area.addEventListener("click",function(e){e.preventDefault();if(typeof homeShow==="function")homeShow();});
})();
/* Trình phát tự vẽ nối vào <audio> thật (giọng do server tạo, ttsGen gán src như cũ) */
function ttsPlayerInit(){
  var a=ttsEl("ttsplayer");if(!a||a._ttsWired)return;a._ttsWired=true;
  var btn=ttsEl("tts-play-btn"),wave=ttsEl("tts-wave"),cur=ttsEl("tts-tcur"),dur=ttsEl("tts-tdur"),vol=ttsEl("tts-vol");
  var fmt=function(s){s=Math.floor(s||0);return Math.floor(s/60)+":"+String(s%60).padStart(2,"0");};
  a.volume=0.8;
  [22,38,30,48,26,55,34,44,20,52,30,40,24,50,36,28,54,32,42,22,46,30,38,26,50,34,44,20,40,30,52,28,36,48,24,42].forEach(function(h){var i=document.createElement("i");i.style.height=h+"px";wave.appendChild(i);});
  btn.addEventListener("click",function(){if(a.paused){a.play().catch(function(){});}else{a.pause();}});
  a.addEventListener("play",function(){wave.classList.add("playing");});
  a.addEventListener("pause",function(){wave.classList.remove("playing");});
  a.addEventListener("ended",function(){wave.classList.remove("playing");cur.textContent="0:00";});
  a.addEventListener("loadedmetadata",function(){dur.textContent=fmt(a.duration);});
  a.addEventListener("timeupdate",function(){cur.textContent=fmt(a.currentTime);});
  vol.addEventListener("input",function(){a.volume=vol.value/100;});
  /* Khi ttsGen tạo xong và hiện khung kết quả thì cuộn tới đó */
  var out=ttsEl("ttsout");
  if(out&&window.MutationObserver)new MutationObserver(function(){if(!out.classList.contains("hide"))out.scrollIntoView({behavior:"smooth",block:"nearest"});}).observe(out,{attributes:true,attributeFilter:["class"]});
}
function ttsShare(){
  var a=ttsEl("ttsdl");var url=(a&&a.href&&a.href.indexOf("#")===-1)?a.href:location.href;
  if(navigator.share){navigator.share({title:"Giọng đọc",url:url}).catch(function(){});}
  else if(navigator.clipboard){navigator.clipboard.writeText(url).then(function(){ttsEl("ttsstat").textContent="Đã sao chép link file âm thanh.";});}
}
function ttsLove(btn){
  var loved=btn.classList.toggle("loved");
  btn.textContent=loved?"♥":"♡";
  try{var a=ttsEl("ttsdl");localStorage.setItem("tts_love",loved?(a?a.href:""):"");}catch(e){}
}
function ttsToggleNative(btn){
  var a=ttsEl("ttsplayer");if(!a)return;
  var show=a.style.display==="none";
  a.style.display=show?"block":"none";
  btn.classList.toggle("active",show);
}
ttsPlayerInit();
</script>

<!-- MÀN HÌNH TẠO VIDEO AI (V114) — overlay full-screen tràn viền, kịch bản nhiều cảnh + giọng TTS + timeline -->
<div id="vaView" style="display:none">
<style>
#vaView{position:fixed;inset:0;z-index:40;overflow-y:auto;background:linear-gradient(180deg,#0a1e6e,#050f3a 60%,#03081f);font-family:"Segoe UI",system-ui,-apple-system,sans-serif;color:#fff}
#vaView .va-head{display:flex;gap:16px;align-items:center;padding:16px 24px;background:linear-gradient(90deg,#1d4ed8,#7c3aed,#d946ef)}
#vaView .va-homebtn{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.5);color:#fff;font-weight:800;font-size:15px;padding:10px 20px;border-radius:999px;cursor:pointer}
#vaView .va-head h2{margin:0;font-size:24px}
#vaView .va-head p{margin:3px 0 0;color:#e0e7ff;font-size:14px}
#vaView .va-head-actions{margin-left:auto;display:flex;gap:10px;align-items:center;flex:none}
#vaView .va-total{font-size:15px;color:#fff;background:rgba(0,0,0,.25);border-radius:999px;padding:8px 16px}
#vaView .va-export{border:0;cursor:pointer;color:#fff;font-weight:800;font-size:16px;padding:12px 24px;border-radius:999px;background:linear-gradient(90deg,#f59e0b,#ef4444);box-shadow:0 0 20px rgba(239,68,68,.6)}
#vaView .va-grid{display:grid;grid-template-columns:360px 1fr;gap:20px;padding:20px}
@media(max-width:900px){#vaView .va-grid{grid-template-columns:1fr}}
#vaView .va-card{background:linear-gradient(180deg,#0d2268,#081654);border:1px solid rgba(96,165,250,.35);border-radius:20px;padding:18px;box-shadow:0 8px 30px rgba(0,0,0,.35)}
#vaView .va-card h3{margin:0 0 12px;font-size:18px}
#vaView .va-scene{border:2px solid rgba(96,165,250,.3);border-radius:16px;padding:12px;margin-bottom:14px;cursor:pointer;background:rgba(7,26,77,.5)}
#vaView .va-scene.on{border-color:#f59e0b;box-shadow:0 0 18px rgba(245,158,11,.5)}
#vaView .va-scene img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:10px;display:block}
#vaView .va-scene-head{display:flex;gap:8px;align-items:center;margin-top:10px}
#vaView .va-scene-head b{flex:1;font-size:15px}
#vaView .va-del{border:0;background:none;color:#f87171;font-size:18px;cursor:pointer;padding:0 4px}
#vaView label.va-fl{display:block;color:#e0e7ff;font-weight:700;font-size:14px;margin-top:10px}
#vaView select,#vaView input[type=text],#vaView textarea{width:100%;margin-top:6px;background-color:#071a4d!important;border:1px solid rgba(96,165,250,.4);border-radius:12px;color:#fff;font-size:15px;padding:10px 12px;outline:none}
#vaView textarea{resize:vertical;min-height:64px}
#vaView .va-row{display:flex;gap:10px}
#vaView .va-row>*{flex:1}
#vaView .va-listen{margin-top:10px;border:0;cursor:pointer;color:#fff;font-weight:700;font-size:14px;padding:9px 16px;border-radius:999px;background:linear-gradient(90deg,#2563eb,#7c3aed)}
#vaView .va-add{width:100%;margin-top:4px;border:1px dashed rgba(96,165,250,.6);background:transparent;color:#c7d6f7;font-weight:700;font-size:15px;padding:12px;border-radius:14px;cursor:pointer}
#vaView .va-stage{position:relative;border-radius:20px;overflow:hidden;border:1px solid rgba(96,165,250,.4);background:#000}
#vaView .va-stage img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
#vaView .va-sub{position:absolute;left:0;right:0;bottom:0;padding:26px 20px 16px;text-align:center;font-size:20px;font-weight:700;text-shadow:0 2px 8px rgba(0,0,0,.9);background:linear-gradient(180deg,transparent,rgba(0,0,0,.75))}
#vaView .va-status{color:#c7d6f7;font-size:14px;min-height:20px;margin-top:12px}
#vaView .va-timeline{padding:0 20px 24px}
#vaView .va-tl{display:flex;gap:10px;margin-top:10px}
#vaView .va-block{border:1px solid rgba(96,165,250,.45);background:linear-gradient(180deg,#0d2268,#081654);border-radius:12px;padding:12px 10px;cursor:pointer;color:#fff;text-align:center}
#vaView .va-block.on{background:linear-gradient(90deg,#2563eb,#7c3aed);border-color:transparent;box-shadow:0 0 18px rgba(124,58,237,.7)}
#vaView .va-block b{display:block;font-size:15px}
#vaView .va-block span{color:#9db4e8;font-size:13px}
#vaView .va-block.on span{color:#e0e7ff}
</style>
<div class="va-head">
  <button type="button" class="va-homebtn" onclick="homeShow()">🏠 Trang chủ</button>
  <div><h2>🎬 Tạo video AI</h2><p>Kịch bản nhiều cảnh → giọng đọc → video (ảnh + phụ đề, ghép bằng ffmpeg)</p></div>
  <div class="va-head-actions"><span class="va-total" id="va-total">Tổng: 24 giây</span><button type="button" class="va-export" onclick="vaExport()">⬇ Xuất video</button></div>
</div>
<div class="va-grid">
  <div class="va-card">
    <h3>📋 Danh sách cảnh</h3>
    <div id="va-scenes"></div>
    <button type="button" class="va-add" onclick="vaAddScene()">＋ Thêm cảnh</button>
  </div>
  <div>
    <div class="va-card">
      <h3>🖥️ Xem trước</h3>
      <div class="va-stage"><img id="va-preview-img" src="/static/img/va-scene1.jpg?v=__V__" alt="Cảnh đang chọn"><div class="va-sub" id="va-preview-sub"></div></div>
      <div class="va-status" id="va-status"></div>
      <audio id="va-audio" style="display:none"></audio>
    </div>
  </div>
</div>
<div class="va-timeline">
  <div class="va-card">
    <h3>⏱️ Timeline</h3>
    <div class="va-tl" id="va-timeline"></div>
  </div>
</div>
</div>
<div id="vipLock" style="display:none" onclick="if(event.target===this)vipLockClose()">
<style>
#vipLock{position:fixed;inset:0;z-index:220;background:#0f172a99;display:grid;place-items:center;padding:16px}
#vipLock .vipbox{width:min(520px,calc(100vw - 32px));background:linear-gradient(180deg,#1e293b,#0f172a);border:2px solid #f59e0b;border-radius:20px;padding:28px 24px;text-align:center;color:#fff;box-shadow:0 20px 60px rgba(0,0,0,.5)}
#vipLock .vipbox .viplock{font-size:44px}
#vipLock .vipbox h3{margin:10px 0 6px;font-size:20px;color:#fbbf24}
#vipLock .vipbox p{margin:0;color:#cbd5e1;font-size:15px}
#vipLock .vipok{margin-top:18px;border:0;cursor:pointer;color:#fff;font-weight:800;font-size:16px;padding:11px 28px;border-radius:999px;background:linear-gradient(90deg,#f59e0b,#ef4444)}
</style>
<div class="vipbox"><div class="viplock">🔒</div><h3>Chức năng này chỉ dành cho tài khoản Víp</h3><p>Chức năng đang được hoàn thiện, sẽ mở lại sau.</p><button type="button" class="vipok" onclick="vipLockClose()">Đã hiểu</button></div>
</div>
<script>
/* Tạo video AI — màn hình riêng V114: biên tập kịch bản nhiều cảnh, nghe thử giọng TTS thật */
var vaScenes = [
  {img:"/static/img/va-scene1.jpg?v=__V__", title:"Cảnh 1: Cô giáo chào lớp", line:"Chào các em, hôm nay chúng ta cùng học bài mới nhé!", voice:"", dur:8},
  {img:"/static/img/va-scene2.jpg?v=__V__", title:"Cảnh 2: Cả lớp hát vang", line:"Cả lớp cùng hát vang bài hát chúng mình yêu thích nào!", voice:"", dur:8},
  {img:"/static/img/va-scene3.jpg?v=__V__", title:"Cảnh 3: Cùng nhau cố gắng", line:"Các em hãy giơ tay phát biểu, chúng ta cùng nhau cố gắng nhé!", voice:"", dur:8}
];
var vaSel = 0;
function vaEl(id){return document.getElementById(id);}
async function vaShow(){
  var vaMe=null;
  try{vaMe=(typeof hmGet==="function")?await hmGet("/api/me"):null;}catch(e){vaMe=null;}
  if(!(vaMe&&(vaMe.admin||vaMe.tier==="vip"||vaMe.tier==="pro"))){var vl=document.getElementById("vipLock");if(vl)vl.style.display="grid";return;}
  if(typeof etHide==="function")etHide();
  if(typeof ttsHide==="function")ttsHide();if(typeof vcHide==="function")vcHide();if(typeof cvHide==="function")cvHide();
  ["p1","p2","p3","p4","p5","p8","p9","p10","p11","p12","p13"].forEach(function(id){var e=vaEl(id);if(e)e.classList.add("hide");});
  var hv=vaEl("homeView");if(hv)hv.classList.add("hide");
  var b=vaEl("bot");if(b)b.style.display="none";
  var v=vaEl("vaView");if(v)v.style.display="block";
  vaRenderAll();
  if(window.ttsInit){var p=ttsInit();if(p&&p.then)p.then(function(){vaSyncVoices();});}
  vaSyncVoices();
  scrollTo(0,0);
}
function vaHide(){var v=vaEl("vaView");if(v)v.style.display="none";} function vipLockClose(){var l=document.getElementById("vipLock");if(l)l.style.display="none";}
function vaVoices(){
  /* TTS_VOICES là biến let trong script chính (không nằm trên window) nên đọc lại từ ô chọn giọng mà ttsInit đã nạp sẵn */
  var sel=document.getElementById("ttsvoice");var out=[];
  if(sel)for(var i=0;i<sel.options.length;i++){var o=sel.options[i];if(o.value&&o.value!=="custom"&&o.text.indexOf("Đang tải")!==0)out.push({id:o.value,label:o.text});}
  return out;
}
function vaSyncVoices(){
  var vs=vaVoices();
  document.querySelectorAll("#va-scenes .va-voice").forEach(function(sel){
    var i=+sel.dataset.scene;var cur=vaScenes[i]?vaScenes[i].voice:"";
    if(!vs.length){sel.innerHTML='<option value="">Chưa tải được giọng đọc</option>';return;}
    sel.innerHTML=vs.map(function(v){return '<option value="'+v.id+'">'+v.label+"</option>";}).join("");
    if(cur&&vs.some(function(v){return v.id===cur;}))sel.value=cur;
    else{sel.value=vs[0].id;if(vaScenes[i])vaScenes[i].voice=vs[0].id;}
  });
}
function vaTotal(){return vaScenes.reduce(function(t,s){return t+(+s.dur||0);},0);}
function vaSelect(i){
  vaSel=i;
  document.querySelectorAll("#va-scenes .va-scene").forEach(function(el,j){el.classList.toggle("on",j===i);});
  document.querySelectorAll("#va-timeline .va-block").forEach(function(el,j){el.classList.toggle("on",j===i);});
  vaPreview();
}
function vaPreview(){
  var s=vaScenes[vaSel];if(!s)return;
  vaEl("va-preview-img").src=s.img;
  vaEl("va-preview-sub").textContent=s.line||"";
}
function vaRenderScenes(){
  var box=vaEl("va-scenes");
  box.innerHTML=vaScenes.map(function(s,i){
    return '<div class="va-scene'+(i===vaSel?" on":"")+'" onclick="vaSelect('+i+')">'
      + '<img src="'+s.img+'" alt="'+s.title+'">'
      + '<div class="va-scene-head"><b>'+s.title+'</b>'
      + '<button type="button" class="va-del" title="Xóa cảnh" onclick="event.stopPropagation();vaDelScene('+i+')">×</button></div>'
      + '<label class="va-fl">Tên cảnh<input type="text" value="'+s.title.replace(/"/g,"&quot;")+'" onchange="vaScenes['+i+'].title=this.value;vaRenderTimeline();"></label>'
      + '<label class="va-fl">Lời thoại<textarea oninput="vaScenes['+i+'].line=this.value;vaPreview();">'+s.line.replace(/</g,"&lt;")+'</textarea></label>'
      + '<div class="va-row"><label class="va-fl">Giọng đọc<select class="va-voice" data-scene="'+i+'" onchange="vaScenes['+i+'].voice=this.value;"></select></label>'
      + '<label class="va-fl">Thời lượng<select onchange="vaScenes['+i+'].dur=+this.value;vaRenderTimeline();"><option value="5"'+(s.dur===5?" selected":"")+'>5 giây</option><option value="8"'+(s.dur===8?" selected":"")+'>8 giây</option><option value="10"'+(s.dur===10?" selected":"")+'>10 giây</option></select></label></div>'
      + '<button type="button" class="va-listen" onclick="event.stopPropagation();vaListen('+i+')">🔊 Nghe thử giọng cảnh này</button>'
      + '</div>';
  }).join("");
  vaSyncVoices();
}
function vaRenderTimeline(){
  var tl=vaEl("va-timeline");
  tl.innerHTML=vaScenes.map(function(s,i){
    return '<button type="button" class="va-block'+(i===vaSel?" on":"")+'" style="flex-grow:'+(+s.dur||8)+'" onclick="vaSelect('+i+')"><b>Cảnh '+(i+1)+'</b><span>'+s.dur+' giây</span></button>';
  }).join("");
  vaEl("va-total").textContent="Tổng: "+vaTotal()+" giây";
}
function vaRenderAll(){vaRenderScenes();vaRenderTimeline();vaPreview();}
function vaAddScene(){
  vaScenes.push({img:"/static/img/va-scene1.jpg?v=__V__", title:"Cảnh mới", line:"", voice:"", dur:8});
  vaSel=vaScenes.length-1;vaRenderAll();
}
function vaDelScene(i){
  if(vaScenes.length<=1){vaEl("va-status").textContent="Cần giữ ít nhất 1 cảnh.";return;}
  vaScenes.splice(i,1);
  if(vaSel>=vaScenes.length)vaSel=vaScenes.length-1;
  vaRenderAll();
}
async function vaListen(i){
  var s=vaScenes[i];if(!s)return;
  var st=vaEl("va-status");
  if(!s.line.trim()){st.textContent="Nhập lời thoại cho cảnh này trước đã ạ.";return;}
  var vs=vaVoices();var voice=s.voice||(vs.length?vs[0].id:"");
  if(!voice){st.textContent="Chưa tải được danh sách giọng đọc.";return;}
  st.textContent="Đang tạo giọng thử cho cảnh "+(i+1)+"…";
  try{
    var r=await api("/api/tts/synth",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({mode:"read",text:s.line,voice:voice,speed:"vua"})});
    var a=vaEl("va-audio");a.src="/api/tts/audio/"+r.id;a.play().catch(function(){});
    st.textContent="Đang phát giọng thử cảnh "+(i+1)+".";
  }catch(e){st.textContent="Lỗi: "+(e.message||e);}
}
function vaExport(){
  vaEl("va-status").textContent="Chức năng xuất video đang được xây dựng — thầy duyệt giao diện trước, em nối pipeline xuất (ghép ảnh + giọng đọc + phụ đề) sau.";
}
</script>

<!-- MÀN HÌNH ÔN VC MỚI (V117) — overlay full-screen theo ảnh mẫu thầy gửi, nối đúng bộ máy luyện tập cũ (vcInit/vcStart/vcBrowse) -->
<div id="vcView" style="display:none">
<style>
#vcView{position:fixed;inset:0;z-index:40;overflow-y:auto;background:linear-gradient(180deg,#dbeafe,#eff6ff 55%,#ffffff);font-family:"Segoe UI",system-ui,-apple-system,sans-serif;color:#0f172a}
#vcView .vc-banner img{width:100%;display:block}
#vcView .vc-nav{display:flex;gap:10px;flex-wrap:wrap;align-items:center;padding:12px 20px;background:#fff;box-shadow:0 2px 12px rgba(37,99,235,.12)}
#vcView .vc-pill{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid #dbeafe;border-radius:99px;padding:9px 16px;font-weight:700;font-size:14px;color:#1e3a8a;white-space:nowrap}
#vcView button.vc-pill{cursor:pointer;font:inherit}
#vcView .vc-pill b{color:#1d4ed8}
#vcView .vc-badge{min-width:20px;height:20px;border-radius:10px;background:#ef4444;color:#fff;font-size:11.5px;font-weight:700;display:none;place-items:center;padding:0 5px}
#vcView .vc-main{display:grid;grid-template-columns:380px 1fr;gap:20px;padding:20px;align-items:start}
@media(max-width:900px){#vcView .vc-main{grid-template-columns:1fr}}
#vcView .vc-card{background:#fff;border:1px solid #dbeafe;border-radius:20px;padding:20px;box-shadow:0 8px 30px rgba(37,99,235,.10)}
#vcView .vc-card h3{margin:0 0 10px;font-size:19px;color:#1e3a8a}
#vcView .vc-muted{color:#64748b;font-size:14px;line-height:1.55;margin:8px 0}
#vcView .vc-fl{display:block;font-weight:800;font-size:15px;color:#1e3a8a;margin:16px 0 8px}
#vcView #vcChaps{display:grid;grid-template-columns:1fr 1fr;gap:8px}
#vcView #vcChaps .btn2{width:100%;margin:0;justify-content:center}
#vcView #vcNum{width:100%;margin-top:6px;border:1.5px solid #cbd5e1;border-radius:12px;padding:11px 12px;font-size:15px;background:#fff;color:#0f172a}
#vcView .vc-start{width:100%;margin-top:16px;border:0;cursor:pointer;color:#fff;font-weight:800;font-size:17px;padding:14px;border-radius:14px;background:linear-gradient(90deg,#2563eb,#0ea5e9);box-shadow:0 8px 20px rgba(37,99,235,.35)}
#vcView .vc-chk{display:flex;gap:8px;align-items:center;font-weight:700;font-size:15px;margin-top:12px;cursor:pointer}
#vcView .vc-chk input{width:18px;height:18px;accent-color:#2563eb}
#vcView .vc-hero{display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap}
#vcView .vc-hero-text{flex:1;min-width:260px}
#vcView .vc-kicker{display:inline-block;background:#eff6ff;color:#2563eb;font-weight:800;font-size:13px;letter-spacing:.5px;border-radius:99px;padding:6px 12px}
#vcView .vc-hero-text h2{font-size:34px;line-height:1.2;margin:12px 0 10px;color:#1e3a8a}
#vcView .vc-hero-text h2 .vc-gold{color:#d97706}
#vcView .vc-hero-text p{font-size:15px;line-height:1.65;color:#334155;margin:0}
#vcView .vc-chips{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}
#vcView .vc-chips span{display:flex;gap:8px;align-items:center;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:10px 12px;font-size:14px;font-weight:600;color:#334155}
#vcView .vc-hero-img{width:42%;min-width:260px;border-radius:14px;display:block;box-shadow:0 8px 24px rgba(15,23,42,.18)}
#vcView .vc-tablehead{display:flex;justify-content:space-between;align-items:center;gap:10px;font-weight:800;font-size:17px;color:#1e3a8a;border-top:1px solid #dbeafe;margin-top:18px;padding-top:14px}
#vcView .vc-total{font-size:13px;font-weight:700;color:#2563eb;background:#eff6ff;border-radius:99px;padding:6px 12px;white-space:nowrap}
#vcView #vcChapList>div{display:flex;justify-content:space-between;gap:10px;padding:9px 2px;border-bottom:1px dashed #dbeafe;cursor:pointer;align-items:center}
#vcView #vcChapList>div::after{content:"›";color:#2563eb;font-weight:800;font-size:20px}
#vcView #vcChapList>div b{color:#1e3a8a}
#vcView #vcQuizCard{padding:18px}
#vcView #vcQuizCard .btn2{font-size:17px}
</style>
<div class="vc-banner"><img src="/static/img/vc-banner.png?v=__V__" alt="Cùng mình ôn tập nhé"></div>
<div class="vc-nav">
  <button type="button" class="vc-pill" onclick="homeShow()">🏠 Trang chủ</button>
  <span class="vc-pill">👤 Người viết phần mềm <b>Lê Đắc Đạt</b></span>
  <span class="vc-pill">📞 0865291703</span>
  <span class="vc-pill">📊 LƯỢT TRUY CẬP <b id="vc-visits">000000</b></span>
  <button type="button" class="vc-pill" onclick="openAdm()">⚙️ Quản lý tài khoản</button>
  <button type="button" class="vc-pill" onclick="vcBell()">🔔 Người truy cập <span class="vc-badge" id="vc-bellbadge" style="display:none"></span></button>
  <button type="button" class="vc-pill" onclick="vcUser()">👨‍🏫 <span id="vc-username">Tài khoản</span> ▾</button>
</div>
<div class="vc-main">
  <div class="vc-rail">
    <div class="vc-card">
      <h3>🎓 Giáo viên ôn VC – Luật Viên chức</h3>
      <p class="vc-muted" id="vcStat">Đang tải ngân hàng câu hỏi…</p>
      <label class="vc-fl">📚 Chọn chương:</label>
      <div id="vcChaps"></div>
      <label class="vc-fl">Số câu
        <select id="vcNum"><option value="10">10 câu</option><option value="20">20 câu</option><option value="30">30 câu</option><option value="0">Tất cả</option></select>
      </label>
      <button class="vc-start" type="button" onclick="vcStart()">▶ Bắt đầu luyện</button>
      <label class="vc-chk"><input type="checkbox" id="vcShuffleChk" checked> 🔀 Đảo toàn bộ câu hỏi</label>
      <label class="vc-chk"><input type="checkbox" id="vcBrowseChk" onchange="vcBrowseChk(this.checked)"> 📖 Xem toàn bộ câu hỏi</label>
      <p class="vc-muted" id="vcBest"></p>
    </div>
  </div>
  <div class="vc-stage">
    <div class="vc-card" id="vcIntro">
      <div class="vc-hero">
        <div class="vc-hero-text">
          <span class="vc-kicker">🎓 LUYỆN THI HIỆU QUẢ</span>
          <h2>Sẵn sàng ôn thi chưa, <span class="vc-gold">thầy cô?</span></h2>
          <p>Chọn chương và số câu ở cột bên trái rồi bấm <b>Bắt đầu luyện</b> — câu hỏi hiện ra ngay tại bảng này. Chọn đáp án là <b>chấm ngay</b>, có giải thích theo điều luật. Cuối lượt có <b>tổng kết chấm điểm</b> và danh sách câu sai để ôn lại.</p>
          <div class="vc-chips">
            <span>📄 Câu hỏi bám sát nội dung luật</span>
            <span>⚡ Chấm ngay sau khi trả lời</span>
            <span>📖 Giải thích chi tiết theo điều luật</span>
            <span>📊 Tổng kết điểm và ôn lại câu sai</span>
          </div>
        </div>
        <img class="vc-hero-img" src="/static/img/vc-hero.png?v=__V__" alt="Giáo viên đang ôn thi">
      </div>
      <div class="vc-tablehead"><span>📚 Ngân hàng câu hỏi theo chương</span><span class="vc-total">Tổng cộng: 87 câu · 6 chương</span></div>
      <div id="vcChapList"><p class="vc-muted">Đang tải…</p></div>
    </div>
    <div class="vc-card hide" id="vcQuizCard">
      <div style="margin:-18px -18px 14px;padding:12px 18px;background:linear-gradient(90deg,#2563eb,#0ea5e9);color:#fff;font-weight:800;letter-spacing:.4px">📝 BẢNG LUYỆN TRẮC NGHIỆM · LUẬT VIÊN CHỨC</div>
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:17px"><b id="vcProg"></b><span class="vc-muted" id="vcScore"></span></div>
      <div style="height:8px;background:#e5e7eb;border-radius:99px;overflow:hidden;margin:8px 0 14px"><div id="vcBar" style="height:100%;width:0%;background:#2563eb;transition:width .3s"></div></div>
      <div id="vcQBox"></div>
    </div>
    <div class="vc-card hide" id="vcListCard"><h3 style="margin-top:0">📖 Toàn bộ câu hỏi &amp; đáp án</h3><div id="vcList"></div></div>
  </div>
</div>
</div>
<script>
/* Ôn VC mới — overlay full-screen, dùng lại bộ máy cũ qua đúng các id vc* */
function vcEl(id){return document.getElementById(id);}
function vcShow(){
  if(typeof etHide==="function")etHide();
  if(typeof ttsHide==="function")ttsHide();
  if(typeof vaHide==="function")vaHide();if(typeof cvHide==="function")cvHide();
  ["p1","p2","p3","p4","p5","p8","p9","p10","p11","p12","p13"].forEach(function(id){var e=vcEl(id);if(e)e.classList.add("hide");});
  var hv=vcEl("homeView");if(hv)hv.classList.add("hide");
  var b=vcEl("bot");if(b)b.style.display="none";
  var v2=vcEl("vcView");if(v2)v2.style.display="block";
  var un=vcEl("uname");var nm=(un&&un.textContent||"").trim();
  var u2=vcEl("vc-username");if(u2)u2.textContent=nm||"Tài khoản";
  if(typeof hmGet==="function"){hmGet("/api/visits/total").then(function(t){var e=vcEl("vc-visits");if(e&&t)e.textContent=String(+t.total||0).padStart(6,"0");});}
  if(typeof hmBellBadge==="function"){try{hmBellBadge();}catch(e){}setTimeout(function(){var hb=vcEl("hmbadge");var vb=vcEl("vc-bellbadge");if(hb&&vb&&!hb.classList.contains("hide")){vb.textContent=(hb.textContent||"").trim();vb.style.display="inline-grid";}},1200);}
  if(window.vcInit)vcInit();
  scrollTo(0,0);
}
function vcHide(){var v=vcEl("vcView");if(v)v.style.display="none";}
/* Bấm chuông / tên người dùng trên màn hình ôn VC: về trang chủ rồi bấm đúng nút thật ở đó */
function vcBell(){vcHide();homeShow();setTimeout(function(){var b=document.querySelector("#homeView .hm-iconbtn");if(b)b.click();},80);}
function vcUser(){vcHide();homeShow();setTimeout(function(){var b=document.querySelector("#homeView .hm-userwrap .hm-pill");if(b)b.click();},80);}
/* Ô "Xem toàn bộ câu hỏi": đồng bộ với trạng thái thật của bảng danh sách (vcBrowse chỉ bật/tắt) */
function vcBrowseChk(on){
  var lc=vcEl("vcListCard");if(!lc)return;
  var showing=!lc.classList.contains("hide");
  if(on&&!showing)vcBrowse();
  if(!on&&showing){vcBrowse();var it=vcEl("vcIntro");if(it)it.classList.remove("hide");}
  var chk=vcEl("vcBrowseChk");if(chk)chk.checked=!vcEl("vcListCard").classList.contains("hide");
}
/* Bấm hàng chương trong bảng: chọn chương đó (nút chương sáng lên theo) */
document.addEventListener("click",function(e){
  var row=e.target.closest&&e.target.closest("#vcChapList>div");
  if(!row)return;
  var b=row.querySelector("b");
  if(b&&window.vcSetChap)vcSetChap(b.textContent.trim());
});
</script>

<div id="cvView" style="display:none">
<style>
#cvView{position:fixed;inset:0;z-index:40;overflow-y:auto;background:linear-gradient(180deg,#071233 0%,#04081a 38%,#02040f 100%);font-family:"Segoe UI",system-ui,-apple-system,sans-serif;color:#eaf2ff}
#cvView .cv-top{display:flex;align-items:center;gap:14px;padding:14px 20px;background:#071233;border-bottom:1px solid #1b2f5e;position:sticky;top:0;z-index:3}
#cvView .cv-back{border:1px solid #33507e;background:#0f2247;color:#dbe7ff;border-radius:99px;padding:9px 18px;font-weight:800;font-size:14px;cursor:pointer;white-space:nowrap}
#cvView .cv-toptitle{font-size:22px;font-weight:900;color:#f5c542}
#cvView .cv-page{max-width:1240px;margin:0 auto;padding:0 16px 48px}
#cvView .cv-prof{display:flex;flex-wrap:wrap;gap:10px;align-items:center;background:#0a1734;border:1px solid #1b2f5e;border-radius:14px;padding:12px 16px;margin:16px 0}
#cvView .cv-prof b{color:#fff}
#cvView .cv-prof input{background-color:#071233!important;border:1px solid #33507e;color:#eaf2ff!important;border-radius:9px;padding:8px 12px;font-size:14px;min-width:200px}
#cvView .cv-btn{border:0;border-radius:12px;padding:9px 16px;font-weight:800;cursor:pointer;font-size:14px;transition:transform .12s ease,filter .12s ease;box-shadow:0 3px 10px rgba(0,0,0,.35)}
#cvView .cv-btn:hover{filter:brightness(1.12);transform:translateY(-1px)}
#cvView .cv-btn.blue{background:linear-gradient(180deg,#1a86f2,#0b5fc0);color:#fff}
#cvView .cv-btn.gold{background:linear-gradient(180deg,#ffd964,#f0b429);color:#231600}
#cvView .cv-btn.ghost{background:#0f2247;color:#dbe7ff;border:1px solid #33507e}
#cvView .cv-btn.small{padding:6px 12px;font-size:13px}
#cvView .cv-btn:disabled{opacity:.5;cursor:default}
#cvView img.cv-block{width:100%;height:auto;display:block}
#cvView .cv-hot{position:relative}
#cvView .cv-hot button.hs{position:absolute;border:0;background:transparent;cursor:pointer;padding:0}
#cvView .cv-hot button.hs:focus-visible{outline:2px solid #f5c542;outline-offset:-2px}
#cvView .cv-hot button.hs:hover{box-shadow:inset 0 0 0 2px rgba(245,197,66,.45);border-radius:14px}
#cvView .cv-bar{margin:30px 0 14px}
#cvView .cv-bar img{width:100%;height:auto;display:block}
#cvView .cv-panel{background:linear-gradient(180deg,#0c1d42,#0a1734);border:1px solid #233c6e;border-radius:18px;padding:18px 20px;box-shadow:0 10px 26px rgba(0,0,0,.35)}
#cvView .cv-scroll{overflow-x:auto}
#cvView .cv-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:700px){#cvView .cv-stats{grid-template-columns:1fr 1fr}}
#cvView .cv-stat{background:linear-gradient(180deg,#0e2149,#0a1734);border:1px solid #233c6e;border-radius:18px;padding:16px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,.3);transition:transform .12s ease}
#cvView .cv-stat:hover{transform:translateY(-2px)}
#cvView .cv-stat b{font-size:26px;color:#f5c542;display:block}
#cvView .cv-stat span{color:#9fb4d8;font-size:13.5px}
#cvView table.cv-tbl{width:100%;border-collapse:collapse;min-width:640px;font-size:14.5px}
#cvView table.cv-tbl th{color:#8fa6c0;font-size:12.5px;text-align:left;padding:8px 10px;border-bottom:2px solid #1b2f5e}
#cvView table.cv-tbl td{padding:11px 10px;border-bottom:1px solid #13224a;color:#dbe7ff!important;background:#0a1730!important;vertical-align:middle}
#cvView table.cv-tbl tbody tr{background:#0a1730!important}
#cvView table.cv-tbl td small{color:#8fa6c0}
#cvView table.cv-tbl tbody tr:hover td{background:rgba(245,197,66,.06)}
#cvView .cv-pill{display:inline-block;border-radius:99px;padding:3px 11px;font-size:12.5px;font-weight:800;white-space:nowrap}
#cvView .cv-pill.blue{background:#123a6b;color:#7cc0ff}
#cvView .cv-pill.red{background:#4a1220;color:#ff8fa0}
#cvView .cv-pill.gold{background:#4a3410;color:#ffcf5c}
#cvView .cv-pill.green{background:#0d3a24;color:#5ee8a0}
#cvView .cv-pill.orange{background:#4a2a08;color:#ffb45e}
#cvView .cv-pill.grey{background:#1c2740;color:#9fb4d8}
#cvView .cv-form{display:flex;flex-wrap:wrap;gap:10px;align-items:end;margin:12px 0}
#cvView .cv-form label{font-size:13px;color:#9fb4d8;display:block;margin-bottom:4px}
#cvView .cv-form select,#cvView .cv-form input[type=text],#cvView .cv-form input[type=password]{background-color:#071233!important;border:1px solid #33507e;color:#eaf2ff!important;border-radius:9px;padding:9px 12px;font-size:14px}
#cvView .cv-opt{display:inline-flex;flex-direction:column;align-items:center;gap:2px;border:2px solid #33507e;background:#0f2247;color:#dbe7ff;border-radius:14px;padding:11px 16px;cursor:pointer;font-size:14px;font-weight:700;min-width:104px}
#cvView .cv-opt small{color:#9fb4d8;font-weight:400;font-size:12px}
#cvView .cv-opt.on{border-color:#f5c542;background:#2a2100;color:#ffd964;box-shadow:0 0 0 2px rgba(245,197,66,.25)}
#cvView .cv-opt.on small{color:#e8c86a}
#cvView .cv-theme{width:104px;border:2px solid #33507e;border-radius:14px;overflow:hidden;cursor:pointer;padding:0;background:#0f2247}
#cvView .cv-theme img{width:100%;height:62px;object-fit:cover;display:block}
#cvView .cv-theme span{display:block;text-align:center;font-size:12.5px;font-weight:700;color:#dbe7ff;padding:5px 2px 7px}
#cvView .cv-theme.on{border-color:#f5c542;box-shadow:0 0 0 2px rgba(245,197,66,.3)}
#cvView .cv-grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;align-items:start}
@media(max-width:900px){#cvView .cv-grid3{grid-template-columns:1fr}}
#cvView .cv-grid2{display:grid;grid-template-columns:1.4fr 1fr;gap:16px;align-items:start}
@media(max-width:900px){#cvView .cv-grid2{grid-template-columns:1fr}}
#cvView .cv-boardwrap{display:grid;grid-template-columns:300px minmax(0,560px) 1fr;gap:20px;align-items:start}
@media(max-width:1000px){#cvView .cv-boardwrap{grid-template-columns:1fr}}
#cvView .cv-board{width:100%;aspect-ratio:1;display:grid;grid-template-columns:repeat(8,1fr);grid-template-rows:repeat(8,1fr);border:4px solid #6b4a26;border-radius:12px;overflow:hidden;user-select:none;box-shadow:0 20px 44px rgba(0,0,0,.6)}
#cvView .cv-sq{display:flex;align-items:center;justify-content:center;font-size:clamp(26px,5.4vw,52px);cursor:pointer;position:relative;line-height:1}
#cvView .cv-sq.light{background:#f0d9b5}
#cvView .cv-sq.dark{background:#b58863}
#cvView .cv-board[data-theme="space"] .cv-sq.light{background:#c7d6f5}
#cvView .cv-board[data-theme="space"] .cv-sq.dark{background:#3b5a8a}
#cvView .cv-board[data-theme="gold"] .cv-sq.light{background:#f6e3a1}
#cvView .cv-board[data-theme="gold"] .cv-sq.dark{background:#8a6a1f}
#cvView .cv-board[data-theme="ice"] .cv-sq.light{background:#eef7ff}
#cvView .cv-board[data-theme="ice"] .cv-sq.dark{background:#7fb2d9}
#cvView .cv-board[data-theme="dark"] .cv-sq.light{background:#9aa3ad}
#cvView .cv-board[data-theme="dark"] .cv-sq.dark{background:#3a3f47}
#cvView .cv-board[data-theme="crystal"] .cv-sq.light{background:#e6dcf7}
#cvView .cv-board[data-theme="crystal"] .cv-sq.dark{background:#7b5ea7}
#cvView .cv-sq.sel{box-shadow:inset 0 0 0 4px #f5c542}
#cvView .cv-sq.last{box-shadow:inset 0 0 0 4px rgba(245,197,66,.55)}
#cvView .cv-sq.chk{box-shadow:inset 0 0 0 4px #ef4444}
#cvView .cv-sq .dot{position:absolute;width:26%;height:26%;border-radius:50%;background:rgba(20,80,20,.45)}
#cvView .cv-sq .ring{position:absolute;width:88%;height:88%;border-radius:50%;border:4px solid rgba(20,80,20,.5)}
#cvView .cv-pc-w{color:#ffffff;text-shadow:0 2px 3px #000,0 0 2px #000,0 4px 6px rgba(0,0,0,.6)}
#cvView .cv-pc-b{color:#16162a;text-shadow:0 0 3px rgba(255,255,255,.7)}
#cvView .cv-coord{position:absolute;font-size:11px;font-weight:900;line-height:1;pointer-events:none}
#cvView .cv-coord.br{right:3px;bottom:2px}
#cvView .cv-coord.tl{left:3px;top:2px}
#cvView .cv-sq.light .cv-coord{color:#b58863}
#cvView .cv-sq.dark .cv-coord{color:#f0d9b5}
#cvView .cv-board[data-theme="space"] .cv-sq.light .cv-coord{color:#3b5a8a}
#cvView .cv-board[data-theme="space"] .cv-sq.dark .cv-coord{color:#c7d6f5}
#cvView .cv-board[data-theme="ice"] .cv-sq.light .cv-coord{color:#7fb2d9}
#cvView .cv-board[data-theme="ice"] .cv-sq.dark .cv-coord{color:#eef7ff}
#cvView .cv-clock{font-size:22px;font-weight:900;color:#f5c542;font-variant-numeric:tabular-nums;background:#0f2247;border:1px solid #33507e;border-radius:10px;padding:4px 12px}
#cvView .cv-clock.low{color:#ef4444}
#cvView .cv-moves{font-size:14px;line-height:1.9;color:#dbe7ff;max-height:280px;overflow-y:auto;background:#081233;border:1px solid #1b2f5e;border-radius:12px;padding:12px 14px}
#cvView .cv-moves b{color:#fff}
#cvView .cv-promo{display:flex;gap:10px;margin:10px 0}
#cvView .cv-promo button{font-size:30px;width:56px;height:56px;border-radius:12px;border:2px solid #f5c542;background:#0f2247;color:#fff;cursor:pointer}
#cvView .cv-pod{display:grid;grid-template-columns:1fr 1.2fr 1fr;gap:14px;align-items:end}
#cvView .cv-podc{border-radius:16px;padding:18px 12px;text-align:center}
#cvView .cv-podc.first{background:linear-gradient(180deg,#4a3900,#1c1500);border:1px solid #f5c542;transform:scale(1.04);box-shadow:0 14px 30px rgba(245,197,66,.25)}
#cvView .cv-podc.second{background:#0f2247;border:1px solid #33507e}
#cvView .cv-podc.third{background:#2a1a08;border:1px solid #8a5a1e}
#cvView .cv-rankrow{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:11px 6px;border-bottom:1px solid #13224a;font-size:15px}
#cvView .cv-rankrow b{color:#fff}
#cvView .cv-foot{color:#8299b4;font-size:13px;text-align:center;margin-top:28px}
#cvView .cv-sec{display:none}
#cvView .cv-sec.on{display:block}
#cvView h3.cv-h{font-size:19px;margin:4px 0 10px}
#cvView .cv-mut{color:#9fb4d8;font-size:14px}
#cvView .cv-goldtitle{font-size:30px;font-weight:900;color:#f5c542;letter-spacing:.3px}
#cvView .cv-subtitle{color:#9fb4d8;font-size:15px;margin-top:2px}
#cvView .cv-chat{max-height:260px;overflow-y:auto;background:#081233;border:1px solid #1b2f5e;border-radius:12px;padding:10px 12px;font-size:14px}
#cvView .cv-chat div{margin-bottom:8px}
#cvView .cv-chat b{color:#ffd964}
#cvView .cv-avatar{width:44px;height:44px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-weight:900;font-size:19px;background:linear-gradient(135deg,#1a86f2,#0b5fc0);color:#fff;flex:none}
#cvView #cvOppName,#cvView #cvMySideName{font-weight:800;background:#0f2247;border:1px solid #33507e;border-radius:99px;padding:7px 14px;font-size:14.5px}
#cvView .cv-spin{width:54px;height:54px;border-radius:50%;border:5px solid #1b2f5e;border-top-color:#f5c542;animation:cvspin 1s linear infinite;margin:0 auto}
@keyframes cvspin{to{transform:rotate(360deg)}}
#cvView .cv-donut{width:120px;height:120px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto}
#cvView .cv-donut span{background:#0a1734;border-radius:50%;width:86px;height:86px;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:22px;color:#f5c542}
</style>
<div class="cv-top"><button type="button" class="cv-back" onclick="cvBack()">← Trang chủ</button><span class="cv-toptitle">👑 Đấu Trường Cờ Vua</span></div>
<div class="cv-page">
  <div class="cv-prof">
    <span>👤 <b id="cvMyName">…</b></span><span id="cvMyStats" class="cv-mut"></span>
    <span style="flex:1"></span>
    <input id="cvSchool" type="text" maxlength="60" placeholder="Tên trường / đội của bạn">
    <button type="button" class="cv-btn gold small" onclick="cvSaveSchool()">Lưu trường</button>
  </div>

  <!-- TRANG CHỦ ĐẤU TRƯỜNG -->
  <div class="cv-sec on" id="cvSecHome">
    <div class="cv-hot"><img class="cv-block" src="/static/img/cv-nav-buttons.png?v=__V__" alt="Menu đấu trường">
      <button type="button" class="hs" style="left:0.7%;width:17.7%;top:7.7%;height:85.2%" aria-label="Trang chủ đấu trường" onclick="cvNav('home')"></button>
      <button type="button" class="hs" style="left:19.2%;width:15%;top:7.7%;height:85.2%" aria-label="Thi đấu" onclick="cvNav('rooms')"></button>
      <button type="button" class="hs" style="left:35%;width:15.4%;top:7.7%;height:85.2%" aria-label="Giải đấu" onclick="cvNav('tours')"></button>
      <button type="button" class="hs" style="left:51.3%;width:14.7%;top:7.7%;height:85.2%" aria-label="Học cờ" onclick="cvNav('learn')"></button>
      <button type="button" class="hs" style="left:66.8%;width:17.9%;top:7.7%;height:85.2%" aria-label="Cộng đồng" onclick="cvNav('community')"></button>
      <button type="button" class="hs" style="left:85.5%;width:13.7%;top:7.7%;height:85.2%" aria-label="Tin tức" onclick="cvNav('news')"></button>
    </div>
    <img class="cv-block" src="/static/img/cv-nav-search.png?v=__V__" alt="Tìm kiếm, thông báo, tài khoản">
    <img class="cv-block" src="/static/img/cv-hero.png?v=__V__" alt="Đấu Trường Cờ Vua — Trí tuệ dẫn lối vinh quang">
    <div class="cv-hot"><img class="cv-block" src="/static/img/cv-actions.png?v=__V__" alt="Bắt đầu chinh phục, Đấu nhanh, Tạo phòng cờ, Vào phòng, Bảng xếp hạng">
      <button type="button" class="hs" style="left:29.4%;width:41.2%;top:1.4%;height:16.6%" aria-label="Bắt đầu chinh phục" onclick="cvNav('quick')"></button>
      <button type="button" class="hs" style="left:0.7%;width:48.6%;top:24.7%;height:35.4%" aria-label="Đấu nhanh" onclick="cvNav('quick')"></button>
      <button type="button" class="hs" style="left:50.7%;width:48.5%;top:24.7%;height:35.4%" aria-label="Tạo phòng cờ" onclick="cvNav('create')"></button>
      <button type="button" class="hs" style="left:0.7%;width:48.6%;top:63.3%;height:35%" aria-label="Vào phòng" onclick="cvNav('rooms')"></button>
      <button type="button" class="hs" style="left:50.6%;width:48.6%;top:63.3%;height:35%" aria-label="Bảng xếp hạng" onclick="cvNav('community')"></button>
    </div>
    <div class="cv-stats" id="cvHomeStats" style="margin-top:18px"></div>
    <div class="cv-bar"><img src="/static/img/cv-bar-che-do.png?v=__V__" alt="Chế độ chơi nổi bật"></div>
    <div class="cv-hot"><img class="cv-block" src="/static/img/cv-modes.png?v=__V__" alt="Cờ nhanh, Cờ chớp, Cờ tiêu chuẩn, Đấu với AI, Luyện chiến thuật, Học khai cuộc">
      <button type="button" class="hs" style="left:0.8%;width:32.3%;top:2.9%;height:44.6%" aria-label="Cờ nhanh" onclick="cvNav('quick','nhanh')"></button>
      <button type="button" class="hs" style="left:34.6%;width:30.7%;top:2.9%;height:44.6%" aria-label="Cờ chớp" onclick="cvNav('quick','chop')"></button>
      <button type="button" class="hs" style="left:66.8%;width:32.4%;top:2.9%;height:44.6%" aria-label="Cờ tiêu chuẩn" onclick="cvNav('quick','tieuchuan')"></button>
      <button type="button" class="hs" style="left:0.8%;width:32.3%;top:52.3%;height:44.8%" aria-label="Đấu với AI" onclick="cvNav('ai')"></button>
      <button type="button" class="hs" style="left:34.6%;width:30.7%;top:52.3%;height:44.8%" aria-label="Luyện chiến thuật" onclick="cvNav('learn','tactics')"></button>
      <button type="button" class="hs" style="left:66.8%;width:32.4%;top:52.3%;height:44.8%" aria-label="Học khai cuộc" onclick="cvNav('learn','openings')"></button>
    </div>
    <div class="cv-grid3" style="margin-top:22px">
      <div>
        <div class="cv-bar" style="margin-top:0"><img src="/static/img/cv-bar-phong.png?v=__V__" alt="Phòng cờ đang mở"></div>
        <div class="cv-panel cv-scroll"><table class="cv-tbl" id="cvHomeRooms"><tr><td class="cv-mut">Đang tải phòng…</td></tr></table></div>
      </div>
      <div>
        <div class="cv-bar" style="margin-top:0"><img src="/static/img/cv-bar-giai.png?v=__V__" alt="Giải đấu nổi bật"></div>
        <div class="cv-panel" id="cvHomeTour"><p class="cv-mut">Đang tải giải…</p></div>
      </div>
      <div>
        <div class="cv-bar" style="margin-top:0"><img src="/static/img/cv-bar-vinh-danh.png?v=__V__" alt="Bảng vinh danh hôm nay"></div>
        <div class="cv-panel" id="cvHomeBoard"><p class="cv-mut">Đang tải bảng…</p></div>
      </div>
    </div>
  </div>

  <!-- TẠO PHÒNG -->
  <div class="cv-sec" id="cvSecCreate">
    <img class="cv-block" src="/static/img/cv-hero-taophong.png?v=__V__" alt="Tạo phòng cờ — Tùy chỉnh trận đấu theo phong cách của bạn" style="border-radius:0 0 18px 18px">
    <div class="cv-grid2" style="margin-top:18px">
      <div class="cv-panel">
        <h3 class="cv-h">👥 Thiết lập phòng cờ</h3>
        <p class="cv-mut">Tùy chỉnh các thông số để tạo phòng cờ theo ý muốn.</p>
        <div class="cv-form"><div style="flex:1;min-width:240px"><label>Tên phòng cờ *</label><input id="cvCrName" type="text" maxlength="50" placeholder="VD: Giao lưu cuối tuần" style="width:100%"><div class="cv-mut" style="text-align:right"><span id="cvCrCount">0</span>/50</div></div></div>
        <div style="margin:14px 0"><label style="font-size:13px;color:#9fb4d8;display:block;margin-bottom:6px">Loại phòng *</label>
          <button type="button" class="cv-opt on" data-cr-type="casual" onclick="cvCrPick('type','casual',this)">⚔️ Đấu thường<small>Chơi tự do, không tính rank</small></button>
          <button type="button" class="cv-opt" data-cr-type="ranked" onclick="cvCrPick('type','ranked',this)">🏆 Đấu xếp hạng<small>Tính điểm xếp hạng</small></button>
          <button type="button" class="cv-opt" data-cr-type="practice" onclick="cvCrPick('type','practice',this)">🎓 Tập luyện<small>Rèn luyện kỹ năng</small></button>
        </div>
        <div style="margin:14px 0"><label style="font-size:13px;color:#9fb4d8;display:block;margin-bottom:6px">Thời gian *</label>
          <button type="button" class="cv-opt on" data-cr-time="5|0" onclick="cvCrPick('time','5|0',this)">5 phút<small>5+0</small></button>
          <button type="button" class="cv-opt" data-cr-time="10|0" onclick="cvCrPick('time','10|0',this)">10 phút<small>10+0</small></button>
          <button type="button" class="cv-opt" data-cr-time="15|0" onclick="cvCrPick('time','15|0',this)">15 phút<small>15+0</small></button>
          <button type="button" class="cv-opt" data-cr-time="30|0" onclick="cvCrPick('time','30|0',this)">30 phút<small>30+0</small></button>
          <button type="button" class="cv-opt" data-cr-time="custom" onclick="cvCrPick('time','custom',this)">⚙️ Tùy chỉnh<small>Chọn phút + cộng giờ</small></button>
          <div class="cv-form" id="cvCrCustom" style="display:none">
            <div><label>Phút mỗi bên</label><select id="cvCrMin"><option value="1">1</option><option value="3">3</option><option value="5">5</option><option value="10" selected>10</option><option value="15">15</option><option value="30">30</option><option value="60">60</option></select></div>
            <div><label>Cộng giờ mỗi nước (giây)</label><select id="cvCrInc"><option value="0" selected>0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="5">5</option><option value="10">10</option><option value="30">30</option></select></div>
          </div>
        </div>
        <div style="margin:14px 0"><label style="font-size:13px;color:#9fb4d8;display:block;margin-bottom:6px">Số người chơi *</label>
          <button type="button" class="cv-opt on">👥 2 người<small>Cờ vua đấu 2 người</small></button>
          <p class="cv-mut" style="margin-top:6px">Phòng 4–8 người là thể thức đội, sẽ mở ở bản sau.</p>
        </div>
        <div style="margin:14px 0"><label style="font-size:13px;color:#9fb4d8;display:block;margin-bottom:6px">Quyền riêng tư *</label>
          <button type="button" class="cv-opt on" data-cr-priv="public" onclick="cvCrPick('priv','public',this)">🌐 Công khai<small>Ai cũng có thể tham gia</small></button>
          <button type="button" class="cv-opt" data-cr-priv="friends" onclick="cvCrPick('priv','friends',this)">👥 Bạn bè<small>Chỉ hiện ở tab Bạn bè</small></button>
          <button type="button" class="cv-opt" data-cr-priv="private" onclick="cvCrPick('priv','private',this)">🔒 Riêng tư<small>Cần mật khẩu để vào</small></button>
        </div>
        <div class="cv-form" id="cvCrPwRow" style="display:none"><div style="flex:1;min-width:240px"><label>Mật khẩu phòng</label><input id="cvCrPw" type="password" maxlength="40" placeholder="Nhập mật khẩu (bắt buộc với phòng riêng tư)" style="width:100%"></div></div>
        <div style="margin:14px 0"><label style="font-size:13px;color:#9fb4d8;display:block;margin-bottom:6px">Chủ đề bàn cờ</label>
          <div style="display:flex;flex-wrap:wrap;gap:10px" id="cvCrThemes"></div>
        </div>
        <button type="button" class="cv-btn gold" style="width:100%;font-size:18px;padding:14px;margin-top:8px" onclick="cvCreateRoomFull()">♟️ TẠO PHÒNG</button>
      </div>
      <div>
        <div class="cv-panel">
          <h3 class="cv-h">👁️ Xem trước phòng cờ</h3>
          <p class="cv-mut">Đây là giao diện phòng cờ sau khi tạo.</p>
          <div id="cvCrPreview"></div>
        </div>
        <div class="cv-panel" style="margin-top:16px">
          <h3 class="cv-h">👥 Mời bạn bè tham gia</h3>
          <p class="cv-mut">Chọn bạn bè để mời vào phòng cờ.</p>
          <div id="cvCrFriends"><p class="cv-mut">Tạo phòng trước, rồi gửi mã phòng cho bạn bè nhé.</p></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ĐẤU NHANH -->
  <div class="cv-sec" id="cvSecQuick">
    <img class="cv-block" src="/static/img/cv-hero-daunhanh.png?v=__V__" alt="Đấu nhanh — Tìm đối thủ, bắt đầu trận đấu ngay" style="border-radius:0 0 18px 18px">
    <div class="cv-grid3" style="margin-top:18px">
      <div class="cv-panel">
        <h3 class="cv-h">⚡ Chọn chế độ đấu</h3>
        <p class="cv-mut">Ba chế độ kinh điển — phù hợp mọi phong cách.</p>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px">
          <button type="button" class="cv-opt on" style="align-items:flex-start;text-align:left" data-q-mode="chop" onclick="cvQPick('chop',this)">🔥 Cờ chớp<small>Ván đấu tốc độ cao · 1 phút + 1 giây</small></button>
          <button type="button" class="cv-opt" style="align-items:flex-start;text-align:left" data-q-mode="nhanh" onclick="cvQPick('nhanh',this)">⚡ Cờ nhanh<small>Cân bằng giữa tốc độ và tư duy · 10 phút + 5 giây</small></button>
          <button type="button" class="cv-opt" style="align-items:flex-start;text-align:left" data-q-mode="tieuchuan" onclick="cvQPick('tieuchuan',this)">🏰 Cờ tiêu chuẩn<small>Dành cho những nhà chiến lược · 30 phút + 30 giây</small></button>
        </div>
      </div>
      <div class="cv-panel" style="text-align:center">
        <h3 class="cv-h" id="cvQTitle">ĐANG TÌM ĐỐI THỦ</h3>
        <div id="cvQIdle">
          <p class="cv-mut">Hệ thống sẽ ghép cặp với kỳ thủ cùng chế độ.</p>
          <button type="button" class="cv-btn gold" style="font-size:18px;padding:14px 34px;margin-top:12px" onclick="cvQuickStart()">Tìm đối thủ ≫</button>
          <p class="cv-mut" style="margin-top:10px">Thời gian chờ ước tính: 5 – 15 giây (nếu có người cùng chờ).</p>
        </div>
        <div id="cvQSearching" style="display:none">
          <div class="cv-spin" style="margin-top:14px"></div>
          <p style="font-weight:800;margin-top:12px" id="cvQSearchText">Đang tìm đối thủ…</p>
          <p class="cv-mut" id="cvQRoomCode"></p>
          <button type="button" class="cv-btn ghost" style="margin-top:10px" onclick="cvQuickCancel()">Hủy tìm</button>
        </div>
      </div>
      <div>
        <div class="cv-panel">
          <h3 class="cv-h">📜 Luật thi đấu</h3>
          <p style="font-size:14px;line-height:1.8">• Thi đấu theo luật cờ vua quốc tế (FIDE).<br>• Hết giờ mà đối thủ còn đủ lực chiếu hết thì xử thua.<br>• Hòa: hết nước đi, không đủ lực, 50 nước, lặp lại 3 lần, hoặc hai bên đồng ý.<br>• Ván xếp hạng mới tính điểm bảng.</p>
        </div>
        <div class="cv-panel" style="margin-top:16px">
          <h3 class="cv-h">📊 Thống kê nhanh</h3>
          <div id="cvQStats"><p class="cv-mut">Đang tải…</p></div>
        </div>
      </div>
    </div>
    <div class="cv-panel" style="margin-top:16px">
      <h3 class="cv-h">🕘 Ván đấu gần đây</h3>
      <div id="cvQRecent"><p class="cv-mut">Đang tải…</p></div>
    </div>
  </div>

  <!-- VÀO PHÒNG -->
  <div class="cv-sec" id="cvSecRooms">
    <img class="cv-block" src="/static/img/cv-hero-vaophong.png?v=__V__" alt="Vào phòng — Gia nhập những trận đấu đỉnh cao" style="border-radius:0 0 18px 18px">
    <div class="cv-panel" style="margin-top:18px">
      <div style="display:flex;gap:10px;flex-wrap:wrap">
