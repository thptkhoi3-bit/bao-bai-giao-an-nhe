        <div><label>Chế độ</label><select id="cvTourMode"><option value="nhanh">Cờ nhanh</option><option value="chop">Cờ chớp</option><option value="tieuchuan">Cờ tiêu chuẩn</option></select></div>
        <div><label>Đồng hồ</label><select id="cvTourClock"><option value="10">10 phút</option><option value="3">3 phút</option><option value="30">30 phút</option></select></div>
        <div><label>Tối đa</label><select id="cvTourMax"><option value="8">8 người</option><option value="16" selected>16 người</option><option value="32">32 người</option></select></div>
        <button type="button" class="cv-btn blue" onclick="cvCreateTour()">+ Tạo giải</button>
