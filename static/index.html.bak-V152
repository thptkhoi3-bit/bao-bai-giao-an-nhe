    <div id="cvLearnHeroOpenings" style="display:none"><img class="cv-block" src="/static/img/cv-hero-khaicuoc.png?v=__V__" alt="Học khai cuộc — Nền tảng cho mọi ván cờ vĩ đại" style="border-radius:0 0 18px 18px"></div>
    <div class="cv-panel" style="margin-top:16px">
