  <button type="button" id="bclr" title="Xoá cuộc trò chuyện" aria-label="Xoá cuộc trò chuyện" onclick="botClear()">🗑</button><button type="button" id="bcls" title="Đóng" aria-label="Đóng" onclick="botClose()">✕</button></div>
