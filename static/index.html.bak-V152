  </div>

  <!-- ĐẤU VỚI AI -->
  <div class="cv-sec" id="cvSecAI">
    <img class="cv-block" src="/static/img/cv-hero-dauai.png?v=__V__" alt="Đấu với AI — Thử thách trí tuệ, nâng tầm kỹ năng" style="border-radius:0 0 18px 18px">
    <div class="cv-grid3" style="margin-top:18px">
      <div class="cv-panel">
        <h3 class="cv-h">🎚️ Chọn cấp độ AI</h3>
        <p class="cv-mut">Mức ELO là ước lượng để tham khảo, không phải đo lường chính thức.</p>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px" id="cvAILevels"></div>
      </div>
      <div class="cv-panel">
        <h3 class="cv-h">⭐ Chọn cá tính AI</h3>
        <p class="cv-mut">Cá tính thay đổi cách máy chọn nước đi.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:12px" id="cvAIStyles"></div>
        <h3 class="cv-h" style="margin-top:18px">⚙️ Tùy chọn luyện tập</h3>
        <label style="display:flex;gap:8px;font-size:14px;margin:8px 0"><input type="checkbox" id="cvAIHint" checked> Hiển thị gợi ý nước đi trong ván</label>
        <label style="display:flex;gap:8px;font-size:14px;margin:8px 0"><input type="checkbox" id="cvAIFlip"> Tự lật bàn cờ theo lượt đi (ván chung máy)</label>
        <label style="display:flex;gap:8px;font-size:14px;margin:8px 0"><input type="checkbox" id="cvAIAnalysis" checked> Phân tích sau ván (hiển thị đánh giá cuối ván)</label>
        <button type="button" class="cv-btn gold" style="width:100%;font-size:18px;padding:14px;margin-top:12px" onclick="cvStartAISelected()">⚔️ BẮT ĐẦU ĐẤU AI</button>
        <h3 class="cv-h" style="margin-top:18px">📖 Khai cuộc gợi ý</h3>
        <div id="cvAISuggest"></div>
      </div>
      <div>
        <div class="cv-panel">
          <h3 class="cv-h">🤖 Thông tin AI</h3>
          <div id="cvAIInfo"><p class="cv-mut">Chọn cấp độ và cá tính để xem mô tả.</p></div>
        </div>
        <div class="cv-panel" style="margin-top:16px">
          <h3 class="cv-h">🏅 Thành tích với AI</h3>
          <p class="cv-mut">Lưu trên máy này (không đồng bộ tài khoản).</p>
          <div id="cvAIRecord" style="margin-top:10px"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="cv-foot">Đấu trường cờ vua — tài khoản người chơi dùng luôn tài khoản đăng ký web, không cần đăng ký riêng. Ván đấu với máy và ván chung máy không tính điểm bảng xếp hạng. Ván giải đấu hòa sẽ đánh lại ván mới. Phòng 4–8 người, giải thưởng mùa giải và bảng ELO theo tháng là tính năng bản sau.</div>
</div>
</div>
<script>
// Đấu trường cờ vua v2 — điều hướng, trang chủ, tạo phòng, đấu nhanh, sảnh phòng.
var CV_GLYPH = { K: '♚', Q: '♛', R: '♜', B: '♝', N: '♞', P: '♟', k: '♚', q: '♛', r: '♜', b: '♝', n: '♞', p: '♟' };
var CVA = {
  me: null, view: 'home', game: null, local: null, poll: null, clockT: null,
  roomT: null, sel: -1, targets: [], lastPoll: 0, claimedTO: false,
  tactic: null, opening: null, openingIdx: 0, tourDetail: null,
  cr: { type: 'casual', time: '5|0', priv: 'public', theme: 'classic' },
  q: { mode: 'chop', searching: null, searchT: null },
  rooms: [], roomTab: 'public', roomPage: 1, roomSel: null,
  ai: { level: 3, style: 'balanced' }, histPly: null
};
var CV_REASON = {
  checkmate: 'chiếu hết', resign: 'đầu hàng', timeout: 'hết giờ', stalemate: 'hết nước đi',
  insufficient: 'không đủ lực chiếu hết', fifty: 'luật 50 nước', threefold: 'lặp lại 3 lần',
  agreement: 'đồng ý hòa', 'timeout-draw': 'hết giờ nhưng không đủ lực chiếu hết'
};
var CV_THEMES = [
  { id: 'classic', name: 'Cổ điển', img: '/static/img/cv-theme-codien.png?v=__V__' },
  { id: 'space', name: 'Vũ trụ', img: '/static/img/cv-theme-vutru.png?v=__V__' },
  { id: 'gold', name: 'Rồng vàng', img: '/static/img/cv-theme-rongvang.png?v=__V__' },
  { id: 'ice', name: 'Băng tuyết', img: '/static/img/cv-theme-bangtuyet.png?v=__V__' },
  { id: 'dark', name: 'Hắc ám', img: '/static/img/cv-theme-hacam.png?v=__V__' },
  { id: 'crystal', name: 'Pha lê', img: '/static/img/cv-theme-phale.png?v=__V__' }
];
function cvToast(m) { if (typeof toast === 'function') toast(m); }
async function cvApi(path, method, body) {
  var opt = { method: method || 'GET', headers: { 'Content-Type': 'application/json' } };
  if (body) opt.body = JSON.stringify(body);
  var r = await fetch(path, opt);
  var j = await r.json().catch(function () { return {}; });
  if (r.status === 401) { cvToast('Phiên đăng nhập đã hết, mời thầy cô đăng nhập lại'); cvBack(); throw new Error('unauthorized'); }
  if (!r.ok) throw new Error((j && j.detail) || 'Có lỗi, thầy cô thử lại nhé');
  return j;
}
function cvFmt(ms) {
  ms = Math.max(0, Math.floor(ms / 1000));
  return Math.floor(ms / 60) + ':' + String(ms % 60).padStart(2, '0');
}
function cvEsc(s) {
  return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
  });
}
function cvModeName(m) { return { nhanh: 'Cờ nhanh', chop: 'Cờ chớp', tieuchuan: 'Cờ tiêu chuẩn' }[m] || m; }
function cvTypeName(t) { return { casual: 'Đấu thường', ranked: 'Đấu xếp hạng', practice: 'Tập luyện' }[t] || t; }
function cvStopTimers() {
  if (CVA.poll) { clearInterval(CVA.poll); CVA.poll = null; }
  if (CVA.clockT) { clearInterval(CVA.clockT); CVA.clockT = null; }
  if (CVA.roomT) { clearInterval(CVA.roomT); CVA.roomT = null; }
  if (CVA.q.searchT) { clearInterval(CVA.q.searchT); CVA.q.searchT = null; }
}
var CV_SEC_MAP = { home: 'cvSecHome', rooms: 'cvSecRooms', game: 'cvSecGame', tours: 'cvSecTours', learn: 'cvSecLearn', community: 'cvSecCommunity', news: 'cvSecNews', create: 'cvSecCreate', quick: 'cvSecQuick', ai: 'cvSecAI' };
function cvNav(view, sub) {
  CVA.view = view;
  document.querySelectorAll('#cvView .cv-sec').forEach(function (el) { el.classList.remove('on'); });
  var el = document.getElementById(CV_SEC_MAP[view] || 'cvSecHome');
  if (el) el.classList.add('on');
  var cv = document.getElementById('cvView');
  if (cv) cv.scrollTop = 0;
  cvStopTimers();
  if (view === 'home') cvLoadHome();
  if (view === 'rooms') { cvLoadRooms(); CVA.roomT = setInterval(cvLoadRooms, 8000); }
  if (view === 'create') cvCreateInit();
  if (view === 'quick') { if (sub) cvQPick(sub); cvQuickInit(); }
  if (view === 'tours') cvLoadTours();
  if (view === 'learn') cvLearnTab(sub === 'openings' ? 'openings' : 'tactics');
  if (view === 'community') cvLoadBoard();
  if (view === 'news') cvLoadNews();
  if (view === 'ai') cvAIInit();
}
function cvBackToRooms() { cvStopTimers(); cvNav('rooms'); }
async function cvLoadMe() {
  try {
    var me = await cvApi('/api/covua/me');
    CVA.me = me;
    document.getElementById('cvMyName').textContent = me.name;
    document.getElementById('cvMyStats').textContent =
      '· ' + me.w + ' thắng · ' + me.l + ' thua · ' + me.d + ' hòa · ' + me.points + ' điểm' +
      (me.school ? ' · 🏫 ' + me.school : ' · chưa đặt trường');
    document.getElementById('cvSchool').value = me.school || '';
  } catch (e) { /* chưa đăng nhập */ }
}
async function cvSaveSchool() {
  try {
    var s = document.getElementById('cvSchool').value;
    await cvApi('/api/covua/profile', 'POST', { school: s });
    cvToast('Đã lưu trường: ' + (s || '—'));
    cvLoadMe();
  } catch (e) { cvToast(e.message); }
}
// ---------- Trang chủ ----------
async function cvLoadHome() {
  try {
    var rooms = await cvApi('/api/covua/rooms');
    var lb = await cvApi('/api/covua/leaderboard');
    var tours = await cvApi('/api/covua/tours');
    var openRooms = rooms.rooms.filter(function (r) { return r.status === 'lobby'; }).length;
    var openTours = tours.tours.filter(function (t) { return t.status === 'open'; }).length;
    document.getElementById('cvHomeStats').innerHTML =
      '<div class="cv-stat"><b>' + lb.players.length + '</b><span>👥 Kỳ thủ có điểm</span></div>' +
      '<div class="cv-stat"><b>' + lb.recent.length + '</b><span>🎮 Ván gần đây</span></div>' +
      '<div class="cv-stat"><b>' + openRooms + '</b><span>🚪 Phòng đang mở</span></div>' +
      '<div class="cv-stat"><b>' + openTours + '</b><span>🏆 Giải đang mở đăng ký</span></div>';
    var list = rooms.rooms.slice(0, 5);
    document.getElementById('cvHomeRooms').innerHTML =
      '<tr><th>Tên phòng</th><th>Chế độ</th><th>Trạng thái</th><th></th></tr>' +
      (list.length ? list.map(function (r) {
        return '<tr><td><b>' + cvEsc(r.name) + '</b><br><small>' + cvEsc(r.host_name) + (r.code ? ' · Mã: ' + r.code : '') + '</small></td>' +
          '<td>' + cvModeName(r.mode) + ' · ' + r.clock + '+' + r.inc + '</td>' +
          '<td>' + (r.status === 'lobby' ? '<span class="cv-pill green">Đang chờ</span>' : '<span class="cv-pill orange">Đang chơi</span>') + '</td>' +
          '<td>' + (r.status === 'lobby'
            ? (r.mine ? '<button type="button" class="cv-btn gold small" data-code="' + r.code + '" onclick="cvMyRoom(this.dataset.code)">Phòng của bạn</button>' : (r.privacy === 'private'
              ? '<button type="button" class="cv-btn ghost small" onclick="cvNav(\'rooms\');cvRoomTab(\'private\')">Có mật khẩu</button>'
              : '<button type="button" class="cv-btn blue small" onclick="cvJoinRoom(\'' + r.code + '\')">Vào phòng</button>'))
            : (r.game_id ? '<button type="button" class="cv-btn ghost small" onclick="cvOpenGame(\'' + r.game_id + '\',true)">Xem ván</button>' : '')) + '</td></tr>';
      }).join('') : '<tr><td class="cv-mut" colspan="4">Chưa có phòng nào — thầy cô bấm “Tạo phòng” để mở phòng đầu tiên.</td></tr>');
    var ot = tours.tours.filter(function (t) { return t.status === 'open' || t.status === 'running'; })[0];
    document.getElementById('cvHomeTour').innerHTML = ot
      ? '<b>' + cvEsc(ot.name) + '</b><br><span class="cv-mut">' + cvModeName(ot.mode) + ' ' + ot.clock + ' phút · ' + ot.players + ' người · ' +
        (ot.status === 'open' ? 'Đang mở đăng ký' : 'Đang đấu') + '</span><br>' +
        '<button type="button" class="cv-btn gold small" style="margin-top:10px" onclick="cvNav(\'tours\');cvTourDetail(\'' + ot.id + '\')">Xem giải</button>'
      : '<p class="cv-mut">Chưa có giải nào đang mở — thầy cô tạo giải ở mục Giải đấu.</p>';
    var top = lb.players.slice(0, 5);
    document.getElementById('cvHomeBoard').innerHTML = top.length
      ? '<div class="cv-pod">' + [1, 0, 2].map(function (k) {
          var p = top[k];
          if (!p) return '<div></div>';
          var cls = k === 0 ? 'first' : (k === 1 ? 'second' : 'third');
          var medal = k === 0 ? '🥇' : (k === 1 ? '🥈' : '🥉');
          return '<div class="cv-podc ' + cls + '"><div style="font-size:30px">' + medal + '</div><div style="font-weight:800;margin-top:6px">' + cvEsc(p.name) + '</div><div style="color:#f5c542;font-weight:800;font-size:19px">' + p.points + '</div><div class="cv-mut">' + p.w + ' thắng · ' + p.d + ' hòa</div></div>';
        }).join('') + '</div>' +
        top.slice(3).map(function (p, i) {
          return '<div class="cv-rankrow"><span>' + (i + 4) + ' &nbsp; ' + cvEsc(p.name) + (p.school ? ' · ' + cvEsc(p.school) : '') + '</span><b>' + p.points + '</b></div>';
        }).join('')
      : '<p class="cv-mut">Chưa có ván đấu nào được tính điểm — đấu một ván xếp hạng là có tên trên bảng.</p>';
  } catch (e) { /* im lặng khi chưa tải được */ }
}
// ---------- Tạo phòng ----------
function cvCreateInit() {
  // Reset form về mặc định (tránh rò rỉ loại phòng/riêng tư/mật khẩu từ lần tạo trước)
  CVA.cr = { type: 'casual', time: '5|0', priv: 'public', theme: 'classic' };
  var nm0 = document.getElementById('cvCrName');
  if (nm0) nm0.value = '';
  var cnt0 = document.getElementById('cvCrCount');
  if (cnt0) cnt0.textContent = '0';
  var pw0 = document.getElementById('cvCrPw');
  if (pw0) pw0.value = '';
  document.getElementById('cvCrCustom').style.display = 'none';
  document.getElementById('cvCrPwRow').style.display = 'none';
  document.querySelectorAll('[data-cr-type]').forEach(function (b) { b.classList.toggle('on', b.dataset.crType === 'casual'); });
  document.querySelectorAll('[data-cr-time]').forEach(function (b) { b.classList.toggle('on', b.dataset.crTime === '5|0'); });
  document.querySelectorAll('[data-cr-priv]').forEach(function (b) { b.classList.toggle('on', b.dataset.crPriv === 'public'); });
  document.querySelectorAll('[data-theme]').forEach(function (b) { b.classList.toggle('on', b.dataset.theme === 'classic'); });
  var box = document.getElementById('cvCrThemes');
  if (box && !box.dataset.done) {
    box.dataset.done = '1';
    box.innerHTML = CV_THEMES.map(function (t) {
      return '<button type="button" class="cv-theme' + (t.id === 'classic' ? ' on' : '') + '" data-theme="' + t.id + '" onclick="cvCrPick(\'theme\',\'' + t.id + '\',this)"><img src="' + t.img + '" alt="' + t.name + '"><span>' + t.name + '</span></button>';
    }).join('');
  }
  var nm = document.getElementById('cvCrName');
  if (nm) nm.oninput = function () {
    document.getElementById('cvCrCount').textContent = nm.value.length;
    cvCrPreview();
  };
  cvCrPreview();
}
function cvCrPick(kind, val, btn) {
  if (kind === 'type') CVA.cr.type = val;
  if (kind === 'time') {
    CVA.cr.time = val;
    document.getElementById('cvCrCustom').style.display = val === 'custom' ? 'flex' : 'none';
  }
  if (kind === 'priv') {
    CVA.cr.priv = val;
    document.getElementById('cvCrPwRow').style.display = val === 'private' ? 'flex' : 'none';
  }
  if (kind === 'theme') CVA.cr.theme = val;
  var group = btn.parentElement;
  group.querySelectorAll('.cv-opt,.cv-theme').forEach(function (b) { b.classList.remove('on'); });
  btn.classList.add('on');
  cvCrPreview();
}
function cvCrTime() {
  if (CVA.cr.time === 'custom') {
    return { clock: parseInt(document.getElementById('cvCrMin').value, 10), inc: parseInt(document.getElementById('cvCrInc').value, 10) };
  }
  var parts = CVA.cr.time.split('|');
  return { clock: parseInt(parts[0], 10), inc: parseInt(parts[1], 10) };
}
function cvCrPreview() {
  var t = cvCrTime();
  var theme = CV_THEMES.filter(function (x) { return x.id === CVA.cr.theme; })[0];
  var name = (document.getElementById('cvCrName').value || '').trim() || 'Phòng của ' + (CVA.me ? CVA.me.name : 'bạn');
  document.getElementById('cvCrPreview').innerHTML =
    '<div style="background:#081233;border:1px solid #1b2f5e;border-radius:14px;padding:16px">' +
    '<div style="font-size:20px;font-weight:900">♛ ' + cvEsc(name) + '</div>' +
    '<div style="margin-top:8px;font-size:14px;line-height:1.9">⚔️ ' + cvTypeName(CVA.cr.type) + '<br>🕐 ' + cvModeName('nhanh') + ' · ' + t.clock + ' phút + ' + t.inc + ' giây<br>👥 2 người chơi<br>' +
    (CVA.cr.priv === 'public' ? '🌐 Công khai' : (CVA.cr.priv === 'friends' ? '👥 Bạn bè' : '🔒 Riêng tư (có mật khẩu)')) + '<br>🎨 Chủ đề: ' + theme.name + '</div>' +
    (theme ? '<img src="' + theme.img + '" style="width:100%;height:74px;object-fit:cover;border-radius:10px;margin-top:10px" alt="">' : '') + '</div>';
}
async function cvCreateRoomFull() {
  try {
    var t = cvCrTime();
    var body = {
      action: 'create', name: document.getElementById('cvCrName').value,
      type: CVA.cr.type, mode: 'nhanh', clock: t.clock, inc: t.inc,
      privacy: CVA.cr.priv, password: document.getElementById('cvCrPw').value,
      theme: CVA.cr.theme
    };
    // Chế độ theo thời gian: <5 chớp, <15 nhanh, còn lại tiêu chuẩn
    body.mode = t.clock < 5 ? 'chop' : (t.clock < 15 ? 'nhanh' : 'tieuchuan');
    var d = await cvApi('/api/covua/rooms', 'POST', body);
    cvToast('Đã tạo phòng' + (d.room.code ? ' mã ' + d.room.code : '') + ' — gửi mã này cho đối thủ.');
    if (CVA.cr.waitT) { clearInterval(CVA.cr.waitT); CVA.cr.waitT = null; }
    (function () {
      var wcode = d.room.code; var until = Date.now() + 10 * 60 * 1000;
      CVA.cr.waitT = setInterval(async function () {
        if (Date.now() > until) { clearInterval(CVA.cr.waitT); CVA.cr.waitT = null; return; }
        try {
          var rl = await cvApi('/api/covua/rooms');
          var rr = (rl.rooms || []).filter(function (x) { return x.code === wcode; })[0];
          if (rr && rr.game_id) {
            clearInterval(CVA.cr.waitT); CVA.cr.waitT = null;
            var vis = document.getElementById('cvView') && document.getElementById('cvView').style.display === 'block';
            if (vis) { cvToast('Đối thủ đã vào — bắt đầu đấu!'); cvOpenGame(rr.game_id, false); }
            else { cvToast('Đối thủ đã vào phòng ' + wcode + ' — mở Đấu trường Cờ vua để chơi!'); }
          }
        } catch (e) { /* chờ lần hỏi sau */ }
      }, 3000);
    })();
    var fr = document.getElementById('cvCrFriends');
    if (fr) {
      var lb = await cvApi('/api/covua/leaderboard');
      var others = lb.players.filter(function (p) { return !CVA.me || p.name !== CVA.me.name; }).slice(0, 5);
      fr.innerHTML = '<p style="font-size:14px">Mã phòng: <b style="color:#f5c542;font-size:18px">' + (d.room.code || '—') + '</b> ' +
        (d.room.privacy === 'private' ? '(phòng riêng tư — người vào cần cả mã và mật khẩu)' : '') + '</p>' +
        (others.length ? others.map(function (p) {
          return '<div class="cv-rankrow"><span>👤 ' + cvEsc(p.name) + (p.school ? ' · ' + cvEsc(p.school) : '') + '</span>' +
            '<button type="button" class="cv-btn blue small" onclick="cvToast(\'Đã gửi lời mời cho ' + cvEsc(p.name) + ' — mã phòng: ' + (d.room.code || '') + '\')">Mời</button></div>';
        }).join('') : '<p class="cv-mut">Chưa có kỳ thủ khác để mời.</p>');
    }
  } catch (e) { cvToast(e.message); }
}
// ---------- Đấu nhanh ----------
function cvQPick(mode, btn) {
  CVA.q.mode = mode;
  if (btn) {
    document.querySelectorAll('[data-q-mode]').forEach(function (b) { b.classList.remove('on'); });
    btn.classList.add('on');
  } else {
    document.querySelectorAll('[data-q-mode]').forEach(function (b) { b.classList.toggle('on', b.dataset.qMode === mode); });
  }
}
var CV_Q_MODES = { chop: { clock: 1, inc: 1 }, nhanh: { clock: 10, inc: 5 }, tieuchuan: { clock: 30, inc: 30 } };
async function cvQuickInit() {
  CVA.q.searching = null;
  try {
    var me = await cvApi('/api/covua/me');
    var lb = await cvApi('/api/covua/leaderboard');
    document.getElementById('cvQStats').innerHTML =
      '<div style="font-size:14px;line-height:2">🏆 Tổng số ván: <b>' + me.games + '</b><br>📈 Tỷ lệ thắng: <b>' + (me.games ? Math.round(100 * me.w / me.games) : 0) + '%</b><br>⭐ Điểm xếp hạng: <b>' + me.points + '</b><br>✅ Số ván thắng: <b>' + me.w + '</b></div>';
    document.getElementById('cvQRecent').innerHTML = lb.recent.length ? lb.recent.slice(0, 8).map(function (g) {
      var res = g.result === '1-0' ? g.white + ' thắng' : (g.result === '0-1' ? g.black + ' thắng' : 'Hòa');
      return '<div class="cv-rankrow"><span><b>' + cvEsc(g.white) + '</b> vs <b>' + cvEsc(g.black) + '</b> · ' + cvModeName(g.mode) + (g.ranked === false ? ' · không tính điểm' : '') + '</span><b>' + res + '</b></div>';
    }).join('') : '<p class="cv-mut">Chưa có ván đấu nào kết thúc.</p>';
  } catch (e) { /* im lặng */ }
  cvQuickShowIdle();
}
function cvQuickShowIdle() {
  document.getElementById('cvQIdle').style.display = 'block';
  document.getElementById('cvQSearching').style.display = 'none';
  document.getElementById('cvQTitle').textContent = 'ĐANG TÌM ĐỐI THỦ';
}
async function cvQuickStart() {
  var m = CV_Q_MODES[CVA.q.mode] || CV_Q_MODES.nhanh;
  try {
    var d = await cvApi('/api/covua/rooms', 'POST', { action: 'quick', mode: CVA.q.mode, clock: m.clock, inc: m.inc });
    if (d.game) { cvOpenGame(d.game.id, false); return; }
    CVA.q.searching = d.room.code;
    document.getElementById('cvQIdle').style.display = 'none';
    document.getElementById('cvQSearching').style.display = 'block';
    document.getElementById('cvQTitle').textContent = 'ĐANG TÌM ĐỐI THỦ…';
    document.getElementById('cvQSearchText').textContent = 'Đang tìm đối thủ cùng chế độ ' + cvModeName(CVA.q.mode) + '…';
    document.getElementById('cvQRoomCode').textContent = 'Phòng của bạn: mã ' + d.room.code + ' — có người vào là ván tự bắt đầu.';
    CVA.q.searchT = setInterval(async function () {
      try {
        var rooms = await cvApi('/api/covua/rooms');
        var r = rooms.rooms.filter(function (x) { return x.code === CVA.q.searching; })[0];
        if (r && r.game_id) { clearInterval(CVA.q.searchT); CVA.q.searchT = null; cvOpenGame(r.game_id, false); }
        if (!r) { clearInterval(CVA.q.searchT); CVA.q.searchT = null; cvQuickShowIdle(); }
      } catch (e) { /* nhịp sau thử lại */ }
    }, 3000);
  } catch (e) { cvToast(e.message); }
}
async function cvQuickCancel() {
  if (CVA.q.searchT) { clearInterval(CVA.q.searchT); CVA.q.searchT = null; }
  if (CVA.q.searching) {
    try { await cvApi('/api/covua/rooms', 'POST', { action: 'leave', code: CVA.q.searching }); } catch (e) { /* phòng có thể đã có người */ }
    CVA.q.searching = null;
  }
  cvQuickShowIdle();
}
// ---------- Sảnh phòng ----------
function cvRoomTab(tab, btn) {
  CVA.roomTab = tab;
  CVA.roomPage = 1;
  document.querySelectorAll('[data-room-tab]').forEach(function (b) {
    b.className = 'cv-btn ' + (b.dataset.roomTab === tab ? 'blue' : 'ghost') + ' small';
  });
  cvRenderRooms();
}
async function cvLoadRooms() {
  try {
    var d = await cvApi('/api/covua/rooms');
    CVA.rooms = d.rooms;
    cvRenderRooms();
  } catch (e) { cvToast(e.message); }
}
function cvRenderRooms() {
  var q = (document.getElementById('cvRoomSearch').value || '').toLowerCase();
  var mf = document.getElementById('cvRoomModeF').value;
  var list = CVA.rooms.filter(function (r) {
    if (r.privacy !== CVA.roomTab) return false;
    if (mf && r.mode !== mf) return false;
    if (q && (r.name || '').toLowerCase().indexOf(q) < 0 && (r.code || '').toLowerCase().indexOf(q) < 0 && (r.host_name || '').toLowerCase().indexOf(q) < 0) return false;
    return true;
  });
  var per = 10;
  var pages = Math.max(1, Math.ceil(list.length / per));
  if (CVA.roomPage > pages) CVA.roomPage = pages;
  var page = list.slice((CVA.roomPage - 1) * per, CVA.roomPage * per);
  document.getElementById('cvRoomsTbl').innerHTML =
    '<tr><th>#</th><th>Tên phòng</th><th>Chế độ</th><th>Số người</th><th>Trạng thái</th><th>Chủ phòng</th><th>Thao tác</th></tr>' +
    (page.length ? page.map(function (r, i) {
      var idx = (CVA.roomPage - 1) * per + i + 1;
      var act = r.status === 'lobby'
        ? '<button type="button" class="cv-btn blue small" onclick="cvRoomSelect(\'' + r.code + '\')">Xem</button>'
        : (r.game_id ? '<button type="button" class="cv-btn ghost small" onclick="cvOpenGame(\'' + r.game_id + '\',true)">Xem ván</button>' : '');
      return '<tr><td>' + String(idx).padStart(3, '0') + '</td><td><b>' + cvEsc(r.name) + '</b><br><small>' + cvTypeName(r.type) + '</small></td>' +
        '<td>' + cvModeName(r.mode) + '<br><small>' + r.clock + '+' + r.inc + '</small></td>' +
        '<td>' + (r.black_name ? '2/2' : '1/2') + '</td>' +
        '<td>' + (r.status === 'lobby' ? '<span class="cv-pill green">Đang chờ</span>' : '<span class="cv-pill orange">Đang chơi</span>') + '</td>' +
        '<td>' + cvEsc(r.host_name) + '</td><td>' + act + '</td></tr>';
    }).join('') : '<tr><td class="cv-mut" colspan="7">Không có phòng nào ở tab này.</td></tr>');
  var pg = document.getElementById('cvRoomsPage');
  pg.innerHTML = '<span class="cv-mut">Hiển thị 1 – ' + page.length + ' / ' + list.length + ' phòng · Trang ' + CVA.roomPage + '/' + pages + '</span>' +
    (CVA.roomPage > 1 ? '<button type="button" class="cv-btn ghost small" onclick="CVA.roomPage--;cvRenderRooms()">‹ Trước</button>' : '') +
    (CVA.roomPage < pages ? '<button type="button" class="cv-btn ghost small" onclick="CVA.roomPage++;cvRenderRooms()">Sau ›</button>' : '');
}
function cvMyRoom(code) { cvNav('rooms'); cvRoomSelect(code); }
async function cvRoomSelect(code, roomObj) {
  var r = roomObj || CVA.rooms.filter(function (x) { return x.code === code; })[0];
  if (!r) {
    try {
      var rl = await cvApi('/api/covua/rooms');
      CVA.rooms = rl.rooms || [];
      r = CVA.rooms.filter(function (x) { return x.code === code; })[0];
    } catch (e) { /* giữ fallback bên dưới */ }
  }
  if (!r) {
    // Phòng riêng tư không lộ mã trong bảng: nhập mã trực tiếp
    document.getElementById('cvRoomDetail').innerHTML = '<h3 class="cv-h">ℹ️ Thông tin phòng</h3><p class="cv-mut">Nhập mã phòng riêng tư vào ô tìm kiếm rồi bấm Vào phòng.</p>' +
      '<div class="cv-form"><input id="cvPrivCode" type="text" placeholder="Mã phòng" style="flex:1"><input id="cvPrivPw" type="password" placeholder="Mật khẩu" style="flex:1"><button type="button" class="cv-btn blue small" onclick="cvJoinPrivate()">Vào phòng</button></div>';
    return;
  }
  CVA.roomSel = r;
  document.getElementById('cvRoomDetail').innerHTML =
    '<h3 class="cv-h">ℹ️ Thông tin phòng</h3>' +
    '<div style="font-size:15px;line-height:2"><b style="font-size:19px">' + cvEsc(r.name) + '</b><br>' +
    'Chế độ: ' + cvModeName(r.mode) + ' ' + r.clock + '+' + r.inc + '<br>' +
    'Loại: ' + cvTypeName(r.type) + ' · ' + (r.privacy === 'public' ? '🌐 Công khai' : (r.privacy === 'friends' ? '👥 Bạn bè' : '🔒 Riêng tư')) + '<br>' +
    'Chủ phòng: ' + cvEsc(r.host_name) + '<br>' +
    'Người chơi: ' + cvEsc(r.white_name) + (r.black_name ? ' — ' + cvEsc(r.black_name) : ' — chờ đối thủ') + '<br>' +
    'Trạng thái: ' + (r.status === 'lobby' ? 'Đang chờ' : 'Đang chơi') + '</div>' +
    (r.status === 'lobby'
      ? '<button type="button" class="cv-btn gold" style="width:100%;margin-top:12px" onclick="cvJoinRoom(\'' + r.code + '\')">VÀO PHÒNG →</button>'
      : (r.game_id ? '<button type="button" class="cv-btn blue" style="width:100%;margin-top:12px" onclick="cvOpenGame(\'' + r.game_id + '\',true)">Xem ván</button>' : ''));
  if (r && r.mine && r.status === 'lobby') {
    var jb = document.querySelector('#cvRoomDetail button');
    if (jb) {
      var wb = document.createElement('div');
      wb.style.cssText = 'margin-top:12px;padding:12px;border:1px solid #f5c542;border-radius:10px;background:#2a2210';
      wb.innerHTML = '<p style="margin:0 0 6px">⏳ Bạn là chủ phòng — đang chờ đối thủ.</p>' + (r.code ? '<p style="margin:0">Mã phòng: <b style="color:#f5c542;font-size:18px">' + r.code + '</b> — gửi mã này cho đối thủ nhé.</p>' : '');
      jb.replaceWith(wb);
    }
  }
}
async function cvJoinPrivate() {
  var code = (document.getElementById('cvPrivCode').value || '').trim().toUpperCase();
  var pw = document.getElementById('cvPrivPw').value || '';
  if (!code) { cvToast('Thầy cô nhập mã phòng trước nhé'); return; }
  try {
    var d = await cvApi('/api/covua/rooms', 'POST', { action: 'join', code: code, password: pw });
    if (d.game) cvOpenGame(d.game.id, false);
    else { cvToast('Bạn đã ở trong phòng — đang chờ đối thủ vào đủ 2 người.'); cvNav('rooms'); cvRoomSelect(code, d.room); }
  } catch (e) { cvToast(e.message); }
}
async function cvJoinRoom(code) {
  try {
    var d = await cvApi('/api/covua/rooms', 'POST', { action: 'join', code: code });
    if (d.game) { cvOpenGame(d.game.id, false); }
    else { cvToast('Bạn đã ở trong phòng — đang chờ đối thủ vào đủ 2 người.'); cvNav('rooms'); cvRoomSelect(code, d.room); }
  } catch (e) { cvToast(e.message); }
}

</script>
<script>
// Đấu trường cờ vua v2 — ván cờ, AI, giải đấu, học cờ, cộng đồng, tin tức.
// Lưu ý API bộ luật: state = {b:[64], turn:'w'|'b', castling:{K,Q,k,q}, ep:int|null, half, full};
// genMoves = nước hợp lệ; applyMove trả về state MỚI; status = playing|checkmate|stalemate|draw-*;
// inCheck(st, whiteBool); attacked(st, sq, byWhiteBool); evaluate = góc nhìn Trắng.
function cvEngState(g) {
  var cast = { K: false, Q: false, k: false, q: false };
  var cs = g.castling || '';
  ['K', 'Q', 'k', 'q'].forEach(function (k) { cast[k] = cs.indexOf(k) >= 0; });
  return CVEngine.stateFromString(g.board, g.turn, cast, (g.ep === -1 || g.ep == null) ? null : g.ep, g.half, g.full);
}
function cvMySide(g) {
  if (!CVA.me || !g) return null;
  if (g.white_key === CVA.me.key) return 'w';
  if (g.black_key === CVA.me.key) return 'b';
  return null;
}
function cvOpenGame(gid, spectator) {
  cvStopTimers();
  CVA.game = null;
  CVA.local = null;
  CVA.histPly = null;
  cvNav('game');
  CVA.game = { id: gid, spectator: !!spectator };
  cvPollGame();
  CVA.poll = setInterval(cvPollGame, 2000);
  CVA.clockT = setInterval(cvTickClocks, 500);
}
async function cvPollGame() {
  if (!CVA.game || CVA.local) return;
  try {
    var g = await cvApi('/api/covua/games/' + CVA.game.id);
    g._fetched = Date.now();
    CVA.game = g;
    cvRenderGame();
  } catch (e) {
    if (String(e.message) === 'unauthorized') { cvStopTimers(); }
  }
}
function cvClockLeft(g) {
  if (!g.clocks || !g._fetched) return { w: 0, b: 0 };
  var el = Date.now() - g._fetched;
  var w = g.clocks.w, b = g.clocks.b;
  if (g.status === 'playing') {
    if (g.turn === 'w') w = Math.max(0, w - el);
    else b = Math.max(0, b - el);
  }
  return { w: w, b: b };
}
function cvTickClocks() {
  var g = CVA.game;
  if (!g || CVA.local || !g.clocks) return;
  var left = cvClockLeft(g);
  var ow = document.getElementById('cvOppClock'), mw = document.getElementById('cvMyClock');
  if (!ow || !mw) return;
  var my = cvMySide(g);
  var opp = my === 'w' ? 'b' : (my === 'b' ? 'w' : 'b');
  var myLeft = my ? left[my] : left.w;
  var oppLeft = my ? left[opp] : left.b;
  mw.textContent = cvFmt(myLeft);
  ow.textContent = cvFmt(oppLeft);
  mw.classList.toggle('low', myLeft < 60000);
  ow.classList.toggle('low', oppLeft < 60000);
  if (g.status === 'playing' && (left.w <= 0 || left.b <= 0) && !CVA.claimedTO) {
    CVA.claimedTO = true;
    cvApi('/api/covua/games/' + g.id + '/timeout', 'POST', {}).then(function () { cvPollGame(); }).catch(function () {});
  }
}
function cvCaptured(boardStr) {
  var start = { K: 1, Q: 1, R: 2, B: 2, N: 2, P: 8 };
  var cnt = { w: {}, b: {} };
  for (var i = 0; i < 64; i++) {
    var p = boardStr[i];
    if (p === '.') continue;
    var side = p === p.toUpperCase() ? 'w' : 'b';
    var t = p.toUpperCase();
    cnt[side][t] = (cnt[side][t] || 0) + 1;
  }
  var val = { P: 100, N: 320, B: 330, R: 500, Q: 900, K: 0 };
  var cap = { w: [], b: [] }, mat = { w: 0, b: 0 };
  ['P', 'N', 'B', 'R', 'Q'].forEach(function (t) {
    var mw = (cnt.w[t] || 0), mb = (cnt.b[t] || 0);
    for (var k = 0; k < (start[t] - mb); k++) cap.w.push(t.toLowerCase());
    for (var k2 = 0; k2 < (start[t] - mw); k2++) cap.b.push(t.toUpperCase());
    mat.w += mw * val[t]; mat.b += mb * val[t];
  });
  return { cap: cap, diff: Math.round((mat.w - mat.b) / 100) };
}
function cvBoardHTML(boardStr, opts) {
  opts = opts || {};
  var orient = opts.orient || 'w';
  var last = opts.last || null, chk = opts.chk || null, sel = CVA.sel, tg = CVA.targets || [];
  var html = '';
  for (var row = 0; row < 8; row++) {
    for (var col = 0; col < 8; col++) {
      var dr = orient === 'w' ? row : 7 - row;
      var dc = orient === 'w' ? col : 7 - col;
      var sq = dr * 8 + dc;
      var light = (dr + dc) % 2 === 0;
      var p = boardStr[sq];
      var cls = 'cv-sq ' + (light ? 'light' : 'dark');
      if (last && last.indexOf(sq) >= 0) cls += ' last';
      if (chk === sq) cls += ' chk';
      if (sel === sq) cls += ' sel';
      var inner = '';
      if (p && p !== '.') {
        inner = '<span class="' + (p === p.toUpperCase() ? 'cv-pc-w' : 'cv-pc-b') + '">' + CV_GLYPH[p] + '</span>';
      }
      if (tg.indexOf(sq) >= 0) inner += (p && p !== '.') ? '<span class="ring"></span>' : '<span class="dot"></span>';
      var coord = '';
      if (dc === 7) coord += '<span class="cv-coord br">' + '87654321'[dr] + '</span>';
      if (dr === 7) coord += '<span class="cv-coord tl">' + 'abcdefgh'[dc] + '</span>';
      html += '<div class="' + cls + '" data-sq="' + sq + '">' + inner + coord + '</div>';
    }
  }
  return html;
}
function cvPaintBoard(boardStr, opts) {
  var b = document.getElementById('cvBoard');
  if (!b) return;
  b.setAttribute('data-theme', (opts && opts.theme) || 'classic');
  b.innerHTML = cvBoardHTML(boardStr, opts);
  b.querySelectorAll('[data-sq]').forEach(function (el) {
    el.onclick = function () { cvSquareClick(parseInt(el.dataset.sq, 10)); };
  });
}
function cvKingSq(boardStr, white) {
  var k = white ? 'K' : 'k';
  for (var s = 0; s < 64; s++) if (boardStr[s] === k) return s;
  return -1;
}
function cvRenderGame() {
  var g = CVA.game;
  if (!g || CVA.local) return;
  var hb = document.getElementById('cvHintBtn');
  if (hb) hb.remove();
  document.getElementById('cvGameTitle').textContent = 'Ván cờ · ' + cvModeName(g.mode) + ' ' + g.clock_min + '+' + (g.inc || 0) + ' phút' +
    (g.ranked === false ? ' · không tính điểm' : ' · đấu xếp hạng') + (g.room_code ? ' · Mã phòng: ' + g.room_code : '');
  document.getElementById('cvGameMeta').innerHTML =
    'Chế độ: ' + cvModeName(g.mode) + ' ' + g.clock_min + '+' + (g.inc || 0) + '<br>' +
    'Loại: ' + (g.ranked === false ? 'Không tính điểm' : 'Đấu xếp hạng') + '<br>' +
    'Chủ đề bàn cờ: ' + ((CV_THEMES.filter(function (t) { return t.id === g.theme; })[0] || {}).name || 'Cổ điển') + '<br>' +
    'Trạng thái: ' + (g.status === 'playing' ? 'Đang đấu' : 'Đã kết thúc');
  document.getElementById('cvViewers').textContent = '👁️ ' + (g.viewers || 0) + ' người đang xem ván này';
  var my = cvMySide(g);
  var orient = my === 'b' ? 'b' : 'w';
  var st = cvEngState(g);
  var showBoard = g.board, showTurn = g.turn;
  if (CVA.histPly != null) {
    st = CVEngine.startState();
    for (var i = 0; i < Math.min(CVA.histPly, g.moves.length); i++) {
      var mv = CVEngine.findMoveBySAN(st, g.moves[i].san);
      if (mv) st = CVEngine.applyMove(st, mv);
    }
    showBoard = CVEngine.boardString(st);
    showTurn = st.turn;
  }
  var inChk = CVEngine.inCheck(st, showTurn === 'w');
  var kingSq = cvKingSq(showBoard, showTurn === 'w');
  var last = null;
  if (g.moves.length && CVA.histPly == null) {
    var lm = g.moves[g.moves.length - 1];
    last = [lm.from, lm.to];
  }
  cvPaintBoard(showBoard, { orient: orient, last: last, chk: inChk ? kingSq : null, theme: g.theme });
  var cap = cvCaptured(showBoard);
  var oppName = my === 'w' ? g.black : (my === 'b' ? g.white : g.black);
  var myName = my === 'w' ? g.white : (my === 'b' ? g.black : g.white);
  document.getElementById('cvOppName').textContent = '⬛ ' + oppName + (cap.diff < 0 ? ' · +' + (-cap.diff) : '');
  document.getElementById('cvMySideName').textContent = '⬜ ' + myName + (cap.diff > 0 ? ' · +' + cap.diff : '');
  document.getElementById('cvOppCap').textContent = cap.cap[my === 'b' ? 'b' : 'w'].map(function (p) { return CV_GLYPH[p]; }).join(' ') || ' ';
  document.getElementById('cvMyCap').textContent = cap.cap[my === 'w' ? 'w' : 'b'].map(function (p) { return CV_GLYPH[p]; }).join(' ') || ' ';
  cvTickClocks();
  var pairs = [];
  for (var m = 0; m < g.moves.length; m += 2) {
    pairs.push('<div>' + (m / 2 + 1) + '. <b>' + cvEsc(g.moves[m].san) + '</b>' + (g.moves[m + 1] ? ' &nbsp; <b>' + cvEsc(g.moves[m + 1].san) + '</b>' : '') + '</div>');
  }
  document.getElementById('cvMoves').innerHTML = pairs.length ? pairs.join('') : '<span class="cv-mut">Chưa có nước đi nào.</span>';
  var stEl = document.getElementById('cvGameStatus');
  if (CVA.histPly != null) {
    stEl.innerHTML = 'Đang xem lại nước ' + CVA.histPly + '/' + g.moves.length + ' — bấm “Về ván trực tiếp” để tiếp tục.';
  } else if (g.status === 'finished') {
    var win = g.result === '1-0' ? g.white : (g.result === '0-1' ? g.black : null);
    stEl.innerHTML = win ? '✅ ' + cvEsc(win) + ' thắng (' + (CV_REASON[g.reason] || g.reason || '') + ')' : '🤝 Hòa (' + (CV_REASON[g.reason] || g.reason || '') + ')';
    if (win && CVA.finishedToasted !== g.id) { CVA.finishedToasted = g.id; cvToast(win + ' thắng (' + (CV_REASON[g.reason] || '') + ')'); }
  } else {
    stEl.textContent = (g.turn === 'w' ? 'Trắng' : 'Đen') + ' đi' + (my && ((my === 'w') === (g.turn === 'w')) ? ' — đến lượt thầy cô!' : '') + (inChk ? ' · ĐANG BỊ CHIẾU!' : '');
  }
  document.getElementById('cvDrawBtn').disabled = !(my && g.status === 'playing');
  document.getElementById('cvResignBtn').disabled = !my || g.status !== 'playing';
  var db = document.getElementById('cvDrawBar');
  if (g.status === 'playing' && g.draw_offer && g.draw_offer !== (CVA.me && CVA.me.key)) {
    db.style.display = 'block';
    db.innerHTML = 'Đối thủ xin hòa. <button type="button" class="cv-btn blue small" onclick="cvDrawRespond(true)">Đồng ý hòa</button> <button type="button" class="cv-btn ghost small" onclick="cvDrawRespond(false)">Từ chối</button>';
  } else if (g.status === 'playing' && g.draw_offer) {
    db.style.display = 'block';
    db.textContent = 'Đã gửi lời xin hòa — chờ đối thủ trả lời.';
  } else { db.style.display = 'none'; }
  var cb = document.getElementById('cvChatBox');
  cb.innerHTML = (g.msgs && g.msgs.length) ? g.msgs.map(function (x) {
    return '<div><b>' + cvEsc(x.name) + '</b>: ' + cvEsc(x.text) + '</div>';
  }).join('') : '<p class="cv-mut">Chưa có tin nhắn.</p>';
  cb.scrollTop = cb.scrollHeight;
}
async function cvSendChat() {
  var inp = document.getElementById('cvChatInput');
  var text = (inp.value || '').trim();
  if (!text) return;
  if (CVA.local) { cvToast('Trò chuyện chỉ có ở ván đấu trực tuyến.'); return; }
  try {
    var d = await cvApi('/api/covua/games/' + CVA.game.id + '/chat', 'POST', { text: text });
    inp.value = '';
    if (CVA.game && !CVA.local) { CVA.game.msgs = d.msgs; cvRenderGame(); }
  } catch (e) { cvToast(e.message); }
}
function cvSquareClick(sq) {
  var g = CVA.game;
  if (CVA.local) { cvLocalClick(sq); return; }
  if (!g || g.status !== 'playing' || CVA.histPly != null) return;
  var my = cvMySide(g);
  if (!my || ((my === 'w') !== (g.turn === 'w'))) return;
  var st = cvEngState(g);
  if (CVA.sel < 0) {
    var p = st.b[sq];
    if (!p) return;
    if ((p === p.toUpperCase()) !== (g.turn === 'w')) return;
    CVA.sel = sq;
    CVA.targets = CVEngine.genMoves(st).filter(function (m) { return m.from === sq; }).map(function (m) { return m.to; });
    if (CVA.targets.indexOf(sq) < 0) CVA.targets.push(sq);
    cvRenderGame();
    return;
  }
  var from = CVA.sel;
  var mv = CVEngine.genMoves(st).filter(function (m) { return m.from === from && m.to === sq; });
  CVA.sel = -1;
  CVA.targets = [];
  if (!mv.length) { cvRenderGame(); return; }
  if (mv[0].promo) {
    var box = document.getElementById('cvPromoBox');
    box.style.display = 'flex';
    box.innerHTML = '<span style="font-weight:800">Phong cấp thành:</span>' + ['Q', 'R', 'B', 'N'].map(function (pc) {
      return '<button type="button" onclick="cvSendMove(' + from + ',' + sq + ',\'' + pc + '\')">' + CV_GLYPH[g.turn === 'w' ? pc : pc.toLowerCase()] + '</button>';
    }).join('');
    CVA.moveFrom = from;
    CVA.pendingTo = sq;
    return;
  }
  cvSendMove(from, sq, null);
}
async function cvSendMove(from, to, promo) {
  var g = CVA.game;
  document.getElementById('cvPromoBox').style.display = 'none';
  try {
    var d = await cvApi('/api/covua/games/' + g.id + '/move', 'POST', { from: from, to: to, promo: promo });
    CVA.game = d;
    CVA.game._fetched = Date.now();
    CVA.claimedTO = false;
    cvRenderGame();
  } catch (e) { cvToast(e.message); cvPollGame(); }
}
function cvHistGo(kind) {
  var g = CVA.game;
  if (!g) return;
  var n = g.moves.length;
  if (CVA.histPly == null) CVA.histPly = n;
  if (kind === 0) CVA.histPly = 0;
  else if (kind === 9999) CVA.histPly = n;
  else CVA.histPly = Math.max(0, Math.min(n, CVA.histPly + kind));
  cvRenderGame();
}
function cvHistLive() { CVA.histPly = null; cvRenderGame(); }
async function cvDrawOffer() {
  try { await cvApi('/api/covua/games/' + CVA.game.id + '/draw/offer', 'POST', {}); cvToast('Đã gửi lời xin hòa.'); cvPollGame(); }
  catch (e) { cvToast(e.message); }
}
async function cvDrawRespond(ok) {
  try { await cvApi('/api/covua/games/' + CVA.game.id + '/draw/respond', 'POST', { accept: ok }); cvPollGame(); }
  catch (e) { cvToast(e.message); }
}
async function cvResign() {
  try { await cvApi('/api/covua/games/' + CVA.game.id + '/resign', 'POST', {}); cvPollGame(); }
  catch (e) { cvToast(e.message); }
}
function cvRematch() {
  cvStopTimers();
  cvToast('Mở lại mục Đấu nhanh để tìm đối thủ mới nhé.');
  cvNav('quick');
}
function cvAnalyze() {
  var g = CVA.game;
  if (!g) return;
  var st;
  if (CVA.histPly != null) {
    st = CVEngine.startState();
    for (var i = 0; i < Math.min(CVA.histPly, g.moves.length); i++) {
      var mv = CVEngine.findMoveBySAN(st, g.moves[i].san);
      if (mv) st = CVEngine.applyMove(st, mv);
    }
  } else {
    st = cvEngState(g);
  }
  document.getElementById('cvAnalysis').innerHTML = cvAnalysisHTML(st);
}
function cvAnalysisHTML(st) {
  var ev = CVEngine.evaluate(st) / 100;
  var sign = ev >= 0 ? '+' : '';
  var moves = CVEngine.genMoves(st);
  var scored = [];
  moves.forEach(function (m) {
    var ns = CVEngine.applyMove(st, m);
    var sc = -CVEngine.negamax(ns, 1, -1e9, 1e9);
    var white = st.turn === 'w' ? sc : -sc;
    scored.push({ san: CVEngine.moveSAN(st, m), sc: white / 100 });
  });
  scored.sort(function (a, b) { return b.sc - a.sc; });
  var best = scored.slice(0, 3).map(function (x) {
    var v = x.sc >= 0 ? '+' + x.sc.toFixed(2) : x.sc.toFixed(2);
    return '<div>📌 ' + cvEsc(x.san) + ' &nbsp; <b>' + v + '</b></div>';
  }).join('');
  return '<div style="font-size:19px;font-weight:900">Đánh giá: <span style="color:#f5c542">' + sign + ev.toFixed(2) + '</span> <span class="cv-mut" style="font-size:13px">(+ là Trắng tốt hơn)</span></div>' +
    '<div style="margin-top:6px">Nước đi hay nhất gợi ý:</div>' + (best || '<span class="cv-mut">Không còn nước đi.</span>');
}
function cvEndText(st, moverWhite) {
  var s = CVEngine.status(st);
  if (s === 'checkmate') return (moverWhite ? 'Trắng' : 'Đen') + ' thắng (chiếu hết)';
  if (s === 'stalemate') return 'Hòa (hết nước đi)';
  if (s === 'draw-insufficient') return 'Hòa (không đủ lực chiếu hết)';
  if (s === 'draw-fifty') return 'Hòa (luật 50 nước)';
  return null;
}
// ---------- Ván chung máy + AI ----------
function cvLocalRender() {
  var L = CVA.local;
  if (!L) return;
  var st = L.st;
  var orient = 'w';
  if (L.mode !== 'ai' && document.getElementById('cvAIFlip') && document.getElementById('cvAIFlip').checked) orient = st.turn;
  var inChk = CVEngine.inCheck(st, st.turn === 'w');
  var boardStr = CVEngine.boardString(st);
  var kingSq = cvKingSq(boardStr, st.turn === 'w');
  var last = L.moves.length ? [L.moves[L.moves.length - 1].from, L.moves[L.moves.length - 1].to] : null;
  cvPaintBoard(boardStr, { orient: orient, last: last, chk: inChk ? kingSq : null, theme: L.theme || 'classic' });
  var cap = cvCaptured(boardStr);
  var opp = L.mode === 'ai' ? '🤖 Máy (' + L.aiLabel + ')' : '⬛ Đen';
  var me = L.mode === 'ai' ? '⬜ Bạn (Trắng)' : '⬜ Trắng';
  document.getElementById('cvOppName').textContent = opp + (cap.diff < 0 ? ' · +' + (-cap.diff) : '');
  document.getElementById('cvMySideName').textContent = me + (cap.diff > 0 ? ' · +' + cap.diff : '');
  document.getElementById('cvOppCap').textContent = cap.cap.w.map(function (p) { return CV_GLYPH[p]; }).join(' ') || ' ';
  document.getElementById('cvMyCap').textContent = cap.cap.b.map(function (p) { return CV_GLYPH[p]; }).join(' ') || ' ';
  document.getElementById('cvGameMeta').innerHTML = (L.mode === 'ai' ? 'Đấu với máy · ' + L.aiLabel : 'Ván chung máy · 2 người chơi trên một màn hình') + '<br>Không tính điểm bảng xếp hạng.';
  document.getElementById('cvViewers').textContent = '👁️ Ván luyện tập — không tính điểm.';
  var pairs = [];
  for (var m = 0; m < L.moves.length; m += 2) {
    pairs.push('<div>' + (m / 2 + 1) + '. <b>' + cvEsc(L.moves[m].san) + '</b>' + (L.moves[m + 1] ? ' &nbsp; <b>' + cvEsc(L.moves[m + 1].san) + '</b>' : '') + '</div>');
  }
  document.getElementById('cvMoves').innerHTML = pairs.length ? pairs.join('') : '<span class="cv-mut">Chưa có nước đi nào.</span>';
  var stEl = document.getElementById('cvGameStatus');
  if (L.status === 'finished') {
    stEl.textContent = L.resultText;
  } else {
    stEl.textContent = (st.turn === 'w' ? 'Trắng' : 'Đen') + ' đi' + (inChk ? ' · ĐANG BỊ CHIẾU!' : '') +
      (L.mode === 'ai' && st.turn === 'b' ? ' — máy đang nghĩ…' : '');
  }
  document.getElementById('cvChatBox').innerHTML = '<p class="cv-mut">Trò chuyện chỉ có ở ván đấu trực tuyến.</p>';
  document.getElementById('cvDrawBtn').disabled = true;
  document.getElementById('cvResignBtn').disabled = true;
  var hb = document.getElementById('cvHintBtn');
  if (L.mode === 'ai' && L.status !== 'finished' && document.getElementById('cvAIHint') && document.getElementById('cvAIHint').checked) {
    if (!hb) {
      var b = document.createElement('button');
      b.id = 'cvHintBtn';
      b.type = 'button';
      b.className = 'cv-btn ghost small';
      b.style.marginTop = '8px';
      b.textContent = '💡 Gợi ý nước đi';
      b.onclick = function () {
        var bm = CVEngine.bestMove(CVA.local.st, 2, false);
        if (bm) cvToast('Gợi ý: ' + CVEngine.moveSAN(CVA.local.st, bm));
      };
      stEl.parentElement.insertBefore(b, stEl.nextSibling);
    }
  } else if (hb) { hb.remove(); }
}
function cvLocalClick(sq) {
  var L = CVA.local;
  if (!L || L.status === 'finished') return;
  if (L.mode === 'ai' && L.st.turn !== 'w') return;
  var st = L.st;
  if (CVA.sel < 0) {
    var p = st.b[sq];
    if (!p) return;
    if ((p === p.toUpperCase()) !== (st.turn === 'w')) return;
    CVA.sel = sq;
    CVA.targets = CVEngine.genMoves(st).filter(function (m) { return m.from === sq; }).map(function (m) { return m.to; });
    if (CVA.targets.indexOf(sq) < 0) CVA.targets.push(sq);
    cvLocalRender();
    return;
  }
  var from = CVA.sel;
  var mv = CVEngine.genMoves(st).filter(function (m) { return m.from === from && m.to === sq; });
  CVA.sel = -1;
  CVA.targets = [];
  if (!mv.length) { cvLocalRender(); return; }
  if (mv[0].promo) {
    var box = document.getElementById('cvPromoBox');
    box.style.display = 'flex';
    box.innerHTML = '<span style="font-weight:800">Phong cấp thành:</span>' + ['Q', 'R', 'B', 'N'].map(function (pc) {
      return '<button type="button" onclick="cvLocalMove(' + from + ',' + sq + ',\'' + pc + '\')">' + CV_GLYPH[st.turn === 'w' ? pc : pc.toLowerCase()] + '</button>';
    }).join('');
    CVA.moveFrom = from;
    CVA.pendingTo = sq;
    return;
  }
  cvLocalMove(from, sq, null);
}
function cvLocalMove(from, to, promo) {
  var L = CVA.local;
  if (!L) return;
  document.getElementById('cvPromoBox').style.display = 'none';
  var st = L.st;
  var mv = CVEngine.genMoves(st).filter(function (m) { return m.from === from && m.to === to && (!m.promo || m.promo === promo); });
  if (!mv.length) return;
  var moverWhite = st.turn === 'w';
  var san = CVEngine.moveSAN(st, mv[0]);
  var ns = CVEngine.applyMove(st, mv[0]);
  L.st = ns;
  L.moves.push({ san: san, from: mv[0].from, to: mv[0].to });
  var end = cvEndText(ns, moverWhite);
  if (end) {
    L.status = 'finished';
    L.resultText = end;
    if (L.mode === 'ai') cvAIRecord(end);
    if (L.mode === 'ai' && document.getElementById('cvAIAnalysis') && document.getElementById('cvAIAnalysis').checked) {
      document.getElementById('cvAnalysis').innerHTML = cvAnalysisHTML(ns);
    }
  }
  cvLocalRender();
  if (L.mode === 'ai' && L.status !== 'finished' && L.st.turn === 'b') {
    setTimeout(function () {
      if (!CVA.local || CVA.local.status === 'finished') return;
      var st2 = CVA.local.st;
      var bm = CVEngine.bestMoveStyled(st2, CVA.local.depth, CVA.local.randomize, CVA.local.style);
      if (!bm) return;
      var san2 = CVEngine.moveSAN(st2, bm);
      var ns2 = CVEngine.applyMove(st2, bm);
      CVA.local.st = ns2;
      CVA.local.moves.push({ san: san2, from: bm.from, to: bm.to });
      var end2 = cvEndText(ns2, false);
      if (end2) { CVA.local.status = 'finished'; CVA.local.resultText = end2; cvAIRecord(end2); }
      cvLocalRender();
    }, 350);
  }
}
function cvAIRecord(resultText) {
  try {
    var r = JSON.parse(localStorage.getItem('cv-ai-record') || '{"games":0,"w":0,"d":0,"l":0}');
    r.games++;
    if (/Trắng thắng/.test(resultText)) r.w++;
    else if (/Đen thắng/.test(resultText)) r.l++;
    else r.d++;
    localStorage.setItem('cv-ai-record', JSON.stringify(r));
  } catch (e) {}
}
function cvStartAI() { cvStartAISelected(); }
function cvStartAISelected() {
  var lv = CV_AI_LEVELS[CVA.ai.level] || CV_AI_LEVELS[3];
  var sty = CV_AI_STYLES.filter(function (x) { return x.id === CVA.ai.style; })[0] || CV_AI_STYLES[0];
  cvStopTimers();
  CVA.game = null;
  CVA.histPly = null;
  CVA.local = {
    mode: 'ai', st: CVEngine.startState(), moves: [],
    depth: lv.depth, randomize: lv.randomize, style: sty.id,
    aiLabel: lv.name + ' · ' + sty.name, theme: 'classic', status: 'playing'
  };
  cvNav('game');
  document.getElementById('cvGameTitle').textContent = 'Ván cờ · Đấu với máy ' + lv.name + ' (' + sty.name + ')';
  cvLocalRender();
}
function cvStartLocal() {
  cvStopTimers();
  CVA.game = null;
  CVA.histPly = null;
  CVA.local = {
    mode: 'local', st: CVEngine.startState(), moves: [],
    theme: 'classic', status: 'playing'
  };
  cvNav('game');
  document.getElementById('cvGameTitle').textContent = 'Ván cờ · Chơi chung máy (2 người)';
  cvLocalRender();
}
// ---------- Giải đấu ----------
async function cvCreateTour() {
  var name = (document.getElementById('cvTourName').value || '').trim();
  if (!name) { cvToast('Thầy cô nhập tên giải trước nhé'); return; }
  try {
    await cvApi('/api/covua/tours', 'POST', {
      action: 'create', name: name,
      mode: document.getElementById('cvTourMode').value,
      clock: document.getElementById('cvTourClock').value,
      max_players: document.getElementById('cvTourMax').value
    });
    document.getElementById('cvTourName').value = '';
    cvToast('Đã tạo giải ' + name);
    cvLoadTours();
  } catch (e) { cvToast(e.message); }
}
async function cvLoadTours() {
  try {
    var d = await cvApi('/api/covua/tours');
    document.getElementById('cvToursList').innerHTML = d.tours.length ? d.tours.map(function (t) {
      return '<div class="cv-panel" style="margin-bottom:12px"><b>' + cvEsc(t.name) + '</b> · ' + cvModeName(t.mode) + ' ' + t.clock + ' phút · ' + t.players + ' người · ' +
        (t.status === 'open' ? '<span class="cv-pill green">Đang mở đăng ký</span>' : (t.status === 'running' ? '<span class="cv-pill orange">Đang đấu</span>' : '<span class="cv-pill grey">Đã kết thúc</span>')) +
        ' <button type="button" class="cv-btn blue small" style="float:right" onclick="cvTourDetail(\'' + t.id + '\')">Xem chi tiết</button></div>';
    }).join('') : '<p class="cv-mut">Chưa có giải nào — thầy cô tạo giải đầu tiên ở trên.</p>';
  } catch (e) { cvToast(e.message); }
}
async function cvTourDetail(tid) {
  try {
    var t = await cvApi('/api/covua/tours/' + tid);
    CVA.tourDetail = t;
    var wins = t.tour_wins || {};
    var html = '<div class="cv-panel"><h3 class="cv-h">🏆 ' + cvEsc(t.name) + '</h3>' +
      '<p class="cv-mut">' + cvModeName(t.mode) + ' ' + t.clock + ' phút · Trạng thái: ' + (t.status === 'open' ? 'Đang mở đăng ký' : (t.status === 'running' ? 'Đang đấu' : 'Đã kết thúc')) + '</p>' +
      '<h3 class="cv-h" style="margin-top:14px">Người chơi (' + t.players.length + ')</h3>' +
      t.players.map(function (n, i) {
        var k = t.player_keys[i];
        return '<div class="cv-rankrow"><span>👤 ' + cvEsc(n) + '</span><span>' + (wins[k] || 0) + ' trận thắng</span></div>';
      }).join('') +
      '<h3 class="cv-h" style="margin-top:14px">Sơ đồ vòng đấu</h3>' +
      (t.matches.length ? t.matches.map(function (m) {
        var w = m.p1, b = m.p2 || 'Miễn đấu (bye)';
        var res = m.result ? ' → ' + (m.result === '1-0' ? cvEsc(w) + ' thắng' : (m.result === '0-1' ? cvEsc(b) + ' thắng' : 'Hòa — đánh lại')) : '';
        return '<div class="cv-rankrow"><span>Vòng ' + m.round + ' · ' + cvEsc(w) + ' vs ' + cvEsc(b) + res + '</span>' +
          (m.game_id ? '<button type="button" class="cv-btn ghost small" onclick="cvOpenGame(\'' + m.game_id + '\',' + (m.status === 'finished' ? 'true' : 'false') + ')">' + (m.status === 'finished' ? 'Xem lại' : 'Vào ván') + '</button>' : '') + '</div>';
      }).join('') : '<p class="cv-mut">Chưa có cặp đấu — cần ít nhất 2 người đăng ký rồi bấm Bắt đầu.</p>') +
      (t.champion ? '<p style="margin-top:12px;font-weight:900;color:#f5c542">🏆 Nhà vô địch: ' + cvEsc(t.champion) + '</p>' : '') +
      '<div style="display:flex;gap:10px;margin-top:14px;flex-wrap:wrap">' +
      '<button type="button" class="cv-btn blue small" onclick="cvTourJoin(\'' + t.id + '\')">Đăng ký tham gia</button>' +
      '<button type="button" class="cv-btn ghost small" onclick="cvTourLeave(\'' + t.id + '\')">Rút khỏi giải</button>' +
      '<button type="button" class="cv-btn gold small" onclick="cvTourStart(\'' + t.id + '\')">Bắt đầu giải</button>' +
      '</div></div>';
    document.getElementById('cvTourDetail').innerHTML = html;
  } catch (e) { cvToast(e.message); }
}
async function cvTourJoin(tid) { try { await cvApi('/api/covua/tours', 'POST', { action: 'join', tour_id: tid }); cvToast('Đã đăng ký vào giải.'); cvTourDetail(tid); } catch (e) { cvToast(e.message); } }
async function cvTourLeave(tid) { try { await cvApi('/api/covua/tours', 'POST', { action: 'leave', tour_id: tid }); cvToast('Đã rút khỏi giải.'); cvTourDetail(tid); } catch (e) { cvToast(e.message); } }
async function cvTourStart(tid) { try { await cvApi('/api/covua/tours', 'POST', { action: 'start', tour_id: tid }); cvToast('Giải đã bắt đầu — các cặp đấu vòng 1 đã mở.'); cvTourDetail(tid); } catch (e) { cvToast(e.message); } }
// ---------- Học cờ ----------
var CV_TACTICS = [
  { fen: '6k1/5ppp/8/8/8/8/8/R5K1 w', goal: 'Tìm nước chiếu hết trong 1 nước.' },
  { fen: '6k1/5ppp/8/8/8/8/8/4Q1K1 w', goal: 'Tìm nước chiếu hết trong 1 nước.' },
  { fen: 'r1bqkbnr/pppp1ppp/2n5/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq', goal: 'Tìm nước chiếu hết trong 1 nước (mẫu đòn học trò).' },
  { fen: '6k1/5ppp/8/8/8/8/8/1R3K2 w', goal: 'Tìm nước chiếu hết trong 1 nước.' },
  { fen: '6k1/5ppp/8/8/8/8/8/2R3K1 w', goal: 'Tìm nước chiếu hết trong 1 nước.' }
];
var CV_OPENINGS = [
  { name: 'Italian Game', moves: ['e4', 'e5', 'Nf3', 'Nc6', 'Bc4'], note: 'Khai cuộc cổ điển, cân bằng và giàu tính chiến thuật.' },
  { name: 'Ruy Lopez', moves: ['e4', 'e5', 'Nf3', 'Nc6', 'Bb5'], note: 'Khai cuộc của những bậc thầy, kiểm soát trung tâm bền bỉ.' },
  { name: 'Sicilian Defense', moves: ['e4', 'c5', 'Nf3', 'd6', 'd4', 'cxd4', 'Nxd4', 'Nf6', 'Nc3', 'a6'], note: 'Phòng thủ sắc bén, lựa chọn hàng đầu để phản công.' },
  { name: 'Queen\u2019s Gambit', moves: ['d4', 'd5', 'c4', 'e6', 'Nc3', 'Nf6'], note: 'Khai cuộc kiểm soát trung tâm, nền tảng vững chắc.' }
];
function cvLearnTab(tab) {
  document.getElementById('cvLearnHeroTactics').style.display = tab === 'tactics' ? 'block' : 'none';
  document.getElementById('cvLearnHeroOpenings').style.display = tab === 'openings' ? 'block' : 'none';
  document.getElementById('cvLearnTactics').style.display = tab === 'tactics' ? 'block' : 'none';
  document.getElementById('cvLearnOpenings').style.display = tab === 'openings' ? 'block' : 'none';
  if (tab === 'tactics') cvTacticShow(CVA.tactic != null ? CVA.tactic : 0);
  if (tab === 'openings') cvOpeningShow(CVA.opening != null ? CVA.opening : 0);
}
function cvTacticSolved() {
  try { return JSON.parse(localStorage.getItem('cv-tactics-solved') || '[]'); }
  catch (e) { return []; }
}
function cvTacticShow(i) {
  CVA.tactic = i;
  var t = CV_TACTICS[i];
  var st = CVEngine.parseFEN(t.fen);
  var solved = cvTacticSolved();
  var dayIdx = Math.floor(Date.now() / 86400000) % CV_TACTICS.length;
  var html = '<div class="cv-grid3">' +
    '<div class="cv-panel"><h3 class="cv-h">📚 Danh mục chiến thuật</h3>' +
    '<div class="cv-rankrow"><span>🎯 Tất cả bài tập</span><b>' + CV_TACTICS.length + '</b></div>' +
    '<div class="cv-rankrow"><span>👑 Chiếu hết</span><b>' + CV_TACTICS.length + '</b></div>' +
    '<div class="cv-rankrow"><span class="cv-mut">📌 Ghim quân</span><span class="cv-mut">Sắp có</span></div>' +
    '<div class="cv-rankrow"><span class="cv-mut">🔗 Phối hợp</span><span class="cv-mut">Sắp có</span></div>' +
    '<div class="cv-rankrow"><span class="cv-mut">⚔️ Đòn đôi</span><span class="cv-mut">Sắp có</span></div>' +
    '<p class="cv-mut" style="margin-top:10px">Hiện có ' + CV_TACTICS.length + ' bài chiếu hết trong 1 nước. Các dạng khác sẽ bổ sung sau.</p></div>' +
    '<div><h3 class="cv-h">Bài tập ' + (i + 1) + '/' + CV_TACTICS.length + ' ' + (solved.indexOf(i) >= 0 ? '<span class="cv-pill green">Đã giải ✓</span>' : '') + '</h3>' +
    '<p class="cv-mut">🎯 Mục tiêu: ' + t.goal + '</p>' +
    '<div class="cv-board" data-theme="classic" id="cvTacBoard"></div>' +
    '<div style="display:flex;gap:10px;margin-top:12px;flex-wrap:wrap">' +
    '<button type="button" class="cv-btn ghost small" onclick="cvTacticShow(' + Math.max(0, i - 1) + ')">← Bài trước</button>' +
    '<button type="button" class="cv-btn ghost small" onclick="cvTacticShow(' + Math.min(CV_TACTICS.length - 1, i + 1) + ')">Bài tiếp theo →</button>' +
    '<button type="button" class="cv-btn blue small" onclick="cvTacticHint()">💡 Gợi ý</button>' +
    '<button type="button" class="cv-btn gold small" onclick="cvTacticSolve()">👁️ Xem lời giải</button>' +
    '</div><div id="cvTacMsg" style="margin-top:10px;font-weight:700"></div></div>' +
    '<div><div class="cv-panel"><h3 class="cv-h">📊 Tiến trình luyện tập</h3>' +
    '<div class="cv-donut" style="background:conic-gradient(#f5c542 ' + Math.round(100 * solved.length / CV_TACTICS.length) + '%,#1b2f5e 0)"><span>' + Math.round(100 * solved.length / CV_TACTICS.length) + '%</span></div>' +
    '<p style="text-align:center;margin-top:10px">Đã hoàn thành ' + solved.length + ' / ' + CV_TACTICS.length + ' bài</p></div>' +
    '<div class="cv-panel" style="margin-top:14px"><h3 class="cv-h">🔥 Thử thách hàng ngày</h3>' +
    '<p class="cv-mut">Bài của hôm nay: bài ' + (dayIdx + 1) + '.</p>' +
    '<button type="button" class="cv-btn blue small" onclick="cvTacticShow(' + dayIdx + ')">Làm bài hôm nay</button></div></div></div>';
  document.getElementById('cvLearnTactics').innerHTML = html;
  CVA.tacState = st;
  CVA.tacSel = -1;
  CVA.tacTargets = [];
  cvTacticPaint();
}
function cvTacticPaint() {
  var b = document.getElementById('cvTacBoard');
  if (!b) return;
  var st = CVA.tacState;
  CVA.sel = CVA.tacSel;
  CVA.targets = CVA.tacTargets;
  b.innerHTML = cvBoardHTML(CVEngine.boardString(st), { orient: 'w' });
  b.querySelectorAll('[data-sq]').forEach(function (el) {
    el.onclick = function () { cvTacticClick(parseInt(el.dataset.sq, 10)); };
  });
  CVA.sel = -1;
  CVA.targets = [];
}
function cvTacticClick(sq) {
  var st = CVA.tacState;
  if (CVA.tacSel < 0) {
    var p = st.b[sq];
    if (!p) return;
    if ((p === p.toUpperCase()) !== (st.turn === 'w')) return;
    CVA.tacSel = sq;
    CVA.tacTargets = CVEngine.genMoves(st).filter(function (m) { return m.from === sq; }).map(function (m) { return m.to; });
    if (CVA.tacTargets.indexOf(sq) < 0) CVA.tacTargets.push(sq);
    cvTacticPaint();
    return;
  }
  var from = CVA.tacSel;
  var mv = CVEngine.genMoves(st).filter(function (m) { return m.from === from && m.to === sq; });
  CVA.tacSel = -1;
  CVA.tacTargets = [];
  if (!mv.length) { cvTacticPaint(); return; }
  var san = CVEngine.moveSAN(st, mv[0]);
  var ns = CVEngine.applyMove(st, mv[0]);
  CVA.tacState = ns;
  cvTacticPaint();
  var msg = document.getElementById('cvTacMsg');
  if (CVEngine.status(ns) === 'checkmate') {
    msg.innerHTML = '🎉 Chính xác! ' + san + ' chiếu hết.';
    var solved = cvTacticSolved();
    if (solved.indexOf(CVA.tactic) < 0) {
      solved.push(CVA.tactic);
      try { localStorage.setItem('cv-tactics-solved', JSON.stringify(solved)); } catch (e) {}
    }
    setTimeout(function () { cvTacticShow(CVA.tactic); }, 1600);
  } else {
    msg.textContent = 'Nước ' + san + ' chưa chiếu hết — thử nước khác nhé.';
  }
}
function cvTacticHint() {
  var st = CVA.tacState;
  var bm = CVEngine.bestMove(st, 3, false);
  if (bm) document.getElementById('cvTacMsg').textContent = '💡 Gợi ý: thử nước ' + CVEngine.moveSAN(st, bm) + '.';
}
function cvTacticSolve() { cvTacticHint(); }
function cvOpeningShow(i) {
  CVA.opening = i;
  CVA.openingIdx = 0;
  var cats = [
    ['Tất cả khai cuộc', CV_OPENINGS.length],
    ['Khai cuộc với 1.e4', CV_OPENINGS.filter(function (o) { return o.moves[0] === 'e4'; }).length],
    ['Khai cuộc với 1.d4', CV_OPENINGS.filter(function (o) { return o.moves[0] === 'd4'; }).length],
    ['Phòng thủ Sicilia', CV_OPENINGS.filter(function (o) { return o.name.indexOf('Sicilian') >= 0; }).length],
    ['Gambit Hậu', CV_OPENINGS.filter(function (o) { return o.name.indexOf('Gambit') >= 0; }).length]
  ];
  var html = '<div class="cv-grid3">' +
    '<div class="cv-panel"><h3 class="cv-h">📚 Danh mục khai cuộc</h3>' +
    '<div style="margin-bottom:10px"><input type="text" id="cvOpSearch" placeholder="Tìm khai cuộc… (VD: Italian, Sicilian, e4, d4)" style="width:100%;background-color:#071233!important;border:1px solid #33507e;color:#eaf2ff!important;border-radius:9px;padding:9px 12px;font-size:14px" oninput="cvOpeningSearch()"></div>' +
    '<div id="cvOpCats">' + cats.map(function (c) {
      return '<div class="cv-rankrow"><span>' + c[0] + '</span><b>' + c[1] + '</b></div>';
    }).join('') + '</div></div>' +
    '<div><div class="cv-panel"><h3 class="cv-h">⭐ KHÓA HỌC NỔI BẬT — ' + cvEsc(CV_OPENINGS[0].name.toUpperCase()) + '</h3>' +
    '<p>' + cvEsc(CV_OPENINGS[0].note) + '</p><p><b>' + CV_OPENINGS[0].moves.join(' ') + '</b></p>' +
    '<button type="button" class="cv-btn gold small" onclick="cvOpeningShow(0)">▶ Tiếp tục học</button></div>' +
    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px">' +
    CV_OPENINGS.map(function (o, k) {
      return '<div class="cv-panel"><b>' + cvEsc(o.name) + '</b><p class="cv-mut" style="margin-top:6px">' + cvEsc(o.note) + '</p><p style="font-size:13px">' + o.moves.join(' ') + '</p>' +
        '<button type="button" class="cv-btn blue small" onclick="cvOpeningShow(' + k + ')">Học khai cuộc này</button></div>';
    }).join('') + '</div>' +
    '<div class="cv-panel" style="margin-top:14px"><h3 class="cv-h">Bàn cờ minh họa — ' + cvEsc(CV_OPENINGS[i].name) + '</h3>' +
    '<div class="cv-board" data-theme="classic" id="cvOpBoard" style="max-width:420px"></div>' +
    '<div style="display:flex;gap:10px;margin-top:12px">' +
    '<button type="button" class="cv-btn ghost small" onclick="cvOpeningStep(-1)">← Nước trước</button>' +
    '<button type="button" class="cv-btn ghost small" onclick="cvOpeningStep(1)">Nước sau →</button>' +
    '<button type="button" class="cv-btn ghost small" onclick="cvOpeningReset()">Chơi lại từ đầu</button></div>' +
    '<div id="cvOpTree" style="margin-top:10px;font-size:14px;line-height:2"></div></div></div>' +
    '<div><div class="cv-panel"><h3 class="cv-h">🗺️ Lộ trình học tập</h3>' +
    '<div class="cv-rankrow"><span>1 · Nền tảng khai cuộc</span><span class="cv-pill green">Học ngay</span></div>' +
    '<div class="cv-rankrow"><span>2 · Khai cuộc phổ biến</span><span class="cv-pill blue">4 khai cuộc</span></div>' +
    '<div class="cv-rankrow"><span>3 · Khai cuộc theo phong cách</span><span class="cv-mut">Tấn công / phòng thủ / cân bằng</span></div>' +
    '<div class="cv-rankrow"><span>4 · Phân tích với kỳ thủ nổi tiếng</span><span class="cv-mut">Qua ván đấu mẫu</span></div>' +
    '<div class="cv-rankrow"><span>5 · Luyện tập &amp; kiểm tra</span><span class="cv-mut">Bài tập, test hiểu biết khai cuộc</span></div></div></div></div>';
  document.getElementById('cvLearnOpenings').innerHTML = html;
  cvOpeningPaint();
}
function cvOpeningState() {
  var st = CVEngine.startState();
  var o = CV_OPENINGS[CVA.opening];
  for (var i = 0; i < Math.min(CVA.openingIdx, o.moves.length); i++) {
    var mv = CVEngine.findMoveBySAN(st, o.moves[i]);
    if (mv) st = CVEngine.applyMove(st, mv);
  }
  return st;
}
function cvOpeningPaint() {
  var st = cvOpeningState();
  var b = document.getElementById('cvOpBoard');
  if (!b) return;
  b.innerHTML = cvBoardHTML(CVEngine.boardString(st), { orient: 'w' });
  var o = CV_OPENINGS[CVA.opening];
  document.getElementById('cvOpTree').innerHTML = '<b>Cây nước đi — ' + cvEsc(o.name) + ':</b><br>' +
    o.moves.map(function (m, k) {
      var on = k < CVA.openingIdx;
      return '<span style="' + (on ? 'color:#f5c542;font-weight:800' : 'color:#9fb4d8') + '">' + (k % 2 === 0 ? Math.floor(k / 2) + 1 + '. ' : '') + m + '</span> ';
    }).join('') +
    '<br><span class="cv-mut">Đang ở nước ' + CVA.openingIdx + '/' + o.moves.length + '.</span>';
}
function cvOpeningStep(d) {
  var o = CV_OPENINGS[CVA.opening];
  CVA.openingIdx = Math.max(0, Math.min(o.moves.length, CVA.openingIdx + d));
  cvOpeningPaint();
}
function cvOpeningReset() { CVA.openingIdx = 0; cvOpeningPaint(); }
function cvOpeningSearch() {
  var q = (document.getElementById('cvOpSearch').value || '').toLowerCase();
  var box = document.getElementById('cvOpCats');
  if (!box) return;
  var list = CV_OPENINGS.filter(function (o) {
    return o.name.toLowerCase().indexOf(q) >= 0 || o.moves.join(' ').toLowerCase().indexOf(q) >= 0;
  });
  box.innerHTML = list.length ? list.map(function (o, k) {
    return '<div class="cv-rankrow"><span>' + cvEsc(o.name) + ' <span class="cv-mut">(' + o.moves.join(' ') + ')</span></span>' +
      '<button type="button" class="cv-btn blue small" onclick="cvOpeningShow(' + CV_OPENINGS.indexOf(o) + ')">Học</button></div>';
  }).join('') : '<p class="cv-mut">Không tìm thấy khai cuộc phù hợp.</p>';
}
// ---------- Cộng đồng / Tin tức ----------
async function cvLoadBoard() {
  try {
    var lb = await cvApi('/api/covua/leaderboard');
    var top = lb.players.slice(0, 3);
    document.getElementById('cvPodium').innerHTML = top.length ? '<div class="cv-pod">' + [1, 0, 2].map(function (k) {
      var p = top[k];
      if (!p) return '<div></div>';
      var cls = k === 0 ? 'first' : (k === 1 ? 'second' : 'third');
      var medal = k === 0 ? '🥇' : (k === 1 ? '🥈' : '🥉');
      return '<div class="cv-podc ' + cls + '"><div style="font-size:34px">' + medal + '</div><div style="font-weight:800;margin-top:6px">' + cvEsc(p.name) + '</div><div style="color:#f5c542;font-weight:900;font-size:21px">' + p.points + ' điểm</div><div class="cv-mut">' + p.w + ' thắng · ' + p.pct + '% thắng</div></div>';
    }).join('') + '</div>' : '<p class="cv-mut">Chưa có kỳ thủ nào có điểm.</p>';
    document.getElementById('cvBoardPlayers').innerHTML =
      '<tr><th>Hạng</th><th>Người chơi</th><th>Trường</th><th>Thắng</th><th>Hòa</th><th>Thua</th><th>Tỷ lệ thắng</th><th>Điểm</th></tr>' +
      (lb.players.length ? lb.players.map(function (p, i) {
        return '<tr><td>' + (i + 1) + '</td><td><b>' + cvEsc(p.name) + '</b></td><td>' + cvEsc(p.school || '—') + '</td><td>' + p.w + '</td><td>' + p.d + '</td><td>' + p.l + '</td><td>' + p.pct + '%</td><td><b>' + p.points + '</b></td></tr>';
      }).join('') : '<tr><td class="cv-mut" colspan="8">Chưa có kỳ thủ nào có điểm.</td></tr>');
    document.getElementById('cvBoardSchools').innerHTML =
      '<tr><th>Hạng</th><th>Trường</th><th>Kỳ thủ</th><th>Điểm</th></tr>' +
      (lb.schools.length ? lb.schools.map(function (s, i) {
        return '<tr><td>' + (i + 1) + '</td><td><b>' + cvEsc(s.school) + '</b></td><td>' + s.players + '</td><td><b>' + s.points + '</b></td></tr>';
      }).join('') : '<tr><td class="cv-mut" colspan="4">Chưa có trường nào có điểm.</td></tr>');
    var totalGames = lb.players.reduce(function (a, p) { return a + p.games; }, 0) / 2;
    document.getElementById('cvSeasonBox').innerHTML =
      '<div style="font-size:15px;line-height:2">👥 Kỳ thủ có điểm: <b>' + lb.players.length + '</b><br>' +
      '🎮 Tổng ván đã kết thúc: <b>' + Math.round(totalGames) + '</b><br>' +
      '🏫 Trường có điểm: <b>' + lb.schools.length + '</b><br>' +
      (lb.players[0] ? '🥇 Dẫn đầu: <b>' + cvEsc(lb.players[0].name) + '</b> với ' + lb.players[0].points + ' điểm' : '') + '</div>';
  } catch (e) { cvToast(e.message); }
}
async function cvLoadNews() {
  try {
    var lb = await cvApi('/api/covua/leaderboard');
    var tours = await cvApi('/api/covua/tours');
    var openT = tours.tours.filter(function (t) { return t.status === 'open'; });
    document.getElementById('cvNewsBox').innerHTML =
      (openT.length ? '<h3 class="cv-h">🏆 Giải đang mở đăng ký</h3>' + openT.map(function (t) {
        return '<div class="cv-rankrow"><span><b>' + cvEsc(t.name) + '</b> · ' + cvModeName(t.mode) + ' ' + t.clock + ' phút · ' + t.players + ' người</span><button type="button" class="cv-btn blue small" onclick="cvNav(\'tours\');cvTourDetail(\'' + t.id + '\')">Xem giải</button></div>';
      }).join('') : '') +
      '<h3 class="cv-h" style="margin-top:14px">🎮 Ván đấu mới nhất</h3>' +
      (lb.recent.length ? lb.recent.map(function (g) {
        var res = g.result === '1-0' ? g.white + ' thắng' : (g.result === '0-1' ? g.black + ' thắng' : 'Hòa');
        return '<div class="cv-rankrow"><span><b>' + cvEsc(g.white) + '</b> vs <b>' + cvEsc(g.black) + '</b> · ' + cvModeName(g.mode) + ' · ' + (CV_REASON[g.reason] || g.reason || '') + (g.ranked === false ? ' · không tính điểm' : '') + '</span><b>' + res + '</b></div>';
      }).join('') : '<p class="cv-mut">Chưa có ván đấu nào kết thúc.</p>');
  } catch (e) { cvToast(e.message); }
}
// ---------- AI ----------
var CV_AI_LEVELS = {
  1: { name: 'Dễ', elo: 'ELO ~ 600', depth: 1, randomize: true, desc: 'Dành cho người mới bắt đầu. Máy đi nhanh, thỉnh thoảng đi nước ngẫu nhiên.' },
  2: { name: 'Trung bình', elo: 'ELO ~ 1000', depth: 2, randomize: false, desc: 'Cân bằng và thử thách. Máy tính toán 2 nước sâu.' },
  3: { name: 'Khó', elo: 'ELO ~ 1600', depth: 3, randomize: false, desc: 'Dành cho người chơi có kinh nghiệm. Máy được khuyên dùng cho luyện tập nghiêm túc.' },
  4: { name: 'Chuyên gia', elo: 'ELO ~ 2200', depth: 3, randomize: false, desc: 'Thuật toán nâng cao, lối chơi sâu và khó lường.' },
  5: { name: 'Huyền thoại', elo: 'ELO ~ 2800', depth: 4, randomize: false, desc: 'Thử thách đỉnh cao — máy tính 4 nước sâu, nghĩ lâu hơn.' }
};
var CV_AI_STYLES = [
  { id: 'balanced', name: 'Cân bằng', desc: 'Lối chơi toàn diện, không thiên về tấn công hay phòng thủ.' },
  { id: 'attack', name: 'Tấn công', desc: 'Máu lửa, chủ động — ưu tiên chiếu và ăn quân.' },
  { id: 'defense', name: 'Phòng thủ', desc: 'Kiên nhẫn, chắc chắn — ưu tiên an toàn vua và nhập thành.' },
  { id: 'tactics', name: 'Chiến thuật', desc: 'Tìm kiếm combo — ưu tiên ăn quân và đòn phối hợp.' },
  { id: 'position', name: 'Vị trí', desc: 'Kiểm soát bàn cờ — ưu tiên trung tâm và tính cơ động.' }
];
function cvAIInit() {
  var lvBox = document.getElementById('cvAILevels');
  if (lvBox && !lvBox.dataset.done) {
    lvBox.dataset.done = '1';
    lvBox.innerHTML = [1, 2, 3, 4, 5].map(function (k) {
      var lv = CV_AI_LEVELS[k];
      return '<button type="button" class="cv-opt' + (k === CVA.ai.level ? ' on' : '') + '" style="align-items:flex-start;text-align:left" data-ai-level="' + k + '" onclick="cvAIPickLevel(' + k + ',this)">♟️ ' + lv.name + (k === 3 ? ' <span class="cv-pill gold">Được khuyên dùng</span>' : '') + '<small>' + lv.elo + ' · ' + lv.desc + '</small></button>';
    }).join('');
  }
  var stBox = document.getElementById('cvAIStyles');
  if (stBox && !stBox.dataset.done) {
    stBox.dataset.done = '1';
    stBox.innerHTML = CV_AI_STYLES.map(function (s) {
      return '<button type="button" class="cv-opt' + (s.id === CVA.ai.style ? ' on' : '') + '" data-ai-style="' + s.id + '" onclick="cvAIPickStyle(\'' + s.id + '\',this)">⭐ ' + s.name + '<small>' + s.desc + '</small></button>';
    }).join('');
  }
  cvAIInfo();
  var sg = document.getElementById('cvAISuggest');
  if (sg && !sg.dataset.done) {
    sg.dataset.done = '1';
    sg.innerHTML = CV_OPENINGS.map(function (o, k) {
      return '<div class="cv-rankrow"><span><b>' + cvEsc(o.name) + '</b><br><span class="cv-mut">' + o.moves.join(' ') + '</span></span><button type="button" class="cv-btn blue small" onclick="cvNav(\'learn\',\'openings\');cvOpeningShow(' + k + ')">Dùng</button></div>';
    }).join('');
  }
  try {
    var r = JSON.parse(localStorage.getItem('cv-ai-record') || '{"games":0,"w":0,"d":0,"l":0}');
    document.getElementById('cvAIRecord').innerHTML =
      '<div style="font-size:15px;line-height:2">🎮 Tổng số ván: <b>' + r.games + '</b><br>🏆 Thắng: <b>' + r.w + '</b> · 🤝 Hòa: <b>' + r.d + '</b> · ❌ Thua: <b>' + r.l + '</b></div>';
  } catch (e) {}
}
function cvAIPickLevel(k, btn) {
  CVA.ai.level = k;
  document.querySelectorAll('[data-ai-level]').forEach(function (b) { b.classList.toggle('on', parseInt(b.dataset.aiLevel, 10) === k); });
  cvAIInfo();
}
function cvAIPickStyle(id, btn) {
  CVA.ai.style = id;
  document.querySelectorAll('[data-ai-style]').forEach(function (b) { b.classList.toggle('on', b.dataset.aiStyle === id); });
  cvAIInfo();
}
function cvAIInfo() {
  var lv = CV_AI_LEVELS[CVA.ai.level];
  var sty = CV_AI_STYLES.filter(function (x) { return x.id === CVA.ai.style; })[0];
  var box = document.getElementById('cvAIInfo');
  if (box) box.innerHTML = '<div style="font-size:15px;line-height:2"><b>AI ' + lv.name + '</b> · ' + lv.elo + '<br><span class="cv-mut">' + lv.desc + '</span><br><b>Cá tính: ' + sty.name + '</b><br><span class="cv-mut">' + sty.desc + '</span></div>';
}
// ---------- Mở/đóng ----------
function cvShow() {
  var v = document.getElementById('cvView');
  if (!v) return;
  ['homeView', 'etView', 'ttsView', 'vaView', 'vcView'].forEach(function (id) { var e = document.getElementById(id); if (e) e.style.display = 'none'; });
  var bot = document.getElementById('bot'); if (bot) bot.style.display = 'none';
  v.style.display = 'block';
  cvLoadMe();
  cvNav('home');
}
function cvHide() {
  var v = document.getElementById('cvView');
  if (v) v.style.display = 'none';
  cvStopTimers();
}
function cvBack() {
  cvHide();
  if (typeof homeShow === 'function') homeShow();
  else {
    var h = document.getElementById('homeView');
    if (h) h.style.display = 'block';
  }
}

</script>
<script>
(function(){
function hvName(){var un=document.getElementById('uname');return (un&&un.textContent||'').trim();}
function hvGreet(){var h=new Date().getHours();var p=h<11?'buổi sáng':(h<18?'buổi chiều':'buổi tối');var nm=hvName()||'bạn';var el=document.getElementById('hvGreet');if(el)el.textContent='Chào '+p+' '+nm+',';}
function hvClock(){var el=document.getElementById('hvClock');if(!el)return;var d=new Date();var days=['Chủ nhật','Thứ hai','Thứ ba','Thứ tư','Thứ năm','Thứ sáu','Thứ bảy'];var q=function(n){return String(n).padStart(2,'0');};el.textContent=q(d.getHours())+':'+q(d.getMinutes())+':'+q(d.getSeconds())+' · '+days[d.getDay()]+', '+q(d.getDate())+'/'+q(d.getMonth()+1)+'/'+d.getFullYear();}
function hvEsc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
async function hvFillAcc(){var nm=hvName();var nEl=document.getElementById('hvAccName');if(nEl)nEl.textContent=nm||'Tài khoản';try{var me=await hmGet('/api/me');if(me){window._hvAdmin=!!me.admin;var ph=document.getElementById('hvAccTier');if(ph)ph.textContent=me.tier_label?('Hạng '+me.tier_label):'—';var bd=document.getElementById('hvAccBadge');if(bd)bd.textContent=me.admin?'Quản trị viên':'Giáo viên';}}catch(e){}}
async function hvFillVisits(){try{var t=await hmGet('/api/visits/total');var el=document.getElementById('hvVisits');if(el)el.textContent=t?((+t.total||0).toLocaleString('vi-VN')):'—';}catch(e){}}
async function hvFillNoti(){var box=document.getElementById('hvNotiRows');if(!box)return;try{var d=await hmBellData();if(d&&d.items&&d.items.length){window._hvNotiActs=d.items.map(function(it){return it.act;});box.innerHTML=d.items.map(function(it,i){return '<div class="hv-row" onclick="hvNotiAct('+i+')"><b>'+it.t+'</b> · '+it.n+(it.sub?' ('+it.sub+')':'')+'</div>';}).join('');}else{box.innerHTML='<div class="hv-empty">Chưa có thông báo mới.</div>';}}catch(e){box.innerHTML='<div class="hv-empty">Chưa tải được thông báo.</div>';}}
async function hvAvLoad(){var img=document.getElementById('hvAvImg');var ini=document.getElementById('hvAvInit');if(!img||!ini)return;try{var r=await fetch('/api/avatar/me');if(r.ok){img.src='/api/avatar/me?t='+Date.now();img.style.display='';ini.style.display='none';}else{img.style.display='none';ini.style.display='flex';ini.textContent=(hvName()||'?').trim().charAt(0)||'?';}}catch(e){}}
window.hvAvChange=async function(){var inp=document.getElementById('hvAvFile');var f=inp&&inp.files&&inp.files[0];if(!f)return;try{var fd=new FormData();fd.append('file',f);var r=await fetch('/api/me/avatar',{method:'POST',body:fd});if(!r.ok){var d={};try{d=await r.json();}catch(e){}alert('Chưa đổi được ảnh: '+(d.detail||'thử lại giúp em.'));}else{hvAvLoad();}}catch(e){alert('Chưa đổi được ảnh, thầy thử lại giúp em.');}inp.value='';};
window.hvAskAi=function(){var inp=document.getElementById('hvAiIn');var q=inp?(inp.value||'').trim():'';if(!q)return;try{if(typeof botOpen==='function')botOpen();var ta=document.getElementById('bta');if(ta)ta.value=q;if(typeof botSend==='function')botSend();}catch(e){}if(inp)inp.value='';};
function hvRoom(){return window._hvRoom||'world';}
function hvRoomSyncDel(){var del=document.getElementById('hvRoomDel');if(!del)return;var rm=(window._hvRooms||{})[hvRoom()];del.style.display=(rm&&rm.can_delete)?'inline-block':'none';var cs=document.getElementById('hvRoomCode');if(cs){if(rm&&rm.private&&rm.code){cs.textContent='Mã phòng: '+rm.code;cs.style.display='inline';}else{cs.style.display='none';}}}
async function hvRoomLoad(){var sel=document.getElementById('hvRoomSel');if(!sel)return;try{var d=await hmGet('/api/onthi/chat/rooms');var rooms=(d&&d.rooms)||[];window._hvRooms={};rooms.forEach(function(r){window._hvRooms[r.id]=r;});var saved='';try{saved=localStorage.getItem('hv-room')||'';}catch(e){}if(saved&&!window._hvRooms[saved])saved='';window._hvRoom=saved||'world';sel.innerHTML=rooms.map(function(r){return '<option value="'+r.id+'">'+(r.private?'🔒 ':'')+hvEsc(r.name)+' ('+r.n+')</option>';}).join('');sel.value=window._hvRoom;hvRoomSyncDel();}catch(e){}}
window.hvRoomChange=function(){var sel=document.getElementById('hvRoomSel');if(!sel)return;window._hvRoom=sel.value||'world';try{localStorage.setItem('hv-room',window._hvRoom);}catch(e){}hvRoomSyncDel();hvChatLoad();};
window.hvRoomPrivate=async function(){var t=prompt('Nhập tên phòng chát riêng:');if(!t||!t.trim())return;try{var r=await fetch('/api/onthi/chat/rooms',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:t.trim(),private:true})});if(!r.ok)throw new Error('create failed');var d=await r.json();alert('Đã tạo phòng riêng! Mã phòng: '+d.code+' — gửi mã này cho người muốn mời.');await hvRoomLoad();var sel=document.getElementById('hvRoomSel');if(sel&&d.id){sel.value=d.id;window._hvRoom=d.id;try{localStorage.setItem('hv-room',d.id);}catch(e){}hvRoomSyncDel();}hvChatLoad();}catch(e){alert('Chưa tạo được phòng riêng, thầy thử lại giúp em.');}};
window.hvRoomJoin=async function(){var c=prompt('Nhập mã phòng (6 ký tự):');if(!c||!c.trim())return;try{var r=await fetch('/api/onthi/chat/rooms/join',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({code:c.trim()})});if(!r.ok){var dd={};try{dd=await r.json();}catch(e){}alert(dd.detail||'Không tìm thấy phòng với mã này.');return;}var d=await r.json();await hvRoomLoad();var sel=document.getElementById('hvRoomSel');if(sel&&d.id){sel.value=d.id;window._hvRoom=d.id;try{localStorage.setItem('hv-room',d.id);}catch(e){}hvRoomSyncDel();}hvChatLoad();}catch(e){alert('Chưa vào được phòng, thầy thử lại giúp em.');}};
window.hvRoomCreate=async function(){var t=prompt('Nhập tên phòng chát:');if(!t||!t.trim())return;try{var r=await fetch('/api/onthi/chat/rooms',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:t.trim()})});if(!r.ok)throw new Error('create failed');var d=await r.json();await hvRoomLoad();var sel=document.getElementById('hvRoomSel');if(sel&&d.id){sel.value=d.id;window._hvRoom=d.id;try{localStorage.setItem('hv-room',d.id);}catch(e){}hvRoomSyncDel();}hvChatLoad();}catch(e){alert('Chưa tạo được phòng, thầy thử lại giúp em.');}};
window.hvRoomDel=async function(){var id=hvRoom();if(id==='world')return;if(!confirm('Xóa phòng này và toàn bộ tin nhắn trong phòng?'))return;try{var r=await fetch('/api/onthi/chat/rooms/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})});if(!r.ok)throw new Error('del failed');window._hvRoom='world';try{localStorage.removeItem('hv-room');}catch(e){}await hvRoomLoad();hvChatLoad();}catch(e){alert('Chưa xóa được phòng, thầy thử lại giúp em.');}};
function hvColor(key){var pal=['#FDE047','#F9A8D4','#93C5FD','#86EFAC','#FCA5A5','#C4B5FD','#FDBA74','#5EEAD4'];var h=0;var s=String(key||'');for(var i=0;i<s.length;i++){h=(h*31+s.charCodeAt(i))%997;}return pal[h%pal.length];}
function hvChatRender(){var box=document.getElementById('hvMsgs');if(!box)return;var all=window._hvChatMsgs||[];var q='';var si=document.getElementById('hvChatSearch');if(si)q=(si.value||'').trim().toLowerCase();var msgs=all;if(q){msgs=all.filter(function(m){return ((m.name||'')+' '+(m.text||'')).toLowerCase().indexOf(q)>=0;});}var last=msgs.slice(-8);if(!last.length){box.innerHTML='<div class="hv-empty">'+(q?'Không tìm thấy tin nhắn phù hợp.':'Chưa có tin nhắn nào — thầy cô mở đầu câu chuyện đi ạ.')+'</div>';return;}box.innerHTML=last.map(function(m){var av=hvEsc((m.name||'?').trim().charAt(0)||'?');var col=hvColor(m.key||m.name);var role=m.role||'';var badge=role?'<span class="hv-role '+(role==='Quản trị viên'?'admin':'teacher')+'">'+hvEsc(role)+'</span>':'';var del=window._hvAdmin?'<button class="hv-x" type="button" title="Xóa tin này" onclick="hvChatDel('+Number(m.ts||0)+')">×</button>':'';return '<div class="hv-msg"><span class="hv-av" style="background:'+col+';color:#1E293B">'+av+'</span><div><b style="color:'+col+'">'+hvEsc(m.name)+'</b>'+badge+'<div>'+hvEsc(m.text)+'</div><small>'+hvEsc(m.t||'')+'</small></div>'+del+'</div>';}).join('');}
window.hvChatFilter=function(){hvChatRender();};
async function hvChatLoad(){var box=document.getElementById('hvMsgs');if(!box)return;try{var d=await hmGet('/api/onthi/chat?room='+encodeURIComponent(hvRoom()));window._hvChatMsgs=(d&&d.msgs)||[];hvChatRender();try{var o=await hmGet('/api/onthi/chat/online');var oe=document.getElementById('hvOnline');if(oe&&o)oe.textContent='● '+(o.online||0)+' đang online';}catch(e){}}catch(e){box.innerHTML='<div class="hv-empty">Chưa tải được kênh chát.</div>';}}
window.hvChatSend=async function(){var inp=document.getElementById('hvChatIn');var v=(inp.value||'').trim();if(!v)return;var btn=document.querySelector('#homeView .hv-send button');try{var r=await fetch('/api/onthi/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:v,room:hvRoom()})});if(!r.ok)throw new Error('send failed');inp.value='';hvChatLoad();if(btn){btn.disabled=true;setTimeout(function(){btn.disabled=false;},3000);}}catch(e){alert('Chưa gửi được tin nhắn, thầy thử lại giúp em.');}};
window.hvChatDel=async function(ts){try{await fetch('/api/onthi/chat/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({ts:ts,room:hvRoom()})});hvChatLoad();}catch(e){}};
async function hvTickLoad(){var box=document.getElementById('hvTickRows');if(!box)return;try{var d=await hmGet('/api/bulletin');var rows=[];((d&&d.ai)||[]).forEach(function(a){rows.push({kind:'ai',tag:'AI',html:hvEsc(a.text),del:null,sub:a.at});});var anns=(d&&d.announcements)||[];anns.forEach(function(a){rows.push({kind:'ann',tag:'Thông báo',html:hvEsc(a.text),del:((d&&d.is_admin)?a.idx:null),sub:a.at});});((d&&d.honors)||[]).forEach(function(h){rows.push({kind:'honor',tag:'Vinh danh',html:hvEsc(h.text),del:null,sub:''});});var btn=document.getElementById('hvTickPost');if(btn)btn.style.display=(d&&d.is_admin)?'inline-block':'none';if(!rows.length){box.innerHTML='<div class="hv-empty">Chưa có bản tin mới.</div>';return;}box.innerHTML=rows.slice(0,5).map(function(r){var del=(r.del!==null&&r.del!==undefined)?'<button class="hv-x" type="button" title="Xóa thông báo" onclick="hvTickDel('+r.del+')">×</button>':'';var cls=r.kind==='ai'?'hv-bn-row hv-bn-ai':'hv-bn-row';return '<div class="'+cls+'"><span class="hv-bn-tag '+(r.kind||'')+'">'+(r.kind==='ai'?'✨ ':'')+r.tag+'</span> '+r.html+(r.sub?' <small>· '+hvEsc(r.sub)+'</small>':'')+del+'</div>';}).join('');}catch(e){box.innerHTML='<div class="hv-empty">Chưa tải được bản tin.</div>';}}
window.hvTickPost=async function(){var t=prompt('Nhập nội dung thông báo:');if(!t||!t.trim())return;try{var r=await fetch('/api/bulletin/announce',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:t.trim()})});if(!r.ok)throw new Error('post failed');hvTickLoad();}catch(e){alert('Chưa đăng được thông báo, thầy thử lại giúp em.');}};
window.hvTickDel=async function(idx){try{await fetch('/api/bulletin/announce/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({idx:idx})});hvTickLoad();}catch(e){}};
async function hvBtLoad(){var box=document.getElementById('hvBtRows');if(!box)return;try{var d=await hmGet('/api/bantru/summary');if(!d||!d.ok){box.innerHTML='<div class="hv-empty">Chưa kết nối được dữ liệu bán trú.</div>';return;}var rows=[];rows.push('<div class="hv-bn-row">'+(d.serve?'🍚':'⛔')+' <b>Hôm nay '+hvEsc(d.weekday)+' — '+(d.serve?'có ăn bán trú':'không ăn bán trú')+'</b>'+(d.serve_note?' <small>· '+hvEsc(d.serve_note)+'</small>':'')+'</div>');var mt=d.menu_tomorrow||{};rows.push('<div class="hv-bn-row">📋 <b>Thực đơn ngày mai '+(mt.posted?'đã đăng':'chưa đăng')+'</b>'+(mt.posted&&mt.dishes&&mt.dishes.length?' <small>· '+hvEsc(mt.dishes.join(' · '))+'</small>':'')+'</div>');if(d.late_pending!==null&&d.late_pending!==undefined&&d.late_pending>0){rows.push('<div class="hv-bn-row">🔔 <b>Có '+d.late_pending+' yêu cầu báo muộn chờ duyệt</b></div>');}box.innerHTML=rows.join('');}catch(e){box.innerHTML='<div class="hv-empty">Chưa tải được thông báo bán trú.</div>';}}
function hvWmo(c){var m={0:['☀️','Trời quang'],1:['🌤️','Ít mây'],2:['⛅','Nhiều mây'],3:['☁️','U ám'],45:['🌫️','Sương mù'],48:['🌫️','Sương mù'],51:['🌦️','Mưa phùn'],53:['🌦️','Mưa phùn'],55:['🌦️','Mưa phùn'],56:['🌦️','Mưa phùn lạnh'],57:['🌦️','Mưa phùn lạnh'],61:['🌧️','Mưa nhẹ'],63:['🌧️','Mưa'],65:['🌧️','Mưa to'],66:['🌧️','Mưa lạnh'],67:['🌧️','Mưa lạnh'],71:['🌨️','Tuyết nhẹ'],73:['🌨️','Tuyết'],75:['🌨️','Tuyết dày'],77:['🌨️','Mưa tuyết'],80:['🌧️','Mưa rào nhẹ'],81:['🌧️','Mưa rào'],82:['🌧️','Mưa rào to'],85:['🌨️','Tuyết rơi'],86:['🌨️','Tuyết rơi dày'],95:['⛈️','Dông'],96:['⛈️','Dông kèm mưa đá'],99:['⛈️','Dông kèm mưa đá']};return m[c]||['🌤️','Thời tiết'];}
function hvWdir(deg){var ds=['Bắc','Đông bắc','Đông','Đông nam','Nam','Tây nam','Tây','Tây bắc'];return ds[Math.round(((deg%360)+360)%360/45)%8];}
function hvWtime(){var d=new Date();var q=function(n){return String(n).padStart(2,'0');};return q(d.getHours())+':'+q(d.getMinutes());}
async function hvWeatherLoad(){var big=document.getElementById('hvWBig');if(!big)return;try{var r=await fetch('https://api.open-meteo.com/v1/forecast?latitude=21.14148&longitude=106.01942&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m,wind_direction_10m&daily=weather_code,temperature_2m_max&timezone=Asia%2FBangkok&forecast_days=4');if(!r.ok)throw new Error('wx failed');var d=await r.json();var cur=d.current||{};var w=hvWmo(cur.weather_code);var cond=document.getElementById('hvWCond');var det=document.getElementById('hvWDetail');big.textContent=Math.round(cur.temperature_2m)+'°C';if(cond)cond.textContent=w[0]+' '+w[1]+' · Phật Tích';if(det)det.textContent='Độ ẩm '+(cur.relative_humidity_2m||'—')+'% · Gió '+hvWdir(cur.wind_direction_10m||0)+' '+Math.round(cur.wind_speed_10m||0)+' km/h';var week=document.getElementById('hvWWeek');if(week&&d.daily&&d.daily.time){var days=['Chủ nhật','Thứ 2','Thứ 3','Thứ 4','Thứ 5','Thứ 6','Thứ 7'];var rows='';for(var i=1;i<Math.min(4,d.daily.time.length);i++){var dt=new Date(d.daily.time[i]+'T00:00:00');var ww=hvWmo(d.daily.weather_code[i]);rows+='<li><span>'+days[dt.getDay()]+'</span><span>'+ww[0]+' '+Math.round(d.daily.temperature_2m_max[i])+'°C · '+ww[1]+'</span></li>';}week.innerHTML=rows;}var note=document.getElementById('hvWNote');if(note)note.textContent='Cập nhật '+hvWtime()+' · open-meteo';try{localStorage.setItem('hv-weather',JSON.stringify({d:d,at:Date.now()}));}catch(e){}}catch(e){try{var c=JSON.parse(localStorage.getItem('hv-weather')||'null');if(c&&c.d){var d=c.d;var cur=d.current||{};var w=hvWmo(cur.weather_code);big.textContent=Math.round(cur.temperature_2m)+'°C';var cond=document.getElementById('hvWCond');var det=document.getElementById('hvWDetail');if(cond)cond.textContent=w[0]+' '+w[1]+' · Phật Tích';if(det)det.textContent='Độ ẩm '+(cur.relative_humidity_2m||'—')+'% · Gió '+hvWdir(cur.wind_direction_10m||0)+' '+Math.round(cur.wind_speed_10m||0)+' km/h';var note=document.getElementById('hvWNote');if(note)note.textContent='Số đã lưu · open-meteo';}}catch(e2){}}}
window.hvNotiAct=function(i){if(window._hvNotiActs&&window._hvNotiActs[i])window._hvNotiActs[i]();};
hvGreet();hvClock();setInterval(hvClock,1000);hvFillAcc();hvFillVisits();hvFillNoti();hvAvLoad();hvRoomLoad();hvChatLoad();hvTickLoad();hvBtLoad();hvWeatherLoad();
var hvTiles=document.querySelector('#homeView .hv-tiles');
if(hvTiles){hvTiles.addEventListener('wheel',function(e){e.preventDefault();hvTiles.scrollLeft+=e.deltaY;},{passive:false});}
setInterval(function(){var hv=document.getElementById('homeView');if(hv&&getComputedStyle(hv).display!=='none'){hvChatLoad();}},15000);
setInterval(function(){var hv=document.getElementById('homeView');if(hv&&getComputedStyle(hv).display!=='none'){hvWeatherLoad();}},900000);
if(typeof homeShow==='function'){var _hs=homeShow;homeShow=function(){_hs();hvGreet();hvFillAcc();hvFillVisits();hvFillNoti();hvAvLoad();hvRoomLoad();hvChatLoad();hvTickLoad();hvBtLoad();hvWeatherLoad();};}
})();
</script>
</body></html>
