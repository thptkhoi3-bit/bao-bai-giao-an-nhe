e="button" class="lopdel" onclick="lopDel('+e+')" title="Xóa">✕</button></div>').join(""))}function lopDel(t){LOP.students.splice(t,1),lopRender(),wheelDraw()}function lopImport(){const t=document.getElementById("loppaste").value;let e=0;t.split(/\r?\n/).forEach(t=>{if(!(t=t.trim()))return;const n=t.split(/\t|;|\|/).map(t=>t.trim()).filter(Boolean);let s="";const a=t.match(/\d{1,2}[\/\-.]\d{1,2}([\/\-.]\d{2,4})?/);a&&(s=a[0]);let i=(n[0]||"").replace(/^\d+\s*[.)\-:]/,"").replace(/\d{1,2}[\/\-.]\d{1,2}([\/\-.]\d{2,4})?/g,"").replace(/,+\s*$/,"").trim();i.length>=2&&LOP.students.length<200&&(LOP.students.push({name:i,bd:s}),e++)}),document.getElementById("loppaste").value="",lopRender(),wheelDraw(),toast(e?"Đã nạp thêm "+e+" bạn — nhớ bấm LƯU":"Không đọc được tên nào từ phần vừa dán",e?void 0:1)}function lopAddOne(){const t=document.getElementById("lopone"),e=t.value.trim();e.length<2?toast("Nhập tên bạn cần thêm",1):(LOP.students.push({name:e,bd:""}),t.value="",lopRender(),wheelDraw())}async function lopSave(){LOP.class_name=document.getElementById("lopname").value.trim();try{toast("Đã lưu danh sách lớp ("+(await api("/api/lop/save",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({class_name:LOP.class_name,students:LOP.students})})).count+" bạn) ✅")}catch(t){toast(t.message||"Không lưu được",1)}}let WH={ang:0,vel:0,run:!1,raf:0};function wheelNames(){const t=document.getElementById("wheelexcl"),e=t&&t.checked;return LOP.students.map(t=>t.name).filter(t=>!e||!LOP.picked.includes(t))}function wheelDraw(){const t=document.getElementById("wheel");if(!t)return;const e=t.getContext("2d"),n=wheelNames(),s=t.width,a=t.height,i=s/2,o=a/2,c=s/2-8;if(e.clearRect(0,0,s,a),!n.length)return e.fillStyle="#f1f5f9",e.beginPath(),e.arc(i,o,c,0,7),e.fill(),e.fillStyle="#64748b",e.font="bold 17px sans-serif",e.textAlign="center",void e.fillText(LOP.students.length?"Tất cả đã được chọn — bấm Đặt lại vòng":"Chưa có danh sách lớp",i,o);const l=2*Math.PI/n.length,d=["#f87171","#fb923c","#facc15","#4ade80","#38bdf8","#818cf8","#e879f9","#2dd4bf"];n.forEach((t,n)=>{const s=WH.ang+n*l,a=s+l;e.beginPath(),e.moveTo(i,o),e.arc(i,o,c,s,a),e.closePath(),e.fillStyle=d[n%d.length],e.fill(),e.strokeStyle="#fff",e.lineWidth=2,e.stroke(),e.save(),e.translate(i,o),e.rotate(s+l/2),e.textAlign="right",e.fillStyle="#1e293b",e.font="bold 13px sans-serif",e.fillText(t.length>16?t.slice(0,15)+"…":t,c-10,5),e.restore()}),e.beginPath(),e.arc(i,o,34,0,7),e.fillStyle="#fff",e.fill(),e.strokeStyle="#cbd5e1",e.lineWidth=2,e.stroke(),e.fillStyle="#1d4ed8",e.font="bold 15px sans-serif",e.textAlign="center",e.fillText("QUAY",i,o+5),e.beginPath(),e.moveTo(i-13,2),e.lineTo(i+13,2),e.lineTo(i,26),e.closePath(),e.fillStyle="#dc2626",e.fill()}function wheelSpin(){const t=wheelNames();if(t.length<2)return void toast("Cần ít nhất 2 bạn trong vòng quay",1);if(WH.run)return;WH.run=!0,WH.vel=.3+.12*Math.random(),document.getElementById("wheelres").textContent="Đang quay…";const e=()=>{if(WH.ang=(WH.ang+WH.vel)%(2*Math.PI),WH.vel*=.992,wheelDraw(),WH.vel>.0025)WH.raf=requestAnimationFrame(e);else{WH.run=!1;const e=2*Math.PI/t.length;let n=(1.5*Math.PI-WH.ang)%(2*Math.PI);n<0&&(n+=2*Math.PI);const s=t[Math.floor(n/e)%t.length];LOP.picked.includes(s)||LOP.picked.push(s),document.getElementById("wheelres").innerHTML="🎉 Chúc mừng bạn: <b>"+esc(s)+"</b>",beep(880,.15),setTimeout(()=>beep(1174,.22),170),wheelDraw()}};WH.raf=requestAnimationFrame(e)}function wheelReset(){LOP.picked=[];const t=document.getElementById("wheelres");t&&(t.textContent=""),wheelDraw()}let TM={left:0,run:!1,int:null};function beep(t,e){try{const n=window._ac||(window._ac=new(window.AudioContext||window.webkitAudioContext)),s=n.createOscillator(),a=n.createGain();s.frequency.value=t||880,s.type="sine",a.gain.value=.12,s.connect(a),a.connect(n.destination),s.start(),a.gain.exponentialRampToValueAtTime(1e-4,n.currentTime+(e||.2)),s.stop(n.currentTime+(e||.2))}catch(t){}}function tFmt(t){return t=Math.max(0,Math.ceil(t)),String(Math.floor(t/60)).padStart(2,"0")+":"+String(t%60).padStart(2,"0")}function tShow(){const t=document.getElementById("tdisp");t&&(t.textContent=tFmt(TM.left))}function tStop(){TM.run=!1,clearInterval(TM.int);const t=document.getElementById("tbtn");t&&(t.textContent="▶️ Bắt đầu")}function tSet(t){TM.left=60*(+t||0),tStop(),tShow()}function tToggle(){if(TM.run)return void tStop();if(TM.left<=0){const t=parseFloat(document.getElementById("tmin").value)||0;if(t<=0)return void toast("Nhập số phút trước đã",1);TM.left=60*t}TM.run=!0,document.getElementById("tbtn").textContent="⏸️ Tạm dừng";const t=Date.now(),e=TM.left;TM.int=setInterval(()=>{TM.left=Math.max(0,e-(Date.now()-t)/1e3),tShow(),TM.left<=0&&(tStop(),document.getElementById("tdisp").textContent="⏰ HẾT GIỜ!",beep(660,.25),setTimeout(()=>beep(660,.25),350),setTimeout(()=>beep(880,.45),700))},200)}function grpMake(){const t=Math.max(2,Math.min(12,parseInt(document.getElementById("gnum").value)||4)),e=LOP.students.map(t=>t.name);if(e.length<2)return void toast("Chưa có danh sách lớp",1);const n=e.slice();for(let t=n.length-1;t>0;t--){const e=Math.floor(Math.random()*(t+1)),s=n[t];n[t]=n[e],n[e]=s}const s=Array.from({length:t},()=>[]);n.forEach((e,n)=>s[n%t].push(e));const a=["#fef2f2","#fff7ed","#fefce8","#f0fdf4","#eff6ff","#f5f3ff","#fdf2f8","#ecfeff"];document.getElementById("gout").innerHTML=s.map((t,e)=>'<div class="gbox" style="background:'+a[e%a.length]+'"><b>Nhóm '+(e+1)+"</b> ("+t.length+" bạn)"+t.map(t=>"<div>"+esc(t)+"</div>").join("")+"</div>").join("")}

/* ===== Giao vien on VC (V80) ===== */
const VC={bank:null,deck:[],i:0,right:0,wrong:[],chap:'',lock:false,best:+(localStorage.getItem('vcBest')||0)};
window.vcInit=async()=>{if(VC.bank)return;try{const r=await api('/api/vc/questions');VC.bank=r.questions;vcFillChap();vcRenderBest();$('vcStat').textContent=`Ngân hàng: ${r.total} câu · 6 chương · mỗi câu có đáp án và giải thích theo điều luật.`;vcRenderList();}catch(e){$('vcStat').textContent='Chưa tải được ngân hàng câu hỏi, thầy cô thử lại sau.';}};
const VC_TITLES={'Chương I':'Những quy định chung','Chương II':'Nghĩa vụ, quyền của viên chức','Chương III':'Tuyển dụng, sử dụng viên chức','Chương IV':'Khen thưởng, xử lý kỷ luật','Chương V':'Quản lý viên chức','Chương VI':'Điều khoản thi hành'};
function vcFillChap(){const c={};VC.bank.forEach(q=>c[q.chuong]=(c[q.chuong]||0)+1);const ks=Object.keys(c).sort();$('vcChaps').innerHTML=[`<button type="button" class="btn2" data-k="" onclick="vcSetChap('')">📚 Tất cả (${VC.bank.length})</button>`].concat(ks.map(k=>`<button type="button" class="btn2" data-k="${esc(k)}" onclick="vcSetChap('${esc(k)}')">📖 ${esc(k)} (${c[k]})</button>`)).join('');vcSetChap('');$('vcChapList').innerHTML=ks.map(k=>`<div style="display:flex;justify-content:space-between;gap:10px;padding:7px 2px;border-bottom:1px dashed #dbeafe"><span><b>${esc(k)}</b> — ${esc(VC_TITLES[k]||'')}</span><b style="color:#2563eb;white-space:nowrap">${c[k]} câu</b></div>`).join('');}
function vcSetChap(k){VC.chap=k;document.querySelectorAll('#vcChaps button').forEach(b=>{const on=b.dataset.k===k;b.style.background=on?'#2563eb':'';b.style.color=on?'#fff':'';b.style.borderColor=on?'#2563eb':'';});}
function vcRenderBest(){$('vcBest').textContent=VC.best?`🏆 Kỷ lục đúng cao nhất của bạn: ${VC.best}%`:'';}
function vcShuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function vcStart(){if(!VC.bank){toast('Đang tải câu hỏi…');return;}let pool=VC.bank.filter(q=>!VC.chap||q.chuong===VC.chap);pool=((document.getElementById('vcShuffleChk')||{checked:true}).checked?vcShuffle(pool.slice()):pool.slice());const n=+$('vcNum').value;if(n>0)pool=pool.slice(0,n);if(!pool.length){toast('Chưa có câu hỏi cho lựa chọn này','err');return;}VC.deck=pool;VC.i=0;VC.right=0;VC.wrong=[];$('vcIntro').classList.add('hide');$('vcListCard').classList.add('hide');$('vcQuizCard').classList.remove('hide');vcShowQ();$('vcQuizCard').scrollIntoView({behavior:'smooth',block:'start'});}
function vcShowQ(){const q=VC.deck[VC.i];VC.lock=false;var _vp=document.getElementById('vcPop');if(_vp)_vp.remove();$('vcProg').textContent=`Câu ${VC.i+1}/${VC.deck.length}`;$('vcScore').textContent=`Đúng: ${VC.right}`;$('vcBar').style.width=(VC.i/VC.deck.length*100)+'%';$('vcQBox').innerHTML=`<p style="margin:0 0 4px"><span style="background:#eef2ff;color:#3730a3;border-radius:99px;padding:2px 10px;font-size:13.5px;font-weight:600">${esc(q.ref)} · ${esc(q.chuong)}</span></p><p style="font-size:23px;font-weight:700;margin:8px 0 16px;line-height:1.45">${esc(q.q)}</p>`+q.options.map((o,ix)=>`<button type="button" class="btn2" style="display:block;width:100%;text-align:left;margin:8px 0;padding:15px 16px;font-size:17px;line-height:1.5" onclick="vcPick(${ix})"><b>${'ABCD'[ix]}.</b> ${esc(o)}</button>`).join('')+`<div id="vcExp"></div>`;}
const VC_PRAISES=["Ồ, hôm nay có tiến bộ nha!","Một câu đúng. Một bước tiến của nhân loại.","Tuyệt vời, kiến thức vẫn còn hoạt động!","Ủa, nay bật mode thiên tài à?","Slay!","Đỉnh nóc, kịch trần, bay phấp phới!","Flex nhẹ cái trình độ đi bạn!","Không phải dạng vừa đâu nha!","Xin vía cái đầu này!","10 điểm không có nhưng!","Cook được đấy, đầu bếp tri thức!"];const VC_ROASTS=["Ủa alo? Kiến thức đi vắng à?","Bạn khoanh đáp án bằng thực lực hay tâm linh vậy?","Đề dễ thế này mà vẫn tạo được bất ngờ he.","Đáp án đúng đang khóc ở một góc phòng.","Bạn có chắc mình là người đi kiểm tra không?","Sai có chiến lược à?","Xin chúc mừng! Bạn vừa chọn đúng một đáp án sai.","Một pha xử lý đi vào lòng đất.","Đáp án đúng ở ngay trước mắt, nhưng có vẻ hai bạn chưa quen nhau."];
function vcPop(txt,good){try{var o=document.getElementById('vcPop');if(o)o.remove();if(!document.getElementById('vcPopStyle')){var st=document.createElement('style');st.id='vcPopStyle';st.textContent='@keyframes vcPopIn{0%{transform:scale(.6);opacity:0}60%{transform:scale(1.08);opacity:1}100%{transform:scale(1);opacity:1}}';document.head.appendChild(st);}var w=document.createElement('div');w.id='vcPop';w.style.cssText='position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:200;pointer-events:none;padding:20px';w.innerHTML='<div style="animation:vcPopIn .35s ease;max-width:520px;text-align:center;background:'+(good?'#dcfce7':'#fee2e2')+';border:2px solid '+(good?'#16a34a':'#dc2626')+';border-radius:20px;padding:22px 26px;font-size:22px;font-weight:800;line-height:1.45;color:'+(good?'#166534':'#991b1b')+';box-shadow:0 18px 50px rgba(0,0,0,.35)">'+txt+'</div>';document.body.appendChild(w);setTimeout(function(){var x=document.getElementById('vcPop');if(x){x.style.transition='opacity .4s';x.style.opacity='0';setTimeout(function(){var y=document.getElementById('vcPop');if(y)y.remove();},400);}},2600);}catch(e){}}
function vcPick(ix){if(VC.lock)return;VC.lock=true;const q=VC.deck[VC.i];const ok=ix===q.answer;const _pl=VC_PRAISES[Math.floor(Math.random()*VC_PRAISES.length)];const _rl=VC_ROASTS[Math.floor(Math.random()*VC_ROASTS.length)];if(ok)VC.right++;else VC.wrong.push({q:q,picked:ix});$('vcQBox').querySelectorAll('button').forEach((b,j)=>{b.disabled=true;if(j===q.answer)b.style.cssText+=';background:#dcfce7;border-color:#16a34a';else if(j===ix)b.style.cssText+=';background:#fee2e2;border-color:#dc2626';});$('vcScore').textContent=`Đúng: ${VC.right}`;const last=VC.i>=VC.deck.length-1;$('vcExp').innerHTML=`<div style="margin-top:10px;padding:10px 12px;border-radius:10px;background:${ok?'#f0fdf4':'#fef2f2'};border:1px solid ${ok?'#bbf7d0':'#fecaca'}"><b>${ok?'✅ Đúng rồi! '+_pl:'❌ Chưa đúng — đáp án đúng là '+'ABCD'[q.answer]}</b>${ok?'':'<p style="margin:8px 0 0;font-size:16px;line-height:1.5">😅 '+_rl+'</p>'}<p style="margin:8px 0 12px;font-size:16px;line-height:1.55">💡 ${esc(q.explain)} <i>(${esc(q.ref)})</i></p><button type="button" class="btn" onclick="vcNext()">${last?'🏁 Xem kết quả':'Câu tiếp theo →'}</button></div>`;vcPop(ok?'✅ Đúng rồi! '+_pl:'😅 '+_rl,ok);}
function vcNext(){if(VC.i>=VC.deck.length-1){vcResult();return;}VC.i++;vcShowQ();}
function vcResult(){const total=VC.deck.length,pct=total?Math.round(VC.right/total*100):0,diem=(VC.right/Math.max(total,1)*10).toFixed(1).replace('.',',');if(pct>VC.best){VC.best=pct;localStorage.setItem('vcBest',pct);}vcRenderBest();$('vcBar').style.width='100%';$('vcProg').textContent='🏁 Tổng kết';$('vcScore').textContent='';const loai=pct>=90?'Xuất sắc':pct>=80?'Giỏi':pct>=65?'Khá':pct>=50?'Trung bình':'Cần ôn thêm';const col=pct>=80?'#16a34a':pct>=50?'#d97706':'#dc2626';let h=`<div style="text-align:center;padding:8px 4px 2px"><div style="width:128px;height:128px;border-radius:50%;margin:0 auto;background:conic-gradient(${col} ${pct}%,#e5e7eb 0);display:flex;align-items:center;justify-content:center"><div style="width:102px;height:102px;border-radius:50%;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center"><span style="font-size:30px;font-weight:800;color:${col}">${pct}%</span><span style="font-size:12px;color:#64748b">điểm số</span></div></div><p style="font-size:21px;font-weight:800;margin:12px 0 2px">Đúng ${VC.right}/${total} câu</p><p class="muted" style="margin:0">Xếp loại: <b style="color:${col}">${loai}</b> · Điểm thang 10: <b>${diem}</b></p></div>`;
h+=`<div style="display:flex;gap:10px;justify-content:center;margin:14px 0;flex-wrap:wrap"><span style="background:#f1f5f9;border-radius:12px;padding:10px 16px;text-align:center"><b style="font-size:19px">${total}</b><br><small>Tổng số câu</small></span><span style="background:#f0fdf4;border-radius:12px;padding:10px 16px;text-align:center"><b style="font-size:19px;color:#16a34a">✅ ${VC.right}</b><br><small>Câu đúng</small></span><span style="background:#fef2f2;border-radius:12px;padding:10px 16px;text-align:center"><b style="font-size:19px;color:#dc2626">❌ ${VC.wrong.length}</b><br><small>Câu sai</small></span></div>`;
if(VC.wrong.length){h+=`<p style="font-weight:700;margin:14px 0 6px">📌 Các câu làm sai — xem lại để nhớ lâu:</p>`+VC.wrong.map(w=>`<div style="border:1px solid #fecaca;background:#fff7f7;border-radius:12px;padding:10px 14px;margin:8px 0"><p style="margin:0 0 6px;font-weight:600">${esc(w.q.q)} <span class="muted">(${esc(w.q.ref)})</span></p><p style="margin:2px 0;color:#b91c1c">Bạn chọn: <b>${'ABCD'[w.picked]}.</b> ${esc(w.q.options[w.picked])}</p><p style="margin:2px 0;color:#15803d">Đáp án đúng: <b>${'ABCD'[w.q.answer]}.</b> ${esc(w.q.options[w.q.answer])}</p><p class="muted" style="margin:4px 0 0">💡 ${esc(w.q.explain)}</p></div>`).join('');}else{h+=`<p style="text-align:center;font-weight:700;color:#16a34a">🎉 Tuyệt vời — không sai câu nào!</p>`;}
h+=`<div style="text-align:center;margin-top:14px"><button type="button" class="btn" onclick="vcStart()">🔁 Làm đề mới</button> <button type="button" class="btn2" onclick="vcBrowse()">📖 Xem toàn bộ câu hỏi</button></div>`;
$('vcQBox').innerHTML=h;$('vcQuizCard').scrollIntoView({behavior:'smooth',block:'start'});}
function vcShuffleAll(){if(!VC.bank){toast('Đang tải câu hỏi…');return;}VC.deck=vcShuffle(VC.bank.slice());VC.i=0;VC.right=0;VC.wrong=[];$('vcIntro').classList.add('hide');$('vcListCard').classList.add('hide');$('vcQuizCard').classList.remove('hide');vcShowQ();$('vcQuizCard').scrollIntoView({behavior:'smooth',block:'start'});}
function vcBrowse(){if(!VC.bank){toast('Đang tải câu hỏi…');return;}$('vcIntro').classList.add('hide');$('vcQuizCard').classList.add('hide');$('vcListCard').classList.toggle('hide');$('vcListCard').scrollIntoView({behavior:'smooth',block:'start'});}
function vcRenderList(){let h='',cur='';VC.bank.forEach((q,ix)=>{if(q.chuong!==cur){cur=q.chuong;h+=`<h4 style="margin:16px 0 6px">${esc(cur)}</h4>`;}h+=`<details style="border:1px solid #e5e7eb;border-radius:10px;padding:8px 12px;margin:6px 0"><summary style="cursor:pointer"><b>Câu ${ix+1}.</b> ${esc(q.q)} <span class="muted">(${esc(q.ref)})</span></summary><div style="margin-top:8px">${q.options.map((o,j)=>`<p style="margin:3px 0;${j===q.answer?'font-weight:700;color:#15803d':''}">${'ABCD'[j]}. ${esc(o)}${j===q.answer?' ✔':''}</p>`).join('')}<p class="muted" style="margin-top:6px">💡 ${esc(q.explain)}</p></div></details>`;});$('vcList').innerHTML=h;}
