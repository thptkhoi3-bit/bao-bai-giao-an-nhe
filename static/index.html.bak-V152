st.students[t].name=e,nxSave()):n.value=NX.st.students[t].name}function nxNote(t,n){NX.st.students[t].note=n.value.trim(),nxSave()}function nxTx(t){const n=NX.st.students[+t.dataset.i];n.nx=n.nx||{},n.nx[t.dataset.k]=t.value.trim(),nxSave()}function nxRm(t){confirm("Bỏ em "+NX.st.students[t].name+" khỏi danh sách?")&&(NX.st.students.splice(t,1),nxDraw(),nxSave())}function nxAddRow(){const t=prompt("Họ và tên học sinh:");if(t&&t.trim()){if(NX.st.students.length>=NX.info.max_students)return toast("Tối đa "+NX.info.max_students+" em","err");NX.st.students.push({name:t.trim(),note:"",muc:{},pn:{},nx:{}}),nxDraw(),nxSave()}}async function nxLoadList(t){const n=$("nxfile").files[0],e=$("nxpaste").value.trim();if(!n&&!e)return toast("Chọn tệp hoặc dán danh sách trước","err");await busy(t,async()=>{const t=new FormData;n?t.append("file",n):t.append("text",e);const a=await api("/api/nhanxet/parse",{method:"POST",body:t}),s={};NX.st.students.forEach(t=>s[t.name.toLowerCase()]=t),NX.st.students.length&&!confirm(`Thay danh sách hiện tại bằng ${a.names.length} em vừa nhập? (Em trùng tên giữ nguyên mức đạt & nhận xét)`)||(NX.st.students=a.names.map(t=>s[t.toLowerCase()]||{name:t,note:"",muc:{},pn:{},nx:{}}),$("nxpaste").value="",resetDrop("nxfile"),nxView(1),nxSave(),toast(`Đã nhập ${a.names.length} học sinh`))})}async function nxGen(t){if(!NX.st.students.length)return toast("Chưa có học sinh nào","err");NX.st.students.some(t=>t.nx&&Object.values(t.nx).some(t=>t))&&!confirm("Viết lại nhận xét cho cả lớp? Các câu thầy cô đã sửa sẽ được thay mới.")||await busy(t,async()=>{nxAi("Đang viết nhận xét…");const t=await api("/api/nhanxet/generate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({state:NX.st})});NX.st=t.state,NX.info.ai_used=t.ai_used,nxView(2),$("nxtw").scrollLeft=0,$("nxtw").scrollTop=0,nxAi(t.message),toast(t.message)}).finally(()=>{"Đang viết nhận xét…"===$("nxai").textContent&&nxAi()})}async function nxExport(t,n){if(!NX.st.students.length)return toast("Chưa có học sinh nào","err");const e=NX.st.students.filter(t=>!t.nx||!Object.values(t.nx).some(t=>t)).length;e&&!confirm(e+" em chưa có nhận xét. Vẫn xuất tệp?")||await busy(t,async()=>{const t=await api("/api/nhanxet/export",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({state:NX.st,fmt:n})}),e=document.createElement("a");e.href=t.download,e.download=t.item.name,document.body.appendChild(e),e.click(),e.remove(),toast("Đã xuất và lưu vào Kho ("+t.week+")"),KH.stale=1})}const KH={stale:1},KHI={baobai:"📒",giaoan:"📗",giaoan_th:"🧩",de:"📝",nhanxet_xlsx:"📊",nhanxet_docx:"🧒",phieu_bai_tap:"✏️",tro_choi:"🎲",tro_choi_web:"🎮"};function khSize(t){return t>=1048576?(t/1048576).toFixed(1).replace(".",",")+" MB":Math.max(1,Math.round(t/1024))+" KB"}function khTime(t){try{return new Date(t).toLocaleString("vi-VN",{timeZone:"Asia/Ho_Chi_Minh",hour:"2-digit",minute:"2-digit",day:"2-digit",month:"2-digit",year:"numeric"})}catch(n){return t}}async function khLoad(t){try{const t=await api("/api/kho");KH.stale=0,khDraw(t)}catch(t){$("khl").innerHTML=`<p class="muted">${esc(t.message)}</p>`}}function khDraw(t){const n=t.groups.length;$("khstat").textContent=`${n}/${t.max_weeks} tuần · ${khSize(t.total)} / ${khSize(t.cap)}`,$("khbar").style.width=Math.min(100,100*t.total/t.cap).toFixed(1)+"%",$("khl").innerHTML=n?t.groups.map(t=>`<div class="khg"><h3>📅 ${esc(t.label)} <small>· ${t.items.length} tệp</small></h3>${t.items.map(t=>`<div class="khi" data-id="${t.id}"><div><b>${KHI[t.type]||"📄"} ${esc(t.name)}</b><small>${esc(t.type_vi)} · ${esc(khTime(t.created))} · ${khSize(t.size)}</small></div><div class="acts">${"tro_choi_web"===t.type?`<a class="btn" href="/choi/${t.id}" target="_blank" title="Mở trò chơi">▶ Chơi</a>`:""}<a class="btn light" href="/api/kho/file/${t.id}" download="${esc(t.name)}" title="Tải về">⬇ Tải về</a><button class="btn light" style="color:var(--bad)" title="Xoá tệp này" onclick="khDel('${t.id}',this)">🗑 Xoá</button></div></div>`).join("")}</div>`).join(""):'<div class="nxempty">Kho còn trống. Tệp thầy cô tạo (báo bài, giáo án, đề, nhận xét) sẽ tự lưu vào đây.</div>'}async function khDel(t,n){const e=n.closest(".khi").querySelector("b").textContent.trim();if(confirm("Xoá “"+e+"” khỏi kho?"))try{khDraw(await api("/api/kho/file/"+t,{method:"DELETE"})),toast("Đã xoá khỏi kho")}catch(t){toast(t.message,"err")}}document.getElementById("nxfile").addEventListener("change",()=>{$("nxfile").files.length&&($("nxpaste").value="")});
</script>
<link rel="stylesheet" href="/static/game.css?v=__V__"><script src="/static/game.js?v=__V__"></script>
<script>const PF={info:null,st:null,ls:[],sec:"phieu",t:0},PFK={mcq:"Trắc nghiệm A/B/C/D",fill:"Điền chỗ chấm",tf:"Đúng/Sai",match:"Nối",write:"Trả lời / viết"};function pfBlank(){return{lesson:{week:null,mon:"",thu:"",tiet:"",ten:""},muc:"vua",types:["phieu","tuongtac"],src:"tay",phieu:{exercises:[]},khoidong:{name:"",luat:"",questions:[]},game:{questions:[],ochu:{keyword:"",clue:"",rows:[]}}}}async function pfInit(){if(pfWeeks(),!PF.info)try{const t=await api("/api/phieu");PF.info=t.info,PF.st=t.state||pfBlank(),$("pftypes").innerHTML=Object.entries(t.info.types).map(([t,n])=>`<label data-k="${t}"><input type="checkbox" value="${t}" onchange="pfTypes()">${esc(n)}</label>`).join(""),$("pfmuc").innerHTML=Object.entries(t.info.muc).map(([t,n])=>`<button data-k="${t}" onclick="pfMuc('${t}')">${esc(n)}</button>`).join(""),pfFill(),PF.st.lesson.week&&($("pfweek").value=String(PF.st.lesson.week),pfWeek(!0)),pfDraw(),pfAi()}catch(t){toast(t.message,"err")}}function pfWeeks(){const t=ST&&ST.weeks||[],n=$("pfweek").value||(PF.st&&PF.st.lesson.week?String(PF.st.lesson.week):"");$("pfweek").innerHTML=(t.length?'<option value="">Chọn tuần…</option>':'<option value="">Chưa có báo bài gốc – tải ở tab Báo bài</option>')+t.map(t=>`<option value="${t.week}">Tuần ${t.week}${t.range&&t.range.length?" ("+esc(t.range.join(" – "))+")":""}</option>`).join(""),n&&t.some(t=>String(t.week)===n)&&($("pfweek").value=n),$("pfwhint").style.display=$("pfweek").value?"none":""}function pfFill(){const t=PF.st;$("pften").value=t.lesson.ten||"",$("pfmon").value=t.lesson.mon||"",document.querySelectorAll("#pftypes label").forEach(n=>{const e=t.types.includes(n.dataset.k);n.classList.toggle("on",e),n.querySelector("input").checked=e}),document.querySelectorAll("#pfmuc button").forEach(n=>n.classList.toggle("on",n.dataset.k===t.muc))}function pfAi(t){const n=PF.info;n&&($("pfai").textContent=t||(n.ai?`AI: còn ${Math.max(0,n.ai_limit-n.ai_used)}/${n.ai_limit} lượt hôm nay · mỗi lần tạo dùng 1 lượt.`:"Chưa bật AI – thầy cô tự soạn câu hỏi ở khung bên phải."))}async function pfWeek(t){const n=$("pfweek").value;if($("pfwhint").style.display=n?"none":"",PF.st.lesson.week=n?+n:null,t||pfSave(),n){$("pfls").innerHTML='<p class="muted">Đang tải…</p>';try{const t=await api("/api/phieu/lessons?week="+n);PF.ls=t.lessons,PF.hasGa=t.has_ga,$("pfls").innerHTML=t.lessons.length?t.lessons.map((t,n)=>`<button class="pfl${t.ten===PF.st.lesson.ten?" on":""}" data-i="${n}" onclick="pfPick(${n})"><b>${esc(t.mon)}</b> – ${esc(t.ten)}<small>Thứ ${esc(t.thu)} · ${esc(t.tiet)}</small></button>`).join("")+(t.has_ga?'<p class="muted" style="font-size:12px;margin:4px 6px">✓ Có giáo án tuần này – AI sẽ tham khảo.</p>':""):'<p class="muted" style="font-size:13px">Tuần này chưa có bài trong báo bài đã điền – thầy cô gõ tên bài bên dưới.</p>'}catch(t){$("pfls").innerHTML=`<p class="muted">${esc(t.message)}</p>`}}else $("pfls").innerHTML='<p class="muted">Chọn tuần để xem các bài.</p>'}function pfPick(t){const n=PF.ls[t];Object.assign(PF.st.lesson,{mon:n.mon,thu:n.thu,tiet:n.tiet,ten:n.ten}),document.querySelectorAll(".pfl").forEach(n=>n.classList.toggle("on",+n.dataset.i===t)),pfFill(),pfSave(),pfCnt()}function pfLes(){PF.st.lesson.ten=$("pften").value.trim(),PF.st.lesson.mon=$("pfmon").value.trim(),document.querySelectorAll(".pfl").forEach(t=>t.classList.toggle("on",PF.ls[+t.dataset.i]&&PF.ls[+t.dataset.i].ten===PF.st.lesson.ten)),pfSave(),pfCnt()}function pfTypes(){PF.st.types=[...document.querySelectorAll("#pftypes input:checked")].map(t=>t.value),pfFill(),pfSave(),PF.st.types.includes("tuongtac")&&"phieu"===PF.sec&&!PF.st.types.includes("phieu")&&pfSec("cau")}function pfMuc(t){PF.st.muc=t,pfFill(),pfSave()}function pfSave(){pfGames(),clearTimeout(PF.t),PF.t=setTimeout(()=>api("/api/phieu/state",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({state:PF.st})}).catch(()=>{}),700)}function pfSec(t){PF.sec=t,document.querySelectorAll("#pfsec button").forEach(n=>n.classList.toggle("on",n.dataset.s===t)),pfDraw()}function pfCnt(){const t=PF.st,n=t.game;$("pfcnt").textContent=`· ${t.phieu.exercises.length} bài tập · ${t.khoidong.questions.length} câu khởi động · ${n.questions.length} câu trò chơi`}function pfV(t,n){let e=PF.st;const s=t.split(".");s.slice(0,-1).forEach(t=>e=e[t]);const o=s[s.length-1];e[o]="number"===n.type?+n.value||1:n.value,pfSave(),"ochu"===PF.sec&&pfOcStat()}function pfInp(t,n,e,s,o){return`<input type="text" class="${s||"w"}" value="${esc(n||"")}" placeholder="${e||""}" maxlength="${o||300}" oninput="pfV('${t}',this)">`}function pfTa(t,n,e){return`<textarea placeholder="${e||""}" maxlength="300" oninput="pfV('${t}',this)">${esc(n||"")}</textarea>`}function pfDraw(){pfCnt(),pfGames();const t=PF.st,n=PF.sec;let e="";if("phieu"===n)t.phieu.exercises.forEach((t,n)=>{const s=`phieu.exercises.${n}`;e+=`<div class="pfbox" data-ex="${n}"><h4>Bài ${n+1}. <select onchange="pfKind(${n},this.value)">${Object.entries(PFK).map(([n,e])=>`<option value="${n}" ${n===t.kind?"selected":""}>${e}</option>`).join("")}</select>${pfInp(s+".title",t.title,"Lệnh của bài")}<button class="pfx" title="Xoá bài" onclick="pfDel('phieu.exercises',${n})">×</button></h4>`,t.items.forEach((o,i)=>{const a=`${s}.items.${i}`;e+=`<div class="pfit"><span>${String.fromCharCode(97+i)})</span>`,"match"===t.kind?e+=pfInp(a+".left",o.left,"Vế trái")+pfInp(a+".right",o.right,"Vế phải (đúng)"):(e+=pfInp(a+".q",o.q,"fill"===t.kind?"Câu có chỗ trống ___":"tf"===t.kind?"Nhận định":"Câu hỏi")+("mcq"===t.kind?`<button class="pfx" title="Xoá ý" onclick="pfDel('${s}.items',${i})">×</button>`:""),"mcq"===t.kind?e+=`<div class="pfopts">${[0,1,2,3].map(t=>`<label><input type="radio" name="r${n}_${i}" ${o.a==="ABCD"[t]?"checked":""} onchange="pfSetA('${a}','${"ABCD"[t]}')" title="Đáp án đúng">${"ABCD"[t]}.<input type="text" value="${esc((o.options||[])[t]||"")}" maxlength="120" oninput="pfOpt('${a}',${t},this)"></label>`).join("")}</div>`:"tf"===t.kind?e+=`<select onchange="pfV('${a}.a',this)"><option value="Đ" ${"Đ"===o.a?"selected":""}>Đ</option><option value="S" ${"S"===o.a?"selected":""}>S</option></select>`:e+=pfInp(a+".a",o.a,"Đáp án","",300)+("write"===t.kind?`<input type="number" min="1" max="6" value="${o.lines||2}" title="Số dòng để viết" style="width:56px" oninput="pfV('${a}.lines',this)">`:"")),e+=("mcq"===t.kind?"":`<button class="pfx" title="Xoá ý" onclick="pfDel('${s}.items',${i})">×</button>`)+"</div>"}),e+=`<button class="pfadd" onclick="pfAddItem(${n})">＋ Thêm ý</button></div>`}),e+=t.phieu.exercises.length<6?'<button class="pfadd" id="pfaddex" onclick="pfAddEx()">＋ Thêm bài tập</button>':'<p class="muted" style="font-size:13px">Phiếu có tối đa 6 bài.</p>',t.phieu.exercises.length||(e='<div class="nxempty">Chưa có bài tập. Chọn bài rồi bấm “Tạo bằng AI”, hoặc tự soạn.</div>'+e);else if("khoidong"===n){const n=t.khoidong;e=`<div class="pfbox"><h4>Tên trò chơi ${pfInp("khoidong.name",n.name,"VD: Truyền điện","w",120)}</h4>${pfTa("khoidong.luat",n.luat,"Luật chơi…")}</div>`,n.questions.forEach((t,n)=>{e+=`<div class="pfit"><span>${n+1}.</span>${pfInp(`khoidong.questions.${n}.q`,t.q,"Câu hỏi")}${pfInp(`khoidong.questions.${n}.a`,t.a,"Đáp án")}<button class="pfx" onclick="pfDel('khoidong.questions',${n})">×</button></div>`}),e+='<button class="pfadd" onclick="pfAddK()">＋ Thêm câu hỏi</button>'}else if("cau"===n)t.game.questions.forEach((t,n)=>{const s=`game.questions.${n}`;e+=`<div class="pfbox" data-gq="${n}"><div class="pfit"><span>${n+1}.</span>${pfInp(s+".q",t.q,"Câu hỏi")}<button class="pfx" onclick="pfDel('game.questions',${n})">×</button>\n   <div class="pfopts">${[0,1,2,3].map(e=>`<label><input type="radio" name="g${n}" ${t.a==="ABCD"[e]?"checked":""} onchange="pfSetA('${s}','${"ABCD"[e]}')" title="Đáp án đúng">${"ABCD"[e]}.<input type="text" value="${esc((t.options||[])[e]||"")}" maxlength="120" oninput="pfOpt('${s}',${e},this)"></label>`).join("")}</div>${pfInp(s+".explain",t.explain,"Giải thích ngắn (tuỳ chọn)")}</div></div>`}),e+='<button class="pfadd" id="pfaddq" onclick="pfAddQ()">＋ Thêm câu hỏi</button><p class="muted" style="font-size:12.5px">Dùng chung cho Rung chuông vàng, Vòng quay, Ai nhanh ai đúng. Chọn ô tròn ở phương án đúng.</p>',t.game.questions.length||(e='<div class="nxempty">Chưa có câu hỏi trò chơi.</div>'+e);else{const n=t.game.ochu;e=`<div class="pfbox"><h4>Từ khoá hàng dọc ${pfInp("game.ochu.keyword",n.keyword,"VD: CỘNG","",40)} <button class="pfadd" onclick="pfOcRows()">Tạo đủ hàng theo từ khoá</button></h4>${pfInp("game.ochu.clue",n.clue,"Gợi ý từ khoá (tuỳ chọn)","w",200)}</div>`,n.rows.forEach((t,n)=>{e+=`<div class="pfit"><span>${n+1}.</span>${pfInp(`game.ochu.rows.${n}.clue`,t.clue,"Gợi ý hàng ngang")}${pfInp(`game.ochu.rows.${n}.answer`,t.answer,"Đáp án","",40)}<b class="ocst" data-i="${n}"></b><button class="pfx" onclick="pfDel('game.ochu.rows',${n})">×</button></div>`}),e+='<button class="pfadd" onclick="pfAddOc()">＋ Thêm hàng</button> <span id="pfocall"></span><p class="muted" style="font-size:12.5px">Hàng thứ n phải chứa chữ cái thứ n của từ khoá (không tính dấu).</p>'}$("pfed").innerHTML=e,"ochu"===n&&pfOcStat()}function pfOcStat(){const t=PF.st.game.ochu,n=GamePlayer.norm(t.keyword);let e=n.length>=2&&t.rows.length===n.length;document.querySelectorAll(".ocst").forEach(s=>{const o=+s.dataset.i,i=t.rows[o],a=n[o]||"",c=a&&GamePlayer.norm(i.answer).includes(a)&&i.clue;c||(e=!1),s.className="ocst "+(c?"pfok":"pfbad"),s.textContent=c?"✓":a?"thiếu “"+a+"”":"thừa"});const s=$("pfocall");s&&(s.className=e?"pfok":"pfbad",s.textContent=n?e?"✓ Ô chữ hợp lệ":`Cần ${n.length} hàng, mỗi hàng chứa đúng chữ của từ khoá`:"")}function pfGet(t){let n=PF.st;return t.split(".").forEach(t=>n=n[t]),n}function pfDel(t,n){pfGet(t).splice(n,1),pfSave(),pfDraw()}function pfSetA(t,n){pfGet(t).a=n,pfSave()}function pfOpt(t,n,e){const s=pfGet(t);for(s.options=s.options||["","","",""];s.options.length<4;)s.options.push("");s.options[n]=e.value,pfSave()}function pfKind(t,n){PF.st.phieu.exercises[t].kind=n,pfSave(),pfDraw()}function pfAddEx(){PF.st.phieu.exercises.push({kind:"fill",title:"Điền vào chỗ chấm:",items:[{q:"",a:""}]}),pfSave(),pfDraw()}function pfAddItem(t){PF.st.phieu.exercises[t].items.push({q:"",a:"",options:["","","",""],left:"",right:"",lines:2}),pfSave(),pfDraw()}function pfAddK(){PF.st.khoidong.questions.push({q:"",a:""}),pfSave(),pfDraw()}function pfAddQ(){PF.st.game.questions.push({q:"",options:["","","",""],a:"A",explain:""}),pfSave(),pfDraw()}function pfAddOc(){PF.st.game.ochu.rows.push({clue:"",answer:""}),pfSave(),pfDraw()}function pfOcRows(){const t=PF.st.game.ochu,n=GamePlayer.norm(t.keyword).length;for(;t.rows.length<n;)t.rows.push({clue:"",answer:""});t.rows.length=Math.min(t.rows.length,n||t.rows.length),pfSave(),pfDraw()}function pfNeed(){return PF.st.lesson.week?!!PF.st.lesson.ten||(toast("Thầy cô chọn bài (hoặc gõ tên bài) trước nhé","err"),!1):(toast("Thầy cô chọn tuần trước nhé","err"),!1)}const PFJ=t=>({method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(t)});async function pfGen(t){if(pfNeed())return PF.st.types.length?void((PF.st.phieu.exercises.length||PF.st.game.questions.length||PF.st.khoidong.questions.length)&&!confirm("Tạo mới bằng AI? Nội dung đang soạn của các loại đã chọn sẽ được thay.")||await busy(t,async()=>{pfAi("AI đang soạn, thầy cô chờ khoảng 20–40 giây…");try{const t=await api("/api/phieu/generate",PFJ({state:PF.st}));PF.st=t.state,PF.info.ai_used=t.ai_used,pfSec(PF.st.types.includes("phieu")?"phieu":PF.st.types.includes("tuongtac")?"cau":"khoidong"),pfAi(t.message+(t.warnings.length?" "+t.warnings.join(" "):"")),toast(t.message)}catch(t){throw pfAi(t.message+(PF.st.types.includes("tuongtac")?" Thầy cô có thể tự soạn câu hỏi trò chơi ở khung bên phải.":"")),PF.st.types.includes("tuongtac")&&!PF.st.game.questions.length&&pfSec("cau"),t}})):toast("Chọn ít nhất một loại","err")}async function pfExport(t,n){pfNeed()&&await busy(t,async()=>{const t=await api("/api/phieu/export",PFJ({state:PF.st,kind:n})),e=document.createElement("a");e.href=t.download,e.download=t.item.name,document.body.appendChild(e),e.click(),e.remove(),toast("Đã xuất và lưu vào Kho ("+t.week+")"),KH.stale=1})}async function pfNames(){try{if(NX.st&&NX.st.students)return NX.st.students.map(t=>t.name);const t=await api("/api/nhanxet");return(t.state&&t.state.students||[]).map(t=>t.name)}catch(t){return[]}}const PFG=[["rcv","🔔 Rung chuông vàng",3,"cau"],["ochu","🔤 Ô chữ",0,"ochu"],["vq","🎡 Vòng quay",2,"cau"],["an","⚡ Ai nhanh ai đúng",3,"cau"]];function pfGStat(t,n){const e=PF.st.game,s=e.questions.length,o=GamePlayer.prep({questions:e.questions,ochu:e.ochu}),i=o.questions.length;if("ochu"===t){if(o.ochu)return{ok:1,t:`✓ Sẵn sàng · từ khoá ${o.ochu.kw.length} chữ`};const t=e.ochu,n=GamePlayer.norm(t.keyword);return n?n.length<2?{t:"Từ khoá cần ít nhất 2 chữ cái."}:t.rows.length!==n.length?{t:`Cần đủ ${n.length} hàng ngang (đang có ${t.rows.length}).`}:{t:`Hàng ${t.rows.map((t,e)=>t.clue&&GamePlayer.norm(t.answer).includes(n[e])?0:e+1).filter(Boolean).join(", ")} chưa có gợi ý hoặc đáp án chưa chứa chữ của từ khoá.`}:{t:"Chưa có từ khoá hàng dọc – gõ từ khoá (ít nhất 2 chữ) và các hàng ngang."}}return i>=n?{ok:1,t:`✓ Sẵn sàng · ${i} câu hỏi`}:{t:`Cần ít nhất ${n} câu hỏi hợp lệ – còn thiếu ${n-i} câu.`+(s>i?` Có ${s-i} câu chưa đủ (cần câu hỏi, ít nhất 2 phương án và chọn đáp án đúng).`:"")}}function pfGames(){const t=$("pfgcard");if(!t||!PF.st)return;const n=PF.st.types.includes("tuongtac");t.classList.toggle("hide",!n),n&&($("pfgames").innerHTML=PFG.map(([t,n,e,s])=>{const o=pfGStat(t,e);return`<div class="pfgi" data-g="${t}"><b>${n}</b><span class="gst ${o.ok?"ok":"no"}">${esc(o.t)}</span><div class="bs"><button class="gedit" type="button" onclick="pfSec('${s}');pfFocusEd()">✎ ${"ochu"===t?"Soạn ô chữ":"Soạn câu hỏi"}</button><button class="gplay" type="button" ${o.ok?"":"disabled"} title="${o.ok?"Chơi ngay":esc(o.t)}" onclick="pfPlayG('${t}')">▶ Chơi ngay</button></div></div>`}).join(""))}function pfFocusEd(){const t=PF.st;"cau"!==PF.sec||t.game.questions.length||pfAddQ();const n=$("pfed");if(n){n.scrollIntoView({block:"start",behavior:"smooth"});const t=n.querySelector("input[type=text]");t&&setTimeout(()=>t.focus({preventScroll:!0}),300)}}async function pfPlayG(t){const n=PF.st.game,e={title:PF.st.lesson.ten||"Trò chơi",questions:n.questions,ochu:n.ochu};GamePlayer.open(e,{names:await pfNames(),mode:t})}async function pfPlay(){const t=PF.st.game,n={title:PF.st.lesson.ten||"Trò chơi",questions:t.questions,ochu:t.ochu},e=GamePlayer.prep(n);if(!e.questions.length&&!e.ochu)return toast("Chưa có câu hỏi trò chơi hợp lệ (đủ 4 phương án + đáp án) hoặc ô chữ","err");GamePlayer.open(n,{names:await pfNames(),mode:e.questions.length?"rcv":"ochu"})}async function pfSaveGame(t){pfNeed()&&await busy(t,async()=>{const t=await api("/api/phieu/game/save",PFJ({state:PF.st})),n=location.origin+t.play;$("pflink").innerHTML=`Đã lưu vào Kho (${esc(t.week)}). Link chơi (chỉ thầy cô mở được khi đã đăng nhập): <a href="${esc(t.play)}" target="_blank" id="pfplaylink">${esc(n)}</a>`;try{await navigator.clipboard.writeText(n)}catch(t){}toast("Đã lưu trò chơi vào Kho"),KH.stale=1})}
</script>
<script>!function(){const t=/BaoBaiApp/.test(navigator.userAgent)||matchMedia("(display-mode: standalone)").matches||navigator.standalone;let n=null;const a=document.getElementById("instbtn");if("serviceWorker"in navigator&&(!navigator.webdriver||window.__swtest)&&("https:"===location.protocol||"127.0.0.1"===location.hostname||"localhost"===location.hostname))try{navigator.serviceWorker.register("/sw.js").catch(()=>{})}catch(t){}addEventListener("beforeinstallprompt",e=>{e.preventDefault(),n=e,t||a&&a.classList.remove("hide")}),addEventListener("appinstalled",()=>{n=null,a&&a.classList.add("hide"),toast("Đã cài ứng dụng – mở từ màn hình chính nhé")}),window.pwaInstall=async()=>{if(!n)return toast('Trình duyệt chưa cho cài: dùng menu ⋮ → "Cài đặt ứng dụng" / "Thêm vào màn hình chính"');n.prompt();try{await n.userChoice}catch(t){}n=null,a.classList.add("hide")}}();
