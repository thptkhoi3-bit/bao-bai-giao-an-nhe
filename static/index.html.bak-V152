        <div style="flex:1;min-width:220px"><label>Nhập mã phòng hoặc tên phòng…</label><input id="cvRoomSearch" type="text" placeholder="VD: K7X2PQ hoặc Giao lưu" style="width:100%" oninput="cvRenderRooms()"></div>
        <div><label>Tất cả chế độ</label><select id="cvRoomModeF" onchange="cvRenderRooms()"><option value="">Tất cả chế độ</option><option value="nhanh">Cờ nhanh</option><option value="chop">Cờ chớp</option><option value="tieuchuan">Cờ tiêu chuẩn</option></select></div>
        <button type="button" class="cv-btn ghost" onclick="cvLoadRooms()">↻ Làm mới</button>
      </div>
    </div>
