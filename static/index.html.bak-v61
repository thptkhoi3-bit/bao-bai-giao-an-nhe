<div id="gvover" class="hide gvoverlay"><div class="gvhead"><b>👁️ Xem giáo án</b><span class="muted" id="gvinfo"></span><span style="flex:1"></span><a id="gvpdf" href="#" target="_blank" rel="noopener" class="btn2">📄 Mở PDF</a><a id="gvdl" href="#" class="btn2">⬇️ Tải Word</a><button class="btn2" onclick="gvClose()">✖ Đóng</button></div><div class="gvbody" id="gvbody"><p class="muted" style="text-align:center">Đang mở giáo án…</p></div></div>

<div id="pwov" class="hide pwov"><div class="pwcard"><h3>🔑 Đổi mật khẩu</h3><label>Mật khẩu hiện tại <input type="password" id="pwold" autocomplete="current-password"></label><label>Mật khẩu mới (tối thiểu 6 ký tự) <input type="password" id="pwnew" autocomplete="new-password"></label><label>Nhập lại mật khẩu mới <input type="password" id="pwnew2" autocomplete="new-password"></label><p class="pwmsg" id="pwmsg"></p><div class="row"><button class="btn" id="pwsave" onclick="pwSave()">💾 Lưu mật khẩu</button><button class="btn2" onclick="pwClose()">Huỷ</button></div></div></div>
<div id="giov" class="hide pwov"><div class="pwcard"><h3>📝 Thông tin giáo án</h3><p class="muted" style="margin:4px 0 8px">Tự ghi vào đầu trang mỗi lần tạo giáo án — điền 1 lần, web nhớ theo tài khoản.</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><label class="f" style="margin:0">Trường<input id="gi_truong" type="text" placeholder="VD: Tiểu học Phật Tích"></label><label class="f" style="margin:0">Họ tên giáo viên<input id="gi_gv" type="text" placeholder="VD: Lê Đắc Đạt"></label><label class="f" style="margin:0">Lớp<input id="gi_lop" type="text" placeholder="VD: 2A1"></label><label class="f" style="margin:0">Năm học<input id="gi_namhoc" type="text" placeholder="VD: 2026 - 2027"></label></div><div class="row" style="margin-top:10px"><button class="btn" type="button" onclick="gaInfoSave(this)"><span class="spin"></span>💾 Lưu thông tin</button><button class="btn2" type="button" onclick="giClose()">Đóng</button></div></div></div> <script>
(function(){

"use strict";
/* ============ TIỆN ÍCH ============ */
const $ = id => document.getElementById(id);
const cv = $("gvStage"), ctx = cv.getContext("2d");
const W = 960, H = 540;
const rand = (a,b) => a + Math.random()*(b-a);
const irand = (a,b) => Math.floor(rand(a, b+1));
const shuffle = arr => { const a=[...arr]; for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; };
const clamp = (v,a,b) => Math.max(a, Math.min(b, v));
const lerp = (a,b,t) => a+(b-a)*t;
const ease = t => 1-Math.pow(1-t,3);
function rr(x,y,w,h,r){ ctx.beginPath(); ctx.moveTo(x+r,y); ctx.arcTo(x+w,y,x+w,y+h,r); ctx.arcTo(x+w,y+h,x,y+h,r); ctx.arcTo(x,y+h,x,y,r); ctx.arcTo(x,y,x+w,y,r); ctx.closePath(); }
function circle(x,y,r){ ctx.beginPath(); ctx.arc(x,y,r,0,7); }
function shortName(n){const w=String(n).trim().split(/\s+/);return w.length>2?w.slice(-2).join(" "):n}
function label(text,x,y,size=15,color="#4A3220",bold=true){
  if(typeof state!=="undefined"&&state.actors&&state.actors.length>=26)size*=.85;
  ctx.font = `${bold?800:600} ${size}px "Segoe UI", sans-serif`;
  const _lw=ctx.measureText(text).width; if(_lw>84){size=Math.max(8.5,size*84/_lw); ctx.font=`${bold?800:600} ${size}px "Segoe UI", sans-serif`;}
  ctx.textAlign="center"; ctx.textBaseline="middle";
  ctx.lineWidth = 5.5; ctx.strokeStyle = "rgba(255,255,255,.92)"; ctx.strokeText(text,x,y);
  ctx.fillStyle = color; ctx.fillText(text,x,y);
}

/* ============ ÂM THANH (WebAudio, không cần file) ============ */
let AC = null;
function ac(){ if(!AC) AC = new (window.AudioContext||window.webkitAudioContext)(); if(AC.state==="suspended") AC.resume(); return AC; }
function tone(freq, t0, dur, type="sine", vol=.18, slide=0){
  if(!$("gvSound").checked) return;
  try{
    const a=ac(), o=a.createOscillator(), g=a.createGain(), now=a.currentTime+t0;
    o.type=type; o.frequency.setValueAtTime(freq, now);
    if(slide) o.frequency.exponentialRampToValueAtTime(Math.max(40,freq+slide), now+dur);
    g.gain.setValueAtTime(0, now); g.gain.linearRampToValueAtTime(vol, now+.015);
    g.gain.exponentialRampToValueAtTime(.001, now+dur);
    o.connect(g).connect(a.destination); o.start(now); o.stop(now+dur+.05);
  }catch(e){}
}
const sndTick  = () => tone(880, 0, .07, "square", .06);
const sndPop   = () => tone(520, 0, .12, "sine", .22, 500);
const sndBoing = () => tone(300, 0, .18, "sine", .2, -180);
function sndWin(){ [523,659,784,1047].forEach((f,i)=>tone(f, i*.11, .22, "triangle", .2)); tone(1319,.48,.4,"triangle",.2); tone(1568,.6,.5,"sine",.11); noiseHit(.05,.5,3200,0.7,.045,"highpass"); }
function sndFake(){ tone(392,0,.12,"triangle",.16); tone(330,.1,.18,"triangle",.16); }
/* ============ ÂM THANH RIÊNG CHO TỪNG TRÒ ============ */
let _noiseBuf = null;
function noiseBuf(){
  if(_noiseBuf) return _noiseBuf;
  const a = ac(), b = a.createBuffer(1, a.sampleRate * .5, a.sampleRate), d = b.getChannelData(0);
  for(let i=0;i<d.length;i++) d[i] = Math.random()*2-1;
  return _noiseBuf = b;
}
function noiseHit(t0, dur, freq, q, vol, type="bandpass"){
  if(!$("gvSound").checked) return;
  try{
    const a = ac(), src = a.createBufferSource(); src.buffer = noiseBuf();
    const f = a.createBiquadFilter(); f.type = type; f.frequency.value = freq; f.Q.value = q;
    const g = a.createGain(), now = a.currentTime + t0;
    g.gain.setValueAtTime(0, now); g.gain.linearRampToValueAtTime(vol, now + .015);
    g.gain.exponentialRampToValueAtTime(.001, now + dur);
    src.connect(f); f.connect(g); g.connect(a.destination);
    src.start(now); src.stop(now + dur + .05);
  }catch(e){}
}
const sndCluck  = () => { tone(640, 0, .07, "square", .11, -190); tone(545, .09, .085, "square", .11, -150); };
const sndSquawk = () => { tone(930, 0, .2, "sawtooth", .09, -570); noiseHit(0, .13, 1900, 1, .05); };
const sndStep   = () => noiseHit(0, .045, 850, .8, .03);
const sndDing   = () => { tone(1568, 0, .35, "sine", .13); tone(2093, .02, .3, "sine", .06); };
const sndSwitch = () => { noiseHit(0, .05, 2500, 1, .11, "highpass"); tone(185, 0, .07, "square", .09); };
const sndLights = () => { sndSwitch(); [523,659,784].forEach((f,i)=>tone(f, .06 + i*.03, .55, "triangle", .09)); };
function cluckTrio(){ sndCluck(); setTimeout(sndCluck, 160); setTimeout(sndCluck, 330); }
function noiseSweep(t0, dur, f0, f1, vol){
  if(!$("gvSound").checked) return;
  try{
    const a = ac(), src = a.createBufferSource(); src.buffer = noiseBuf();
    const f = a.createBiquadFilter(); f.type = "bandpass"; f.Q.value = 1.1;
    const g = a.createGain(), now = a.currentTime + t0;
    f.frequency.setValueAtTime(f0, now); f.frequency.exponentialRampToValueAtTime(Math.max(f1, 1), now + dur);
    g.gain.setValueAtTime(0, now); g.gain.linearRampToValueAtTime(vol, now + dur*.3);
    g.gain.exponentialRampToValueAtTime(.001, now + dur);
    src.connect(f); f.connect(g); g.connect(a.destination);
    src.start(now); src.stop(now + dur + .05);
  }catch(e){}
}
const sndWhoosh  = () => noiseSweep(0, .8, 300, 2400, .12);
const sndSplash  = () => { noiseSweep(0, .3, 1600, 500, .14); noiseHit(.05, .25, 800, .7, .09, "lowpass"); };
const sndWhistle = () => { tone(2350, 0, .16, "square", .045); tone(2350, .2, .32, "square", .045); };
const sndRoar    = () => { tone(160, 0, .4, "sawtooth", .085, -70); tone(110, .05, .42, "sawtooth", .065, -40); noiseHit(.02, .3, 500, .8, .05, "lowpass"); };
const sndChomp   = () => { tone(220, 0, .07, "square", .11, -120); noiseHit(0, .06, 1200, 1, .07); };
const sndSparkle = () => [1047,1319,1568,2093].forEach((f,i)=>tone(f, i*.06, .25, "sine", .08));
const sndBeam    = () => { tone(880, 0, .5, "sine", .05, -500); tone(1320, .1, .4, "sine", .04, -700); };

/* ============ TRẠNG THÁI ============ */
const state = {
  game: "trung", playing: false,
  players: [],           // {id, name}
  called: [],            // names theo thứ tự
  actors: [],            // vị trí/trạng thái trên sân
  round: null,           // thông tin lượt đang chơi
};
function currentPlayers(){
  const tn = gvTypedNames();
  if(tn) return tn.map((name,i)=>({ id:i, name }));
  const ns = gvNames();
  if(ns) return ns.map((name,i)=>({ id:i, name }));
  const n = $("gvCnt") ? clamp(+$("gvCnt").value || 20, 2, 50) : 20;
  return Array.from({length:n}, (_,i)=>({ id:i, name:"Bạn " + (i+1) }));
}
function activePool(){
  const all = currentPlayers();
  if(!$("gvSit").checked) return all;
  return all.filter(p => !state.called.some(c => c.id === p.id));
}
function refreshCounter(){
  const all = currentPlayers(), pool = activePool();
  $("gvCounter").textContent = `CÒN ${pool.length}/${all.length} BẠN CHƯA ĐƯỢC GỌI`;
  renderCalled();
}
function renderCalled(){
  const el = $("gvCalled");
  el.innerHTML = state.called.length
    ? state.called.map(c=>`<span class="tag">${c.name}</span>`).join("")
    : `<span class="none">Chưa bạn nào — bấm Bắt đầu để chơi lượt đầu tiên!</span>`;
}

/* ============ NHÂN VẬT ============ */
const SKIN = ["#FFD9B3","#F2C094","#E8AC7E","#FFD9B3","#C68863"];
const HAIRC = ["#3A2A1A","#1F1A17","#5A3A1A","#2E2A4A","#6E3B12"];
const PANTS = ["#2B4C9A","#7A4FA3","#1E7A5A","#B3541E","#37474F"];
function dustFx(R, x, y, dt, spread){
  const g = R.g; g.dust = g.dust || [];
  if(Math.random() < .55) g.dust.push({ x: x + rand(-spread, spread), y: y + rand(-2, 2), r: rand(3, 6), a: .45, t: 0 });
  for(let i = g.dust.length - 1; i >= 0; i--){ const p = g.dust[i]; p.t += dt; p.x += 6 * dt; p.y -= 7 * dt; p.r += 9 * dt; p.a = .45 * (1 - p.t / .55); if(p.t > .55) g.dust.splice(i, 1); }
  for(const p of g.dust){ ctx.fillStyle = `rgba(216,198,162,${Math.max(0, p.a)})`; circle(p.x, p.y, p.r); ctx.fill(); }
}
function drawKid(x, y, s, seed, opts={}){
  const kim = GV_KID[seed % GV_KID.length];
  if(imgReady(kim)){
    ctx.save(); ctx.translate(x, y);
    if(opts.jump) ctx.translate(0, -Math.abs(Math.sin(opts.jump))*7);
    if(opts.spin) ctx.rotate(Math.sin(opts.spin)*.12);
    const hh = 64*s, ww = hh * kim.naturalWidth / kim.naturalHeight;
    ctx.drawImage(kim, -ww/2, 25*s - hh, ww, hh);
    ctx.restore();
    if(opts.name) label(opts.name, x, y - 47*s, 14.5);
    if(opts.ring){ ctx.strokeStyle = "#43D17C"; ctx.lineWidth = 4; circle(x, y-8*s, 30*s); ctx.stroke(); }
    return;
  }
  // học sinh: áo trắng, khăn quàng đỏ — s = chiều cao khoảng 54*s
  const skin = SKIN[seed%SKIN.length], hair = HAIRC[seed%HAIRC.length], pants = PANTS[seed%PANTS.length];
  ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
  if(opts.jump) ctx.translate(0, -Math.abs(Math.sin(opts.jump))*7);
  if(opts.spin) ctx.rotate(Math.sin(opts.spin)*.12);
  ctx.fillStyle = pants; rr(-9, 8, 8, 15, 3); ctx.fill(); rr(1, 8, 8, 15, 3); ctx.fill();      // chân
  ctx.fillStyle = "#fff"; rr(-12, -12, 24, 22, 6); ctx.fill();                                  // áo trắng
  ctx.strokeStyle = "#D8C9AE"; ctx.lineWidth = 1.4; rr(-12,-12,24,22,6); ctx.stroke();
  ctx.fillStyle = "#E53935"; ctx.beginPath(); ctx.moveTo(-4,-11); ctx.lineTo(4,-11); ctx.lineTo(0,-2); ctx.closePath(); ctx.fill(); // khăn quàng
  ctx.fillStyle = skin; circle(-13, -4, 4.4); ctx.fill(); circle(13, -4, 4.4); ctx.fill();      // tay
  ctx.fillStyle = skin; circle(0, -22, 10.5); ctx.fill();                                       // đầu
  ctx.fillStyle = hair; ctx.beginPath(); ctx.arc(0, -24.5, 10.5, Math.PI*1.02, Math.PI*1.98); ctx.fill(); // tóc
  if(!opts.noFace){
    ctx.fillStyle = "#333"; circle(-3.6, -21, 1.25); ctx.fill(); circle(3.6, -21, 1.25); ctx.fill();
    ctx.strokeStyle = "#333"; ctx.lineWidth = 1.1; ctx.beginPath();
    if(opts.ooh){ circle(0,-16.5,2.4); ctx.stroke(); } else ctx.arc(0,-18.5,3.4, .25*Math.PI, .75*Math.PI); ctx.stroke();
  }
  ctx.restore();
  if(opts.name) label(opts.name, x, y - 42*s, 14.5);
  if(opts.ring){ ctx.strokeStyle = "#43D17C"; ctx.lineWidth = 4; circle(x, y-8*s, 30*s); ctx.stroke(); }
}
/* ============ BỘ MÁY VÒNG CHƠI ============ */
const GAMES = {};   // mỗi trò đăng ký: {icon, name, desc, layout(actors), begin(R), draw(now, R)}
let confetti = [];
function spawnConfetti(x, y){
  for(let i=0;i<110;i++) confetti.push({ x:x+rand(-60,60), y:y+rand(-20,20), vx:rand(-160,160), vy:rand(-320,-60),
    g:520, life:rand(1.4,2.4), t:0, c:["#F0541E","#F5A623","#43D17C","#2B7FFF","#E2543E","#9B59B6"][irand(0,5)], s:rand(4,8), rot:rand(0,6), vr:rand(-6,6) });
}
function drawConfetti(dt){
  confetti = confetti.filter(p => (p.t += dt) < p.life);
  for(const p of confetti){
    p.x += p.vx*dt; p.y += p.vy*dt; p.vy += p.g*dt; p.rot += p.vr*dt;
    ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot); ctx.globalAlpha = clamp(1.4 - p.t/p.life, 0, 1);
    ctx.fillStyle = p.c; ctx.fillRect(-p.s/2, -p.s/2, p.s, p.s*.62); ctx.restore();
  }
  ctx.globalAlpha = 1;
}
function showBanner(b1, b2, b3){
  $("gvB1").textContent = b1||""; $("gvB2").textContent = b2||"";
  const el3 = $("gvB3"); if(b3){ el3.textContent = b3; el3.style.display="inline-block"; } else el3.style.display="none";
  $("gvBanner").style.display = "flex";
}
function hideBanner(){ $("gvBanner").style.display = "none"; }

function makeActors(){
  const pool = activePool();
  state.actors = pool.map((p,i)=>({ p, seed:i*7+3, x:0, y:0, s:1, st:"idle", prog:0, gone:false, flash:0 }));
  const g = GAMES[state.game];
  if(g) g.layout(state.actors);
}
function startRound(){
  if(state.playing) return;
  let pool = activePool();
  if(pool.length === 0){ state.called = []; refreshCounter(); pool = activePool(); }
  if(pool.length < 2){ showBanner("Cần ít nhất 2 bạn để chơi!", "", ""); setTimeout(hideBanner, 1600); return; }
  if($("gvShuffle").checked || state.actors.length !== pool.length) makeActors();
  const winner = state.actors[irand(0, state.actors.length-1)];
  const dur = Math.max(6, +$("gvDur").value - 0.5 - Math.random()); // mỗi lượt lệch ngẫu nhiên 0,5–1,5 giây như bản gốc
  const others = shuffle(state.actors.filter(a => a !== winner));
  const nFake = Math.min(others.length, irand(2,3));
  const fakes = [];
  for(let i=0;i<nFake;i++){
    fakes.push({ at: dur * (0.16 + 0.62*(i+ rand(.2,.8)) / Math.max(1,nFake)) , actor: others[i], done:false });
  }
  fakes.sort((a,b)=>a.at-b.at);
  const R = { winner, dur, t:0, fakes, phase:"play", twist:$("gvTwist").checked, decoy: others[0]||null,
              twistShown:false, revealed:false, target:null, targetKind:"", g:{} };
  state.round = R;
  state.playing = true;
  hideBanner();
  $("gvStart").disabled = true; $("gvStart").textContent = "Đang chọn…";
  $("gvTimer").style.display = "block";
  const g = GAMES[state.game]; if(g && g.begin) g.begin(R);
}
function endRound(){
  const R = state.round; if(!R || R.phase === "done") return;
  // vào pha "done": giữ nguyên cảnh ăn mừng + bảng thông báo (trò có holdAfter, vd 5 giây) rồi mới dọn sân
  R.phase = "done"; R.doneT = 0;
  if(!state.called.some(c => c.id === R.winner.p.id)) state.called.push({ id: R.winner.p.id, name: R.winner.p.name });
  $("gvTimer").style.display = "none"; $("gvTimer").classList.remove("urgent");
  refreshCounter();
  const g = GAMES[state.game];
  showBanner(g.resultText ? g.resultText(R.winner) : "Người được gọi là", R.winner.p.name + "!", R.challenge || "");
  if(!((g && g.holdAfter) > 0)) finishRound();
}
function finishRound(){
  if(!state.round) return;
  state.playing = false; state.round = null;
  $("gvStart").disabled = false; $("gvStart").textContent = "Chơi lượt mới!";
  $("gvTimer").style.display = "none"; $("gvTimer").classList.remove("urgent");
  refreshCounter();
}
function stepRound(dt){
  const R = state.round; if(!R) return;
  if(R.phase === "done"){ R.doneT += dt; const gd = GAMES[state.game]; if(R.doneT >= ((gd && gd.holdAfter) || 0)) finishRound(); return; }
  R.t += dt;
  const remain = R.dur - R.t;
  $("gvTimer").textContent = "⏱ " + Math.max(0, Math.ceil(remain));
  $("gvTimer").classList.toggle("urgent", remain <= 5.05);
  if(R.phase === "play" && remain <= 5 && remain > 0){ // tick tăng nhịp dần ở 5 giây cuối
    R._tickT = (R._tickT || 0) - dt;
    if(R._tickT <= 0){ R._tickT = .14 + (remain / 5) * .4; if(state.soundOn) sndTick(); }
  }
  // sự kiện bắt hụt
  for(const f of R.fakes){
    if(!f.done && R.t >= f.at && R.t < R.dur - 2.4){ f.done = true; R.target = f.actor; R.targetKind = "fake"; R.targetT = 0; sndFake(); }
  }
  if(R.target){ R.targetT += dt; if(R.targetT > 1.25 && R.phase==="play"){ R.target = null; R.targetKind=""; } }
  // lộ diện ở 2 giây cuối
  if(remain <= 2 && R.phase === "play"){
    R.phase = "reveal"; R.target = R.winner; R.targetKind = "win"; R.targetT = 0;
    if(R.twist && R.decoy && R.decoy !== R.winner){
      showBanner(GAMES[state.game].resultText ? GAMES[state.game].resultText(R.decoy) : "Tưởng bắt được rồi…", R.decoy.p.name + "!", ""); sndBoing();
    } else {
      finishReveal();
    }
  }
  if(R.phase === "reveal" && R.twist && !R.twistShown && remain <= 0.9){
    R.twistShown = true;
    if(state.game === "qua" && !R.challenge) R.challenge = "🎯 " + CHALLENGES[irand(0, CHALLENGES.length-1)];
    showBanner("Lật kèo! Người được gọi thật là", R.winner.p.name + "!", R.challenge || "");
    spawnConfetti(R.winner.x, R.winner.y - 40); sndWin(); const _og = GAMES[state.game]; if(_og && _og.onReveal) _og.onReveal();
  }
  if(R.t >= R.dur) endRound();
}
function finishReveal(){
  const R = state.round; if(!R || R.revealed) return;
  R.revealed = true;
  const g = GAMES[state.game];
  if(state.game === "qua" && !R.challenge) R.challenge = "🎯 " + CHALLENGES[irand(0, CHALLENGES.length-1)];
  showBanner(g.resultText ? g.resultText(R.winner) : "Người được gọi là", R.winner.p.name + "!", R.challenge || "");
  spawnConfetti(R.winner.x, R.winner.y - 40); sndWin(); const _og = GAMES[state.game]; if(_og && _og.onReveal) _og.onReveal();
}
const CHALLENGES = [
  "Đặt một câu với từ mới học", "Đọc to một đoạn trong bài học", "Nhẩm nhanh một phép tính cô/trò đưa ra",
  "Kể một điều em thích ở bạn bên cạnh", "Hát một câu trong bài hát yêu thích", "Đoán nghĩa của một từ mới",
  "Viết một từ có vần giống từ mẫu", "Làm động tác mô tả một con vật cho cả lớp đoán",
  "Nói một câu tiếng Anh em vừa học", "Kể tên 3 thứ có trong cặp sách của em",
];
/* vòng lặp vẽ chính */
let lastTs = 0;
function loop(ts){
  const dt = Math.min(.05, (ts - lastTs)/1000 || 0); lastTs = ts;
  const now = ts/1000;
  if(state.playing) stepRound(dt);
  const g = GAMES[state.game];
  ctx.clearRect(0,0,W,H);
  // hiệu ứng máy quay lúc lộ diện: phóng nhẹ vào giữa sân + rung ngắn
  let zk = 0, shx = 0, shy = 0;
  const Rd = state.round;
  if(Rd && Rd.phase === "done" && Rd.doneT !== undefined){
    const fx = Rd.doneT;
    if(fx < 0.5) zk = 0.055 * (1 - Math.pow(1 - fx/0.5, 3));
    else zk = Math.max(0, 0.055 - (fx - 0.5) * 0.012);
    if(fx < 0.45){ const m = (0.45 - fx) * 16; shx = Math.sin(fx*80) * m; shy = Math.cos(fx*67) * m * 0.6; }
  }
  ctx.save();
  if(zk > 0 || shx || shy){ ctx.translate(480 + shx, 290 + shy); ctx.scale(1 + zk, 1 + zk); ctx.translate(-480, -290); }
  if(g) g.draw(now, state.round, dt);
  if(Rd && Rd.decoy && Rd.decoy !== Rd.winner && (Rd.twistShown || Rd.phase === "done")){
    const dc = Rd.decoy, pu = 1 + Math.sin(now * 6) * .06;
    const gg = ctx.createRadialGradient(dc.x, dc.y - 12, 6, dc.x, dc.y - 12, 56 * pu);
    gg.addColorStop(0, "rgba(255,213,74,.40)"); gg.addColorStop(1, "rgba(255,213,74,0)");
    ctx.fillStyle = gg; circle(dc.x, dc.y - 12, 56 * pu); ctx.fill();
    ctx.strokeStyle = "rgba(255,183,28,.85)"; ctx.lineWidth = 3; circle(dc.x, dc.y - 12, 47 * pu); ctx.stroke();
  }
  ctx.restore();
  drawConfetti(dt);
  /* khung hình do gvLoop điều khiển */
}

/* ============ TRÒ 1: TRỘM TRỨNG ============ */
function bubble(text, x, y){
  ctx.font = '800 17px "Segoe UI", sans-serif';
  const w = ctx.measureText(text).width + 24;
  ctx.fillStyle = "rgba(255,255,255,.97)"; rr(x-w/2, y-19, w, 31, 15); ctx.fill();
  ctx.strokeStyle = "#D89B4E"; ctx.lineWidth = 1.6; rr(x-w/2, y-19, w, 31, 15); ctx.stroke();
  ctx.fillStyle = "#B3541E"; ctx.textAlign="center"; ctx.textBaseline="middle"; ctx.fillText(text, x, y-3);
}
function moveToward(o, tx, ty, speed, dt){
  const dx = tx-o.x, dy = ty-o.y, d = Math.hypot(dx,dy);
  if(d < 4) return true;
  o.x += dx/d * Math.min(d, speed*dt); o.y += dy/d * Math.min(d, speed*dt);
  o.face = dx >= 0 ? 1 : -1;
  return d < 26;
}
function sky(top="#8ED8FF", bot="#E8F9FF"){ const g = ctx.createLinearGradient(0,0,0,H); g.addColorStop(0,top); g.addColorStop(1,bot); ctx.fillStyle = g; ctx.fillRect(0,0,W,H); }
function sun(x,y,r=34){ ctx.fillStyle="#FFD93B"; circle(x,y,r); ctx.fill(); ctx.strokeStyle="#F5A623"; ctx.lineWidth=3;
  for(let i=0;i<8;i++){ const a=i/8*Math.PI*2; ctx.beginPath(); ctx.moveTo(x+Math.cos(a)*(r+4), y+Math.sin(a)*(r+4)); ctx.lineTo(x+Math.cos(a)*(r+13), y+Math.sin(a)*(r+13)); ctx.stroke(); } }
function cloud(x,y,s=1){ ctx.fillStyle="rgba(255,255,255,.92)"; circle(x,y,20*s); ctx.fill(); circle(x+22*s,y+3*s,16*s); ctx.fill(); circle(x-22*s,y+4*s,15*s); ctx.fill(); rr(x-38*s,y-2*s,76*s,16*s,8*s); ctx.fill(); }

function drawHen(x, y, s, face=1, t=0, mode="run"){
  ctx.save(); ctx.translate(x,y); ctx.scale(s*face, s);
  ctx.fillStyle = "rgba(90,60,20,.18)"; ctx.beginPath(); ctx.ellipse(0, 26, 26, 5, 0, 0, 7); ctx.fill(); // bóng
  if(mode === "sit"){
    ctx.translate(0, 7);
    ctx.fillStyle = "#fff"; ctx.beginPath(); ctx.ellipse(0, 4, 28, 16.5, 0, 0, 7); ctx.fill();
    ctx.strokeStyle = "#E3D5BE"; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.ellipse(0, 4, 28, 16.5, 0, 0, 7); ctx.stroke();
    ctx.fillStyle = "#FBF7EC"; ctx.beginPath(); ctx.ellipse(-3, 6, 19, 10.5, -.15, 0, 7); ctx.fill(); // cánh phủ trứng
    ctx.strokeStyle = "#E8DCC2"; ctx.lineWidth = 1.3;
    for(let i=-2;i<3;i++){ ctx.beginPath(); ctx.moveTo(-16 + i*6, 2 + Math.abs(i)*1.4); ctx.quadraticCurveTo(-12 + i*6, 9, -6 + i*6, 11); ctx.stroke(); }
    ctx.fillStyle = "#F7F3E8"; ctx.beginPath(); ctx.moveTo(-22,-4); ctx.lineTo(-38,-16); ctx.lineTo(-31,0); ctx.lineTo(-39,-3); ctx.lineTo(-25,7); ctx.closePath(); ctx.fill(); // đuôi
    ctx.fillStyle = "#fff"; circle(21, -6, 11); ctx.fill(); ctx.strokeStyle = "#E3D5BE"; ctx.beginPath(); ctx.arc(21,-6,11,0,7); ctx.stroke();
    ctx.fillStyle = "#E53935"; circle(17,-17,4.4); ctx.fill(); circle(22.6,-19,5); ctx.fill(); circle(27.6,-16.6,4); ctx.fill(); // mào
    ctx.fillStyle = "#F5A623"; ctx.beginPath(); ctx.moveTo(30,-7); ctx.lineTo(41,-3.4); ctx.lineTo(30,-.6); ctx.closePath(); ctx.fill(); // mỏ
    ctx.fillStyle = "#E53935"; ctx.beginPath(); ctx.ellipse(25, 2.6, 3.2, 4.6, 0, 0, 7); ctx.fill(); // yếm
    ctx.strokeStyle = "#333"; ctx.lineWidth = 1.8; ctx.beginPath(); ctx.moveTo(20.4,-7.6); ctx.lineTo(27,-7.6); ctx.stroke(); // mắt lim dim
    ctx.restore(); return;
  }
  const runPh = t * 13, bob = Math.abs(Math.sin(runPh)) * (mode === "proud" ? 5 : 3.4);
  ctx.translate(0, -bob);
  ctx.fillStyle = "#F7F3E8"; ctx.beginPath(); ctx.moveTo(-20,-6); ctx.lineTo(-37,-19); ctx.lineTo(-30,-2); ctx.lineTo(-39,-6); ctx.lineTo(-24,5); ctx.closePath(); ctx.fill(); // đuôi
  ctx.fillStyle = "#fff"; ctx.beginPath(); ctx.ellipse(0, 0, 24.5, 17, 0, 0, 7); ctx.fill();
  ctx.strokeStyle = "#E3D5BE"; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.ellipse(0, 0, 24.5, 17, 0, 0, 7); ctx.stroke();
  ctx.save(); ctx.translate(-2, 1); ctx.rotate(Math.sin(t * (mode === "proud" ? 7 : 19)) * .38); // cánh vẫy
  ctx.fillStyle = "#FBF7EC"; ctx.beginPath(); ctx.ellipse(0, 2, 14.5, 8.6, -.2, 0, 7); ctx.fill();
  ctx.strokeStyle = "#E8DCC2"; ctx.lineWidth = 1.2; ctx.beginPath(); ctx.ellipse(0, 2, 14.5, 8.6, -.2, 0, 7); ctx.stroke(); ctx.restore();
  ctx.fillStyle = "#fff"; circle(20, -13, 11); ctx.fill(); ctx.strokeStyle = "#E3D5BE"; ctx.beginPath(); ctx.arc(20,-13,11,0,7); ctx.stroke();
  ctx.fillStyle = "#E53935"; circle(16,-25,4.6); ctx.fill(); circle(22,-27,5.2); ctx.fill(); circle(27,-24,4.2); ctx.fill(); // mào
  ctx.fillStyle = "#F5A623"; ctx.beginPath(); ctx.moveTo(29,-14); ctx.lineTo(41,-10); ctx.lineTo(29,-6.6); ctx.closePath(); ctx.fill(); // mỏ
  ctx.fillStyle = "#E53935"; ctx.beginPath(); ctx.ellipse(24,-3.6, 3.4, 5, 0, 0, 7); ctx.fill(); // yếm
  ctx.fillStyle = "#263238"; circle(23,-15,2); ctx.fill(); ctx.fillStyle = "#fff"; circle(23.7,-15.7,.8); ctx.fill();
  if(mode === "chase"){ ctx.strokeStyle = "#263238"; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(18.6,-20.6); ctx.lineTo(27,-18.8); ctx.stroke(); } // lông mày quyết tâm
  ctx.strokeStyle = "#F5A623"; ctx.lineWidth = 2.6;
  const lp = Math.sin(runPh) * 7.5;
  ctx.beginPath(); ctx.moveTo(-6,15); ctx.lineTo(-6 + lp, 26); ctx.moveTo(8,15); ctx.lineTo(8 - lp, 26); ctx.stroke();
  ctx.restore();
}
function yardLayout(actors, y0=320, y1=472){
  const n = actors.length, cols = Math.min(9, Math.ceil(Math.sqrt(n*1.9)));
  actors.forEach((a,i)=>{
    const col = i%cols, row = Math.floor(i/cols), rows = Math.ceil(n/cols);
    a.x = 90 + (W-180) * (cols===1 ? .5 : col/(cols-1)) + Math.sin(a.seed*3.7)*14;
    a.y = rows===1 ? (y0+y1)/2 : y0 + (y1-y0) * row/(rows-1);
    a.s = .92;
  });
}
/* ============ TRÒ 1: TRỘM TRỨNG — bản ẢNH THẬT ============ */
const GV_PATH = "/static/img/gv-";
const GV_IMG = {};
function gvLoad(name, file){
  const im = new Image(); im.src = GV_PATH + file; GV_IMG[name] = im; return im;
}
gvLoad("bg", "bg-farm.png");
gvLoad("henHome", "hen.png");
gvLoad("henRun", "hen-run.png");
for(let i=0;i<7;i++){ gvLoad("stand"+i, "kid-stand-"+i+".png"); gvLoad("flee"+i, "kid-flee-"+i+".png"); }
const GV_BGS = {};
for(const [k, f] of [["dua","bg-dua.jpg"],["ca","bg-cau.jpg"],["bong","bg-bong.jpg"],["long","bg-khunglong.jpg"],["lua","bg-tenlua.jpg"],["pin","bg-pin.jpg"],["qua","bg-qua.jpg"],["ufo","bg-ufo.jpg"]]){
  const im = new Image(); im.src = GV_PATH + f; GV_BGS[k] = im;
}
const GV_BGC = {};
function imgReady(im){ return im && im.complete && im.naturalWidth > 0; }
function drawBG(k){ const im = GV_BGS[k]; if(!imgReady(im)) return false; let c = GV_BGC[k]; if(!c){ c = document.createElement("canvas"); c.width = W; c.height = H; c.getContext("2d").drawImage(im, 0, 0, W, H); GV_BGC[k] = c; } ctx.drawImage(c, 0, 0); return true; }
const GV_KID = [], GV_ANI = [], GV_DINO = [];
for(let i=0;i<8;i++){ const im = new Image(); im.src = GV_PATH + "kid2-" + i + ".png"; GV_KID.push(im); }
for(let i=0;i<4;i++){ const im = new Image(); im.src = GV_PATH + "ani-" + i + ".png"; GV_ANI.push(im); }
for(let i=0;i<2;i++){ const im = new Image(); im.src = GV_PATH + "dino-" + i + ".png"; GV_DINO.push(im); }
const GV_RKT = [], GV_GIFT = [], GV_FISH = [], GV_BAL = []; let GV_UFO2 = null;
for(let i=0;i<4;i++){ const im = new Image(); im.src = GV_PATH + "rocket-" + i + ".png"; GV_RKT.push(im); }
for(let i=0;i<5;i++){ const im = new Image(); im.src = GV_PATH + "gift-" + i + ".png"; GV_GIFT.push(im); }
for(let i=0;i<6;i++){ const im = new Image(); im.src = GV_PATH + "fish-" + i + ".png"; GV_FISH.push(im); }
for(let i=0;i<6;i++){ const im = new Image(); im.src = GV_PATH + "balloon-" + i + ".png"; GV_BAL.push(im); }
{ const im = new Image(); im.src = GV_PATH + "ufo2-0.png"; GV_UFO2 = im; }
const FLEE_MAP = [0,1,2,3,1,5,4];
const BG_SC = 960/1620, BG_DY = (540 - 971*BG_SC)/2;
const HEN_HOME = { x:128, y:466 };
function drawSprite(im, cx, baseY, h, face=1, bobPx=0, tilt=0){
  if(!im || !im.complete || !im.naturalWidth) return;
  const w = h * im.naturalWidth / im.naturalHeight;
  ctx.save(); ctx.translate(cx, baseY - bobPx); ctx.rotate(tilt * face); ctx.scale(face, 1);
  ctx.drawImage(im, -w/2, -h, w, h);
  ctx.restore();
}
function shadow(x, y, w, a=.2){
  ctx.fillStyle = `rgba(80,55,15,${a})`;
  ctx.beginPath(); ctx.ellipse(x, y, w, w*.24, 0, 0, 7); ctx.fill();
}
GAMES.trung = {
  icon:"🐔", name:"Trộm trứng", desc:"Gà mẹ rượt đuổi",
  layout(actors){
    const n = actors.length, cols = Math.min(6, Math.ceil(Math.sqrt(n * 1.7)));
    actors.forEach((a,i)=>{
      const col = i % cols, row = Math.floor(i / cols), rows = Math.ceil(n / cols);
      a.homeX = 320 + (880 - 320) * (cols === 1 ? .5 : col / (cols - 1)) + Math.sin(a.seed * 12.9) * 18;
      if(row === 1 && cols > 1) a.homeX += (880 - 320) / (cols - 1) / 2; // hàng sau so le, không che tên hàng trước
      a.homeY = rows === 1 ? 415 : 356 + (478 - 356) * row / (rows - 1);
      a.homeX = clamp(a.homeX, 262, 928); a.homeY = clamp(a.homeY, 336, 492);
      a.x = a.homeX; a.y = a.homeY; a.cx = a.homeX; a.cy = a.homeY;
      a.vx = 0; a.vy = 0; a.pose = "stand"; a.av = i % 7;
      a.h = rows === 1 ? 97 : (row === 0 ? 88 : 104);
    });
  },
  begin(R){
    R.g.hen = { x:HEN_HOME.x, y:HEN_HOME.y, vx:0, vy:0, face:1, bob:0 };
    R.g.caught = null; R.g.puffs = []; R.g.stepT = 0; R.g.lastT = null; R.g.missedFor = null; R.g.burstT = 0; R.g.woke = false;
    state.actors.forEach((a, i) => {
      a.cx = a.homeX; a.cy = a.homeY; a.vx = 0; a.vy = 0; a.pose = "stand"; a.wp = null; a.wpT = 0;
      a.sx = 238 + (i % 3) * 58 + (a.seed % 9); // điểm rón rén tiến về phía ổ trứng
      a.sy = 334 + Math.floor(i / 3) * 64 + (i % 2) * 16;
    });
  },
  resultText: w => "Gà mẹ bắt được",
  holdAfter: 5,
  onReveal(){ cluckTrio(); },
  draw(now, R, dt){
    dt = dt || .016;
    const bg = GV_IMG.bg;
    if(bg && bg.complete && bg.naturalWidth){ if(!GV_BGC.farm){ const c = document.createElement("canvas"); c.width = W; c.height = H; const g2 = c.getContext("2d"); g2.fillStyle = "#BDE7FF"; g2.fillRect(0,0,W,H); g2.drawImage(bg, 0, BG_DY, 960, 971 * BG_SC); GV_BGC.farm = c; } ctx.drawImage(GV_BGC.farm, 0, 0); }
    else { ctx.fillStyle = "#BDE7FF"; ctx.fillRect(0,0,W,H); }
    const henRun = GV_IMG.henRun, henHome = GV_IMG.henHome;

    if(!R){
      // lúc chờ: gà mẹ nằm ấp trứng trên ổ, các bạn đứng yên trong sân
      if(henHome && henHome.complete && henHome.naturalWidth)
        ctx.drawImage(henHome, 0, 422 * BG_SC + BG_DY, 488 * BG_SC, 416 * BG_SC);
      for(const a of state.actors){ // đứng chờ: nhún nhảy tại chỗ cho sinh động
        const ph = a.seed * 2.3;
        const hop = Math.abs(Math.sin(now * 3.1 + ph)) * 6;
        shadow(a.homeX, a.homeY + 3, 22, .16);
        drawSprite(GV_IMG["stand" + a.av], a.homeX, a.homeY, a.h || 97, 1, hop, Math.sin(now * 2.2 + ph) * .045);
      }
      for(const a of state.actors) label(state.actors.length>24?shortName(a.p.name):a.p.name, a.homeX, a.homeY + 16, 14);
      return;
    }

    const hen = R.g.hen;
    const win = (R.phase === "reveal" || R.phase === "done") ? R.winner : null;
    const sneak = R.t < 1.15, wakeT = R.t - 1.15; // 1,15 giây đầu: các bé rón rén ra ổ, gà còn ngủ
    if(sneak && henHome && henHome.complete && henHome.naturalWidth)
      ctx.drawImage(henHome, 0, 422 * BG_SC + BG_DY, 488 * BG_SC, 416 * BG_SC);
    if(!sneak && !R.g.woke){ R.g.woke = true; sndSquawk(); for(let i2 = 0; i2 < 6; i2++) R.g.puffs.push({ x: hen.x + rand(-26, 26), y: hen.y - rand(0, 12), t: -i2 * .04 }); }
    if(R.phase !== "done" && $("gvSound").checked){ // gà mẹ cục tác rộn ràng suốt lúc rượt
      R.g.cluckT = (R.g.cluckT == null ? .25 : R.g.cluckT) - dt;
      if(R.g.cluckT <= 0){ R.g.cluckT = .3 + Math.random() * .28; sndCluck(); }
    }
    if(R.target !== R.g.lastT){ R.g.lastT = R.target; if(R.target && R.targetKind === "fake") sndSquawk(); }
    if(R.g.burstT > 0) R.g.burstT -= dt;

    /* --- học sinh: chạy trốn / quay về chỗ --- */
    for(const a of state.actors){
      let dvx = 0, dvy = 0, fleeing = false;
      const isTarget = (R.target === a) || (win === a);
      if(sneak){ // rón rén tiến về phía ổ trứng
        const dx = a.sx - a.cx, dy = a.sy - a.cy, d = Math.hypot(dx, dy);
        if(d > 4){ const sp = Math.min(120, 30 + d * 1.6); dvx = dx / d * sp; dvy = dy / d * sp; }
      } else if(isTarget && R.g.caught !== a){
        const dx = a.cx - hen.x, dy = (a.cy - hen.y) * 1.6;
        const d = Math.hypot(dx, dy) || 1;
        const burst = (R.g.burstT > 0 && R.target === a);
        let sp = burst ? 338 : 216;
        if(win === a) sp *= clamp((R.dur - R.t) / 2, .3, 1); // 2 giây cuối: bạn thắng đuối dần để gà bắt kịp
        dvx = dx / d * sp; dvy = dy / d * sp * .62;
        fleeing = true;
        // chạm biên sân thì trượt dọc biên
        if((a.cx < 268 && dvx < 0) || (a.cx > 922 && dvx > 0)) dvx = 0;
        if((a.cy < 330 && dvy < 0) || (a.cy > 496 && dvy > 0)) dvy = 0;
        if(dvx === 0 && dvy === 0){ dvx = (a.cx < 480 ? -1 : 1) * sp * .7; }
      } else if(R.g.caught === a){
        // bạn thắng: đứng yên tại chỗ ăn mừng (vòng sáng + tim bay), không đi về
      } else if(R.g.caught){
        // đã bắt được bạn thắng: các bạn còn lại thong thả quay về chỗ đứng
        const dx = a.homeX - a.cx, dy = a.homeY - a.cy, d = Math.hypot(dx, dy);
        if(d > 3){ const sp = Math.min(110, d * 2.2); dvx = dx / d * sp; dvy = dy / d * sp; fleeing = d > 30; }
      } else {
        // CHẠY LUNG TUNG khắp sân: mỗi bạn một hướng ngẫu nhiên, gà đến gần thì bỏ chạy ra xa
        if(!a.wp || (a.wpT -= dt) <= 0 || Math.hypot(a.wp.x - a.cx, a.wp.y - a.cy) < 24){
          let wx = 0, wy = 0, tries = 0;
          do { wx = 262 + Math.random() * 656; wy = 332 + Math.random() * 164; tries++; }
          while(Math.hypot(wx - hen.x, wy - hen.y) < 130 && tries < 6);
          a.wp = { x: wx, y: wy }; a.wpT = .8 + Math.random() * .9;
        }
        let tx = a.wp.x, ty = a.wp.y;
        const hd = Math.hypot(a.cx - hen.x, (a.cy - hen.y) * 1.5);
        if(hd < 108){ tx = clamp(a.cx + (a.cx - hen.x) * 1.7, 246, 928); ty = clamp(a.cy + (a.cy - hen.y) * 1.3, 326, 498); a.wp = null; }
        const dx = tx - a.cx, dy = ty - a.cy, d = Math.hypot(dx, dy) || 1;
        const sp = (178 + (a.seed % 5) * 15) * (hd < 108 ? 1.4 : 1);
        dvx = dx / d * sp; dvy = dy / d * sp * .72; fleeing = true;
      }
      const k = 1 - Math.exp(-7 * dt);
      a.vx += (dvx - a.vx) * k; a.vy += (dvy - a.vy) * k;
      a.cx = clamp(a.cx + a.vx * dt, 236, 936); a.cy = clamp(a.cy + a.vy * dt, 318, 502);
      a.pose = fleeing && Math.hypot(a.vx, a.vy) > 40 ? "flee" : "stand";
      a.x = a.cx; a.y = a.cy;
    }

    /* --- gà mẹ: lái theo vận tốc, có gia tốc + quán tính --- */
    let gx, gy, gsp;
    if(win && R.g.caught === win){ gx = win.cx + (win.cx > 690 ? -118 : 118); gy = win.cy + 4; gsp = 120; }
    else if(R.target){ gx = R.target.cx; gy = R.target.cy + 2; gsp = 306; }
    else if(win){ gx = win.cx; gy = win.cy + 2; const rem = R.dur - R.t; gsp = rem < 1.4 ? clamp(Math.hypot(win.cx - hen.x, win.cy - hen.y) / Math.max(rem - .15, .25), 338, 660) : 338; } // ngân sách thời gian: tốc độ = khoảng cách ÷ thời gian còn lại
    else { const a = state.actors[Math.floor(now / 2.4) % Math.max(1, state.actors.length)]; gx = a ? a.cx : 480; gy = a ? a.cy : 420; gsp = 92; }
    // bắt hụt: mục tiêu giả bứt tốc, gà vồ trượt rồi trượt quán tính
    if(R.target && R.targetKind === "fake" && R.g.missedFor !== R.target){
      const d = Math.hypot(R.target.cx - hen.x, R.target.cy - hen.y);
      if(d < 54){ R.g.missedFor = R.target; R.g.burstT = .48; sndSquawk(); }
    }
    if(R.g.burstT > 0 && R.target && R.targetKind === "fake") gsp = 60; // gà vừa hụt, chậm lại
    let dvx = 0, dvy = 0;
    { const dx = gx - hen.x, dy = gy - hen.y, d = Math.hypot(dx, dy);
      if(d > 6){ dvx = dx / d * Math.min(gsp, 40 + d * 2.4); dvy = dy / d * Math.min(gsp, 40 + d * 2.4) * .8; } }
    if(sneak){ dvx = 0; dvy = 0; } // gà chưa thức, nằm yên trên ổ
    const kh = 1 - Math.exp(-5.2 * dt);
    hen.vx += (dvx - hen.vx) * kh; hen.vy += (dvy - hen.vy) * kh;
    hen.x += hen.vx * dt; hen.y += hen.vy * dt;
    const hSpeed = Math.hypot(hen.vx, hen.vy);
    if(Math.abs(hen.vx) > 12) hen.face = hen.vx > 0 ? 1 : -1;
    hen.bob += hSpeed * dt * .052;
    if(win && !R.g.caught && Math.hypot(win.cx - hen.x, win.cy - hen.y) < 44) R.g.caught = win;
    if(R.target && hSpeed > 130){
      R.g.stepT += dt;
      if(R.g.stepT > .12){ R.g.stepT = 0; sndStep();
        if(Math.random() < .75) R.g.puffs.push({ x: hen.x - hen.face * 20, y: hen.y + 2, t: 0 }); }
    }

    /* --- vẽ các bạn (xa trước, gần sau cho có chiều sâu) --- */
    const sorted = [...state.actors].sort((p, q) => p.cy - q.cy);
    for(const a of sorted){
      const isT = R.target === a, caught = R.g.caught === a;
      const spd = Math.hypot(a.vx, a.vy);
      const bob = a.pose === "flee" ? Math.abs(Math.sin(now * 13 + a.seed)) * 5 : (sneak ? Math.abs(Math.sin(now * 8 + a.seed)) * 2.2 : Math.sin(now * 1.8 + a.seed * 2) * 1.4);
      shadow(a.cx, a.cy + 3, a.pose === "flee" ? 27 : 24, .17);
      if(caught && win === a){ // bạn thắng: đứng tại chỗ nhảy ăn mừng
        drawSprite(GV_IMG["stand" + a.av], a.cx, a.cy, a.h || 118, 1, Math.abs(Math.sin(now * 6)) * 7);
      } else if(a.pose === "flee"){
        const face = a.vx >= -8 ? 1 : -1;
        drawSprite(GV_IMG["flee" + FLEE_MAP[a.av]], a.cx, a.cy, (a.h || 118) * .95, face, bob, clamp(a.vx * .0006, -.12, .12));
        if(spd > 150 && Math.random() < .3) R.g.puffs.push({ x: a.cx - face * 16, y: a.cy + 2, t: 0, small: 1 });
      } else {
        drawSprite(GV_IMG["stand" + a.av], a.cx, a.cy, (a.h || 118) * (sneak ? .93 : 1), 1, -bob * .3);
      }
      if(isT && R.targetKind === "fake" && R.targetT > .95) bubble("ơ... khoan đã!", hen.x, hen.y - 150);
    }
    for(const a of sorted) label(state.actors.length>24?shortName(a.p.name):a.p.name, a.cx, a.cy + 16, 14);

    /* --- vẽ gà mẹ --- */
    for(const p of R.g.puffs){ p.t += dt;
      ctx.fillStyle = `rgba(226,208,170,${clamp(.5 - p.t * .95, 0, .5)})`;
      circle(p.x, p.y - p.t * 13, (p.small ? 3 : 4.4) + p.t * 14); ctx.fill();
    }
    R.g.puffs = R.g.puffs.filter(p => p.t < .55);
    if(!sneak){
      shadow(hen.x, hen.y + 4, 34, .2);
      const hBob = Math.abs(Math.sin(hen.bob)) * clamp(hSpeed / 42, 0, 7.5);
      const puff = wakeT < .5 ? 1 + .3 * Math.sin(Math.PI * clamp(wakeT / .5, 0, 1)) : 1; // vừa thức dậy gà phình to
      drawSprite(henRun, hen.x, hen.y, 122 * puff, hen.face, hBob, clamp(hen.vx * .00042, -.13, .13));
    }
    if(sneak) bubble("Khò khò…", hen.x + 24, hen.y - 158);
    else if(wakeT < 1.35) bubble("Ai trộm trứng của ta?!", hen.x, hen.y - 156);
    if(R.g.caught){ // vòng sáng + tim + lời của gà: vẽ SAU CÙNG để không bị gà che
      const w = R.g.caught;
      ctx.strokeStyle = "#43D17C"; ctx.lineWidth = 4.5; circle(w.cx, w.cy - 52, 44); ctx.stroke();
      ctx.fillStyle = "#EF5350";
      for(const [hx, hy, hs] of [[-30, -118 - Math.sin(now * 3) * 3, 1], [28, -126 - Math.cos(now * 2.6) * 3, .8]]){
        ctx.save(); ctx.translate(w.cx + hx, w.cy + hy); ctx.scale(hs, hs);
        ctx.beginPath(); ctx.moveTo(0, 4); ctx.bezierCurveTo(-9, -4, -4, -11, 0, -6); ctx.bezierCurveTo(4, -11, 9, -4, 0, 4); ctx.fill(); ctx.restore();
      }
      let bx = clamp(hen.x, 185, 775), by = hen.y - 152;
      if(bx > 270 && bx < 690 && by > 165 && by < 378) by = 164; // tránh bị bảng thông báo ở giữa che
      bubble("Lần này bắt được thật rồi!", bx, by);
    }
  }
};

/* ============ TRÒ 2: ĐƯỜNG ĐUA ============ */
function drawAnimal(x, y, s, kind, name, runPh){
  const aim = GV_ANI[kind % GV_ANI.length];
  if(imgReady(aim)){
    const bob2 = Math.abs(Math.sin(runPh*10))*3;
    const hh = 52*s, ww = hh * aim.naturalWidth / aim.naturalHeight;
    ctx.drawImage(aim, x - ww/2, y + 16*s - bob2 - hh, ww, hh);
    label(name, x, y + 30*s, 13.5);
    return;
  }
  ctx.save(); ctx.translate(x, y); ctx.scale(s, s);
  const bob = Math.abs(Math.sin(runPh*10))*3; ctx.translate(0, -bob);
  const body = ["#B0BEC5","#D7A86E","#F2A541","#F6C6DA"][kind];
  ctx.fillStyle = body; ctx.beginPath(); ctx.ellipse(0, 0, 20, 12.5, 0, 0, 7); ctx.fill();
  circle(19, -8, 9.5); ctx.fill();
  if(kind === 0){ ctx.beginPath(); ctx.ellipse(14,-24,3.6,10,-.2,0,7); ctx.fill(); ctx.beginPath(); ctx.ellipse(22,-24,3.6,10,.15,0,7); ctx.fill(); ctx.fillStyle="#F6C6DA"; circle(-19,-2,5); ctx.fill(); } // thỏ
  if(kind === 1){ ctx.fillStyle = "#B07B45"; ctx.beginPath(); ctx.ellipse(13,-13,4.4,7,.5,0,7); ctx.fill(); ctx.beginPath(); ctx.ellipse(24,-13,4.4,7,-.4,0,7); ctx.fill(); ctx.strokeStyle=body; ctx.lineWidth=4; ctx.beginPath(); ctx.moveTo(-19,-4); ctx.quadraticCurveTo(-28,-12,-24,-18); ctx.stroke(); } // chó
  if(kind === 2){ ctx.fillStyle = body; ctx.beginPath(); ctx.moveTo(12,-15); ctx.lineTo(15,-23); ctx.lineTo(19,-16); ctx.closePath(); ctx.fill(); ctx.beginPath(); ctx.moveTo(21,-16); ctx.lineTo(26,-22); ctx.lineTo(27,-14); ctx.closePath(); ctx.fill(); ctx.strokeStyle=body; ctx.lineWidth=3.6; ctx.beginPath(); ctx.moveTo(-19,-2); ctx.quadraticCurveTo(-30,2,-27,-8); ctx.stroke(); } // mèo
  if(kind === 3){ ctx.fillStyle = "#F2A0B5"; circle(24,-8,5.4); ctx.fill(); ctx.fillStyle=body; ctx.beginPath(); ctx.ellipse(14,-19,3.8,3,0,0,7); ctx.fill(); ctx.beginPath(); ctx.ellipse(23,-19.6,3.8,3,0,0,7); ctx.fill(); } // lợn
  ctx.fillStyle = "#333"; circle(22.5, -9.5, 1.7); ctx.fill();
  ctx.strokeStyle = "rgba(0,0,0,.25)"; ctx.lineWidth = 2.6;
  const lp = Math.sin(runPh*10)*6;
  ctx.beginPath(); ctx.moveTo(-10,10); ctx.lineTo(-10+lp,19); ctx.moveTo(10,10); ctx.lineTo(10-lp,19); ctx.stroke();
  ctx.restore();
  label(name, x, y + 30*s, 13.5);
}
GAMES.dua = {
  icon:"🏁", name:"Đường đua", desc:"Ai về đích trước",
  layout(actors){ actors.forEach((a,i)=>{ a.lane = i % 6; a.s = .95; }); },
  begin(R){
    const dur = R.dur; sndWhistle();
    R.g.rates = {}; R.g.surger = null; R.g.cdN = 0; R.g.goSnd = false;
    R.g.srgBase = rand(.55,.75);
    for(const a of state.actors) R.g.rates[a.p.id] = rand(.5,.86);
    const others = state.actors.filter(a=>a!==R.winner);
    if(others.length){ R.g.surger = others[irand(0, others.length-1)]; }
    const raceDur = Math.max(4, dur - 3.5);
    R.g.p72 = R.g.srgBase * .45 + 1.85 * .27;
    R.g.sleepEnd = .72 + 1.5 / raceDur;
  },
  resultText: w => "Về đích đầu tiên —",
  onReveal(){ sndWhistle(); },
  draw(now, R){
    const hasBG = drawBG("dua");
    const laneH = 400/6;
    if(!hasBG){ ctx.fillStyle = "#9ED08A"; ctx.fillRect(0,0,W,H);
    ctx.fillStyle = "#B08954"; ctx.fillRect(0, 84, W, 400);
    ctx.fillStyle = "#A67C48"; ctx.fillRect(0, 84, W, 8);
    for(let i=0;i<6;i++){
      ctx.fillStyle = i%2 ? "#B78E58" : "#AF8450"; ctx.fillRect(0, 84+i*laneH, W, laneH);
      ctx.strokeStyle = "rgba(255,255,255,.5)"; ctx.lineWidth = 2; ctx.setLineDash([14,12]);
      ctx.beginPath(); ctx.moveTo(0, 84+(i+1)*laneH); ctx.lineTo(W, 84+(i+1)*laneH); ctx.stroke(); ctx.setLineDash([]);
    } }
    // vạch đích
    for(let rI=0;rI<25;rI++) for(let cI=0;cI<2;cI++){ ctx.fillStyle = (rI+cI)%2 ? "#222" : "#fff"; ctx.fillRect(896+cI*16, 84+rI*16, 16, 16); }
    label("ĐÍCH", 912, 66, 17, "#B3541E");
    const t = R ? Math.min(R.t, R.dur) : 0;
    const raceDur = R ? Math.max(4, R.dur - 3.5) : 1;
    const rt = Math.max(0, t - 1.5);
    const frac = R ? clamp(rt / raceDur, 0, 1) : 0;
    const sleeping = R && R.g.surger && frac >= .72 && frac < R.g.sleepEnd;
    for(const a of state.actors){
      let prog = 0;
      if(R){
        if(a === R.winner) prog = frac;
        else if(a === R.g.surger){
          if(frac < .45) prog = R.g.srgBase * frac;
          else if(frac < .72) prog = R.g.srgBase * .45 + 1.85 * (frac - .45);
          else if(frac < R.g.sleepEnd) prog = R.g.p72;
          else prog = R.g.p72 + .38 * (frac - R.g.sleepEnd);
        } else prog = R.g.rates[a.p.id] * frac;
        if(frac > .78 && a !== R.winner){ // cả đàn co cụm về đích cho sít sao
          prog = lerp(prog, frac * .985, (frac - .78) / .22 * .5);
          prog = Math.min(prog, .985);
        }
        prog = clamp(prog, 0, 1);
        if(R.phase === "reveal" && a !== R.winner) prog = Math.min(prog, .96);
      } else prog = (a.seed % 5) * .012;
      a.x = 56 + prog * 816; a.y = 84 + a.lane*laneH + laneH*.58;
      const win = R && R.phase==="reveal" && R.winner===a;
      if(win){ ctx.strokeStyle = "#43D17C"; ctx.lineWidth = 4; circle(a.x, a.y-4, 30); ctx.stroke(); }
      const frozen = sleeping && a === R.g.surger;
      drawAnimal(a.x, a.y, a.s, a.seed % 4, a.p.name, frozen ? a.seed : (R ? t + a.seed : now + a.seed));
      if(R && a === R.g.surger && frac >= .45 && frac < .72){
        ctx.save(); ctx.font = '800 14px "Segoe UI", sans-serif'; ctx.textAlign = "center";
        const tw = ctx.measureText("Tăng tốc!").width + 18;
        ctx.fillStyle = "#37474F"; rr(a.x - tw/2, a.y - 68, tw, 22, 11); ctx.fill();
        ctx.fillStyle = "#FFD93B"; ctx.fillText("Tăng tốc!", a.x, a.y - 53);
        ctx.restore();
      }
      if(frozen){
        ctx.fillStyle = "#5B7C99"; ctx.font = '800 17px "Segoe UI", sans-serif'; ctx.textAlign = "left";
        ctx.fillText("Z", a.x + 16, a.y - 46 - Math.sin(now * 2.4) * 3);
        ctx.font = '800 13px "Segoe UI", sans-serif'; ctx.fillText("z", a.x + 27, a.y - 58 - Math.sin(now * 2.4 + 1) * 3);
        bubble("Ngủ gật...", a.x, a.y - 74);
      }
    }
    if(R && t < 1.5){ // đếm ngược 3-2-1 kiểu bản gốc
      const n = 3 - Math.floor(t / .5), loc = (t % .5) / .5;
      if(n !== R.g.cdN){ R.g.cdN = n; sndTick(700); }
      const sc = 1.35 - .35 * loc, al = loc < .75 ? 1 : 1 - (loc - .75) / .25;
      ctx.save(); ctx.globalAlpha = Math.max(0, al);
      ctx.font = `900 ${Math.round(100 * sc)}px "Segoe UI", sans-serif`; ctx.textAlign = "center";
      ctx.lineWidth = 12; ctx.strokeStyle = "#7C4A1E"; ctx.strokeText(n, 480, 268);
      ctx.fillStyle = "#fff"; ctx.fillText(n, 480, 268);
      ctx.restore();
    }
    if(R && t >= 1.5 && !R.g.goSnd){ R.g.goSnd = true; sndDing(); }
    if(!R) label("Bấm Bắt đầu để các bạn thú đua nào!", W/2, 34, 18, "#7C4A1E");
  }
};

/* ============ TRÒ 3: CÂU CÁ ============ */
function drawFish(x, y, s, seed, face=1, name){
  const fim = GV_FISH[seed % GV_FISH.length];
  if(imgReady(fim)){
    ctx.save(); ctx.translate(x, y); ctx.scale(face, 1);
    const ww = 48*s, hh = ww * fim.naturalHeight / fim.naturalWidth;
    ctx.drawImage(fim, -ww/2, -hh/2, ww, hh);
    ctx.restore();
    if(name) label(name, x, y + 24*s, 13.5);
    return;
  }
  const cols = ["#FF8A5C","#FFD93B","#7ED3F7","#F28BB4","#9BE15D","#B39DDB"];
  ctx.save(); ctx.translate(x,y); ctx.scale(s*face, s);
  ctx.fillStyle = cols[seed % cols.length];
  ctx.beginPath(); ctx.ellipse(0,0,19,10.5,0,0,7); ctx.fill();
  ctx.beginPath(); ctx.moveTo(-16,0); ctx.lineTo(-28,-8); ctx.lineTo(-28,8); ctx.closePath(); ctx.fill();
  ctx.fillStyle = "rgba(255,255,255,.75)"; circle(6,-2,2.6); ctx.fill();
  ctx.fillStyle = "#20405A"; circle(10,-2.5,2.8); ctx.fill(); ctx.fillStyle = "#fff"; circle(11,-3.5,1); ctx.fill();
  ctx.restore();
  if(name) label(name, x, y + 24*s, 13.5);
}
GAMES.ca = {
  icon:"🎣", name:"Câu cá", desc:"Cá nào cắn câu",
  layout(actors){
    actors.forEach((a,i)=>{ a.baseX = 80 + (W-160) * ((i%7)/6 || .5) * (0.4 + 0.6*((i*37)%10)/10) + Math.sin(a.seed)*20;
      a.baseX = clamp(80 + ((i*173) % 800), 70, 890); a.y = 330 + (i%3)*58; a.s = .95; a.ph = rand(0,6); });
  },
  begin(R){ R.g.hook = { x:880, y:120 }; R.g.lift = 0; },
  resultText: w => "Câu được bạn",
  onReveal(){ sndSplash(); },
  draw(now, R, dt){
    const hasBG = drawBG("ca");
    if(!hasBG){ sky("#AEE7FF","#E6FBFF"); sun(856,58,30); cloud(150,54,.9);
    ctx.fillStyle = "#7CBF57"; ctx.fillRect(0, 196, W, 26);
    // cầu gỗ
    ctx.fillStyle = "#B07B45"; rr(30, 176, 210, 14, 6); ctx.fill();
    for(let i=0;i<5;i++) rr(44+i*44, 188, 9, 30, 3), ctx.fill();
    // nước
    const wg = ctx.createLinearGradient(0,222,0,H); wg.addColorStop(0,"#3FA7D6"); wg.addColorStop(1,"#1D6FA5");
    ctx.fillStyle = wg; ctx.fillRect(0, 222, W, H-222);
    ctx.strokeStyle = "rgba(255,255,255,.35)"; ctx.lineWidth = 2;
    for(let i=0;i<7;i++){ const yy = 244 + i*42 + Math.sin(now*1.4+i)*3; ctx.beginPath(); ctx.moveTo(20 + (i%3)*70, yy); ctx.quadraticCurveTo(90+(i%3)*70, yy-7, 160+(i%3)*70, yy); ctx.stroke(); }
    // lá sen
    for(const [lx,ly,ls] of [[120,262,1],[820,286,.8],[420,252,.7],[660,470,.9],[180,478,.75]]){
      ctx.fillStyle = "#2E9E5B"; ctx.beginPath(); ctx.ellipse(lx,ly,34*ls,11*ls,0,0,7); ctx.fill();
      ctx.fillStyle = "#F28BB4"; circle(lx+8*ls, ly-8*ls, 6*ls); ctx.fill(); ctx.fillStyle="#FFD93B"; circle(lx+8*ls, ly-9*ls, 2.4*ls); ctx.fill();
    } }
    // cá bơi
    for(const a of state.actors){
      a.x = a.baseX + Math.sin(now*.7 + a.ph) * 26;
      let yy = a.y + Math.sin(now*1.3 + a.ph)*4, lift = 0;
      if(R && R.g.liftActor === a) lift = R.g.lift || 0;
      a.curY = yy - lift;
      drawFish(a.x, a.curY, a.s, a.seed, Math.cos(now*.7+a.ph) >= 0 ? 1 : -1, a.p.name);
      if(R && R.phase==="reveal" && R.winner===a){ ctx.strokeStyle="#43D17C"; ctx.lineWidth=4; circle(a.x, a.curY, 30); ctx.stroke(); }
    }
    // cần câu + móc
    const rodX = 896, rodY = 26;
    ctx.strokeStyle = "#8A5A2E"; ctx.lineWidth = 5; ctx.beginPath(); ctx.moveTo(958, 66); ctx.quadraticCurveTo(920, 20, rodX, rodY); ctx.stroke();
    let hx = rodX - 120, hy = 130;
    if(R){
      const hook = R.g.hook;
      const tgt = R.target;
      const txx = tgt ? tgt.x : 480 + Math.sin(now*.5)*220, tyy = tgt ? tgt.y - 26 : 250;
      moveToward(hook, txx, tyy, 330, dt||.016);
      hx = hook.x; hy = hook.y;
      R.g.liftActor = null; R.g.lift = 0;
      if(tgt){
        const d = Math.hypot(hook.x - tgt.x, hook.y - (tgt.y - 26));
        if(d < 30){
          if(R.targetKind === "fake") R.g.lift = Math.sin(Math.min(1, R.targetT/1.25) * Math.PI) * 44;
          else if(R.phase === "reveal") R.g.lift = 120;
          if(R.g.lift > 2) R.g.liftActor = tgt;
          if(R.targetKind === "fake" && R.targetT < .5) bubble("Cá cắn câu rồi!", tgt.x, tgt.y - 58);
        }
      }
    }
    ctx.strokeStyle = "rgba(255,255,255,.85)"; ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.moveTo(rodX, rodY); ctx.lineTo(hx, hy); ctx.stroke();
    ctx.strokeStyle = "#546E7A"; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(hx, hy+7, 7, .3, Math.PI*1.5); ctx.stroke();
  }
};

/* ============ TRÒ 4: BÓNG BAY ============ */
function drawBalloon(x, y, s, seed, name){
  const bim = GV_BAL[seed % GV_BAL.length];
  if(imgReady(bim)){
    const hh = 48*s, ww = hh * bim.naturalWidth / bim.naturalHeight;
    ctx.drawImage(bim, x - ww/2, y - 18*s - hh/2, ww, hh);
    ctx.strokeStyle = "rgba(90,60,30,.55)"; ctx.lineWidth = 1.4;
    ctx.beginPath(); ctx.moveTo(x, y + 6*s); ctx.quadraticCurveTo(x + 4*s, y + 15*s, x - 2*s, y + 24*s); ctx.stroke();
    if(name) label(name, x, y + 34*s, 13.5);
    return;
  }
  const cols = ["#EF5350","#FFA726","#FFEE58","#66BB6A","#42A5F5","#AB47BC","#EC407A","#26A69A"];
  ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
  ctx.fillStyle = cols[seed % cols.length];
  ctx.beginPath(); ctx.ellipse(0,-16,17,21,0,0,7); ctx.fill();
  ctx.fillStyle = "rgba(255,255,255,.5)"; ctx.beginPath(); ctx.ellipse(-6,-24,5.5,8.5,-.4,0,7); ctx.fill();
  ctx.fillStyle = cols[seed % cols.length]; ctx.beginPath(); ctx.moveTo(-3.4,4); ctx.lineTo(3.4,4); ctx.lineTo(0,9); ctx.closePath(); ctx.fill();
  ctx.strokeStyle = "rgba(90,60,30,.55)"; ctx.lineWidth = 1.4;
  ctx.beginPath(); ctx.moveTo(0,9); ctx.quadraticCurveTo(4,18,-2,26); ctx.stroke();
  ctx.restore();
  if(name) label(name, x, y + 34*s, 13.5);
}
GAMES.bong = {
  icon:"🎈", name:"Bóng bay", desc:"Quả cuối cùng còn lại",
  layout(actors){
    actors.forEach((a,i)=>{ a.x = 70 + (W-140) * ((i%8)/7 || .5); a.x = 70 + ((i*149) % 820); a.y = 190 + (i%3)*86 + Math.sin(a.seed*2)*10; a.s = 1.05; a.ph = rand(0,6); });
  },
  begin(R){
    const others = shuffle(state.actors.filter(a => a !== R.winner));
    R.g.elims = others.map((a,i)=>({ a, at: 1 + (R.dur - 3.4) * (i+1)/(others.length+0.35), done:false }));
    R.g.eagle = { x:-80, y:90, face:1 }; R.g.popFx = [];
  },
  resultText: w => "Quả bóng cuối cùng —",
  onReveal(){ sndPop(); sndSparkle(); },
  draw(now, R, dt){
    const hasBG = drawBG("bong");
    if(!hasBG){ sky("#7ED3F7","#EAFBFF");
    // mặt trời cười
    sun(862, 66, 36); ctx.fillStyle="#7C4A1E"; circle(852,60,3); ctx.fill(); circle(872,60,3); ctx.fill();
    ctx.strokeStyle="#7C4A1E"; ctx.lineWidth=2.4; ctx.beginPath(); ctx.arc(862,68,9,.15*Math.PI,.85*Math.PI); ctx.stroke();
    cloud(160,70,1); cloud(430,44,.75); cloud(640,86,.65);
    ctx.fillStyle = "#8FCE6B"; ctx.fillRect(0, 492, W, 48); }
    if(R){
      for(const e of R.g.elims){
        if(!e.done && R.t >= e.at){ e.done = true; e.a.gone = true; sndPop(); R.g.popFx.push({x:e.a.x, y:e.a.y-16, t:0}); }
      }
    }
    for(const a of state.actors){
      if(a.gone) continue;
      const yy = a.y + Math.sin(now*1.2 + a.ph)*9;
      a.curY = yy;
      if(R && R.phase==="reveal" && R.winner===a){ ctx.strokeStyle="#43D17C"; ctx.lineWidth=4.5; circle(a.x, yy-14, 34); ctx.stroke(); }
      drawBalloon(a.x, yy, a.s, a.seed, a.p.name);
    }
    // vụn nổ
    if(R){ for(const fx of R.g.popFx){ fx.t += dt||.016;
      ctx.strokeStyle = `rgba(240,100,35,${clamp(1-fx.t*2.4,0,1)})`; ctx.lineWidth = 3;
      for(let i=0;i<6;i++){ const an = i/6*Math.PI*2 + fx.t; const r1 = 8 + fx.t*46;
        ctx.beginPath(); ctx.moveTo(fx.x+Math.cos(an)*r1*.5, fx.y+Math.sin(an)*r1*.5); ctx.lineTo(fx.x+Math.cos(an)*r1, fx.y+Math.sin(an)*r1); ctx.stroke(); }
    } R.g.popFx = R.g.popFx.filter(f => f.t < .45); }
    // đại bàng
    const eg = R ? R.g.eagle : { x: 480 + Math.sin(now*.4)*330, y: 96, face: 1 };
    if(R){
      let tx = 480 + Math.sin(now*.55)*380, ty = 92;
      const next = R.g.elims.find(e => !e.done);
      if(next && R.t > next.at - .55){ tx = next.a.x; ty = next.a.y - 40; }
      if(R.phase === "reveal"){ tx = R.winner.x; ty = R.winner.y - 74; }
      moveToward(eg, tx, ty, 430, dt||.016);
    }
    ctx.save(); ctx.translate(eg.x, eg.y); ctx.scale(eg.face||1, 1);
    ctx.fillStyle = "#6D4C41"; ctx.beginPath(); ctx.ellipse(0,0,21,11,0,0,7); ctx.fill();
    ctx.beginPath(); ctx.moveTo(-14,-4); ctx.quadraticCurveTo(-36,-16 - Math.sin(now*9)*4, -42,-4); ctx.quadraticCurveTo(-28,2,-14,3); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(12,-4); ctx.quadraticCurveTo(32,-15 - Math.cos(now*9)*4, 40,-3); ctx.quadraticCurveTo(26,3,12,3); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#fff"; circle(17,-7,8); ctx.fill();
    ctx.fillStyle = "#F5A623"; ctx.beginPath(); ctx.moveTo(23,-8); ctx.lineTo(32,-5); ctx.lineTo(23,-2.6); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#333"; circle(19,-8,1.8); ctx.fill();
    ctx.restore();
    if(!R) label("Đại bàng sẽ chọc vỡ dần — quả bóng nào trụ lại cuối cùng?", W/2, 30, 17, "#7C4A1E");
  }
};
/* ============ TRÒ 5: KHỦNG LONG ============ */
function drawCake(x, y, s=1){
  ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
  ctx.fillStyle = "#ECEFF1"; ctx.beginPath(); ctx.ellipse(0,6,13,3.6,0,0,7); ctx.fill();
  ctx.fillStyle = "#F8BBD0"; rr(-9,-4,18,10,3); ctx.fill();
  ctx.fillStyle = "#fff"; rr(-9,-8,18,5,2.4); ctx.fill();
  ctx.fillStyle = "#EF5350"; circle(0,-10,2.6); ctx.fill();
  ctx.strokeStyle = "#F5A623"; ctx.lineWidth = 1.6; ctx.beginPath(); ctx.moveTo(0,-13); ctx.lineTo(0,-16); ctx.stroke();
  ctx.fillStyle = "#FFD93B"; circle(0,-17.4,1.7); ctx.fill();
  ctx.restore();
}
function drawDino(x, y, s, face, chomp, ph){
  const dim = GV_DINO[chomp > .45 ? 1 : 0];
  if(imgReady(dim)){
    ctx.save(); ctx.translate(x, y - Math.abs(Math.sin(ph*9))*2.4); ctx.scale(face, 1);
    const hh = 92*s, ww = hh * dim.naturalWidth / dim.naturalHeight;
    ctx.drawImage(dim, -ww*.42, 10*s - hh, ww, hh);
    ctx.restore();
    return;
  }
  ctx.save(); ctx.translate(x,y); ctx.scale(s*face, s); ctx.translate(0, -Math.abs(Math.sin(ph*9))*2.4);
  ctx.fillStyle = "#66BB6A";
  ctx.beginPath(); ctx.moveTo(-30,-16); ctx.quadraticCurveTo(-58,-10,-64,-26); ctx.quadraticCurveTo(-44,-24,-30,-30); ctx.closePath(); ctx.fill(); // đuôi
  ctx.beginPath(); ctx.ellipse(-4,-18,27,17,-.12,0,7); ctx.fill(); // thân
  ctx.beginPath(); ctx.ellipse(22,-36,17.5,12.5,-.18,0,7); ctx.fill(); // đầu
  ctx.beginPath(); ctx.ellipse(30,-27 + chomp*5, 12.5, 6.5, .12, 0, 7); ctx.fill(); // hàm dưới
  ctx.fillStyle = "#A5D6A7"; ctx.beginPath(); ctx.ellipse(-2,-12,17,9,-.1,0,7); ctx.fill(); // bụng
  ctx.fillStyle = "#fff"; // răng
  for(let i=0;i<4;i++){ ctx.beginPath(); ctx.moveTo(24+i*5.4, -26.5+chomp*2); ctx.lineTo(26.6+i*5.4, -26.5+chomp*2); ctx.lineTo(25.3+i*5.4, -22.5+chomp*2); ctx.closePath(); ctx.fill(); }
  ctx.fillStyle = "#1B3A1E"; circle(24,-40,2.6); ctx.fill(); ctx.fillStyle="#fff"; circle(24.8,-41,1); ctx.fill();
  ctx.fillStyle = "#66BB6A"; rr(2,-24,10,5.4,2.6); ctx.fill(); // tay nhỏ
  ctx.strokeStyle = "#558B2F"; ctx.lineWidth = 5; const lp = Math.sin(ph*9)*7;
  ctx.beginPath(); ctx.moveTo(-14,-4); ctx.lineTo(-14+lp,8); ctx.moveTo(8,-4); ctx.lineTo(8-lp,8); ctx.stroke();
  ctx.restore();
}
GAMES.long = {
  icon:"🦖", name:"Khủng long", desc:"Ai bị ăn mất bánh",
  layout(actors){ yardLayout(actors, 336, 462); actors.forEach(a => a.cake = true); },
  begin(R){
    const others = shuffle(state.actors.filter(a => a !== R.winner));
    R.g.elims = others.map((a,i)=>({ a, at: 1 + (R.dur - 3.4) * (i+1)/(others.length+0.35), done:false }));
    R.g.dino = { x:90, y:430, face:1 }; R.g.chomp = 0;
  },
  resultText: w => "Khủng long ăn bánh của",
  onReveal(){ sndRoar(); },
  draw(now, R, dt){
    const hasBG = drawBG("long");
    if(!hasBG){ sky("#FFE3B3","#FFF6E0");
    // núi lửa
    ctx.fillStyle = "#8D6E63"; ctx.beginPath(); ctx.moveTo(726,268); ctx.lineTo(806,110); ctx.lineTo(838,110); ctx.lineTo(922,268); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#6D4C41"; ctx.beginPath(); ctx.moveTo(800,124); ctx.lineTo(844,124); ctx.lineTo(836,146); ctx.lineTo(808,146); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#FF7043"; ctx.beginPath(); ctx.ellipse(822,120,15,5.4,0,0,7); ctx.fill();
    ctx.fillStyle = "rgba(160,160,160,.55)"; circle(822,88,13+Math.sin(now*1.6)*2); ctx.fill(); circle(840,64,17+Math.cos(now*1.3)*2.4); ctx.fill(); circle(812,44,12); ctx.fill();
    // cây cọ
    for(const px of [70, 620]){
      ctx.strokeStyle = "#8A5A2E"; ctx.lineWidth = 9; ctx.beginPath(); ctx.moveTo(px, 268); ctx.quadraticCurveTo(px+8, 200, px+20, 158); ctx.stroke();
      ctx.strokeStyle = "#43A047"; ctx.lineWidth = 6;
      for(let i=0;i<5;i++){ const an = -0.4 - i*.42; ctx.beginPath(); ctx.moveTo(px+20,158); ctx.quadraticCurveTo(px+20+Math.cos(an)*36, 158+Math.sin(an)*22 - 8, px+20+Math.cos(an)*58, 158+Math.sin(an)*40 + 8); ctx.stroke(); }
    }
    ctx.fillStyle = "#C9A876"; ctx.fillRect(0, 268, W, H-268);
    ctx.fillStyle = "#B8935C"; ctx.fillRect(0, 268, W, 8); }
    if(R){
      for(const e of R.g.elims) if(!e.done && R.t >= e.at){ e.done = true; e.a.cake = false; sndChomp(); }
    }
    for(const a of state.actors){
      drawKid(a.x, a.y + Math.sin(now*2 + a.seed)*1.6, a.s, a.seed, { name:a.p.name, ooh: !a.cake && R,
        ring: R && R.phase==="reveal" && R.winner===a });
      if(a.cake) drawCake(a.x + 20, a.y + 2, .95);
    }
    const dino = R ? R.g.dino : { x:120 + Math.sin(now*.3)*36, y:436, face:1 };
    if(R){
      let tx = dino.x, ty = dino.y; const next = R.g.elims.find(e => !e.done);
      if(next){ tx = next.a.x - 40; ty = next.a.y + 6; }
      else if(R.phase === "reveal"){ tx = R.winner.x - 44; ty = R.winner.y + 6; }
      const arrived = moveToward(dino, tx, ty, 240, dt||.016);
      R.g.chomp = (arrived && ((next && R.t > next.at - .5) || R.phase==="reveal")) ? (Math.sin(now*16)*.5+.5) : 0;
      if(arrived && next && R.t >= next.at - .02 && next.a.cake){ /* chờ điểm thời gian */ }
    }
    if(R && R.phase === "playing") dustFx(R, dino.x, dino.y + 36, dt || .016, 18);
    drawDino(dino.x, dino.y, 1.12, dino.face||1, R ? R.g.chomp||0 : 0, now + (R ? R.t : 0));
    if(R && R.t < 1.9) bubble("Rồooo! Ta đói quá!", dino.x + 34, dino.y - 120);
    if(R && R.target && R.targetKind === "fake" && R.targetT < .7) bubble("Hít hít...", dino.x + 28, dino.y - 120);
    if(!R) label("Khủng long sẽ đi ăn bánh từng bạn — bánh của ai còn lại cuối cùng?", W/2, 32, 17, "#7C4A1E");
  }
};

/* ============ TRÒ 6: TÊN LỬA ============ */
function drawRocket(x, y, s, seed, name, flame){
  const rim = GV_RKT[seed % GV_RKT.length];
  if(imgReady(rim)){
    ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
    if(flame > 0){
      ctx.fillStyle = "#FF9800"; ctx.beginPath(); ctx.moveTo(-6,30); ctx.quadraticCurveTo(0, 30 + 16 + flame*14 + Math.sin(performance.now()/38)*4, 6, 30); ctx.closePath(); ctx.fill();
      ctx.fillStyle = "#FFEB3B"; ctx.beginPath(); ctx.moveTo(-3.4,30); ctx.quadraticCurveTo(0, 30 + 9 + flame*7, 3.4, 30); ctx.closePath(); ctx.fill();
    }
    const hh = 66, ww = hh * rim.naturalWidth / rim.naturalHeight;
    ctx.drawImage(rim, -ww/2, 28 - hh, ww, hh);
    ctx.restore();
    if(name) label(name, x, y + 44*s, 13.5, "#fff");
    return;
  }
  const cols = ["#EF5350","#42A5F5","#FFA726","#AB47BC","#26A69A","#EC407A"];
  ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
  if(flame > 0){
    ctx.fillStyle = "#FF9800"; ctx.beginPath(); ctx.moveTo(-6,26); ctx.quadraticCurveTo(0, 26 + 16 + flame*14 + Math.sin(performance.now()/38)*4, 6, 26); ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#FFEB3B"; ctx.beginPath(); ctx.moveTo(-3.4,26); ctx.quadraticCurveTo(0, 26 + 9 + flame*7, 3.4, 26); ctx.closePath(); ctx.fill();
  }
  ctx.fillStyle = cols[seed % cols.length];
  ctx.beginPath(); ctx.moveTo(-11,8); ctx.quadraticCurveTo(-19,22,-17,27); ctx.lineTo(-7,24); ctx.closePath(); ctx.fill();
  ctx.beginPath(); ctx.moveTo(11,8); ctx.quadraticCurveTo(19,22,17,27); ctx.lineTo(7,24); ctx.closePath(); ctx.fill();
  ctx.fillStyle = "#F5F7FA"; ctx.beginPath(); ctx.ellipse(0,0,11.5,24,0,0,7); ctx.fill();
  ctx.fillStyle = cols[seed % cols.length]; ctx.beginPath(); ctx.ellipse(0,-19,11.5,8.5,0,Math.PI,0); ctx.fill();
  ctx.beginPath(); ctx.ellipse(0,-21.5,7.5,5.6,0,Math.PI,0); ctx.fill();
  ctx.fillStyle = "#B3E5FC"; circle(0,-4,5.6); ctx.fill(); ctx.strokeStyle = "#78909C"; ctx.lineWidth = 1.8; circle(0,-4,5.6); ctx.stroke();
  ctx.fillStyle = "#FFE45E"; circle(0,-4.8,2); ctx.fill();
  ctx.restore();
  if(name) label(name, x, y + 44*s, 13.5, "#fff");
}
GAMES.lua = {
  icon:"🚀", name:"Tên lửa", desc:"Ai lên Mặt Trăng trước",
  layout(actors){ actors.forEach((a,i)=>{ a.padX = 70 + ((i*167) % 800); a.moonDx = ((i%5)-2) * 30; a.s = .95; }); },
  begin(R){
    const dur = R.dur; R.g.rates = {}; sndWhoosh();
    for(const a of state.actors) R.g.rates[a.p.id] = rand(.5,.86)/(dur-2);
    R.g.rates[R.winner.p.id] = 1/(dur-2);
    const others = state.actors.filter(a=>a!==R.winner);
    if(others.length){ const s = others[irand(0, others.length-1)]; R.g.surger = s; R.g.rates[s.p.id] = 1.07/(dur-2); R.g.boostEnd = dur*.52; }
  },
  resultText: w => "Lên Mặt Trăng đầu tiên —",
  draw(now, R){
    const hasBG = drawBG("lua");
    if(!hasBG){ const g = ctx.createLinearGradient(0,0,0,H); g.addColorStop(0,"#0D1440"); g.addColorStop(1,"#27356E");
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);
    for(let i=0;i<70;i++){ const sx = (i*137)%W, sy = (i*89)%380; ctx.fillStyle = `rgba(255,255,255,${.35 + (i%5)*.13})`; circle(sx, sy, (i%3)*.7+.7); ctx.fill(); }
    // Trái Đất
    ctx.fillStyle = "#42A5F5"; circle(66, 496, 66); ctx.fill();
    ctx.fillStyle = "#66BB6A"; ctx.beginPath(); ctx.ellipse(44,474,26,14,-.5,0,7); ctx.fill(); ctx.beginPath(); ctx.ellipse(88,516,22,12,.4,0,7); ctx.fill();
    // Mặt Trăng
    ctx.fillStyle = "#F5EFE0"; circle(838, 104, 56); ctx.fill();
    ctx.fillStyle = "#E3DCC8"; circle(818,88,10); ctx.fill(); circle(856,124,7.4); ctx.fill(); circle(842,80,5.4); ctx.fill();
    // bệ phóng
    ctx.fillStyle = "#5B6B8C"; ctx.fillRect(0, 500, W, 40);
    ctx.fillStyle = "#46536E"; for(let x=0;x<W;x+=48) ctx.fillRect(x, 500, 22, 40);
    }
    const t = R ? Math.min(R.t, R.dur) : 0;
    for(const a of state.actors){
      let prog = 0;
      if(R){
        const rate = R.g.rates[a.p.id];
        if(R.g.surger === a && t > R.g.boostEnd) prog = rate * R.g.boostEnd + .13 * (t - R.g.boostEnd)/(R.dur-2);
        else prog = rate * t;
        prog = clamp(prog, 0, 1);
        if(R.phase === "reveal" && a !== R.winner) prog = Math.min(prog, .93);
      }
      const ex = ease(clamp(prog,0,1));
      a.x = lerp(a.padX, 838 + a.moonDx, ex);
      a.y = lerp(466, 168, ex) - Math.sin(ex * Math.PI) * 36;
      const win = R && R.phase==="reveal" && R.winner===a;
      if(win){ ctx.strokeStyle = "#43D17C"; ctx.lineWidth = 4; circle(a.x, a.y, 36); ctx.stroke(); }
      drawRocket(a.x, a.y, a.s, a.seed, a.p.name, R && prog > 0 && prog < 1 ? 1 : 0);
    }
    if(R && R.phase === "reveal"){
      ctx.strokeStyle = "#8A5A2E"; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(838 + R.winner.moonDx + 16, 168); ctx.lineTo(838 + R.winner.moonDx + 16, 138); ctx.stroke();
      ctx.fillStyle = "#EF5350"; ctx.beginPath(); ctx.moveTo(838 + R.winner.moonDx + 16, 138); ctx.lineTo(838 + R.winner.moonDx + 34, 143); ctx.lineTo(838 + R.winner.moonDx + 16, 149); ctx.closePath(); ctx.fill();
    }
    if(!R) label("Tên lửa nào sẽ lên Mặt Trăng đầu tiên?", W/2, 34, 17.5, "#FFE45E");
  }
};

/* ============ TRÒ 7: ĐÈN PIN ============ */
GAMES.pin = {
  icon:"🔦", name:"Đèn pin", desc:"Tắt đèn đi tìm",
  layout(actors){ yardLayout(actors, 336, 466); actors.forEach(a => a.s = .86); },
  begin(R){ R.g.light = 0; R.g.beam = { x:480, y:130 }; R.g.lastT = null; sndSwitch(); },
  resultText: w => "Đèn pin tìm thấy —",
  holdAfter: 5,
  onReveal(){ sndLights(); },
  draw(now, R, dt){
    // lớp học
    const hasBG = drawBG("pin");
    if(!hasBG){ ctx.fillStyle = "#F7EBD4"; ctx.fillRect(0, 0, W, 452);
    ctx.fillStyle = "#EFDFC2"; ctx.fillRect(0, 0, W, 26);
    ctx.fillStyle = "#C89B6A"; ctx.fillRect(0, 452, W, 88);
    ctx.strokeStyle = "rgba(150,105,55,.35)"; ctx.lineWidth = 2;
    for(let i=0;i<5;i++){ ctx.beginPath(); ctx.moveTo(0, 470 + i*17); ctx.lineTo(W, 470 + i*17); ctx.stroke(); }
    // bảng đen
    ctx.fillStyle = "#8A5A2E"; rr(292, 36, 376, 138, 10); ctx.fill();
    ctx.fillStyle = "#2E5E4E"; rr(300, 44, 360, 122, 6); ctx.fill();
    ctx.fillStyle = "rgba(255,255,255,.93)"; ctx.font = '700 28px "Segoe UI", sans-serif'; ctx.textAlign = "center";
    ctx.fillText("Where is...?", 480, 94);
    ctx.font = '600 15.5px "Segoe UI", sans-serif'; ctx.fillStyle = "rgba(255,255,255,.55)";
    ctx.fillText("a   b   c   d   e   f   g   h ...", 480, 128);
    ctx.strokeStyle = "rgba(255,255,255,.5)"; ctx.lineWidth = 2; // phấn vẽ mặt trời + ngôi nhà
    ctx.beginPath(); ctx.arc(338, 140, 9, 0, 7); ctx.stroke();
    for(let i=0;i<6;i++){ const an = i/6 * Math.PI*2; ctx.beginPath(); ctx.moveTo(338 + Math.cos(an)*12, 140 + Math.sin(an)*12); ctx.lineTo(338 + Math.cos(an)*16, 140 + Math.sin(an)*16); ctx.stroke(); }
    ctx.strokeRect(592, 128, 22, 17); ctx.beginPath(); ctx.moveTo(589, 128); ctx.lineTo(603, 116); ctx.lineTo(617, 128); ctx.stroke();
    // đồng hồ treo tường
    ctx.fillStyle = "#fff"; circle(120, 84, 25); ctx.fill(); ctx.strokeStyle = "#8A5A2E"; ctx.lineWidth = 3.4; circle(120, 84, 25); ctx.stroke();
    ctx.strokeStyle = "#37474F"; ctx.lineWidth = 2.6; ctx.beginPath(); ctx.moveTo(120, 84); ctx.lineTo(120, 69); ctx.moveTo(120, 84); ctx.lineTo(131, 89); ctx.stroke();
    // cửa sổ bên phải (trời tối, trăng)
    ctx.fillStyle = "#8A5A2E"; rr(742, 52, 168, 128, 8); ctx.fill();
    ctx.fillStyle = "#22355E"; rr(750, 60, 152, 112, 5); ctx.fill();
    ctx.fillStyle = "#F5EFE0"; circle(872, 84, 13); ctx.fill(); ctx.fillStyle = "#22355E"; circle(866, 80, 11); ctx.fill();
    ctx.fillStyle = "#fff"; circle(786, 84, 1.8); ctx.fill(); circle(812, 130, 1.6); ctx.fill(); circle(852, 146, 1.8); ctx.fill(); circle(776, 148, 1.4); ctx.fill();
    ctx.strokeStyle = "#8A5A2E"; ctx.lineWidth = 4; ctx.beginPath(); ctx.moveTo(826, 60); ctx.lineTo(826, 172); ctx.stroke();
    ctx.fillStyle = "#C65D7A"; rr(742, 52, 26, 128, 8); ctx.fill(); rr(884, 52, 26, 128, 8); ctx.fill(); // rèm
    // đèn trần
    ctx.strokeStyle = "#8A8A8A"; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(480, 0); ctx.lineTo(480, 20); ctx.stroke();
    ctx.fillStyle = "#FFF3C4"; ctx.beginPath(); ctx.moveTo(448, 38); ctx.quadraticCurveTo(480, 16, 512, 38); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = "#D9A83F"; ctx.lineWidth = 2; ctx.beginPath(); ctx.moveTo(448, 38); ctx.quadraticCurveTo(480, 16, 512, 38); ctx.stroke(); }
    if(hasBG){ ctx.fillStyle = "rgba(255,255,255,.93)"; ctx.font = '700 30px "Segoe UI", sans-serif'; ctx.textAlign = "center"; ctx.fillText("Where is...?", 484, 208); ctx.font = '600 16px "Segoe UI", sans-serif'; ctx.fillStyle = "rgba(255,255,255,.55)"; ctx.fillText("a   b   c   d   e   f   g   h ...", 484, 254); }
    // các bạn + bàn học của từng bạn
    for(const a of state.actors){
      ctx.fillStyle = "#B07B45"; rr(a.x - 31, a.y + 13, 62, 10, 4); ctx.fill();
      ctx.fillStyle = "#96682F"; ctx.fillRect(a.x - 26, a.y + 23, 6, 12); ctx.fillRect(a.x + 20, a.y + 23, 6, 12);
      ctx.fillStyle = "#E53935"; rr(a.x - 14, a.y + 4, 13, 9, 2); ctx.fill(); // sách vở trên bàn
      ctx.fillStyle = "#42A5F5"; rr(a.x + 3, a.y + 5, 11, 8, 2); ctx.fill();
      drawKid(a.x, a.y - Math.abs(Math.sin(now * 3.3 + a.seed * 1.7)) * 4.2, a.s, a.seed, { name: a.p.name, ooh: R && R.target === a,
        ring: R && (R.phase === "reveal" || R.phase === "done") && R.winner === a });
      if(R && R.target === a && R.targetKind === "fake"){ if(R.targetT < .7) bubble("Tìm thấy rồi!", a.x, a.y - 68); else if(R.targetT > .95) bubble("ơ... khoan đã!", a.x, a.y - 68); }
    }
    if(R){
      if(R.target !== R.g.lastT){ R.g.lastT = R.target; if(R.target) sndDing(); }
      const beam = R.g.beam;
      let tx = 480 + Math.sin(now * .66) * 335, ty = 300 + Math.cos(now * .83) * 118;
      if(R.target){ tx = R.target.x; ty = R.target.y - 10; }
      if(R.phase === "reveal" || R.phase === "done" || R.twistShown){ R.g.light = Math.min(1, (R.g.light || 0) + (dt || .016) / .5); if(R.phase !== "playing"){ tx = R.winner.x; ty = R.winner.y - 10; } }
      beam.x = lerp(beam.x, tx, .085); beam.y = lerp(beam.y, ty, .085);
      const dark = .965 * (1 - (R.g.light || 0));
      if(dark > .02){
        const gr = ctx.createRadialGradient(beam.x, beam.y, 24, beam.x, beam.y, 168);
        gr.addColorStop(0, "rgba(8,8,32,0)"); gr.addColorStop(.6, `rgba(8,8,32,${dark * .3})`); gr.addColorStop(1, `rgba(8,8,32,${dark})`);
        ctx.fillStyle = gr; ctx.fillRect(0, 0, W, H);
        ctx.fillStyle = "rgba(255,240,170,.12)"; circle(beam.x, beam.y, 58 + Math.sin(now * 5) * 3); ctx.fill();
      }
      if(R.g.light > 0){ // đèn trần bật sáng
        const lg = ctx.createRadialGradient(480, 34, 8, 480, 34, 300);
        lg.addColorStop(0, `rgba(255,244,180,${.4 * R.g.light})`); lg.addColorStop(1, "rgba(255,244,180,0)");
        ctx.fillStyle = lg; ctx.fillRect(0, 0, W, H);
      }
      // cây đèn pin ở góc dưới trái, chĩa theo chùm sáng
      ctx.save(); ctx.translate(58, 492); ctx.rotate(Math.atan2(beam.y - 492, beam.x - 58) + Math.PI / 2); ctx.scale(1.25, 1.25);
      ctx.fillStyle = "#37474F"; rr(-9, -30, 18, 26, 5); ctx.fill();
      ctx.fillStyle = "#546E7A"; rr(-11, -38, 22, 10, 4); ctx.fill();
      ctx.fillStyle = "#F5A623"; rr(-12.5, -47, 25, 10, 5); ctx.fill();
      ctx.fillStyle = "#FFF59D"; circle(0, -42, 3.4); ctx.fill();
      ctx.restore();
      if(R.t < 1.7) bubble("Tắt đèn! Đèn pin đi tìm nào...", 480, 196);
    } else {
      label("Tắt đèn đi nào — đèn pin sẽ tìm ra một bạn!", W/2, 516, 16.5, "#7C4A1E");
    }
  }
};

/* ============ TRÒ 8: HỘP QUÀ ============ */
function drawGift(x, y, s, seed, opened, t){
  const gim = opened ? GV_GIFT[4] : GV_GIFT[seed % 4];
  if(imgReady(gim)){
    const hh = (opened ? 52 : 46)*s, ww = hh * gim.naturalWidth / gim.naturalHeight;
    ctx.drawImage(gim, x - ww/2, y - 6*s - hh/2 + Math.sin(t*3)*1.5, ww, hh);
    return;
  }
  const cols = ["#EF5350","#66BB6A","#42A5F5","#FFA726","#AB47BC","#EC407A"];
  ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
  if(opened){ // món đồ nhỏ bên trong
    ctx.fillStyle = "#FFD93B"; ctx.save(); ctx.translate(0,-24 - Math.sin(t*3)*2); ctx.rotate(Math.sin(t*2)*.2);
    ctx.beginPath(); for(let i=0;i<5;i++){ const an=-Math.PI/2 + i*2*Math.PI/5;
      ctx.lineTo(Math.cos(an)*9, Math.sin(an)*9); const an2=an+Math.PI/5; ctx.lineTo(Math.cos(an2)*4, Math.sin(an2)*4); }
    ctx.closePath(); ctx.fill(); ctx.restore();
  }
  ctx.fillStyle = cols[seed % cols.length]; rr(-19,-14,38,26,4); ctx.fill();
  ctx.fillStyle = "rgba(0,0,0,.13)"; ctx.fillRect(-19, 6, 38, 6);
  ctx.fillStyle = "#FFE45E"; ctx.fillRect(-3.2,-14,6.4,26);
  ctx.save();
  if(opened){ ctx.translate(-16,-14); ctx.rotate(-.5); ctx.translate(16,14); }
  ctx.fillStyle = cols[seed % cols.length]; rr(-22,-21,44,9,4); ctx.fill();
  ctx.fillStyle = "#FFE45E"; ctx.fillRect(-3.2,-21,6.4,9);
  ctx.beginPath(); ctx.ellipse(-5,-25,5.4,3.4,-.5,0,7); ctx.strokeStyle = "#FFE45E"; ctx.lineWidth = 2.6; ctx.stroke();
  ctx.beginPath(); ctx.ellipse(5,-25,5.4,3.4,.5,0,7); ctx.stroke();
  ctx.restore();
  ctx.restore();
}
GAMES.qua = {
  icon:"🎁", name:"Hộp quà", desc:"Mở hộp nhận thử thách",
  layout(actors){ yardLayout(actors, 322, 452); actors.forEach(a => a.opened = false); },
  begin(R){
    const others = shuffle(state.actors.filter(a => a !== R.winner));
    R.g.elims = others.map((a,i)=>({ a, at: 1 + (R.dur - 3.6) * (i+1)/(others.length+0.3), done:false }));
  },
  resultText: w => "Hộp quà của",
  onReveal(){ sndSparkle(); },
  draw(now, R){
    const hasBG = drawBG("qua");
    if(!hasBG){ ctx.fillStyle = "#FFF3E0"; ctx.fillRect(0,0,W,H);
    // dây cờ tam giác
    for(let sI=0;sI<2;sI++){
      ctx.strokeStyle = "rgba(150,110,60,.5)"; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(-10, 26 + sI*44); ctx.quadraticCurveTo(W/2, 74 + sI*44, W+10, 22 + sI*44); ctx.stroke();
      for(let i=0;i<14;i++){
        const t = i/13, fx = lerp(-10, W+10, t), fy = (26 + sI*44) + Math.sin(t*Math.PI) * (48 - sI*2) - (sI*4);
        ctx.fillStyle = ["#EF5350","#FFA726","#66BB6A","#42A5F5","#AB47BC"][i%5];
        ctx.beginPath(); ctx.moveTo(fx-9, fy); ctx.lineTo(fx+9, fy); ctx.lineTo(fx, fy+17); ctx.closePath(); ctx.fill();
      }
    }
    ctx.fillStyle = "#F6C6DA"; ctx.fillRect(0, 470, W, 70);
    ctx.fillStyle = "#EF9BC2"; ctx.fillRect(0, 470, W, 7); }
    if(R) for(const e of R.g.elims) if(!e.done && R.t >= e.at){ e.done = true; e.a.opened = true; sndPop(); }
    for(const a of state.actors){
      const win = R && R.phase==="reveal" && R.winner===a;
      drawKid(a.x, a.y + Math.sin(now*2 + a.seed)*1.6, a.s*.94, a.seed, { name:a.p.name, ring: win, jump: win ? now*6 : 0 });
      drawGift(a.x, a.y + 26, 1, a.seed, a.opened || win, now);
      if(win && R.t > R.dur - 1.6) bubble("Mở quà!", a.x, a.y - 74);
    }
    if(R && R.t < 1.7) bubble("Xào trộn hộp quà nào!", 480, 128);
    if(R && R.target && R.targetKind === "fake" && R.targetT > .4 && R.targetT < 1.05) bubble("Khoan đã... quay tiếp!", R.target.x, R.target.y - 72);
    if(!R) label("Hộp quà của ai sẽ được mở cuối cùng — kèm một thử thách vui?", W/2, 512, 16.5, "#7C4A1E");
  }
};

/* ============ TRÒ 9: THẺ ĐỎ ============ */
function drawRef(x, y, s, face, card, ph){
  ctx.save(); ctx.translate(x,y); ctx.scale(s*face, s); ctx.translate(0, -Math.abs(Math.sin(ph*11))*2.4);
  ctx.fillStyle = "#263238"; rr(-8, 6, 7.4, 14, 3); ctx.fill(); rr(1, 6, 7.4, 14, 3); ctx.fill();
  ctx.fillStyle = "#FDD835"; rr(-11.5, -12, 23, 20, 6); ctx.fill();
  ctx.fillStyle = "#FFD9B3"; circle(0, -22, 10); ctx.fill();
  ctx.fillStyle = "#4E342E"; ctx.beginPath(); ctx.arc(0,-25,10,Math.PI*1.05,Math.PI*1.95); ctx.fill();
  ctx.fillStyle = "#FFD9B3"; circle(12.6, -5, 4.2); ctx.fill(); circle(-12.6, -5, 4.2); ctx.fill();
  ctx.restore();
  if(card){
    ctx.save(); ctx.translate(x + 20*face, y - 34); ctx.rotate(.12*face);
    ctx.fillStyle = card === "red" ? "#E53935" : "#FDD835";
    rr(-8, -12, 16, 24, 2.6); ctx.fill();
    ctx.strokeStyle = "rgba(0,0,0,.3)"; ctx.lineWidth = 1.6; rr(-8,-12,16,24,2.6); ctx.stroke();
    ctx.restore();
  }
  label("Trọng tài", x, y + 34*s, 12.5, "#546E7A");
}
GAMES.the = {
  icon:"🟥", name:"Thẻ đỏ", desc:"Trọng tài rút thẻ",
  layout(actors){ yardLayout(actors, 318, 466); },
  begin(R){ R.g.ref = { x:90, y:400, face:1 }; },
  resultText: w => "Trọng tài rút thẻ đỏ cho —",
  onReveal(){ sndWhistle(); },
  draw(now, R, dt){
    ctx.fillStyle = "#43A047"; ctx.fillRect(0,0,W,H);
    for(let i=0;i<6;i++){ ctx.fillStyle = i%2 ? "rgba(255,255,255,.05)" : "rgba(0,0,0,.04)"; ctx.fillRect(i*(W/6), 0, W/6, H); }
    ctx.strokeStyle = "rgba(255,255,255,.85)"; ctx.lineWidth = 3.4;
    ctx.strokeRect(26, 26, W-52, H-52);
    ctx.beginPath(); ctx.moveTo(W/2, 26); ctx.lineTo(W/2, H-26); ctx.stroke();
    circle(W/2, H/2, 62); ctx.stroke();
    ctx.strokeRect(26, 168, 92, 204); ctx.strokeRect(W-118, 168, 92, 204);
    for(const a of state.actors){
      drawKid(a.x, a.y + Math.sin(now*2 + a.seed)*1.6, a.s, a.seed, { name:a.p.name, ooh: R && R.target===a,
        ring: R && R.phase==="reveal" && R.winner===a });
      if(R && R.target===a && R.targetKind==="fake" && R.targetT > .95) bubble("Thẻ vàng thôi!", a.x, a.y - 66);
      if(R && R.phase==="reveal" && R.winner===a && R.t > R.dur - 1.5) bubble("Thẻ đỏ!", a.x, a.y - 66);
    }
    const ref = R ? R.g.ref : { x:110, y:404, face:1 };
    let card = null;
    if(R){
      let tx = ref.x, ty = ref.y;
      if(R.target){ tx = R.target.x - 30; ty = R.target.y + 4; }
      else { const a = state.actors[Math.floor(now/2.4) % Math.max(1,state.actors.length)]; if(a){ tx = a.x - 30; ty = a.y + 4; } }
      const arrived = moveToward(ref, tx, ty, 250, dt||.016);
      if(R.phase === "reveal"){ moveToward(ref, R.winner.x - 30, R.winner.y + 4, 300, dt||.016); card = "red"; }
      else if(arrived && R.target && R.targetT > .45) card = "yellow";
      if(arrived && R.target && R.targetKind === "fake" && R.targetT === .45 + (dt||.016)) tone(1200, 0, .1, "square", .05);
    }
    if(R && R.t < 1.7) bubble("Tuýt tuýt! Phạm lỗi!", ref.x + 24, ref.y - 96);
    drawRef(ref.x, ref.y, 1.02, ref.face||1, card, R ? R.t : now);
  }
};

/* ============ TRÒ 10: UFO ============ */
function drawUFO(x, y, s, now, beamOn){
  if(imgReady(GV_UFO2)){
    ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
    if(beamOn){
      const gr = ctx.createLinearGradient(0,10,0,190);
      gr.addColorStop(0,"rgba(179,157,217,.5)"); gr.addColorStop(1,"rgba(179,157,217,.04)");
      ctx.fillStyle = gr; ctx.beginPath(); ctx.moveTo(-13,12); ctx.lineTo(13,12); ctx.lineTo(52,190); ctx.lineTo(-52,190); ctx.closePath(); ctx.fill();
    }
    const ww = 112, hh = ww * GV_UFO2.naturalHeight / GV_UFO2.naturalWidth;
    ctx.drawImage(GV_UFO2, -ww/2, -hh/2 - 2, ww, hh);
    ctx.restore();
    return;
  }
  ctx.save(); ctx.translate(x,y); ctx.scale(s,s);
  if(beamOn){
    const gr = ctx.createLinearGradient(0,10,0,190);
    gr.addColorStop(0,"rgba(179,157,217,.5)"); gr.addColorStop(1,"rgba(179,157,217,.04)");
    ctx.fillStyle = gr; ctx.beginPath(); ctx.moveTo(-13,12); ctx.lineTo(13,12); ctx.lineTo(52,190); ctx.lineTo(-52,190); ctx.closePath(); ctx.fill();
  }
  ctx.fillStyle = "#B39DDB"; ctx.beginPath(); ctx.ellipse(0,6,44,13,0,0,7); ctx.fill();
  ctx.fillStyle = "#9575CD"; ctx.beginPath(); ctx.ellipse(0,10,44,10,0,0,Math.PI); ctx.fill();
  ctx.fillStyle = "rgba(179,229,252,.9)"; ctx.beginPath(); ctx.ellipse(0,-6,21,13,0,Math.PI,0); ctx.fill();
  ctx.fillStyle = "#7ED3F7"; circle(-4,-8,3.4); ctx.fill(); circle(5,-9,2.6); ctx.fill();
  const cols = ["#EF5350","#FFD93B","#66BB6A","#42A5F5"];
  for(let i=0;i<4;i++){ ctx.fillStyle = Math.sin(now*6 + i*1.7) > 0 ? cols[i] : "#5E35B1"; circle(-30 + i*20, 8, 3.6); ctx.fill(); }
  ctx.restore();
}
GAMES.ufo = {
  icon:"🛸", name:"UFO", desc:"Đĩa bay bắt cóc",
  layout(actors){ yardLayout(actors, 392, 480); },
  begin(R){ R.g.ufo = { x:480, y:96 }; R.g.lift = 0; R.g.liftActor = null; },
  resultText: w => "UFO đã bắt cóc",
  onReveal(){ sndBeam(); },
  draw(now, R, dt){
    const hasBG = drawBG("ufo");
    if(!hasBG){ const g = ctx.createLinearGradient(0,0,0,H); g.addColorStop(0,"#FF9E64"); g.addColorStop(.55,"#FFD3A5"); g.addColorStop(1,"#FFF1D6");
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);
    sun(96, 300, 30);
    // phố cổ: nhà mái ngói hai bên
    for(const [hx, hw, hh, c] of [[8,150,120,"#F6E3C5"],[166,120,96,"#F1D9B0"],[676,124,100,"#F1D9B0"],[808,144,126,"#F6E3C5"]]){
      ctx.fillStyle = c; ctx.fillRect(hx, 330-hh, hw, hh+84);
      ctx.fillStyle = "#B5542D"; ctx.beginPath(); ctx.moveTo(hx-8, 330-hh); ctx.lineTo(hx+hw/2, 330-hh-30); ctx.lineTo(hx+hw+8, 330-hh); ctx.closePath(); ctx.fill();
      ctx.fillStyle = "#8A5A2E"; rr(hx+hw/2-13, 330-hh+34, 26, 40, 9); ctx.fill();
      ctx.fillStyle = "#FFE9A8"; rr(hx+16, 330-hh+22, 20, 20, 3); ctx.fill(); rr(hx+hw-36, 330-hh+22, 20, 20, 3); ctx.fill();
    }
    // cây anh đào
    ctx.strokeStyle = "#6D4C41"; ctx.lineWidth = 8; ctx.beginPath(); ctx.moveTo(330, 414); ctx.quadraticCurveTo(336, 360, 322, 322); ctx.stroke();
    ctx.fillStyle = "#F8BBD0"; circle(322,306,21); ctx.fill(); circle(300,320,15); ctx.fill(); circle(346,318,16); ctx.fill(); circle(330,290,13); ctx.fill();
    ctx.fillStyle = "#90A4AE"; ctx.fillRect(0, 414, W, 126);
    ctx.fillStyle = "rgba(255,255,255,.35)"; for(let x=14;x<W;x+=64) ctx.fillRect(x, 470, 34, 5); }
    for(const a of state.actors){
      if(a.abducted) continue;
      let yy = a.y, sc = a.s, alpha = 1;
      if(R && R.g.liftActor === a){ yy -= R.g.lift; sc = a.s * (1 - R.g.lift/420); }
      ctx.save(); ctx.globalAlpha = alpha;
      drawKid(a.x + Math.sin(now*2.2 + a.seed)*3, yy, sc, a.seed, { name: a.p.name, ooh: R && R.target===a, jump: now*7 + a.seed });
      ctx.restore();
      if(R && R.phase === "play" && R.g.ufo && a !== R.target && Math.abs(a.x - R.g.ufo.x) < 64) bubble(a.seed % 2 ? "Cứu với!" : "Ôi!", a.x, a.y - 78);
      if(R && R.target===a && R.targetKind==="fake" && R.targetT > .95) bubble("ơ... khoan đã!", a.x, a.y - 76);
    }
    const ufo = R ? R.g.ufo : { x: 480 + Math.sin(now*.5)*240, y: 96 };
    let beamOn = false;
    if(R){
      let tx = 480 + Math.sin(now*.6)*300, ty = 96;
      if(R.target){ tx = R.target.x; ty = 108; }
      if(R.phase === "reveal"){ tx = R.winner.x; ty = 108; }
      moveToward(ufo, tx, ty, 380, dt||.016);
      R.g.lift = 0; R.g.liftActor = null;
      const tgt = R.phase === "reveal" ? R.winner : R.target;
      if(tgt && Math.abs(ufo.x - tgt.x) < 34){
        beamOn = true;
        if(R.targetKind === "fake" || (R.phase !== "reveal" && tgt === R.target)) { if(R.target) { R.g.lift = Math.sin(Math.min(1, R.targetT/1.25) * Math.PI) * 52; R.g.liftActor = R.target; } }
        if(R.phase === "reveal"){ R.g.lift = Math.min(228, (R.g.lift||0) + (dt||.016)*118); R.g.liftActor = R.winner;
          if(R.g.lift >= 225 && R.t > R.dur - .35) R.winner.abducted = true; }
      }
    }
    drawUFO(ufo.x, ufo.y, 1.15, now, beamOn);
    if(!R) label("Đĩa bay sẽ hút một bạn lên — ai sẽ bị bắt cóc?", W/2, 522, 16, "#7C4A1E");
  }
};

/* ============ GỌI TÊN VUI — gắn vào mục Danh sách lớp (p9) ============ */
for(const k in GAMES){ if(GAMES[k].holdAfter == null) GAMES[k].holdAfter = 5; }
let gvSig = "";
function gvTypedNames(){
  const ta = $("gvNames");
  if(!ta) return null;
  const ns = ta.value.split(/\r?\n/).map(x => x.trim()).filter(Boolean);
  return ns.length >= 2 ? ns : null;
}
function gvNames(){
  try{
    if(typeof LOP !== "undefined" && Array.isArray(LOP.students)){
      const ns = LOP.students.map(s => (s && s.name) ? String(s.name).trim() : "").filter(Boolean);
      if(ns.length >= 2) return ns;
    }
  }catch(e){}
  return null;
}
function gvRefresh(){
  const tn = gvTypedNames(), ns = gvNames();
  const note = $("gvSrcNote"), row = $("gvCntRow");
  if(tn){ if(note) note.textContent = "Đang dùng danh sách nhập ngay trong thẻ trò chơi — " + tn.length + " bạn."; if(row) row.style.display = "none"; }
  else if(ns){ if(note) note.textContent = "Đang dùng danh sách lớp đã lưu — " + ns.length + " bạn."; if(row) row.style.display = "none"; }
  else { if(note) note.textContent = "Chưa có danh sách nào — đang dùng số thứ tự. Thầy cô nhập tên ngay trong thẻ trò chơi bên dưới."; if(row) row.style.display = "flex"; }
  refreshCounter(); gvSyncActors(true);
}
function gvSyncActors(force){
  const pool = activePool();
  const sig = pool.map(p => p.name).join("|");
  if(force || sig !== gvSig){ gvSig = sig; makeActors(); }
}
function gvInit(){
  if(window.__gvInit) { gvRefresh(); return; }
  window.__gvInit = true;
  document.querySelectorAll(".gv-gbtn").forEach(b => b.onclick = () => {
    if(state.playing) return;
    state.game = b.dataset.gv;
    document.querySelectorAll(".gv-gbtn").forEach(x => x.classList.toggle("on", x === b));
    hideBanner(); makeActors();
    const w = $("gvWrap"); if(w) w.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
  $("gvStart").onclick = () => { gvSyncActors(false); startRound(); };
  $("gvWrap").onclick = e => { if(!state.playing){ gvSyncActors(false); startRound(); } };
  $("gvReset").onclick = () => { state.called = []; hideBanner(); $("gvStart").textContent = "Bắt đầu!"; refreshCounter(); makeActors(); };
  $("gvDur").oninput = e => $("gvDurVal").textContent = e.target.value;
  const gvn = $("gvNames"); if(gvn) gvn.oninput = () => gvRefresh();
  $("gvSit").onchange = () => { refreshCounter(); makeActors(); };
  $("gvCnt").oninput = () => { refreshCounter(); makeActors(); };
  $("gvSndTest").onclick = () => { const was = $("gvSound").checked; $("gvSound").checked = true; sndWin(); if(!was) setTimeout(() => $("gvSound").checked = was, 700); };
  $("gvFs").onclick = () => { const el = $("gvWrap"); if(document.fullscreenElement) document.exitFullscreen(); else if(el.requestFullscreen) el.requestFullscreen(); };
  gvRefresh();
  requestAnimationFrame(gvLoop);
}
function gvLoop(ts){
  const p9 = document.getElementById("p9");
  if(p9 && !p9.classList.contains("hide")) loop(ts);
  requestAnimationFrame(gvLoop);
}
window.gvInit = gvInit; window.gvRefresh = gvRefresh;
/* mở tab 9 thì khởi động + nạp lại tên (danh sách lớp tải bất đồng bộ) */
try{
  const _tabOrig = tab;
  tab = function(n){ _tabOrig(n); if(n === 9){ setTimeout(gvInit, 60); setTimeout(gvRefresh, 900); setTimeout(gvRefresh, 2200); } };
}catch(e){}
document.addEventListener("click", e => { if(e.target.closest && e.target.closest("#gvCard")) gvInit(); }, true);

})();</script>

<!-- ===== BẢNG THÔNG BÁO BẢN THỬ NGHIỆM (hiện khi đăng nhập) ===== -->
<div id="tbDemo" class="hide" style="position:fixed;inset:0;background:rgba(43,32,16,.55);z-index:99990;display:flex;align-items:center;justify-content:center;padding:16px">
  <div style="background:#FFF9EE;max-width:520px;width:100%;border-radius:20px;border:3px solid #F2C14E;box-shadow:0 18px 50px rgba(0,0,0,.35);padding:26px 26px 20px;text-align:center">
    <div style="font-size:40px;line-height:1">📢</div>
    <div style="font-weight:800;font-size:23px;color:#B3541E;margin:8px 0 2px">THÔNG BÁO</div>
    <div style="font-weight:700;font-size:17px;color:#37474F">Trang web đang trong giai đoạn<br>CHẠY THỬ NGHIỆM (bản demo)</div>
    <div style="text-align:left;font-size:15px;line-height:1.55;color:#4E342E;margin:14px 4px 4px">
      <p style="margin:0 0 9px">🌐 <b>Trợ lý Báo bài &amp; Giáo án</b> hiện là phiên bản demo. Một số tính năng vẫn đang được hoàn thiện, nên giao diện và cách dùng có thể còn thay đổi trong thời gian tới.</p>
      <p style="margin:0 0 9px">💾 Thầy cô vui lòng <b>giữ lại bản gốc</b> các file đã tải lên (báo bài, giáo án...) trên máy của mình, vì dữ liệu trong giai đoạn thử nghiệm có thể được điều chỉnh khi nâng cấp hệ thống.</p>
      <p style="margin:0 0 9px">🛠️ Nếu gặp lỗi hoặc có góp ý, thầy cô vui lòng liên hệ quản trị viên: <b>Lê Đắc Đạt — 0865 291 703</b>.</p>
      <p style="margin:0">❤️ Cảm ơn thầy cô đã tin tưởng dùng thử và góp ý để trang web ngày càng hoàn thiện!</p>
    </div>
    <button id="tbDemoOk" style="margin-top:18px;background:#F39C3D;color:#fff;font-weight:800;font-size:16.5px;border:none;border-radius:999px;padding:12px 34px;cursor:pointer;box-shadow:0 4px 0 #C77414">Đã hiểu, bắt đầu dùng</button>
  </div>
</div>
<script>
function demoNotice(){
  try{ if(sessionStorage.getItem("tbDemoSeen")) return; }catch(e){}
  var m = document.getElementById("tbDemo"); if(!m) return;
  m.classList.remove("hide");
  document.getElementById("tbDemoOk").onclick = function(){
    try{ sessionStorage.setItem("tbDemoSeen", "1"); }catch(e){}
    m.classList.add("hide");
  };
}
</script>
</body></html>
