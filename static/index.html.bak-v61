t-align:center}.umenu{position:relative}.uchip{display:flex;align-items:center;gap:7px;background:#fff;border:1.5px solid #dbe4f0;border-radius:999px;padding:5px 12px 5px 8px;font:inherit;font-weight:700;color:#1e40af;cursor:pointer}.uchip:hover{border-color:#93c5fd}.uchip .ucaret{font-size:11px;color:#64748b}.udrop{position:absolute;right:0;top:calc(100% + 6px);background:#fff;border:1px solid #e2e8f0;border-radius:12px;box-shadow:0 10px 28px #0f172a22;min-width:190px;padding:6px;z-index:60}.udrop button{display:flex;align-items:center;gap:8px;width:100%;border:0;background:none;padding:10px 12px;font:inherit;font-weight:600;color:#334155;border-radius:8px;cursor:pointer;text-align:left}.udrop button:hover{background:#eff6ff;color:#1d4ed8}.pwov{position:fixed;inset:0;z-index:1000;background:#0f172a99;display:flex;align-items:center;justify-content:center;padding:16px}.pwcard{background:#fff;border-radius:16px;padding:24px;width:min(400px,94vw);box-shadow:0 20px 60px #0006}.pwcard h3{margin:0 0 14px}.pwcard label{display:block;margin-bottom:12px;font-weight:600;color:#334155}.pwcard input{width:100%;margin-top:5px}.pwmsg{min-height:20px;font-size:13.5px;color:#b91c1c}.tsel{font:inherit;font-size:13px;font-weight:700;border-radius:8px;padding:5px 7px;border:1.5px solid #cbd5e1;background:#fff;cursor:pointer}.ts-thuong{color:#64748b!important}.tsel.ts-vip{color:#7c3aed;border-color:#c4b5fd;background:#f5f3ff}.tsel.ts-pro{color:#b45309;border-color:#f59e0b;background:linear-gradient(90deg,#fef3c7,#fde68a)}.utier{font-size:10.5px;font-weight:800;letter-spacing:.4px;padding:2.5px 8px;border-radius:999px;background:#f1f5f9;color:#64748b;white-space:nowrap}.utier.ts-vip{background:#ede9fe;color:#6d28d9}.utier.ts-pro{background:linear-gradient(90deg,#f59e0b,#ef4444);color:#fff}.nm-vip{color:#dc2626}.nm-pro{color:#dc2626}.loplist{max-height:300px;overflow:auto;margin:8px 0}.loprow{display:flex;align-items:center;gap:8px;padding:5px 8px;border-bottom:1px solid #f1f5f9;font-size:14px}.lopnm{flex:1;font-weight:600}.lopdel{border:0;background:#fef2f2;color:#dc2626;border-radius:7px;width:24px;height:24px;cursor:pointer;flex:none}.wheelwrap{display:flex;justify-content:center}#wheel{width:min(440px,88vw);height:auto}.wheelres{text-align:center;font-size:19px;min-height:28px;margin:6px 0}.tdisp{text-align:center;font-family:"Courier New",monospace;font-size:62px;font-weight:700;color:#1d4ed8;letter-spacing:3px;padding:6px 0}.gout{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-top:10px}.gbox{border-radius:12px;padding:10px 12px;font-size:14px;line-height:1.55}.hs-whoin{display:flex;gap:10px;align-items:center;background:#f0f9ff;border:1.5px solid #bae6fd;border-radius:14px;padding:8px 10px}
.hs-whoav{font-size:34px}
.hs-stage{position:relative}
.hs-scene{display:flex;gap:18px;flex-wrap:wrap;background:linear-gradient(180deg,#7dd3fc 0%,#bae6fd 45%,#bbf7d0 100%);border-radius:20px;padding:20px;overflow:hidden}
.hs-left{display:flex;flex-direction:column;align-items:center;gap:8px;min-width:180px;flex:0 1 200px;margin:auto}
.hs-owl{font-size:84px;filter:drop-shadow(0 6px 8px rgba(0,0,0,.18))}
.hs-sign{background:linear-gradient(180deg,#b45309,#92400e);color:#fef3c7;font-weight:900;font-size:26px;line-height:1.15;text-align:center;padding:12px 18px;border-radius:14px;border:3px solid #78350f;box-shadow:0 6px 0 #78350f;text-shadow:0 2px 0 rgba(0,0,0,.25)}
.hs-sign span{color:#fde047}
.hs-bubble{background:#fff;border-radius:14px;padding:8px 12px;font-weight:600;color:#334155;box-shadow:0 3px 8px rgba(0,0,0,.12);text-align:center}
.hs-card{background:#fff;border-radius:18px;padding:18px;flex:1 1 340px;box-shadow:0 10px 24px rgba(2,132,199,.18)}
.hs-card h3{margin:10px 0 8px;font-size:17px;color:#1e3a8a}
.hs-card input[type=text]{width:100%;font-size:17px;padding:10px 12px;border:2px dashed #fbbf24;border-radius:12px;background:#fffbeb;box-sizing:border-box}
.hs-card select{width:100%;margin-top:8px;padding:8px;border-radius:10px;border:1.5px solid #e2e8f0;box-sizing:border-box}
.hs-grades{display:grid;grid-template-columns:repeat(auto-fill,minmax(86px,1fr));gap:8px}
.hs-gcard{border:2.5px solid #e2e8f0;background:#f8fafc;border-radius:14px;padding:8px 4px;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px;font-weight:700;color:#334155;transition:.15s;font-family:inherit}
.hs-gcard span{font-size:30px}
.hs-gcard.sel{border-color:#f59e0b;background:#fef3c7;transform:scale(1.04)}
.hs-buddies{display:flex;gap:8px;flex-wrap:wrap}
.hs-bud{width:46px;height:46px;border-radius:50%;border:2.5px solid #e2e8f0;background:#f8fafc;font-size:24px;cursor:pointer}
.hs-bud.sel{border-color:#ec4899;background:#fdf2f8;transform:scale(1.12)}
.hs-cta{width:100%;margin-top:14px;background:linear-gradient(180deg,#fb923c,#ea580c);color:#fff;font-size:19px;font-weight:900;border:none;border-radius:14px;padding:13px;cursor:pointer;box-shadow:0 5px 0 #9a3412;font-family:inherit}
.hs-cta:active{transform:translateY(3px);box-shadow:0 2px 0 #9a3412}
.hs-bar{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.hs-bar h3{margin:0;flex:1}
.hs-stars{background:#fef3c7;border:1.5px solid #fbbf24;border-radius:999px;padding:4px 12px;font-weight:800;white-space:nowrap}
.hs-hello{display:flex;align-items:center;gap:14px;background:#fff;border:1.5px solid #e2e8f0;border-radius:18px;padding:14px 18px;margin-bottom:14px}
.hs-hello .av{font-size:54px}
.hs-hello h3{margin:0 0 4px}
.hs-home{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px}
.hs-gc2{border:none;border-radius:18px;padding:20px 12px;cursor:pointer;color:#fff;font-weight:900;font-size:17px;display:flex;flex-direction:column;align-items:center;gap:6px;box-shadow:0 6px 14px rgba(0,0,0,.15);font-family:inherit}
.hs-gc2 span{font-size:52px}
.hs-gc2 small{font-weight:600;opacity:.92}
.hs-game{background:#fff;border:1.5px solid #e2e8f0;border-radius:18px;padding:18px;position:relative;overflow:hidden}
.hs-prog{font-weight:700;color:#64748b;margin-bottom:8px}
.hs-rabbit{display:flex;align-items:center;gap:14px;justify-content:center;flex-wrap:wrap}
.hs-rav{font-size:74px}
.hs-bub{background:#fef3c7;border:2.5px solid #f59e0b;border-radius:16px;padding:12px 20px;font-size:30px;font-weight:900;color:#92400e}
.hs-ask{text-align:center;font-size:16px}
.hs-houses{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:10px}
.hs-house{background:#eff6ff;border:2.5px solid #93c5fd;border-radius:16px;padding:10px 18px;cursor:pointer;display:flex;flex-direction:column;align-items:center;font-family:inherit}
.hs-house span{font-size:40px}
.hs-house b{font-size:24px;color:#1d4ed8}
.hs-house.good{background:#dcfce7;border-color:#22c55e}
.hs-house.bad{animation:hsShake .4s;background:#fee2e2;border-color:#ef4444}
@keyframes hsShake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.hs-fb{text-align:center;font-weight:700;min-height:24px;color:#b45309}
.hs-bigpic{font-size:96px;text-align:center;line-height:1.2}
.hs-words{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.hs-word{background:#fdf2f8;border:2.5px solid #f9a8d4;border-radius:14px;padding:12px 22px;font-size:20px;font-weight:800;color:#9d174d;cursor:pointer;font-family:inherit}
.hs-word.good{background:#dcfce7;border-color:#22c55e;color:#166534}
.hs-word.bad{animation:hsShake .4s;background:#fee2e2;border-color:#ef4444}
.hs-mem{display:grid;grid-template-columns:repeat(4,74px);gap:10px;justify-content:center}
.hs-mc{width:74px;height:74px;border-radius:14px;border:2.5px solid #a5b4fc;background:#eef2ff;font-size:34px;cursor:pointer;font-family:inherit}
.hs-mc .hs-mcb{display:none}
.hs-mc.up{background:#fff}
.hs-mc.up .hs-mcf{display:none}
.hs-mc.up .hs-mcb{display:inline}
.hs-mc.win{background:#dcfce7;border-color:#22c55e}
.hs-win{text-align:center;background:#fffbeb;border:1.5px solid #fde68a;border-radius:18px;padding:24px;position:relative;overflow:hidden}
.hs-winav{font-size:76px}
.hs-conf{position:absolute;top:-30px;font-size:22px;animation:hsFall 1.5s ease-in forwards;pointer-events:none;z-index:5}
@keyframes hsFall{to{transform:translateY(430px) rotate(300deg);opacity:0}}
#p10:fullscreen{background:#f0f9ff;overflow:auto;padding:12px}

/* ===== V60: gọn thanh thông tin tren di dong, o doc van ban, nut chon tro goc hoc sinh ===== */
@media(max-width:640px){header.v9 .hbar{padding:5px 8px;gap:6px}.hright{gap:6px}.acard small{display:none}.ledbox{padding:2px 8px}.ledlab{font-size:8.5px}header.v9 .aphone{font-size:13px;padding:4px 9px}}
#ttstext{font-family:"Be Vietnam Pro",system-ui,sans-serif;font-size:15px;line-height:1.55}
.ttsfilelab{display:inline-flex;align-items:center;gap:6px;background:#eff6ff;border:1.5px solid #bfdbfe;color:#1d4ed8;border-radius:10px;padding:7px 12px;font-weight:700;cursor:pointer;margin-top:8px}
#p10 .card label>span .btn2{display:flex;align-items:center;gap:8px;justify-content:flex-start;width:100%;padding:11px 14px;border-radius:12px;font-weight:700;font-size:14.5px;background:linear-gradient(160deg,#f0f9ff,#e0f2fe);border:1.5px solid #bae6fd;color:#0c4a6e;cursor:pointer}
#p10 .card label>span .btn2:hover{border-color:#38bdf8;background:linear-gradient(160deg,#e0f2fe,#bae6fd)}
