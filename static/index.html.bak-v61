lassList.toggle("on",n.dataset.s===t)),pfDraw()}function pfCnt(){const t=PF.st,n=t.game;$("pfcnt").textContent=`· ${t.phieu.exercises.length} bài tập · ${t.khoidong.questions.length} câu khởi động · ${n.questions.length} câu trò chơi`}function pfV(t,n){let e=PF.st;const s=t.split(".");s.slice(0,-1).forEach(t=>e=e[t]);const o=s[s.length-1];e[o]="number"===n.type?+n.value||1:n.value,pfSave(),"ochu"===PF.sec&&pfOcStat()}function pfInp(t,n,e,s,o){return`<input type="text" class="${s||"w"}" value="${esc(n||"")}" placeholder="${e||""}" maxlength="${o||300}" oninput="pfV('${t}',this)">`}function pfTa(t,n,e){return`<textarea placeholder="${e||""}" maxlength="300" oninput="pfV('${t}',this)">${esc(n||"")}</textarea>`}function pfDraw(){pfCnt(),pfGames();const t=PF.st,n=PF.sec;let e="";if("phieu"===n)t.phieu.exercises.forEach((t,n)=>{const s=`phieu.exercises.${n}`;e+=`<div class="pfbox" data-ex="${n}"><h4>Bài ${n+1}. <select onchange="pfKind(${n},this.value)">${Object.entries(PFK).map(([n,e])=>`<option value="${n}" ${n===t.kind?"selected":""}>${e}</option>`).join("")}</select>${pfInp(s+".title",t.title,"Lệnh của bài")}<button class="pfx" title="Xoá bài" onclick="pfDel('phieu.exercises',${n})">×</button></h4>`,t.items.forEach((o,i)=>{const a=`${s}.items.${i}`;e+=`<div class="pfit"><span>${String.fromCharCode(97+i)})</span>`,"match"===t.kind?e+=pfInp(a+".left",o.left,"Vế trái")+pfInp(a+".right",o.right,"Vế phải (đúng)"):(e+=pfInp(a+".q",o.q,"fill"===t.kind?"Câu có chỗ trống ___":"tf"===t.kind?"Nhận định":"Câu hỏi")+("mcq"===t.kind?`<button class="pfx" title="Xoá ý" onclick="pfDel('${s}.items',${i})">×</button>`:""),"mcq"===t.kind?e+=`<div class="pfopts">${[0,1,2,3].map(t=>`<label><input type="radio" name="r${n}_${i}" ${o.a==="ABCD"[t]?"checked":""} onchange="pfSetA('${a}','${"ABCD"[t]}')" title="Đáp án đúng">${"ABCD"[t]}.<input type="text" value="${esc((o.options||[])[t]||"")}" maxlength="120" oninput="pfOpt('${a}',${t},this)"></label>`).join("")}</div>`:"tf"===t.kind?e+=`<select onchange="pfV('${a}.a',this)"><option value="Đ" ${"Đ"===o.a?"selected":""}>Đ</option><option value="S" ${"S"===o.a?"selected":""}>S</option></select>`:e+=pfInp(a+".a",o.a,"Đáp án","",300)+("write"===t.kind?`<input type="number" min="1" max="6" value="${o.lines||2}" title="Số dòng để viết" style="width:56px" oninput="pfV('${a}.lines',this)">`:"")),e+=("mcq"===t.kind?"":`<button class="pfx" title="Xoá ý" onclick="pfDel('${s}.items',${i})">×</button>`)+"</div>"}),e+=`<button class="pfadd" onclick="pfAddItem(${n})">＋ Thêm ý</button></div>`}),e+=t.phieu.exercises.length<6?'<button class="pfadd" id="pfaddex" onclick="pfAddEx()">＋ Thêm bài tập</button>':'<p class="muted" style="font-size:13px">Phiếu có tối đa 6 bài.</p>',t.phieu.exercises.length||(e='<div class="nxempty">Chưa có bài tập. Chọn bài rồi bấm “Tạo bằng AI”, hoặc tự soạn.</div>'+e);else if("khoidong"===n){const n=t.khoidong;e=`<div class="pfbox"><h4>Tên trò chơi ${pfInp("khoidong.name",n.name,"VD: Truyền điện","w",120)}</h4>${pfTa("khoidong.luat",n.luat,"Luật chơi…")}</div>`,n.questions.forEach((t,n)=>{e+=`<div class="pfit"><span>${n+1}.</span>${pfInp(`khoidong.questions.${n}.q`,t.q,"Câu hỏi")}${pfInp(`khoidong.questions.${n}.a`,t.a,"Đáp án")}<button class="pfx" onclick="pfDel('khoidong.questions',${n})">×</button></div>`}),e+='<button class="pfadd" onclick="pfAddK()">＋ Thêm câu hỏi</button>'}else if("cau"===n)t.game.questions.forEach((t,n)=>{const s=`game.questions.${n}`;e+=`<div class="pfbox" data-gq="${n}"><div class="pfit"><span>${n+1}.</span>${pfInp(s+".q",t.q,"Câu hỏi")}<button class="pfx" onclick="pfDel('game.questions',${n})">×</button>\n   <div class="pfopts">${[0,1,2,3].map(e=>`<label><input type="radio" name="g${n}" ${t.a==="ABCD"[e]?"checked":""} onchange="pfSetA('${s}','${"ABCD"[e]}')" title="Đáp án đúng">${"ABCD"[e]}.<input type="text" value="${esc((t.options||[])[e]||"")}" maxlength="120" oninput="pfOpt('${s}',${e},this)"></label>`).join("")}</div>${pfInp(s+".explain",t.explain,"Giải thích ngắn (tuỳ chọn)")}</div></div>`}),e+='<button class="pfadd" id="pfaddq" onclick="pfAddQ()">＋ Thêm câu hỏi</button><p class="muted" style="font-size:12.5px">Dùng chung cho Rung chuông vàng, Vòng quay, Ai nhanh ai đúng. Chọn ô tròn ở phương án đúng.</p>',t.game.questions.length||(e='<div class="nxempty">Chưa có câu hỏi trò chơi.</div>'+e);else{const n=t.game.ochu;e=`<div class="pfbox"><h4>Từ khoá hàng dọc ${pfInp("game.ochu.keyword",n.keyword,"VD: CỘNG","",40)} <button class="pfadd" onclick="pfOcRows()">Tạo đủ hàng theo từ khoá</button></h4>${pfInp("game.ochu.clue",n.clue,"Gợi ý từ khoá (tuỳ chọn)","w",200)}</div>`,n.rows.forEach((t,n)=>{e+=`<div class="pfit"><span>${n+1}.</span>${pfInp(`game.ochu.rows.${n}.clue`,t.clue,"Gợi ý hàng ngang")}${pfInp(`game.ochu.rows.${n}.answer`,t.answer,"Đáp án","",40)}<b class="ocst" data-i="${n}"></b><button class="pfx" onclick="pfDel('game.ochu.rows',${n})">×</button></div>`}),e+='<button class="pfadd" onclick="pfAddOc()">＋ Thêm hàng</button> <span id="pfocall"></span><p class="muted" style="font-size:12.5px">Hàng thứ n phải chứa chữ cái thứ n của từ khoá (không tính dấu).</p>'}$("pfed").innerHTML=e,"ochu"===n&&pfOcStat()}function pfOcStat(){const t=PF.st.game.ochu,n=GamePlayer.norm(t.keyword);let e=n.length>=2&&t.rows.length===n.length;document.querySelectorAll(".ocst").forEach(s=>{const o=+s.dataset.i,i=t.rows[o],a=n[o]||"",c=a&&GamePlayer.norm(i.answer).includes(a)&&i.clue;c||(e=!1),s.className="ocst "+(c?"pfok":"pfbad"),s.textContent=c?"✓":a?"thiếu “"+a+"”":"thừa"});const s=$("pfocall");s&&(s.className=e?"pfok":"pfbad",s.textContent=n?e?"✓ Ô chữ hợp lệ":`Cần ${n.length} hàng, mỗi hàng chứa đúng chữ của từ khoá`:"")}function pfGet(t){let n=PF.st;return t.split(".").forEach(t=>n=n[t]),n}function pfDel(t,n){pfGet(t).splice(n,1),pfSave(),pfDraw()}function pfSetA(t,n){pfGet(t).a=n,pfSave()}function pfOpt(t,n,e){const s=pfGet(t);for(s.options=s.options||["","","",""];s.options.length<4;)s.options.push("");s.options[n]=e.value,pfSave()}function pfKind(t,n){PF.st.phieu.exercises[t].kind=n,pfSave(),pfDraw()}function pfAddEx(){PF.st.phieu.exercises.push({kind:"fill",title:"Điền vào chỗ chấm:",items:[{q:"",a:""}]}),pfSave(),pfDraw()}function pfAddItem(t){PF.st.phieu.exercises[t].items.push({q:"",a:"",options:["","","",""],left:"",right:"",lines:2}),pfSave(),pfDraw()}function pfAddK(){PF.st.khoidong.questions.push({q:"",a:""}),pfSave(),pfDraw()}function pfAddQ(){PF.st.game.questions.push({q:"",options:["","","",""],a:"A",explain:""}),pfSave(),pfDraw()}function pfAddOc(){PF.st.game.ochu.rows.push({clue:"",answer:""}),pfSave(),pfDraw()}function pfOcRows(){const t=PF.st.game.ochu,n=GamePlayer.norm(t.keyword).length;for(;t.rows.length<n;)t.rows.push({clue:"",answer:""});t.rows.length=Math.min(t.rows.length,n||t.rows.length),pfSave(),pfDraw()}function pfNeed(){return PF.st.lesson.week?!!PF.st.lesson.ten||(toast("Thầy cô chọn bài (hoặc gõ tên bài) trước nhé","err"),!1):(toast("Thầy cô chọn tuần trước nhé","err"),!1)}const PFJ=t=>({method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(t)});async function pfGen(t){if(pfNeed())return PF.st.types.length?void((PF.st.phieu.exercises.length||PF.st.game.questions.length||PF.st.khoidong.questions.length)&&!confirm("Tạo mới bằng AI? Nội dung đang soạn của các loại đã chọn sẽ được thay.")||await busy(t,async()=>{pfAi("AI đang soạn, thầy cô chờ khoảng 20–40 giây…");try{const t=await api("/api/phieu/generate",PFJ({state:PF.st}));PF.st=t.state,PF.info.ai_used=t.ai_used,pfSec(PF.st.types.includes("phieu")?"phieu":PF.st.types.includes("tuongtac")?"cau":"khoidong"),pfAi(t.message+(t.warnings.length?" "+t.warnings.join(" "):"")),toast(t.message)}catch(t){throw pfAi(t.message+(PF.st.types.includes("tuongtac")?" Thầy cô có thể tự soạn câu hỏi trò chơi ở khung bên phải.":"")),PF.st.types.includes("tuongtac")&&!PF.st.game.questions.length&&pfSec("cau"),t}})):toast("Chọn ít nhất một loại","err")}async function pfExport(t,n){pfNeed()&&await busy(t,async()=>{const t=await api("/api/phieu/export",PFJ({state:PF.st,kind:n})),e=document.createElement("a");e.href=t.download,e.download=t.item.name,document.body.appendChild(e),e.click(),e.remove(),toast("Đã xuất và lưu vào Kho ("+t.week+")"),KH.stale=1})}async function pfNames(){try{if(NX.st&&NX.st.students)return NX.st.students.map(t=>t.name);const t=await api("/api/nhanxet");return(t.state&&t.state.students||[]).map(t=>t.name)}catch(t){return[]}}const PFG=[["rcv","🔔 Rung chuông vàng",3,"cau"],["ochu","🔤 Ô chữ",0,"ochu"],["vq","🎡 Vòng quay",2,"cau"],["an","⚡ Ai nhanh ai đúng",3,"cau"]];function pfGStat(t,n){const e=PF.st.game,s=e.questions.length,o=GamePlayer.prep({questions:e.questions,ochu:e.ochu}),i=o.questions.length;if("ochu"===t){if(o.ochu)return{ok:1,t:`✓ Sẵn sàng · từ khoá ${o.ochu.kw.length} chữ`};const t=e.ochu,n=GamePlayer.norm(t.keyword);return n?n.length<2?{t:"Từ khoá cần ít nhất 2 chữ cái."}:t.rows.length!==n.length?{t:`Cần đủ ${n.length} hàng ngang (đang có ${t.rows.length}).`}:{t:`Hàng ${t.rows.map((t,e)=>t.clue&&GamePlayer.norm(t.answer).includes(n[e])?0:e+1).filter(Boolean).join(", ")} chưa có gợi ý hoặc đáp án chưa chứa chữ của từ khoá.`}:{t:"Chưa có từ khoá hàng dọc – gõ từ khoá (ít nhất 2 chữ) và các hàng ngang."}}return i>=n?{ok:1,t:`✓ Sẵn sàng · ${i} câu hỏi`}:{t:`Cần ít nhất ${n} câu hỏi hợp lệ – còn thiếu ${n-i} câu.`+(s>i?` Có ${s-i} câu chưa đủ (cần câu hỏi, ít nhất 2 phương án và chọn đáp án đúng).`:"")}}function pfGames(){const t=$("pfgcard");if(!t||!PF.st)return;const n=PF.st.types.includes("tuongtac");t.classList.toggle("hide",!n),n&&($("pfgames").innerHTML=PFG.map(([t,n,e,s])=>{const o=pfGStat(t,e);return`<div class="pfgi" data-g="${t}"><b>${n}</b><span class="gst ${o.ok?"ok":"no"}">${esc(o.t)}</span><div class="bs"><button class="gedit" type="button" onclick="pfSec('${s}');pfFocusEd()">✎ ${"ochu"===t?"Soạn ô chữ":"Soạn câu hỏi"}</button><button class="gplay" type="button" ${o.ok?"":"disabled"} title="${o.ok?"Chơi ngay":esc(o.t)}" onclick="pfPlayG('${t}')">▶ Chơi ngay</button></div></div>`}).join(""))}function pfFocusEd(){const t=PF.st;"cau"!==PF.sec||t.game.questions.length||pfAddQ();const n=$("pfed");if(n){n.scrollIntoView({block:"start",behavior:"smooth"});const t=n.querySelector("input[type=text]");t&&setTimeout(()=>t.focus({preventScroll:!0}),300)}}async function pfPlayG(t){const n=PF.st.game,e={title:PF.st.lesson.ten||"Trò chơi",questions:n.questions,ochu:n.ochu};GamePlayer.open(e,{names:await pfNames(),mode:t})}async function pfPlay(){const t=PF.st.game,n={title:PF.st.lesson.ten||"Trò chơi",questions:t.questions,ochu:t.ochu},e=GamePlayer.prep(n);if(!e.questions.length&&!e.ochu)return toast("Chưa có câu hỏi trò chơi hợp lệ (đủ 4 phương án + đáp án) hoặc ô chữ","err");GamePlayer.open(n,{names:await pfNames(),mode:e.questions.length?"rcv":"ochu"})}async function pfSaveGame(t){pfNeed()&&await busy(t,async()=>{const t=await api("/api/phieu/game/save",PFJ({state:PF.st})),n=location.origin+t.play;$("pflink").innerHTML=`Đã lưu vào Kho (${esc(t.week)}). Link chơi (chỉ thầy cô mở được khi đã đăng nhập): <a href="${esc(t.play)}" target="_blank" id="pfplaylink">${esc(n)}</a>`;try{await navigator.clipboard.writeText(n)}catch(t){}toast("Đã lưu trò chơi vào Kho"),KH.stale=1})}
</script>
<script>!function(){const t=/BaoBaiApp/.test(navigator.userAgent)||matchMedia("(display-mode: standalone)").matches||navigator.standalone;let n=null;const a=document.getElementById("instbtn");if("serviceWorker"in navigator&&(!navigator.webdriver||window.__swtest)&&("https:"===location.protocol||"127.0.0.1"===location.hostname||"localhost"===location.hostname))try{navigator.serviceWorker.register("/sw.js").catch(()=>{})}catch(t){}addEventListener("beforeinstallprompt",e=>{e.preventDefault(),n=e,t||a&&a.classList.remove("hide")}),addEventListener("appinstalled",()=>{n=null,a&&a.classList.add("hide"),toast("Đã cài ứng dụng – mở từ màn hình chính nhé")}),window.pwaInstall=async()=>{if(!n)return toast('Trình duyệt chưa cho cài: dùng menu ⋮ → "Cài đặt ứng dụng" / "Thêm vào màn hình chính"');n.prompt();try{await n.userChoice}catch(t){}n=null,a.classList.add("hide")}}();
