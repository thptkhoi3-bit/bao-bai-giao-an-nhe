<script>const PF={info:null,st:null,ls:[],sec:"phieu",t:0},PFK={mcq:"Trắc nghiệm A/B/C/D",fill:"Điền chỗ chấm",tf:"Đúng/Sai",match:"Nối",write:"Trả lời / viết"};function pfBlank(){return{lesson:{week:null,mon:"",thu:"",tiet:"",ten:""},muc:"vua",types:["phieu","tuongtac"],src:"tay",phieu:{exercises:[]},khoidong:{name:"",luat:"",questions:[]},game:{questions:[],ochu:{keyword:"",clue:"",rows:[]}}}}async function pfInit(){if(pfWeeks(),!PF.info)try{const t=await api("/api/phieu");PF.info=t.info,PF.st=t.state||pfBlank(),$("pftypes").innerHTML=Object.entries(t.info.types).map(([t,n])=>`<label data-k="${t}"><input type="checkbox" value="${t}" onchange="pfTypes()">${esc(n)}</label>`).join(""),$("pfmuc").innerHTML=Object.entries(t.info.muc).map(([t,n])=>`<button data-k="${t}" onclick="pfMuc('${t}')">${esc(n)}</button>`).join(""),pfFill(),PF.st.lesson.week&&($("pfweek").value=String(PF.st.lesson.week),pfWeek(!0)),pfDraw(),pfAi()}catch(t){toast(t.message,"err")}}function pfWeeks(){const t=ST&&ST.weeks||[],n=$("pfweek").value||(PF.st&&PF.st.lesson.week?String(PF.st.lesson.week):"");$("pfweek").innerHTML=(t.length?'<option value="">Chọn tuần…</option>':'<option value="">Chưa có báo bài gốc – tải ở tab Báo bài</option>')+t.map(t=>`<option value="${t.week}">Tuần ${t.week}${t.range&&t.range.length?" ("+esc(t.range.join(" – "))+")":""}</option>`).join(""),n&&t.some(t=>String(t.week)===n)&&($("pfweek").value=n),$("pfwhint").style.display=$("pfweek").value?"none":""}function pfFill(){const t=PF.st;$("pften").value=t.lesson.ten||"",$("pfmon").value=t.lesson.mon||"",document.querySelectorAll("#pftypes label").forEach(n=>{const e=t.types.includes(n.dataset.k);n.classList.toggle("on",e),n.querySelector("input").checked=e}),document.querySelectorAll("#pfmuc button").forEach(n=>n.classList.toggle("on",n.dataset.k===t.muc))}function pfAi(t){const n=PF.info;n&&($("pfai").textContent=t||(n.ai?`AI: còn ${Math.max(0,n.ai_limit-n.ai_used)}/${n.ai_limit} lượt hôm nay · mỗi lần tạo dùng 1 lượt.`:"Ch